<%
  const terms = [
    {
      id: 'original',
      badge: 'pb-badge-passed',
      label: '원안가결',
      desc: '발의된 내용 그대로 본회의 표결을 통과한 법안.',
      note: '본회의에서 수정 없이 원래 법안 형태로 통과된 경우.'
    },
    {
      id: 'modified',
      badge: 'pb-badge-passed',
      label: '수정가결',
      desc: '법안 내용 중 일부를 수정한 뒤 본회의 표결을 통과한 법안.',
      note: '위원회 심사 또는 본회의 과정에서 수정 의결된 경우.'
    },
    {
      id: 'alt-dropped',
      badge: 'pb-badge-alt',
      label: '대안반영폐기',
      desc: '해당 법안의 내용이 유사한 다른 법안(대안)에 흡수·통합되어 원안이 폐기된 경우.',
      note: '비슷한 주제의 여러 법안이 있을 때, 하나의 통합 법안으로 병합되며 원안들은 절차상 폐기 처리됩니다. 내용 자체가 사라지는 것은 아닙니다.'
    },
    {
      id: 'mod-dropped',
      badge: 'pb-badge-alt',
      label: '수정안반영폐기',
      desc: '제출된 수정안이 별도 법안으로 처리되면서 원안이 폐기된 경우.',
      note: '대안반영폐기와 유사한 개념.'
    },
    {
      id: 'withdrawn',
      badge: 'pb-badge-withdrawn',
      label: '철회',
      desc: '발의자가 스스로 취소한 법안.',
      note: '본회의 표결 전, 발의자 본인이 의안을 거둬들인 경우.'
    },
    {
      id: 'pending',
      badge: 'pb-badge-pending',
      label: '계류',
      desc: '아직 심사가 진행 중인 법안.',
      note: '발의 후 위원회 심사, 법사위 심사, 본회의 상정 중 어느 단계에서든 최종 처리가 끝나지 않은 상태.'
    },
    {
      id: 'rejected',
      badge: 'pb-badge-rejected',
      label: '부결',
      desc: '본회의 표결에서 반대가 많아 통과되지 못한 법안.',
      note: '찬성보다 반대/기권이 많았거나 정족수 미달 등으로 통과되지 못한 경우.'
    },
    {
      id: 'dropped',
      badge: 'pb-badge-rejected',
      label: '폐기',
      desc: '임기 만료, 철회, 절차상 문제 등으로 더 이상 심사되지 않는 법안.',
      note: '22대 국회 임기 내 처리되지 않은 법안은 임기 만료와 함께 자동 폐기됩니다.'
    }
  ];

  const roles = [
    { id: 'rep-proposer', label: '대표발의', desc: '법안을 최초로 발의한 의원. 한 법안에 1명.' },
    { id: 'co-proposer',  label: '공동발의', desc: '대표발의자와 함께 이름을 올린 의원. 최소 10명 이상 필요.' }
  ];

  const votes = [
    { id: 'vote-for',     label: '찬성',  desc: '본회의에서 가결에 동의한 경우.' },
    { id: 'vote-against', label: '반대',  desc: '본회의에서 가결에 반대한 경우.' },
    { id: 'vote-abstain', label: '기권',  desc: '표결에 참여했으나 찬성·반대 어느 쪽도 선택하지 않음.' },
    { id: 'vote-absent',  label: '불참',  desc: '표결 자체에 참여하지 않음. 참여율 계산에서 제외.' }
  ];

  const participationFormula = '표결 참여율 = (찬성 + 반대 + 기권) ÷ 전체 본회의 표결 법안 수';
%>

<style>
  .gl-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }
  .gl-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    margin-bottom: 16px;
  }
  .gl-breadcrumb a { color: var(--blue); }

  .gl-title {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text);
  }
  .gl-lead {
    font-size: 14px;
    color: var(--sub);
    margin-bottom: 40px;
    line-height: 1.8;
    max-width: 640px;
  }

  .gl-section {
    margin-bottom: 48px;
  }
  .gl-section h2 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--blue);
    margin-bottom: 16px;
  }
  .gl-section h2 span {
    font-family: 'Noto Sans KR', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0;
    text-transform: none;
    margin-left: 8px;
  }

  .gl-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .gl-item {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px 20px;
    transition: border-color 0.2s;
    scroll-margin-top: 72px;
  }
  .gl-item:target {
    border-color: var(--blue);
    box-shadow: 0 0 0 2px var(--accent-15);
  }
  .gl-item-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .gl-item-label {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }
  .gl-item-desc {
    font-size: 14px;
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 6px;
  }
  .gl-item-note {
    font-size: 13px;
    color: var(--sub);
    line-height: 1.7;
  }

  .gl-formula {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--text);
    margin-top: 12px;
  }
</style>

<div class="gl-wrap">
  <div class="gl-breadcrumb"><a href="/">홈</a> / 용어 설명</div>

  <h1 class="gl-title">용어 설명</h1>
  <p class="gl-lead">
    정치 바로미터는 국회 공공데이터의 원래 용어를 그대로 사용합니다.
    익숙하지 않은 법안 처리 결과·발의 구분·표결 결과를 여기서 찾아보세요.
  </p>

  <!-- 법안 처리 결과 -->
  <section class="gl-section">
    <h2>// BILL_RESULT <span>법안 처리 결과</span></h2>
    <div class="gl-list">
      <% terms.forEach(t => { %>
        <div class="gl-item" id="<%= t.id %>">
          <div class="gl-item-header">
            <span class="pb-badge <%= t.badge %>"><%= t.label %></span>
          </div>
          <div class="gl-item-desc"><%= t.desc %></div>
          <div class="gl-item-note"><%= t.note %></div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- 발의자 구분 -->
  <section class="gl-section">
    <h2>// PROPOSER <span>발의자 구분</span></h2>
    <div class="gl-list">
      <% roles.forEach(r => { %>
        <div class="gl-item" id="<%= r.id %>">
          <div class="gl-item-header">
            <span class="pb-badge <%= r.id === 'rep-proposer' ? 'pb-badge-category' : 'pb-badge-alt' %>"><%= r.label %></span>
          </div>
          <div class="gl-item-desc"><%= r.desc %></div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- 표결 결과 -->
  <section class="gl-section">
    <h2>// VOTE_RESULT <span>본회의 표결 결과</span></h2>
    <div class="gl-list">
      <% votes.forEach(v => { %>
        <div class="gl-item" id="<%= v.id %>">
          <div class="gl-item-header">
            <span class="pb-badge <%= v.id === 'vote-for' ? 'pb-badge-passed' : v.id === 'vote-against' ? 'pb-badge-rejected' : 'pb-badge-alt' %>"><%= v.label %></span>
          </div>
          <div class="gl-item-desc"><%= v.desc %></div>
        </div>
      <% }); %>
    </div>

    <div class="gl-formula">
      <%= participationFormula %>
    </div>
  </section>
</div>
