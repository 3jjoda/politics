             { label: '40대',      cnt: age40, bucket: '40s',    cls: 'age-2' },
             { label: '50대',      cnt: age50, bucket: '50s',    cls: 'age-3' },
             { label: '60대',      cnt: age60, bucket: '60s',    cls: 'age-4' },
