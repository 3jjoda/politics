<%
  const nf = (n) => Number(n || 0).toLocaleString('ko-KR');

  // 정당별 카드 색상
  const partyColorOf = (name) => {
    if (!name) return '#4B5563';
    if (name.indexOf('더불어민주') > -1) return '#1E40AF';
    if (name.indexOf('국민의힘') > -1) return '#B91C1C';
    if (name.indexOf('조국혁신') > -1) return '#6D28D9';
    if (name.indexOf('개혁') > -1) return '#B45309';
    if (name.indexOf('진보') > -1) return '#991B1B';
    return '#4B5563';
  };
  const partyClassOf = (name) => {
    if (!name) return 'party-etc';
    if (name.indexOf('더불어민주') > -1) return 'party-minjoo';
    if (name.indexOf('국민의힘') > -1) return 'party-gukhim';
    if (name.indexOf('조국혁신') > -1) return 'party-jokuk';
    if (name.indexOf('개혁') > -1) return 'party-gaehyuk';
    if (name.indexOf('진보') > -1) return 'party-jinbo';
    return 'party-etc';
  };

  // D 레이어 일치도 배지 (게임 완료 + 의원 좌표 있음)
  // 텍스트는 거리 → 일치도(%) 변환만 노출. 시각 차등·이모지·라벨·v1·거리값 모두 제거 (상세 정보는 툴팁으로)
  const userAxis = locals.userAxis || null;
  const distanceTo = (p) => {
    if (!userAxis || p.axis_economy === null || p.axis_economy === undefined) return null;
    const sum =
      (userAxis.economy     - parseFloat(p.axis_economy))     ** 2 +
      (userAxis.social      - parseFloat(p.axis_social))      ** 2 +
      (userAxis.security    - parseFloat(p.axis_security))    ** 2 +
      (userAxis.institution - parseFloat(p.axis_institution)) ** 2;
    return Math.sqrt(sum) / 2;
  };
  // 일치도(%) — 분모 1.5: 실제 의원 거리 분포가 이론적 최대 2.0 에 절대 도달 못 함
  // 사용자 직관 ("다이아몬드 거의 안 겹치는 의원" → 5~10%)과 정합되도록 보정
  // similarity = max(0, (1 - d/1.5) × 100)
  //   d=0.0  → 100% / d=0.61 (가장 가까움) → 59% / d=1.40 → 7% / d≥1.5 → 0%
  const similarityOf = (d) => {
    if (d === null || d === undefined) return null;
    return Math.max(0, Math.round((1 - d / 1.5) * 100));
  };
  const matchTitle = (d) => `당신 좌표와 4축 거리 ${d.toFixed(2)}. 매핑 v1 기준.`;
%>

<style>

