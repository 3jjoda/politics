<%# 1. 헤더 공통 영역을 불러옵니다. %>
<%- include('../partials/header', { pageTitle: pageTitle, pageStyles: pageStyles, currentUrl: currentUrl }) %>

<%# 2. 페이지에서 사용할 데이터 글로벌 변수로 셋팅 (서버에서 politician로 넘김) %>
<script>
    window.politicianData = <%- JSON.stringify(politician) %>;
</script>

<%# 3. 페이지 고유의 콘텐츠 %>
<section class="controls">
    <div class="filter-container">
        <div class="custom-select-wrapper">
            <select id="type-filter" class="filter-select">
                </select>
        </div>
    </div>
    <div class="politician-count" id="politician-count"></div>
    <div class="search-container">
        <i class="fas fa-search"></i>
        <input type="text" id="name-search" placeholder="이름으로 검색...">
    </div>
    <div class="sort-buttons">
        <button class="sort-btn active" data-sort="name">이름순 <span class="sort-indicator"></span></button>
        <button class="sort-btn" data-sort="party">정당순 <span class="sort-indicator"></span></button>
        <button class="sort-btn" data-sort="reele">재선순 <span class="sort-indicator"></span></button>
        <button class="sort-btn" data-sort="age">나이순 <span class="sort-indicator"></span></button>
    </div>
</section>

<section class="summary-section" id="politician-summary">
    </section>

<section class="politician-grid">
    <p class="loading-message">의원 목록을 불러오는 중입니다...</p>
</section>

<%# 페이징 동적으로 생성 %>
<div class="pagination-container" id="pagination-container"></div>

<%# 4. 푸터 공통 영역 %>
<%- include('../partials/footer') %>

<%# 5. 이 페이지에서만 사용하는 스크립트를 가장 마지막에 추가 %>
<script src="/scripts/politician/politician.js" type="module"></script>