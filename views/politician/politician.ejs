  const gs         = genderStats || { male_cnt: 0, female_cnt: 0, total_cnt: 0 };
  const maleCnt    = Number(gs.male_cnt || 0);
  const femaleCnt  = Number(gs.female_cnt || 0);
  const genderTot  = maleCnt + femaleCnt;
