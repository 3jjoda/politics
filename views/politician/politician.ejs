    text-align: center;
    color: var(--sub);
    background: var(--bg2);
    border: 1px dashed var(--border);
    border-radius: 12px;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .page-btn {
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--sub);
    font-size: 14px;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    transition: all 0.15s;
  }
  .page-btn:hover { border-color: var(--border2); color: var(--text); }
  .page-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }

  /* 필터 시트 (모바일 바텀시트) — 버튼/백드롭은 데스크톱 숨김, 헤더는 항상 노출 */
  .filter-sheet-btn { display: none; }
  .filter-sheet-backdrop { display: none; }

  /* 사이드바 내부 헤더 — 데스크톱/모바일 공통 */
  .filter-sheet-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 12px;
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .filter-sheet-title { font-size: 14px; font-weight: 700; color: var(--text); flex-shrink: 0; }
  .filter-sheet-actions {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }
  .filter-sheet-reset,
  .filter-sheet-apply {
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .filter-sheet-reset {
    background: var(--bg3);
    color: var(--sub);
    border-color: var(--border);
  }
  .filter-sheet-apply {
    background: var(--accent);
    color: #fff;
  }
  .filter-sheet-close {
    display: none;
    background: transparent;
    border: none;
    font-size: 24px;
    line-height: 1;
    color: var(--text);
    cursor: pointer;
    padding: 0 4px;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .content-wrap { grid-template-columns: 1fr; padding: 16px; }
    .filter-toggle { display: none; }
    #grid-view { display: none !important; }
    #list-view { display: block !important; }
    .list-header { display: none; }
    .pol-list-item { grid-template-columns: 48px 1fr auto; gap: 8px 12px; padding: 14px 16px; }
    /* 공동(4번째) 숨김 — 발의(3번째) 만 노출. 5번째(일치도) 는 row2 전폭 노출 */
    .pol-list-item > div:nth-child(4) { display: none; }
    .pol-list-num-label { display: inline-block; }
    .pol-list-num { text-align: right; font-size: 14px; }
    /* 5번째 div 를 row2 전폭으로 — 일치 텍스트만 좌측정렬, 상세→ 는 숨김 */
    .pol-list-aside {
      grid-column: 2 / -1;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
    }
    .pol-list-detail-arrow { display: none; }
    .pol-list-item .pol-match-line { white-space: normal; }

    /* 필터 버튼 노출 — 검색 바 위에 전체 폭 */
    .filter-sheet-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 14px;
      background: var(--bg2);
      border: 1px solid var(--border2);
      border-radius: 8px;
      color: var(--text);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      flex-basis: 100%;
    }
    .filter-sheet-btn:hover { border-color: var(--accent); }

    /* 검색/정렬/총원이 한 줄에 — search 가 가변, count 는 끝에 */
    .filter-right { width: 100%; flex-wrap: wrap; }
    .search-wrap { flex: 1; min-width: 160px; }
    .search-input { width: 100%; }
    .filter-count { margin-left: auto; }
    .filter-sheet-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 18px;
      height: 18px;
      padding: 0 5px;
      background: var(--accent);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      border-radius: 9px;
    }
    .filter-sheet-badge[hidden] { display: none; }

    /* 사이드바를 바텀시트로 전환 */
    .sidebar {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      max-height: 85vh;
      width: 100%;
      background: var(--bg2);
      border-top: 1px solid var(--border);
      border-top-left-radius: 16px;
      border-top-right-radius: 16px;
      padding: 0 16px 20px;
      overflow-y: auto;
      z-index: 150;
      box-shadow: 0 -8px 24px rgba(0,0,0,0.12);
      transform: translateY(100%);
      transition: transform 0.25s ease-out;
    }
    body.filter-sheet-open .sidebar { transform: translateY(0); }

    /* 모바일 시트 헤더 오버라이드 — 닫기 버튼 노출 */
    .filter-sheet-header {
      padding: 16px 14px 12px;
      border-radius: 0;
      border: none;
      border-bottom: 1px solid var(--border);
      margin-bottom: 12px;
    }
    .filter-sheet-title { font-size: 16px; }
    .filter-sheet-close { display: block; font-size: 28px; }

    /* 시트 내부에선 sidebar-list 가 더 길게 보이도록 */
    .sidebar-list { max-height: none; }

    /* 백드롭 */
    .filter-sheet-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      z-index: 140;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s;
    }
    body.filter-sheet-open .filter-sheet-backdrop {
      opacity: 1;
      pointer-events: auto;
    }
    body.filter-sheet-open { overflow: hidden; }
  }
</style>

<div class="pb-page-header">
  <div class="pb-page-header-inner">
    <div>
      <h1 class="pb-page-title">국회의원</h1>
      <p class="pb-page-desc">22대 국회 <%= nf(politicians.length) %>명의 의정 활동을 모두 확인합니다</p>
    </div>
  </div>
</div>

<%
  const histoTotal = partyCounts.reduce((s, p) => s + Number(p.cnt), 0);
%>
<div class="party-histogram">
  <div class="ph-title">
    <div>
      <div class="ph-title-label">SEAT DISTRIBUTION · <strong>정당별 의석 분포</strong></div>
    </div>
    <div class="ph-total">총 <strong><%= nf(histoTotal) %>석</strong></div>
  </div>
  <div class="ph-bar">
    <% partyCounts.forEach(pc => {
         const w = histoTotal > 0 ? (Number(pc.cnt) / histoTotal * 100) : 0;
         const color = partyColorOf(pc.party_name);
         const small = w < 5;
    %>
      <div class="ph-seg" style="background: <%= color %>; width: <%= w.toFixed(2) %>%" data-small="<%= small %>" title="<%= pc.party_name %> · <%= pc.cnt %>석">
        <% if (!small) { %><span class="ph-seg-text"><%= pc.cnt %></span><% } %>
      </div>
    <% }); %>
  </div>
  <div class="ph-legend">
    <% partyCounts.forEach(pc => {
         const w = histoTotal > 0 ? (Number(pc.cnt) / histoTotal * 100) : 0;
         const color = partyColorOf(pc.party_name);
    %>
      <div class="ph-legend-item">
        <span class="ph-legend-dot" style="background: <%= color %>"></span>
        <strong><%= pc.party_name %></strong>
        <span class="ph-legend-count"><%= nf(pc.cnt) %>석 (<%= w.toFixed(1) %>%)</span>
      </div>
    <% }); %>
  </div>
</div>

<div class="filter-bar">
  <div class="filter-bar-inner">
    <!-- LEFT: 뷰 형태 토글 -->
    <div class="filter-toggle">
      <button class="filter-toggle-btn active" id="btn-grid" aria-label="그리드 보기">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        그리드
      </button>
      <button class="filter-toggle-btn" id="btn-list" aria-label="리스트 보기">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        리스트
      </button>
    </div>

    <!-- 모바일 전용: 필터 시트 오픈 (검색 바 위) -->
    <button type="button" class="filter-sheet-btn" id="filter-sheet-btn" aria-label="필터 열기">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
      필터<span class="filter-sheet-badge" id="filter-sheet-badge" hidden>0</span>
    </button>

    <!-- RIGHT: 정렬 + 검색 + 총원 (count 는 검색 옆으로) -->
    <div class="filter-right">
      <% const _bgDone = (locals.balanceGameCompleted === true); %>
      <select id="pol-match-filter" class="filter-select"<% if (!_bgDone) { %> disabled title="성향 진단 후 활성됩니다"<% } %>>
        <option value="">일치도: 전체</option>
        <option value="gte70">70% 이상</option>
        <option value="gte60">60% 이상</option>
        <option value="gte50">50% 이상</option>
        <option value="lt50">50% 미만</option>
      </select>
      <select id="pol-gap-filter" class="filter-select" title="자당 발의 법안과 타당 발의 법안의 찬성률 차이. 클수록 소속 정당에 따라 표결이 갈렸다는 뜻입니다.">
        <option value="">당 성향: 전체</option>
        <option value="lt2">법안 중심 (2%p 미만)</option>
        <option value="lt5">중간 이하 (5%p 미만)</option>
        <option value="gte5">뚜렷한 편 (5%p 이상)</option>
        <option value="gte10">매우 뚜렷 (10%p 이상)</option>
      </select>
      <select id="pol-sort" class="filter-select">
        <option value="propose">정렬: 발의 많은순</option>
        <option value="name">정렬: 이름순</option>
        <option value="party">정렬: 정당순</option>
        <option value="match-desc"<% if (!_bgDone) { %> disabled<% } %>>정렬: 일치도 높은 순</option>
        <option value="match-asc"<% if (!_bgDone) { %> disabled<% } %>>정렬: 일치도 낮은 순</option>
        <option value="gap-desc">정렬: 당 성향 뚜렷한 순</option>
        <option value="gap-asc">정렬: 법안 중심인 순</option>
      </select>
      <div class="search-wrap">
        <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="pol-search" class="search-input" placeholder="의원 이름, 지역구 검색...">
      </div>
      <span class="filter-count" id="filter-count">총 <%= nf(politicians.length) %>명</span>
    </div>
  </div>
</div>

<div class="party-tabs">
  <div class="party-tabs-inner">
    <button class="party-tab active" data-party="">전체 <span class="party-count"><%= nf(politicians.length) %></span></button>
    <% partyCounts.forEach(pc => { %>
      <button class="party-tab" data-party="<%= pc.party_name %>">
        <%= pc.party_name %> <span class="party-count"><%= nf(pc.cnt) %></span>
      </button>
    <% }); %>
  </div>
</div>

<%
  // 성별 분포
  const gs         = genderStats || { male_cnt: 0, female_cnt: 0, total_cnt: 0 };
  const maleCnt    = Number(gs.male_cnt || 0);
  const femaleCnt  = Number(gs.female_cnt || 0);
  const genderTot  = maleCnt + femaleCnt;
  const pct        = (n, t) => t > 0 ? (n / t * 100) : 0;

  // 연령대 분포
  const as = ageGroupStats || { age_20s: 0, age_30s: 0, age_40s: 0, age_50s: 0, age_60s: 0, age_70plus: 0, total_cnt: 0 };
  const age20  = Number(as.age_20s     || 0);
  const age30  = Number(as.age_30s     || 0);
  const age40  = Number(as.age_40s     || 0);
  const age50  = Number(as.age_50s     || 0);
  const age60  = Number(as.age_60s     || 0);
  const age70  = Number(as.age_70plus  || 0);
  const ageTot = age20 + age30 + age40 + age50 + age60 + age70;
  // 막대 기준: 제일 큰 그룹을 100% 로
  const ageMax = Math.max(1, age20, age30, age40, age50, age60, age70);
%>

<div class="filter-sheet-backdrop" id="filter-sheet-backdrop" hidden></div>

<div class="content-wrap">
  <aside class="sidebar" id="filter-sidebar">
    <div class="filter-sheet-header">
      <span class="filter-sheet-title">필터</span>
      <div class="filter-sheet-actions">
        <button type="button" class="filter-sheet-reset" id="filter-sheet-reset">초기화</button>
        <button type="button" class="filter-sheet-apply" id="filter-sheet-apply">적용</button>
      </div>
      <button type="button" class="filter-sheet-close" id="filter-sheet-close" aria-label="닫기">×</button>
    </div>
    <!-- 성별 분포 (클릭 필터) -->
    <div class="sidebar-card">
      <div class="sidebar-title">성별 분포</div>
      <div class="dist-body">
        <div class="dist-row" data-dist="sex" data-dist-value="남">
          <span class="dist-label">남성</span>
          <div class="dist-bar-wrap">
            <div class="dist-bar male" style="width: <%= pct(maleCnt, genderTot).toFixed(1) %>%"></div>
          </div>
          <span class="dist-val"><strong><%= pct(maleCnt, genderTot).toFixed(1) %>%</strong> · <%= nf(maleCnt) %>명</span>
        </div>
        <div class="dist-row" data-dist="sex" data-dist-value="여">
          <span class="dist-label">여성</span>
          <div class="dist-bar-wrap">
            <div class="dist-bar female" style="width: <%= pct(femaleCnt, genderTot).toFixed(1) %>%"></div>
          </div>
          <span class="dist-val"><strong><%= pct(femaleCnt, genderTot).toFixed(1) %>%</strong> · <%= nf(femaleCnt) %>명</span>
        </div>
        <div class="dist-hint">행을 클릭하면 필터가 적용됩니다 · 같은 행 재클릭 시 해제</div>
      </div>
    </div>

    <!-- 연령대 분포 (클릭 필터) -->
    <div class="sidebar-card">
      <div class="sidebar-title">연령대 분포</div>
      <div class="dist-body">
        <% const ageItems = [
             { label: '20대',      cnt: age20, bucket: '20s',    cls: 'age-0' },
             { label: '30대',      cnt: age30, bucket: '30s',    cls: 'age-1' },
             { label: '40대',      cnt: age40, bucket: '40s',    cls: 'age-2' },
             { label: '50대',      cnt: age50, bucket: '50s',    cls: 'age-3' },
             { label: '60대',      cnt: age60, bucket: '60s',    cls: 'age-4' },
             { label: '70대 이상', cnt: age70, bucket: '70plus', cls: 'age-5' }
           ]; %>
        <% ageItems.forEach(it => { %>
          <div class="dist-row" data-dist="ageBucket" data-dist-value="<%= it.bucket %>">
            <span class="dist-label"><%= it.label %></span>
            <div class="dist-bar-wrap">
              <div class="dist-bar <%= it.cls %>" style="width: <%= (it.cnt / ageMax * 100).toFixed(1) %>%"></div>
            </div>
            <span class="dist-val"><strong><%= pct(it.cnt, ageTot).toFixed(1) %>%</strong> · <%= nf(it.cnt) %>명</span>
          </div>
        <% }); %>
      </div>
    </div>

    <div class="sidebar-card">
      <div class="sidebar-title">상임위원회</div>
      <div class="sidebar-list" id="committee-list">
        <div class="sidebar-item active" data-cmit="">
          <span class="sidebar-item-name">전체</span>
          <span class="sidebar-item-count"><%= nf(politicians.length) %></span>
        </div>
        <% committeeCounts.forEach(cc => { %>
          <div class="sidebar-item" data-cmit="<%= cc.cmit_nm %>">
            <span class="sidebar-item-name"><%= cc.cmit_nm %></span>
            <span class="sidebar-item-count"><%= nf(cc.cnt) %></span>
          </div>
        <% }); %>
      </div>
    </div>

    <div class="sidebar-card">
      <div class="sidebar-title">선출 방식</div>
      <div class="sidebar-list" id="elect-list">
        <div class="sidebar-item active" data-elect="">
          <span class="sidebar-item-name">전체</span>
          <span class="sidebar-item-count"><%= nf(politicians.length) %></span>
        </div>
        <% electCounts.forEach(ec => { %>
          <div class="sidebar-item" data-elect="<%= ec.elect_gbn_nm %>">
            <span class="sidebar-item-name"><%= ec.elect_gbn_nm %></span>
            <span class="sidebar-item-count"><%= nf(ec.cnt) %></span>
          </div>
        <% }); %>
      </div>
    </div>
  </aside>

  <div>
    <div class="stats-row">
      <div class="mini-stat">
        <div class="mini-stat-val"><%= nf(politicians.length) %></div>
        <div class="mini-stat-label">전체 의원</div>
      </div>
      <div class="mini-stat">
        <div class="mini-stat-val"><%= nf(politicians.reduce((s, p) => s + Number(p.propose_cnt || 0), 0)) %></div>
        <div class="mini-stat-label">총 발의 법안</div>
      </div>
      <div class="mini-stat">
        <div class="mini-stat-val"><%
          const total = politicians.length || 1;
          const totalProp = politicians.reduce((s, p) => s + Number(p.propose_cnt || 0), 0);
          %><%= (totalProp / total).toFixed(0) %>건</div>
        <div class="mini-stat-label">의원당 평균 발의</div>
      </div>
      <div class="mini-stat">
        <div class="mini-stat-val"><%= partyCounts.length %></div>
        <div class="mini-stat-label">정당 수</div>
      </div>
    </div>

    <!-- GRID VIEW -->
    <div id="grid-view">
      <div class="politicians-grid" id="grid-container">
        <% politicians.forEach(p => {
             const color = partyColorOf(p.party_name);
             const pClass = partyClassOf(p.party_name);
        %>
          <a href="/politician/<%= p.mona_cd %>"
             class="pol-card pol-item"
             data-name="<%= p.name %>"
             data-district="<%= p.electoral_district || '' %>"
             data-party="<%= p.party_name || '' %>"
             data-cmit="<%= p.cmit_nm || '' %>"
             data-elect="<%= p.elect_gbn_nm || '' %>"
             data-sex="<%= p.sex_gbn_nm || '' %>"
             data-age-bucket="<%= p.age_bucket || '' %>"
             data-propose="<%= p.propose_cnt || 0 %>"
             data-match-pct="<% const _mp = similarityOf(distanceTo(p)); %><%= _mp === null ? '' : _mp %>"
             data-gap="<%= (p.cpv_gap === null || p.cpv_gap === undefined) ? '' : p.cpv_gap %>">
            <% if (p.photo_url) { %>
              <img src="<%= p.photo_url %>" alt="<%= p.name %>" class="pol-photo-img" loading="lazy">
            <% } else { %>
              <div class="pol-photo-fallback"><%= (p.name || '?').trim().charAt(0) %></div>
            <% } %>

            <div class="pol-badges">
              <span class="pol-party-badge <%= pClass %>"><%= p.party_name || '무소속' %></span>
              <% if (p.elect_gbn_nm) { %>
                <span class="pol-elect-badge"><%= p.elect_gbn_nm %></span>
              <% } %>
            </div>

            <div class="pol-overlay">
              <div class="pol-name"><%= p.name %></div>
              <div class="pol-district"><%= p.electoral_district || '—' %></div>
              <div class="pol-stats-line">
                <span><span class="num"><%= p.propose_cnt %></span><span class="label">발의</span></span>
                <span><span class="num"><%= p.co_propose_cnt %></span><span class="label">공동</span></span>
              </div>
              <%
                const _d = distanceTo(p);
                const _sim = similarityOf(_d);
              %>
              <% if (locals.balanceGameCompleted === true && _sim !== null) { %>
                <div class="pol-match-line" title="<%= matchTitle(_d) %>">나의 성향 진단과 <strong><%= _sim %>%</strong> 일치</div>
              <% } else if (locals.balanceGameCompleted === false) { %>
                <div class="pol-match-line is-pending" title="성향 진단 후 당신과의 일치도가 표시됩니다">진단 후 일치도 표시</div>
              <% } %>
            </div>
          </a>
        <% }); %>
      </div>
      <div class="empty-state" id="grid-empty" style="display:none">조건에 맞는 의원이 없습니다.</div>
    </div>

    <!-- LIST VIEW -->
    <div id="list-view" style="display:none">
      <div class="list-header">
        <span></span>
        <span>의원</span>
        <span style="text-align:center">발의</span>
        <span style="text-align:center">공동</span>
        <span></span>
      </div>
      <div class="politicians-list" id="list-container">
        <% politicians.forEach(p => {
             const pClass = partyClassOf(p.party_name);
        %>
          <a href="/politician/<%= p.mona_cd %>"
             class="pol-list-item pol-item-list"
             style="text-decoration:none"
             data-name="<%= p.name %>"
             data-district="<%= p.electoral_district || '' %>"
             data-party="<%= p.party_name || '' %>"
             data-cmit="<%= p.cmit_nm || '' %>"
             data-elect="<%= p.elect_gbn_nm || '' %>"
             data-sex="<%= p.sex_gbn_nm || '' %>"
             data-age-bucket="<%= p.age_bucket || '' %>"
             data-propose="<%= p.propose_cnt || 0 %>"
             data-match-pct="<% const _mpL = similarityOf(distanceTo(p)); %><%= _mpL === null ? '' : _mpL %>"
             data-gap="<%= (p.cpv_gap === null || p.cpv_gap === undefined) ? '' : p.cpv_gap %>">
            <div class="pol-list-avatar">
              <%- avatarHtml(p.name, p.photo_url, 40) %>
            </div>
            <div>
              <div class="pol-list-name-row">
                <span class="pol-list-name"><%= p.name %></span>
                <span class="pol-party-badge <%= pClass %>"><%= p.party_name || '무소속' %></span>
              </div>
              <div class="pol-list-sub"><%= p.electoral_district || '—' %></div>
            </div>
            <div class="pol-list-num"><span class="pol-list-num-label">발의</span><%= p.propose_cnt %></div>
            <div class="pol-list-num"><span class="pol-list-num-label">공동</span><%= p.co_propose_cnt %></div>
            <div class="pol-list-aside">
              <%
                const _dl = distanceTo(p);
                const _siml = similarityOf(_dl);
              %>
              <% if (locals.balanceGameCompleted === true && _siml !== null) { %>
                <span class="pol-match-line" title="<%= matchTitle(_dl) %>">나의 성향 진단과 <strong><%= _siml %>%</strong> 일치</span>
              <% } else if (locals.balanceGameCompleted === false) { %>
                <span class="pol-match-line is-pending" title="성향 진단 후 당신과의 일치도가 표시됩니다">진단 후 일치도 표시</span>
              <% } %>
              <span class="pol-list-detail-arrow">상세 →</span>
            </div>
          </a>
        <% }); %>
      </div>
      <div class="empty-state" id="list-empty" style="display:none">조건에 맞는 의원이 없습니다.</div>
    </div>
  </div>
</div>

<script>
(() => {
  // party 는 상단 탭(단일), 나머지는 사이드바 복수선택 배열
  // match: '' | 'gte70' | 'gte60' | 'gte50' | 'lt50'
  // gap:   '' | 'lt2' | 'lt5' | 'gte5' | 'gte10'   (교차 표결 성향 격차 %p)
  // sort: 'propose' | 'name' | 'party' | 'match-desc' | 'match-asc' | 'gap-desc' | 'gap-asc'
  const state = { party: '', cmit: [], elect: [], sex: [], ageBucket: [], q: '', sort: 'propose', match: '', gap: '' };
  const bgDone = <%= locals.balanceGameCompleted === true ? 'true' : 'false' %>;

  const gridContainer = document.getElementById('grid-container');
  const listContainer = document.getElementById('list-container');
  const countEl = document.getElementById('filter-count');

  // 일치도 필터 임계값
  const matchPasses = (pctStr, mode) => {
    if (!mode) return true;
    if (pctStr === '' || pctStr === undefined || pctStr === null) return false; // 좌표 미산출 → 필터 적용 시 제외
    const pct = parseInt(pctStr, 10);
    if (isNaN(pct)) return false;
    if (mode === 'gte70') return pct >= 70;
    if (mode === 'gte60') return pct >= 60;
    if (mode === 'gte50') return pct >= 50;
    if (mode === 'lt50')  return pct <  50;
    return true;
  };

  // 당 성향 격차 필터 — 값이 없는 의원(표본 50건 미만·무소속 등)은 필터 적용 시 제외
  const gapPasses = (gapStr, mode) => {
    if (!mode) return true;
    if (gapStr === '' || gapStr === undefined || gapStr === null) return false;
    const g = parseFloat(gapStr);
    if (isNaN(g)) return false;
    if (mode === 'lt2')   return g <  2;
    if (mode === 'lt5')   return g <  5;
    if (mode === 'gte5')  return g >= 5;
    if (mode === 'gte10') return g >= 10;
    return true;
  };

  const applyFilter = () => {
    const q = state.q.trim();
    let visibleCount = 0;

    const filterCard = (el) => {
      const name     = el.dataset.name || '';
      const district = el.dataset.district || '';
      const party = el.dataset.party || '';
      const cmit = el.dataset.cmit || '';
      const elect = el.dataset.elect || '';
      const sex   = el.dataset.sex || '';
      const age   = el.dataset.ageBucket || '';
      const matchPct = el.dataset.matchPct || '';
      const gapVal = el.dataset.gap || '';

      // 이름·지역구 — 직접 부분일치 + 한글 초성 매칭 (PB.matchesQuery)
      const textHit = !q || (window.PB && (PB.matchesQuery(name, q) || PB.matchesQuery(district, q)));
      const matches = textHit &&
        (!state.party || party === state.party) &&
        (state.cmit.length === 0       || state.cmit.includes(cmit)) &&
        (state.elect.length === 0      || state.elect.includes(elect)) &&
        (state.sex.length === 0        || state.sex.includes(sex)) &&
        (state.ageBucket.length === 0  || state.ageBucket.includes(age)) &&
        matchPasses(matchPct, state.match) &&
        gapPasses(gapVal, state.gap);

      el.style.display = matches ? '' : 'none';
      return matches;
    };

    const gridItems = Array.from(document.querySelectorAll('.pol-item'));
    const listItems = Array.from(document.querySelectorAll('.pol-item-list'));

    gridItems.forEach(filterCard);
    listItems.forEach(filterCard);

    // Sort — 일치도 정렬 시 좌표 미산출(빈 문자열) 의원은 항상 마지막
    const matchKey = (el) => {
      const v = el.dataset.matchPct;
      if (v === '' || v === undefined || v === null) return null;
      const n = parseInt(v, 10);
      return isNaN(n) ? null : n;
    };
    // 격차 정렬 시에도 값 없는 의원은 항상 마지막
    const gapKey = (el) => {
      const v = el.dataset.gap;
      if (v === '' || v === undefined || v === null) return null;
      const n = parseFloat(v);
      return isNaN(n) ? null : n;
    };
    const sortFn = (a, b) => {
      if (state.sort === 'gap-desc' || state.sort === 'gap-asc') {
        const ga = gapKey(a), gb = gapKey(b);
        if (ga === null && gb === null) return 0;
        if (ga === null) return 1;
        if (gb === null) return -1;
        return state.sort === 'gap-desc' ? (gb - ga) : (ga - gb);
      }
      if (state.sort === 'match-desc' || state.sort === 'match-asc') {
        const ma = matchKey(a), mb = matchKey(b);
        if (ma === null && mb === null) return 0;
        if (ma === null) return 1;   // a 마지막
        if (mb === null) return -1;  // b 마지막
        return state.sort === 'match-desc' ? (mb - ma) : (ma - mb);
      }
      if (state.sort === 'name')  return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'ko');
      if (state.sort === 'party') return (a.dataset.party || '').localeCompare(b.dataset.party || '', 'ko');
      return (parseInt(b.dataset.propose, 10) || 0) - (parseInt(a.dataset.propose, 10) || 0);
    };
    gridItems.sort(sortFn).forEach(el => gridContainer.appendChild(el));
    listItems.sort(sortFn).forEach(el => listContainer.appendChild(el));

    visibleCount = gridItems.filter(el => el.style.display !== 'none').length;
    countEl.textContent = `총 ${visibleCount.toLocaleString('ko-KR')}명`;
    document.getElementById('grid-empty').style.display = visibleCount === 0 ? '' : 'none';
    document.getElementById('list-empty').style.display = visibleCount === 0 ? '' : 'none';

    // 필터 시트 배지 — 선택된 항목 총 개수 (party 는 별도 UI 라 제외)
    const active = state.sex.length + state.ageBucket.length + state.cmit.length + state.elect.length;
    const badge = document.getElementById('filter-sheet-badge');
    if (badge) {
      if (active > 0) { badge.textContent = String(active); badge.hidden = false; }
      else { badge.hidden = true; }
    }

    saveToUrl();
  };

  // ===== URL 영속화 =====
  // 모든 필터·정렬 상태를 URL 쿼리에 반영. 새로고침 시 복원, 결과 공유 가능.
  // 배열 필드는 쉼표 분리, party 는 단일 값, q/match/sort 는 그대로
  const saveToUrl = () => {
    const params = new URLSearchParams();
    if (state.party) params.set('party', state.party);
    if (state.cmit.length)      params.set('committee',  state.cmit.join(','));
    if (state.elect.length)     params.set('elect',      state.elect.join(','));
    if (state.sex.length)       params.set('sex',        state.sex.join(','));
    if (state.ageBucket.length) params.set('age',        state.ageBucket.join(','));
    if (state.q)                params.set('q',          state.q);
    if (state.sort && state.sort !== 'propose') params.set('sort',  state.sort);
    if (state.match)            params.set('match',      state.match);
    if (state.gap)              params.set('gap',        state.gap);
    const qs = params.toString();
    const url = window.location.pathname + (qs ? '?' + qs : '');
    window.history.replaceState({}, '', url);
  };
  const loadFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    state.party     = params.get('party') || '';
    state.cmit      = (params.get('committee') || '').split(',').filter(Boolean);
    state.elect     = (params.get('elect')     || '').split(',').filter(Boolean);
    state.sex       = (params.get('sex')       || '').split(',').filter(Boolean);
    state.ageBucket = (params.get('age')       || '').split(',').filter(Boolean);
    state.q         = params.get('q') || '';
    const sortParam = params.get('sort') || 'propose';
    // 게임 미완료 시 일치도 정렬은 무시 (기본값으로 fallback)
    state.sort = (!bgDone && (sortParam === 'match-desc' || sortParam === 'match-asc')) ? 'propose' : sortParam;
    state.match = bgDone ? (params.get('match') || '') : '';
    state.gap = params.get('gap') || '';   // 격차는 성향 진단과 무관 — 항상 사용 가능

    // UI 동기화
    const sortSel = document.getElementById('pol-sort');
    if (sortSel) sortSel.value = state.sort;
    const matchSel = document.getElementById('pol-match-filter');
    if (matchSel) matchSel.value = state.match;
    const gapSel = document.getElementById('pol-gap-filter');
    if (gapSel) gapSel.value = state.gap;
    const searchInput = document.getElementById('pol-search');
    if (searchInput) searchInput.value = state.q;
    document.querySelectorAll('.party-tab').forEach(tab => {
      tab.classList.toggle('active', (tab.dataset.party || '') === state.party);
    });
    syncVisualsFromState();
  };

  // 필터 시트 — 시트 오픈 중엔 applyFilter() 지연, 적용 시에만 커밋
  const sheetBtn       = document.getElementById('filter-sheet-btn');
  const sheetClose     = document.getElementById('filter-sheet-close');
  const sheetBackdrop  = document.getElementById('filter-sheet-backdrop');
  const sheetReset     = document.getElementById('filter-sheet-reset');
  const sheetApply     = document.getElementById('filter-sheet-apply');
  let sheetSnapshot = null;
  const isSheetOpen = () => document.body.classList.contains('filter-sheet-open');

  // state 의 배열에 맞춰 .active 를 재계산. "전체" (값='') 는 배열 빈 경우 active
  const syncVisualsFromState = () => {
    document.querySelectorAll('#committee-list .sidebar-item').forEach(el => {
      const v = el.dataset.cmit || '';
      el.classList.toggle('active', v === '' ? state.cmit.length === 0 : state.cmit.includes(v));
    });
    document.querySelectorAll('#elect-list .sidebar-item').forEach(el => {
      const v = el.dataset.elect || '';
      el.classList.toggle('active', v === '' ? state.elect.length === 0 : state.elect.includes(v));
    });
    document.querySelectorAll('.dist-row[data-dist="sex"]').forEach(el => {
      el.classList.toggle('active', state.sex.includes(el.dataset.distValue || ''));
    });
    document.querySelectorAll('.dist-row[data-dist="ageBucket"]').forEach(el => {
      el.classList.toggle('active', state.ageBucket.includes(el.dataset.distValue || ''));
    });
  };
  const openSheet = () => {
    sheetSnapshot = {
      sex: [...state.sex],
      ageBucket: [...state.ageBucket],
      cmit: [...state.cmit],
      elect: [...state.elect]
    };
    document.body.classList.add('filter-sheet-open');
  };
  const cancelSheet = () => {
    if (sheetSnapshot) {
      state.sex = [...sheetSnapshot.sex];
      state.ageBucket = [...sheetSnapshot.ageBucket];
      state.cmit = [...sheetSnapshot.cmit];
      state.elect = [...sheetSnapshot.elect];
      syncVisualsFromState();
    }
    document.body.classList.remove('filter-sheet-open');
  };
  const applySheet = () => {
    applyFilter();
    document.body.classList.remove('filter-sheet-open');
  };
  const resetSheet = () => {
    state.sex = [];
    state.ageBucket = [];
    state.cmit = [];
    state.elect = [];
    syncVisualsFromState();
  };
  sheetBtn?.addEventListener('click', openSheet);
  sheetClose?.addEventListener('click', cancelSheet);
  sheetBackdrop?.addEventListener('click', cancelSheet);
  sheetReset?.addEventListener('click', resetSheet);
  sheetApply?.addEventListener('click', applySheet);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isSheetOpen()) cancelSheet();
  });

  // Search
  document.getElementById('pol-search').addEventListener('input', (e) => {
    state.q = e.target.value;
    applyFilter();
  });
  // Sort
  document.getElementById('pol-sort').addEventListener('change', (e) => {
    state.sort = e.target.value;
    applyFilter();
  });
  // Match filter
  const matchFilterEl = document.getElementById('pol-match-filter');
  if (matchFilterEl) {
    matchFilterEl.addEventListener('change', (e) => {
      state.match = e.target.value;
      applyFilter();
    });
  }
  // 당 성향 격차 filter
  const gapFilterEl = document.getElementById('pol-gap-filter');
  if (gapFilterEl) {
    gapFilterEl.addEventListener('change', (e) => {
      state.gap = e.target.value;
      applyFilter();
    });
  }
  // Party tabs
  document.querySelectorAll('.party-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.party-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      state.party = tab.dataset.party || '';
      applyFilter();
    });
  });
  // 다중선택 토글 헬퍼 — value='' 이면 "전체" 클릭(배열 비움)
  const toggleMulti = (listSelector, kind, dataKey, value) => {
    if (value === '') {
      state[kind] = [];
    } else {
      const i = state[kind].indexOf(value);
      if (i >= 0) state[kind].splice(i, 1);
      else state[kind].push(value);
    }
    // "전체" 포함 전체 리스트 시각 재계산
    document.querySelectorAll(`${listSelector} .sidebar-item`).forEach(el => {
      const v = el.dataset[dataKey] || '';
      el.classList.toggle('active', v === '' ? state[kind].length === 0 : state[kind].includes(v));
    });
  };

  // Sidebar committee (복수선택)
  document.querySelectorAll('#committee-list .sidebar-item').forEach(item => {
    item.addEventListener('click', () => {
      toggleMulti('#committee-list', 'cmit', 'cmit', item.dataset.cmit || '');
      // 사이드바 클릭은 항상 지연 — 적용 버튼에서만 커밋
    });
  });
  // Sidebar elect (복수선택)
  document.querySelectorAll('#elect-list .sidebar-item').forEach(item => {
    item.addEventListener('click', () => {
      toggleMulti('#elect-list', 'elect', 'elect', item.dataset.elect || '');
      // 사이드바 클릭은 항상 지연 — 적용 버튼에서만 커밋
    });
  });

  // 성별·연령대 분포 행 클릭 → 복수선택 토글
  document.querySelectorAll('.dist-row').forEach(row => {
    row.addEventListener('click', () => {
      const kind  = row.dataset.dist;       // 'sex' 또는 'ageBucket'
      const value = row.dataset.distValue || '';
      const i = state[kind].indexOf(value);
      if (i >= 0) {
        state[kind].splice(i, 1);
        row.classList.remove('active');
      } else {
        state[kind].push(value);
        row.classList.add('active');
      }
      // 사이드바 클릭은 항상 지연 — 적용 버튼에서만 커밋
    });
  });
  // Grid/List toggle
  const btnGrid = document.getElementById('btn-grid');
  const btnList = document.getElementById('btn-list');
  const gridView = document.getElementById('grid-view');
  const listView = document.getElementById('list-view');
  btnGrid.addEventListener('click', () => {
    btnGrid.classList.add('active'); btnList.classList.remove('active');
    gridView.style.display = ''; listView.style.display = 'none';
  });
  btnList.addEventListener('click', () => {
    btnList.classList.add('active'); btnGrid.classList.remove('active');
    gridView.style.display = 'none'; listView.style.display = '';
  });

  // 초기 — URL → state → UI 동기화 → 필터 적용
  loadFromUrl();
  applyFilter();
})();
</script>
