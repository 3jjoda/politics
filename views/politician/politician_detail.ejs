<%- include('../partials/header', { pageTitle: pageTitle, pageStyles: pageStyles, currentUrl: currentUrl }) %>

<div class="politician-detail-container">
    <aside class="profile-sidebar">
        <div class="profile-card">
            <img src="<%= politician.PHOTO_URL %>" alt="<%= politician.NAME %> 의원 사진" class="profile-photo">
            <h1 class="profile-name"><%= politician.NAME %></h1>
            <p class="profile-eng-name"><%= politician.ENG_NM %></p>
            <p class="profile-party"><%= politician.PARTY_NAME %></p>
            <div class="profile-badges">
                <span class="card-reele <%= politician.reeleClass %>"><%= politician.REELE_GBN_NM %></span>
            </div>
        </div>
        <div class="contact-info">
            <h3>연락처 정보</h3>
            <p><i class="fas fa-phone"></i> <%= politician.TEL_NO %></p>
            <p><i class="fas fa-envelope"></i> <%= politician.E_MAIL %></p>
            <p><i class="fas fa-home"></i> <a href="https://<%= politician.HOMEPAGE %>" target="_blank" rel="noopener noreferrer">홈페이지</a></p>
            <p><i class="fas fa-building"></i> <%= politician.ASSEM_ADDR %></p>
        </div>
    </aside>

    <section class="detail-main">
        <nav class="detail-tabs">
            <a href="#" class="tab-link active" data-tab="tab-main">주요 정보</a>
            <a href="#" class="tab-link" data-tab="tab-staff">보좌진</a>
            <a href="#" class="tab-link" data-tab="tab-bio">상세 약력</a>
        </nav>

        <div id="tab-main" class="tab-content active">
            <h2>주요 정보</h2>
            <dl class="detail-list">
                <dt>선거구</dt>
                <dd><%= politician.ELECTORAL_DISTRICT %> (<%= politician.ELECT_GBN_NM %>)</dd>
                <dt>소속위원회</dt>
                <dd><%= politician.CMITS %></dd>
                <dt>성별</dt>
                <dd><%= politician.SEX_GBN_NM %></dd>
                <dt>생년월일</dt>
                <dd><%= new Date(politician.BIRTHDAY).toLocaleDateString('ko-KR') %> (<%= politician.BTH_GBN_NM %>)</dd>
                 <dt>한자명</dt>
                <dd><%= politician.HJ_NM %></dd>
            </dl>
        </div>

        <div id="tab-staff" class="tab-content">
            <h2>보좌진</h2>
            <dl class="detail-list">
                <dt>보좌관 (4급)</dt>
                <dd><%= politician.STAFF %></dd>
                <dt>비서관 (5급)</dt>
                <dd><%= politician.SECRETARY %></dd>
                <dt>비서 (6,7,9급)</dt>
                <dd><%= politician.SECRETARY2 %></dd>
            </dl>
        </div>
        
        <div id="tab-bio" class="tab-content">
            <h2>상세 약력</h2>
            <div class="profile-memo">
                <p><%= (politician.MEM_TITLE || '').replace(/\n/g, '<br>') %></p>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/footer') %>

<script src="/scripts/politician/politician_detail.js"></script>