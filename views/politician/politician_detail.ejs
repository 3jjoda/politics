  .write-input {
    width: 100%;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--text);
    font-size: 13px;
    resize: none;
    outline: none;
    transition: border-color 0.2s;
    min-height: 72px;
  }
  .write-input:focus { border-color: var(--accent); }
  .write-input::placeholder { color: var(--sub2); }
  .write-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
  }
  .write-hint { font-size: 11px; color: var(--sub2); }
  .write-submit {
    padding: 7px 18px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }

  .comments-empty {
    padding: 40px 24px;
    text-align: center;
    color: var(--sub);
    background: var(--bg2);
    border: 1px dashed var(--border);
    border-radius: 12px;
  }

  @media (max-width: 1024px) {
    .content-wrap { grid-template-columns: 1fr; }
    .profile-hero-inner { grid-template-columns: auto 1fr; }
    .profile-actions { display: none; }
    .overview-grid { grid-template-columns: 1fr; }
    .overview-grid.two { grid-template-columns: 1fr; }
    .eval-layout { grid-template-columns: 1fr; }
    .bill-table-header, .bill-table-row {
      grid-template-columns: 1fr 80px 80px;
    }
    .bill-table-header span:nth-child(3),
    .bill-table-header span:nth-child(5),
    .bill-table-row > *:nth-child(3),
    .bill-table-row > *:nth-child(5) { display: none; }
  }
</style>

<!-- PROFILE HERO -->
<div class="profile-hero">
  <div class="profile-hero-inner">
    <div class="breadcrumb">
      <a href="/">홈</a> / <a href="/politician">의원</a> / <%= politician.name %>
    </div>

    <div>
      <div class="profile-identity">
        <div class="profile-avatar">
          <%- avatarHtml(politician.name, politician.photo_url, 96) %>
        </div>
        <div>
          <div class="profile-top">
            <h1 class="profile-name"><%= politician.name %></h1>
            <span class="profile-party-badge"><%= politician.party_name || '무소속' %></span>
          </div>
          <div class="profile-meta">
            <span class="profile-meta-item">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <%= politician.electoral_district || '—' %>
            </span>
            <% if (politician.elect_gbn_nm) { %>
              <span class="profile-meta-item">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <%= politician.elect_gbn_nm %><% if (politician.reele_gbn_nm) { %> · <%= politician.reele_gbn_nm %><% } %>
              </span>
            <% } %>
            <% if (politician.cmit_nm) { %>
              <span class="profile-meta-item">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                <%= politician.cmit_nm %>
              </span>
            <% } %>
          </div>
        </div>
      </div>

      <div class="profile-kpis-row">
        <div class="profile-kpi">
          <div class="profile-kpi-val kpi-blue"><%= nf(proposeCnt) %></div>
          <div class="profile-kpi-label">법안 발의 <a href="/glossary#rep-proposer" class="pb-help" title="대표발의 설명">?</a></div>
          <div class="profile-kpi-sub">공동발의 <%= nf(coProposeCnt) %>건</div>
        </div>
        <div class="profile-kpi">
          <% if (voteParticipateRate == null) { %>
            <div class="profile-kpi-val em-dash" title="추후 제공 예정">—</div>
          <% } else { %>
            <div class="profile-kpi-val kpi-amber"><%= voteParticipateRate.toFixed(0) %>%</div>
          <% } %>
          <div class="profile-kpi-label">표결 참여율 <a href="/glossary#vote-absent" class="pb-help" title="(찬성+반대+기권) / 전체 표결">?</a></div>
          <% if (vsTotal > 0) { %>
            <div class="profile-kpi-sub"><%= nf(vsAttended) %> / <%= nf(vsTotal) %></div>
          <% } else { %>
            <div class="profile-kpi-sub">표결 데이터 수집 전</div>
          <% } %>
        </div>
        <div class="profile-kpi">
          <% if (passRate == null) { %>
            <div class="profile-kpi-val em-dash">—</div>
          <% } else { %>
            <div class="profile-kpi-val kpi-green"><%= passRate.toFixed(0) %>%</div>
          <% } %>
          <div class="profile-kpi-label">가결율 <a href="/glossary#original" class="pb-help" title="가결 법안 수 / 대표발의 법안 수">?</a></div>
          <div class="profile-kpi-sub">
            <% if (proposeCnt === 0) { %>
              대표발의 없음
            <% } else { %>
              <%= nf(passedCnt) %> / <%= nf(proposeCnt) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- 히어로 레이더 (주인공) -->
    <div class="profile-radar-wrap">
      <div class="profile-radar-label">활동 레이더</div>
      <%
        const HERO_R = 110;  // 반지름
        const heroPt = (val, idx) => {
          const r = (val / 100) * HERO_R;
          const angles = [-90, -30, 30, 90, 150, 210];
          const rad = angles[idx] * Math.PI / 180;
          return `${(r * Math.cos(rad)).toFixed(1)},${(r * Math.sin(rad)).toFixed(1)}`;
        };
        const heroRadarPts = [radarPropose, radarAttend, radarVote, radarCoPropose, radarCmit, radarComm]
          .map((v, i) => heroPt(v, i)).join(' ');
        const bgPt = (scale) => [-90,-30,30,90,150,210].map(a => {
          const rad = a * Math.PI / 180;
          const r = HERO_R * scale;
          return `${(r * Math.cos(rad)).toFixed(1)},${(r * Math.sin(rad)).toFixed(1)}`;
        }).join(' ');
      %>
      <svg width="260" height="260" viewBox="-130 -130 260 260" overflow="visible">
        <!-- 배경 육각형 4겹 -->
        <polygon points="<%= bgPt(1.0) %>"  fill="none" stroke="#E2DFD4" stroke-width="1"/>
        <polygon points="<%= bgPt(0.75) %>" fill="none" stroke="#E2DFD4" stroke-width="1"/>
        <polygon points="<%= bgPt(0.5) %>"  fill="none" stroke="#E2DFD4" stroke-width="1"/>
        <polygon points="<%= bgPt(0.25) %>" fill="none" stroke="#E2DFD4" stroke-width="1"/>
        <!-- 축 -->
        <% [-90,-30,30,90,150,210].forEach(a => {
             const rad = a * Math.PI / 180;
             const ex = (HERO_R * Math.cos(rad)).toFixed(1);
             const ey = (HERO_R * Math.sin(rad)).toFixed(1);
        %>
          <line x1="0" y1="0" x2="<%= ex %>" y2="<%= ey %>" stroke="#E2DFD4" stroke-width="1"/>
        <% }); %>
        <!-- 데이터 -->
        <polygon points="<%= heroRadarPts %>" fill="rgba(184,116,12,0.15)" stroke="#B8740C" stroke-width="2"/>
        <!-- 데이터 점 -->
        <% [radarPropose, radarAttend, radarVote, radarCoPropose, radarCmit, radarComm].forEach((v, i) => {
             const angles = [-90, -30, 30, 90, 150, 210];
             const rad = angles[i] * Math.PI / 180;
             const r = (v / 100) * HERO_R;
             const cx = (r * Math.cos(rad)).toFixed(1);
             const cy = (r * Math.sin(rad)).toFixed(1);
        %>
          <circle cx="<%= cx %>" cy="<%= cy %>" r="3" fill="#B8740C"/>
        <% }); %>
        <!-- 축 라벨 (한글 12px) -->
        <text x="0"    y="-120" text-anchor="middle" fill="#4B5362" font-size="12" font-family="Noto Sans KR">법안발의</text>
        <text x="108"  y="-52"  text-anchor="start"  fill="#4B5362" font-size="12" font-family="Noto Sans KR">출석률</text>
        <text x="108"  y="62"   text-anchor="start"  fill="#4B5362" font-size="12" font-family="Noto Sans KR">표결참여</text>
        <text x="0"    y="128"  text-anchor="middle" fill="#4B5362" font-size="12" font-family="Noto Sans KR">공동발의</text>
        <text x="-108" y="62"   text-anchor="end"    fill="#4B5362" font-size="12" font-family="Noto Sans KR">위원회</text>
        <text x="-108" y="-52"  text-anchor="end"    fill="#4B5362" font-size="12" font-family="Noto Sans KR">소통</text>
      </svg>
      <div style="font-size:11px;color:var(--sub2);text-align:center;line-height:1.6;max-width:260px">
        일부 축(출석률·위원회·소통)은 데이터 수집 후 반영됩니다.
      </div>
    </div>
  </div>
</div>

<!-- TABS — 개요분석은 추후 오픈 -->
<div class="tab-bar">
  <div class="tab-bar-inner">
    <button class="tab-btn active" data-tab="bills">
      법안 활동 <span class="tab-count"><%= nf(billsTabCount) %></span>
    </button>
    <button class="tab-btn" data-tab="votes">
      표결 내역 <span class="tab-count"><%= nf(votesTabCount) %></span>
    </button>
    <button class="tab-btn" data-tab="comments">국민 평가</button>
    <!-- 추후 오픈
    <button class="tab-btn" data-tab="overview">개요 분석</button>
    -->
  </div>
</div>

<div class="content-wrap">
  <div>

    <!-- ===== 법안 활동 탭 ===== -->
    <div class="tab-panel active" id="tab-bills">
      <div class="bill-filter-tabs">
        <button class="bill-filter-tab active" data-bf="all">
          <span class="dot" style="background:var(--accent)"></span>
          전체 <span style="font-family:'JetBrains Mono';font-size:12px;margin-left:2px"><%= nf(billsTabCount) %></span>
        </button>
        <% const repCnt = (bills || []).filter(b => b.proposer_yn).length;
           const coCnt  = (bills || []).filter(b => !b.proposer_yn).length; %>
        <button class="bill-filter-tab" data-bf="rep">
          <span class="dot" style="background:var(--accent)"></span>
          대표발의 <span style="font-family:'JetBrains Mono';font-size:12px;margin-left:2px"><%= nf(repCnt) %></span>
        </button>
        <button class="bill-filter-tab" data-bf="co">
          <span class="dot" style="background:var(--sub2)"></span>
          공동발의 <span style="font-family:'JetBrains Mono';font-size:12px;margin-left:2px"><%= nf(coCnt) %></span>
        </button>
      </div>

      <% if (bills && bills.length > 0) { %>
        <div class="bill-table">
          <div class="bill-table-header">
            <span>법안명</span>
            <span>구분</span>
            <span>제안일</span>
            <span>처리결과</span>
            <span>표결</span>
          </div>
          <div id="bills-container">
            <% bills.forEach(b => { %>
              <a href="<%= b.link_url || '#' %>" target="_blank" rel="noopener"
                 class="bill-table-row bills-row"
                 data-kind="<%= b.proposer_yn ? 'rep' : 'co' %>">
                <div class="bill-row-name">
                  <%= b.bill_name %>
                  <% if (b.committee) { %><small><%= b.committee %></small><% } %>
                </div>
                <span>
                  <% if (b.proposer_yn) { %>
                    <span class="pb-badge pb-badge-category">대표발의</span>
                  <% } else { %>
                    <span class="pb-badge pb-badge-alt">공동발의</span>
                  <% } %>
                </span>
                <div style="font-family:'JetBrains Mono';font-size:12px;color:var(--sub2)"><%= b.propose_dt || '—' %></div>
                <span>
                  <% const statusLabel = b.proc_result_name || '계류';
                     const termAnchor = !b.proc_result_name ? 'pending' :
                         b.proc_result_name === '원안가결' ? 'original' :
                         b.proc_result_name === '수정가결' ? 'modified' :
                         b.proc_result_name === '대안반영폐기' ? 'alt-dropped' :
                         b.proc_result_name === '수정안반영폐기' ? 'mod-dropped' :
                         b.proc_result_name === '철회' ? 'withdrawn' :
                         b.proc_result_name === '부결' ? 'rejected' :
                         b.proc_result_name === '폐기' ? 'dropped' : 'pending';
                  %>
                  <span class="pb-badge <%= resultClass(b.proc_result_name) %>"><%= statusLabel %></span>
                  <% if (!b.proc_result_name && b.days_elapsed != null) {
                       const d = Number(b.days_elapsed);
                       const color = d >= 200 ? 'var(--red)' : d >= 100 ? 'var(--accent)' : 'var(--sub2)';
                  %>
                    <span style="display:block;font-size:12px;color: <%= color %>;font-family:'JetBrains Mono';margin-top:4px">+<%= d %>일</span>
                  <% } %>
                </span>
                <div>
                  <% if (b.my_vote_result) { %>
                    <span class="vote-result-chip v-<%= b.my_vote_result === '찬성' ? 'for' : b.my_vote_result === '반대' ? 'against' : b.my_vote_result === '기권' ? 'abstain' : 'absent' %>">
                      <%= b.my_vote_result %>
                    </span>
                  <% } else { %>
                    <span class="v-none">—</span>
                  <% } %>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <div class="pagination-inline" id="bills-pagination"></div>
      <% } else { %>
        <div class="comments-empty">해당 의원의 법안 활동 데이터가 없습니다.</div>
      <% } %>
    </div>

    <!-- ===== 표결 내역 탭 ===== -->
    <div class="tab-panel" id="tab-votes">
      <% if (votes && votes.length > 0) { %>
        <div class="bill-table">
          <div class="bill-table-header">
            <span>법안명</span>
            <span>표결결과</span>
            <span>표결일</span>
            <span>처리결과</span>
            <span>카테고리</span>
          </div>
          <% votes.slice(0, 50).forEach(v => { %>
            <a href="/bill/<%= v.bill_id %>" class="bill-table-row">
              <div class="bill-row-name"><%= v.bill_name || v.bill_id %></div>
              <div>
                <span class="vote-result-chip v-<%= v.vote_result === '찬성' ? 'for' : v.vote_result === '반대' ? 'against' : v.vote_result === '기권' ? 'abstain' : 'absent' %>">
                  <%= v.vote_result %>
                </span>
              </div>
              <div style="font-family:'JetBrains Mono';font-size:12px;color:var(--sub2)"><%= v.vote_date %></div>
              <span><span class="pb-badge <%= resultClass(v.proc_result_name) %>"><%= v.proc_result_name || '—' %></span></span>
              <span><% if (v.bill_topic_nm) { %><span class="pb-badge pb-badge-category"><%= v.bill_topic_nm %></span><% } %></span>
            </a>
          <% }); %>
        </div>
        <% if (votes.length > 50) { %>
          <div style="text-align:center;padding:16px;color:var(--sub2);font-size:12px">
            최근 50건만 표시. 전체 <%= nf(votes.length) %>건.
          </div>
        <% } %>
      <% } else { %>
        <div class="comments-empty">해당 의원의 표결 내역이 없습니다.</div>
      <% } %>
    </div>

    <!-- ===== 개요 분석 탭 ===== -->
    <div class="tab-panel" id="tab-overview">
      <div class="overview-grid">
        <!-- 레이더 -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">활동 레이더 <span class="card-title-mono">6개 지표</span></span>
          </div>
          <div class="card-body radar-big">
            <svg width="220" height="220" viewBox="-110 -110 220 220" overflow="visible">
              <polygon points="0,-90 78,-45 78,45 0,90 -78,45 -78,-45" fill="none" stroke="#E2DFD4" stroke-width="1"/>
              <polygon points="0,-68 59,-34 59,34 0,68 -59,34 -59,-34" fill="none" stroke="#E2DFD4" stroke-width="1"/>
              <polygon points="0,-45 39,-23 39,23 0,45 -39,23 -39,-23" fill="none" stroke="#E2DFD4" stroke-width="1"/>
              <polygon points="0,-23 20,-11 20,11 0,23 -20,11 -20,-11" fill="none" stroke="#E2DFD4" stroke-width="1"/>
              <line x1="0" y1="0" x2="0"  y2="-90" stroke="#E2DFD4" stroke-width="1"/>
              <line x1="0" y1="0" x2="78" y2="-45" stroke="#E2DFD4" stroke-width="1"/>
              <line x1="0" y1="0" x2="78" y2="45"  stroke="#E2DFD4" stroke-width="1"/>
              <line x1="0" y1="0" x2="0"  y2="90"  stroke="#E2DFD4" stroke-width="1"/>
              <line x1="0" y1="0" x2="-78" y2="45" stroke="#E2DFD4" stroke-width="1"/>
              <line x1="0" y1="0" x2="-78" y2="-45" stroke="#E2DFD4" stroke-width="1"/>
              <polygon points="<%= radarPoints %>" fill="rgba(184,116,12,0.12)" stroke="#B8740C" stroke-width="1.5"/>
              <text x="0"    y="-98" text-anchor="middle" fill="#4B5362" font-size="11" font-family="Noto Sans KR">법안발의</text>
              <text x="90"   y="-42" text-anchor="start"  fill="#4B5362" font-size="11" font-family="Noto Sans KR">출석률</text>
              <text x="90"   y="52"  text-anchor="start"  fill="#4B5362" font-size="11" font-family="Noto Sans KR">표결참여</text>
              <text x="0"    y="106" text-anchor="middle" fill="#4B5362" font-size="11" font-family="Noto Sans KR">공동발의</text>
              <text x="-90"  y="52"  text-anchor="end"    fill="#4B5362" font-size="11" font-family="Noto Sans KR">위원회활동</text>
              <text x="-90"  y="-42" text-anchor="end"    fill="#4B5362" font-size="11" font-family="Noto Sans KR">소통지수</text>
            </svg>
          </div>
        </div>

        <!-- 표결 성향 (요약) -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">표결 성향 <span class="card-title-mono">데이터 기반</span></span>
          </div>
          <div class="card-body">
            <% if (vsTotal > 0) { %>
              <div class="category-bars">
                <div>
                  <div class="cat-bar-label">찬성 비율<span class="cat-bar-val" style="color:var(--green)"><%= pct(vs.for_cnt, vsAttended).toFixed(1) %>%</span></div>
                  <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= pct(vs.for_cnt, vsAttended) %>%;background:var(--green)"></div></div>
                </div>
                <div>
                  <div class="cat-bar-label">반대 비율<span class="cat-bar-val" style="color:var(--red)"><%= pct(vs.against_cnt, vsAttended).toFixed(1) %>%</span></div>
                  <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= pct(vs.against_cnt, vsAttended) %>%;background:var(--red)"></div></div>
                </div>
                <div>
                  <div class="cat-bar-label">기권 비율<span class="cat-bar-val" style="color:var(--accent)"><%= pct(vs.abstain_cnt, vsAttended).toFixed(1) %>%</span></div>
                  <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= pct(vs.abstain_cnt, vsAttended) %>%;background:var(--accent)"></div></div>
                </div>
                <div>
                  <div class="cat-bar-label">불참 비율<span class="cat-bar-val"><%= pct(vs.absent_cnt, vsTotal).toFixed(1) %>%</span></div>
                  <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= pct(vs.absent_cnt, vsTotal) %>%;background:var(--sub2)"></div></div>
                </div>
              </div>
              <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border);font-size:11px;color:var(--sub2);line-height:1.7">
                총 <strong style="color:var(--text)"><%= nf(vsTotal) %>건</strong>의 본회의 표결 기록 분석.
              </div>
            <% } else { %>
              <div class="notice-block">
                표결 기록이 아직 수집되지 않았습니다. 데이터 배치 완료 후 표시됩니다.
              </div>
            <% } %>
          </div>
        </div>

        <!-- 관심분야 -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">대표발의 관심분야 <span class="card-title-mono">TOP 5</span></span>
          </div>
          <div class="card-body">
            <% if (topics5.length > 0) { %>
              <div class="category-bars">
                <% topics5.forEach(t => {
                     const w = maxTopicCnt > 0 ? (Number(t.cnt) / maxTopicCnt * 100) : 0;
                %>
                  <div>
                    <div class="cat-bar-label"><%= t.topic_name %><span class="cat-bar-val"><%= t.cnt %>건</span></div>
                    <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= w %>%"></div></div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="notice-block">아직 대표발의 법안이 없습니다.</div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- 월별 발의 + 타임라인 -->
      <div class="overview-grid two">
        <div class="card">
          <div class="card-header">
            <span class="card-title">월별 발의 현황 <span class="card-title-mono">최근 12개월</span></span>
          </div>
          <div class="card-body">
            <% if (monthly && monthly.length > 0) { %>
              <div class="monthly-chart">
                <% monthly.forEach(m => {
                     const h = (Number(m.cnt) / monthlyMax) * 100;
                     const isHigh = Number(m.cnt) >= monthlyMax * 0.8 && Number(m.cnt) > 0;
                %>
                  <div class="month-col">
                    <div class="month-bar-wrap">
                      <span class="month-val"><%= m.cnt %></span>
                      <div class="month-bar <%= isHigh ? 'highlight' : '' %>" style="height:<%= h %>%"></div>
                    </div>
                    <div class="month-label"><%= parseInt(m.mm, 10) %>월</div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="notice-block">월별 발의 데이터가 없습니다.</div>
            <% } %>

            <% if (partyCoopTop.length > 0) { %>
              <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border)">
                <div class="party-coop">
                  <div style="font-size:11px;color:var(--sub2);margin-bottom:4px">정당별 공동발의 협력 (대표발의 법안 기준)</div>
                  <% partyCoopTop.forEach(pc => {
                       const w = partyCoopTotal > 0 ? (Number(pc.cnt) / partyCoopTotal * 100) : 0;
                       const color = partyColorOf(pc.party_name);
                  %>
                    <div class="party-coop-item">
                      <span class="party-coop-name" style="color: <%= color %>"><%= pc.party_name %></span>
                      <div class="party-coop-bar-wrap"><div class="party-coop-bar" style="width:<%= w %>%;background:<%= color %>;opacity:0.7"></div></div>
                      <span class="party-coop-val"><%= nf(pc.cnt) %>건</span>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title">주요 법안 이력 <span class="card-title-mono">타임라인</span></span>
          </div>
          <div class="card-body">
            <% if (timeline && timeline.length > 0) { %>
              <div class="timeline">
                <% timeline.forEach(t => {
                     const r = t.proc_result_name || '';
                     let dotClass = 'pending';
                     if (r.indexOf('가결') > -1) dotClass = 'passed';
                     else if (r.indexOf('대안') > -1 || r === '폐기') dotClass = 'alt';
                     else if (r === '부결' || r === '철회') dotClass = 'rejected';
                     let lblColor = 'var(--sub2)';
                     if (r.indexOf('가결') > -1) lblColor = 'var(--green)';
                     else if (r === '부결' || r === '폐기' || r === '철회') lblColor = 'var(--red)';
                     else if (!r) { lblColor = 'var(--accent)'; }
                %>
                  <div class="tl-item">
                    <div class="tl-dot <%= dotClass %>"></div>
                    <div class="tl-content">
                      <div class="tl-name"><%= t.bill_name %></div>
                      <div class="tl-meta">
                        <span class="tl-date"><%= t.propose_dt %></span>
                        <span style="color: <%= lblColor %>"><%= r || '계류중' %></span>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="notice-block">대표발의 법안이 없습니다.</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== 국민 평가 탭 ===== -->
    <div class="tab-panel" id="tab-comments">
      <!-- 별점 요약 + 나의 별점 (PB.mountRating 이 렌더) -->
      <div id="rating-widget"></div>

      <!-- 댓글 작성 + 목록 (PB.mountComments 가 렌더) -->
      <div id="comment-widget"></div>
    </div>

  </div>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="side-card">
      <div class="side-card-header">표결 요약</div>
      <div class="side-card-body">
        <% if (vsTotal > 0) {
             const partRate = voteParticipateRate;
             const cForDeg = pct(vs.for_cnt, vsTotal);
             const cAgainstDeg = pct(vs.against_cnt, vsTotal);
             const cAbsDeg = pct(vs.abstain_cnt, vsTotal);
             const cMissDeg = pct(vs.absent_cnt, vsTotal);
             const circ = 219.9;
             const s1 = (cForDeg / 100) * circ;
             const s2 = (cAgainstDeg / 100) * circ;
             const s3 = (cAbsDeg / 100) * circ;
             const s4 = (cMissDeg / 100) * circ;
        %>
          <div class="vote-summary" title="참여율 = (찬성+반대+기권) ÷ 전체 본회의 표결 법안 수">
            <svg width="90" height="90" viewBox="0 0 90 90">
              <circle cx="45" cy="45" r="35" fill="none" stroke="#E2DFD4" stroke-width="10"/>
              <circle cx="45" cy="45" r="35" fill="none" stroke="#0F9D6E" stroke-width="10"
                      stroke-dasharray="<%= s1.toFixed(1) %> <%= circ %>" stroke-dashoffset="0" transform="rotate(-90 45 45)"/>
              <circle cx="45" cy="45" r="35" fill="none" stroke="#D03A3A" stroke-width="10"
                      stroke-dasharray="<%= s2.toFixed(1) %> <%= circ %>" stroke-dashoffset="<%= (-s1).toFixed(1) %>" transform="rotate(-90 45 45)"/>
              <circle cx="45" cy="45" r="35" fill="none" stroke="#B8740C" stroke-width="10"
                      stroke-dasharray="<%= s3.toFixed(1) %> <%= circ %>" stroke-dashoffset="<%= (-(s1+s2)).toFixed(1) %>" transform="rotate(-90 45 45)"/>
              <circle cx="45" cy="45" r="35" fill="none" stroke="#7A8090" stroke-width="10"
                      stroke-dasharray="<%= s4.toFixed(1) %> <%= circ %>" stroke-dashoffset="<%= (-(s1+s2+s3)).toFixed(1) %>" transform="rotate(-90 45 45)"/>
              <text x="45" y="42" text-anchor="middle" fill="#1A1D24" font-size="14" font-weight="700" font-family="Bebas Neue"><%= partRate.toFixed(0) %>%</text>
              <text x="45" y="54" text-anchor="middle" fill="#4B5362" font-size="7" font-family="JetBrains Mono">참여율</text>
            </svg>
            <div class="vote-legend">
              <div class="vote-legend-item">
                <span class="vote-legend-left"><span class="legend-dot" style="background:var(--green)"></span>찬성</span>
                <span class="vote-legend-val"><%= nf(vs.for_cnt) %></span>
              </div>
              <div class="vote-legend-item">
                <span class="vote-legend-left"><span class="legend-dot" style="background:var(--red)"></span>반대</span>
                <span class="vote-legend-val"><%= nf(vs.against_cnt) %></span>
              </div>
              <div class="vote-legend-item">
                <span class="vote-legend-left"><span class="legend-dot" style="background:var(--accent)"></span>기권</span>
                <span class="vote-legend-val"><%= nf(vs.abstain_cnt) %></span>
              </div>
              <div class="vote-legend-item">
                <span class="vote-legend-left"><span class="legend-dot" style="background:var(--sub2)"></span>불참</span>
                <span class="vote-legend-val"><%= nf(vs.absent_cnt) %></span>
              </div>
            </div>
          </div>
          <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);font-size:11px;color:var(--sub2);line-height:1.6">
            참여율 = <span style="color:var(--sub)">(찬성+반대+기권)</span> ÷ 전체
            <a href="/glossary#vote-absent" class="pb-help" title="용어 설명">?</a>
          </div>
        <% } else { %>
          <div class="notice-block">표결 기록이 아직 수집되지 않았습니다.</div>
        <% } %>
      </div>
    </div>

    <div class="side-card">
      <div class="side-card-header">관심 분야 Top 5</div>
      <div class="side-card-body">
        <% if (topics5.length > 0) { %>
          <div class="category-bars">
            <% topics5.forEach(t => {
                 const w = maxTopicCnt > 0 ? (Number(t.cnt) / maxTopicCnt * 100) : 0;
            %>
              <div>
                <div class="cat-bar-label"><%= t.topic_name %><span class="cat-bar-val"><%= t.cnt %>건</span></div>
                <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= w %>%"></div></div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div style="font-size:12px;color:var(--sub2)">대표발의 법안이 없습니다.</div>
        <% } %>
      </div>
    </div>

    <div class="side-card">
      <div class="side-card-header">기본 정보</div>
      <div class="side-card-body">
        <div class="info-list">
          <% if (politician.reele_gbn_nm) { %>
          <div class="info-item">
            <span class="info-key">당선 횟수</span>
            <span class="info-val"><%= politician.reele_gbn_nm %></span>
          </div>
          <% } %>
          <% if (politician.elect_gbn_nm) { %>
          <div class="info-item">
            <span class="info-key">선출 방식</span>
            <span class="info-val"><%= politician.elect_gbn_nm %></span>
          </div>
          <% } %>
          <% if (politician.cmit_nm) { %>
          <div class="info-item">
            <span class="info-key">소속 위원회</span>
            <span class="info-val"><%= politician.cmit_nm %></span>
          </div>
          <% } %>
          <% if (politician.birthday) { %>
          <div class="info-item">
            <span class="info-key">생년월일</span>
            <span class="info-val"><%= politician.birthday %> (<%= politician.age %>세)</span>
          </div>
          <% } %>
          <% if (politician.sex_gbn_nm) { %>
          <div class="info-item">
            <span class="info-key">성별</span>
            <span class="info-val"><%= politician.sex_gbn_nm %></span>
          </div>
          <% } %>
          <% if (politician.e_mail) { %>
          <div class="info-item">
            <span class="info-key">이메일</span>
            <span class="info-val" style="font-family:'JetBrains Mono';font-size:12px"><%= politician.e_mail %></span>
          </div>
          <% } %>
          <% if (politician.homepage) { %>
          <div class="info-item">
            <span class="info-key">홈페이지</span>
            <span class="info-val"><a href="<%= politician.homepage %>" target="_blank" rel="noopener" style="color:var(--accent);font-size:11px">바로가기 →</a></span>
          </div>
          <% } %>
          <div class="info-item">
            <span class="info-key">국회 프로필</span>
            <span class="info-val">
              <a href="https://www.assembly.go.kr/portal/assm/search/memberIntro.do?monaCd=<%= politician.mona_cd %>"
                 target="_blank" rel="noopener"
                 style="color:var(--accent);font-size:12px">국회 공식 프로필 →</a>
            </span>
          </div>
        </div>
      </div>
    </div>
  </aside>
</div>

<script>
(() => {
  const MONA_CD = '<%= politician.mona_cd %>';
  let commentsMounted = false;

  const mountCommentsIfNeeded = () => {
    if (commentsMounted || !window.PB) return;
    commentsMounted = true;
    PB.mountRating({ containerId: 'rating-widget', monaCd: MONA_CD });
    PB.mountComments({ containerId: 'comment-widget', type: 'politician', targetId: MONA_CD });
  };

  // Tab switching
  const tabs = document.querySelectorAll('.tab-btn');
  const panels = document.querySelectorAll('.tab-panel');
  tabs.forEach(t => t.addEventListener('click', () => {
    const key = t.dataset.tab;
    tabs.forEach(x => x.classList.toggle('active', x === t));
    panels.forEach(p => p.classList.toggle('active', p.id === 'tab-' + key));
    if (key === 'comments') mountCommentsIfNeeded();
  }));

  // URL hash 로 국민 평가 바로 열기: /politician/XXX#comments
  if (location.hash === '#comments') {
    const btn = document.querySelector('[data-tab="comments"]');
    if (btn) btn.click();
  }

  // Bill filter tabs
  document.querySelectorAll('.bill-filter-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.bill-filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const kind = btn.dataset.bf;
      document.querySelectorAll('.bills-row').forEach(row => {
        if (kind === 'all') row.style.display = '';
        else row.style.display = row.dataset.kind === kind ? '' : 'none';
      });
      resetBillsPaging();
    });
  });

  // 클라이언트 페이지네이션 (법안 탭)
  const PER = 20;
  let currentPage = 1;
  const billsContainer = document.getElementById('bills-container');
  const pagerEl = document.getElementById('bills-pagination');

  function visibleRows() {
    return Array.from(document.querySelectorAll('.bills-row'))
      .filter(r => r.dataset.filtered !== 'true');
  }

  function resetBillsPaging() {
    if (!billsContainer || !pagerEl) return;
    currentPage = 1;
    renderPage();
  }

  function renderPage() {
    const allRows = Array.from(document.querySelectorAll('.bills-row'));
    // 현재 display 속성 기준으로 보임/숨김 판정
    const visible = allRows.filter(r => r.style.display !== 'none');
    const total = visible.length;
    const pages = Math.max(1, Math.ceil(total / PER));
    if (currentPage > pages) currentPage = pages;

    // 전부 한 번 숨기고
    visible.forEach(r => r.dataset._hide = '1');
    // 현재 페이지만 보이기
    const start = (currentPage - 1) * PER;
    visible.slice(start, start + PER).forEach(r => r.dataset._hide = '');
    visible.forEach(r => {
      if (r.dataset._hide === '1') r.style.display = 'none';
      else r.style.display = '';
      delete r.dataset._hide;
    });

    // pager
    pagerEl.innerHTML = '';
    if (pages <= 1) return;
    const mk = (label, page, opts = {}) => {
      const b = document.createElement('button');
      b.className = 'pg' + (opts.active ? ' active' : '');
      b.textContent = label;
      b.disabled = !!opts.disabled;
      b.onclick = () => { currentPage = page; renderPage(); };
      pagerEl.appendChild(b);
    };
    mk('←', Math.max(1, currentPage - 1), { disabled: currentPage === 1 });
    const maxBtns = 7;
    const startPage = Math.max(1, currentPage - 3);
    const endPage = Math.min(pages, startPage + maxBtns - 1);
    for (let p = startPage; p <= endPage; p++) mk(String(p), p, { active: p === currentPage });
    mk('→', Math.min(pages, currentPage + 1), { disabled: currentPage === pages });
  }

  // Hook: when filter changes we re-render. We already reset in filter handler.
  // On first load: ensure filter didn't hide anything, then render page.
  if (billsContainer && pagerEl) {
    renderPage();
  }

})();
</script>
