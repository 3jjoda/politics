    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 11px;
    color: var(--accent);
    background: #FAF6EB;
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 2px 8px;
    margin-top: 2px;
    min-width: 64px;
    text-align: center;
  }

  /* (전체 일치도 박스는 헤더 % 와 중복이라 제거됨 - 12차) */

  @media (max-width: 768px) {
    .bg-vs-body { gap: 14px; }
    .bg-vs-diamond-wrap { width: 100%; max-width: 320px; }
    .bg-vs-diamond { height: 320px; }
    .bg-vs-axes { font-size: 13px; }
  }

  /* Tabs */
  .tab-bar {
    position: sticky;
    top: 60px;
    z-index: 50;
  }
  .tab-bar-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tab-bar-inner::-webkit-scrollbar { display: none; }
  .tab-btn {
    flex-shrink: 0;
    padding: 16px 22px;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--sub);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tab-btn:hover { color: var(--text); }
  .tab-btn.active { color: var(--text); border-bottom-color: var(--accent); }
  .tab-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    background: var(--bg3);
    padding: 3px 8px;
    border-radius: 3px;
    color: var(--sub2);
  }
  .tab-btn.active .tab-count { background: rgba(184,116,12,0.15); color: var(--accent); }

  .content-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px;
  }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* Bill filter tabs */
  .bill-filter-tabs { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
  .bill-filter-tab {
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--sub);
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .bill-filter-tab:hover, .bill-filter-tab.active {
    background: rgba(184,116,12,0.1);
    border-color: var(--accent);
    color: var(--accent);
  }
  .bill-filter-tab .dot { width: 6px; height: 6px; border-radius: 50%; }

  /* Bill table */
  .bill-table { width: 100%; }
  .bill-table-header,
  .bill-table-row {
    display: grid;
    grid-template-columns: 1fr 110px 110px 110px 90px;
    gap: 12px;
    padding: 14px 18px;
    align-items: center;
  }
  .bill-table-header {
    padding: 10px 18px;
    background: var(--bg3);
    border-radius: 12px 12px 0 0;
    font-size: 11px;
    color: var(--sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'JetBrains Mono', monospace;
    border: 1px solid var(--border);
    border-bottom: none;
  }
  .bill-table-row {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-top: none;
    transition: background 0.15s;
    text-decoration: none;
    color: inherit;
  }
  .bill-table-row:hover { background: var(--bg3); }
  .bill-table-row:last-child { border-radius: 0 0 12px 12px; }

  .bill-row-name {
    font-size: 14px;
    color: var(--text);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bill-row-name small {
    display: block;
    font-size: 12px;
    color: var(--sub);
    font-weight: 400;
    margin-top: 3px;
  }

  .vote-result-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 3px;
    font-size: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
  }
  .v-for     { background: rgba(15,157,110,0.1); color: var(--green); }
  .v-against { background: rgba(208,58,58,0.1);  color: var(--red); }
  .v-abstain { background: rgba(184,116,12,0.1); color: var(--accent); }
  .v-absent  { background: rgba(107,114,128,0.1); color: var(--sub); }
  .v-none    { color: var(--sub2); font-size: 12px; }

  /* Sidebar */
  .side-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .side-card-header {
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    color: var(--sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'JetBrains Mono', monospace;
  }
  .side-card-body { padding: 18px; }

  .vote-summary { display: flex; align-items: center; gap: 22px; }
  .vote-donut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .vote-donut-label {
    font-size: 12px;
    color: var(--sub);
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .vote-legend { flex: 1; display: flex; flex-direction: column; gap: 10px; }
  .vote-legend-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
  }
  .vote-legend-left { display: flex; align-items: center; gap: 8px; color: var(--sub); }
  .legend-dot { width: 9px; height: 9px; border-radius: 50%; }
  .vote-legend-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--text);
  }

  .category-bars { display: flex; flex-direction: column; gap: 12px; }
  .cat-bar-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 5px;
    font-size: 13px;
    color: var(--sub);
  }
  .cat-bar-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--accent);
  }
  .cat-bar-track { height: 4px; background: var(--bg3); border-radius: 2px; overflow: hidden; }
  .cat-bar-fill { height: 100%; background: var(--accent); border-radius: 2px; transition: width 0.8s ease-out; }

  /* ===== 교차 표결 성향 (자당 vs 타당 발의) =====
     정당색(파랑·빨강) 사용 금지 — 자당/타당은 명도 차이로만 구분한다. */
  .cpv-block { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--border); }
  .cpv-head { display: flex; align-items: center; gap: 6px; margin-bottom: 12px; }
  .cpv-title { font-size: 12px; font-weight: 700; color: var(--sub); letter-spacing: 0.02em; }
  .cpv-hint {
    width: 14px; height: 14px; border-radius: 50%; flex: none;
    border: 1px solid var(--border2); color: var(--sub2);
    font-size: 9px; line-height: 12px; text-align: center; cursor: help;
  }
  .cpv-rows { display: flex; flex-direction: column; gap: 9px; }
  .cpv-row { display: grid; grid-template-columns: 58px 1fr 48px 44px; align-items: center; gap: 8px; }
  .cpv-lab { font-size: 11px; color: var(--sub2); }
  .cpv-track { height: 6px; background: var(--bg3); border-radius: 3px; overflow: hidden; }
  .cpv-fill { display: block; height: 100%; border-radius: 3px; transition: width 0.8s ease-out; }
  .cpv-fill.is-own   { background: var(--accent); }
  .cpv-fill.is-other { background: var(--sub2); }
  .cpv-val { font-size: 12px; font-weight: 700; color: var(--text); text-align: right; }
  .cpv-n { font-size: 10px; color: var(--sub2); text-align: right; }

  .cpv-gap { display: flex; align-items: baseline; gap: 10px; margin-top: 14px; }
  .cpv-gap-num { font-size: 26px; font-weight: 800; color: var(--accent); line-height: 1; }
  .cpv-gap-num small { font-size: 13px; font-weight: 700; margin-left: 1px; }
  .cpv-gap-desc { font-size: 11px; color: var(--sub2); line-height: 1.5; }
  .cpv-gap-desc em { display: block; font-style: normal; color: var(--sub2); opacity: 0.85; }

  .cpv-rank { margin-top: 10px; font-size: 12px; color: var(--sub); }
  .cpv-rank strong { color: var(--text); }
  .cpv-rank-note { color: var(--sub2); font-size: 11px; }
  .cpv-dissent {
    margin-top: 8px; padding: 9px 11px; background: var(--bg3);
    border-radius: 6px; font-size: 12px; color: var(--sub); line-height: 1.6;
  }
  .cpv-dissent strong { color: var(--text); }
  .cpv-caveat { margin: 10px 0 0; font-size: 10.5px; color: var(--sub2); line-height: 1.65; }

  @media (max-width: 480px) {
    .cpv-row { grid-template-columns: 52px 1fr 44px; }
    .cpv-n { display: none; }
  }

  .info-list { display: flex; flex-direction: column; gap: 12px; }
  .info-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    gap: 8px;
  }
  .info-item:last-child { border-bottom: none; padding-bottom: 0; }
  .info-key { color: var(--sub2); flex-shrink: 0; }
  .info-val { color: var(--text); font-weight: 500; text-align: right; word-break: break-all; }

  /* Pagination (client side) */
  .pagination-inline {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-top: 16px;
  }
  .pagination-inline .pg {
    width: 36px; height: 36px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--sub);
    font-size: 13px;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
  }
  .pagination-inline .pg.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pagination-inline .pg:disabled { opacity: 0.3; cursor: not-allowed; }

  /* ===== 개요 분석 ===== */
  .overview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .overview-grid.two { grid-template-columns: 2fr 1fr; }
  .card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .card-header {
    padding: 16px 22px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .card-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .card-title-mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
  }
  .card-body { padding: 22px; }

  /* Monthly chart */
  .monthly-chart {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 140px;
    padding: 18px 0 24px;
    position: relative;
  }
  .monthly-chart::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    bottom: 24px;
    height: 1px;
    background: var(--border);
  }
  .month-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    height: 100%;
    justify-content: flex-end;
  }
  .month-bar-wrap {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
  }
  .month-bar {
    position: relative;
    width: 100%;
    background: var(--accent);
    border-radius: 3px 3px 0 0;
    opacity: 0.8;
    cursor: pointer;
    min-height: 6px;
    transition: opacity 0.2s;
  }
  .month-bar:hover { opacity: 1; }
  .month-bar.highlight { background: var(--accent2); opacity: 1; }
  .month-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    color: var(--sub2);
    text-align: center;
  }
  .month-val {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 3px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--sub);
    white-space: nowrap;
  }
  /* 0건 월 — 막대 없이 baseline 위에 "0" 만 노출 (데이터 0 vs 결측 구분) */
  .month-val-zero {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--sub2);
    line-height: 1;
    margin-bottom: 2px;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 16px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--border);
  }
  .tl-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 12px 0;
    position: relative;
  }
  .tl-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    margin-top: 4px;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    margin-left: 11px;
  }
  .tl-dot.passed { background: var(--green); box-shadow: 0 0 8px rgba(15,157,110,0.4); }
  .tl-dot.alt    { background: var(--sub2); }
  .tl-dot.pending { background: var(--accent); }
  .tl-dot.rejected { background: var(--red); }
  .tl-content { flex: 1; min-width: 0; }
  .tl-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tl-meta { font-size: 11px; color: var(--sub2); display: flex; gap: 8px; }
  .tl-date { font-family: 'JetBrains Mono', monospace; }

  /* 정당 협력 */
  .party-coop { display: flex; flex-direction: column; gap: 10px; }
  .party-coop-item { display: flex; align-items: center; gap: 12px; }
  .party-coop-name {
    font-size: 12px;
    color: var(--sub);
    width: 90px;
    flex-shrink: 0;
  }
  .party-coop-bar-wrap {
    flex: 1;
    height: 6px;
    background: var(--bg3);
    border-radius: 3px;
    overflow: hidden;
  }
  .party-coop-bar { height: 100%; border-radius: 3px; }
  .party-coop-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    width: 44px;
    text-align: right;
    flex-shrink: 0;
  }

  .radar-big { display: flex; justify-content: center; align-items: center; padding: 10px 0; }

  .notice-block {
    padding: 14px 18px;
    font-size: 12px;
    color: var(--sub2);
    background: var(--bg3);
    border: 1px dashed var(--border2);
    border-radius: 8px;
    line-height: 1.8;
  }
  .notice-block strong { color: var(--text); }

  /* ===== 국민 평가 ===== */
  .eval-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 24px;
    align-items: start;
  }

  .eval-summary {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 24px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .eval-score-wrap { text-align: center; flex-shrink: 0; }
  .eval-score {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 64px;
    line-height: 1;
    color: var(--accent);
  }
  .eval-score-label { font-size: 11px; color: var(--sub2); margin-top: 4px; }
  .eval-stars {
    display: flex;
    gap: 4px;
    justify-content: center;
    margin-top: 6px;
    font-size: 16px;
  }
  .star-empty { color: var(--sub2); }

  .eval-empty-text { flex: 1; color: var(--sub); font-size: 13px; line-height: 1.8; }

  .comment-write {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 20px;
  }
  .comment-write-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .write-avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--bg3);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }
  .write-stars { display: flex; gap: 4px; }
  .write-star {
    font-size: 18px;
    cursor: pointer;
    color: var(--sub2);
    transition: color 0.15s;
  }
  .write-star:hover, .write-star.active { color: var(--accent); }
  .write-input {
    width: 100%;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--text);
    font-size: 13px;
    resize: none;
    outline: none;
    transition: border-color 0.2s;
    min-height: 72px;
  }
  .write-input:focus { border-color: var(--accent); }
  .write-input::placeholder { color: var(--sub2); }
  .write-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
  }
  .write-hint { font-size: 11px; color: var(--sub2); }
  .write-submit {
    padding: 7px 18px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }

  .comments-empty {
    padding: 40px 24px;
    text-align: center;
    color: var(--sub);
    background: var(--bg2);
    border: 1px dashed var(--border);
    border-radius: 12px;
  }

  @media (max-width: 1024px) {
    .profile-identity { grid-template-columns: 1fr; gap: 20px; text-align: center; }
    .profile-avatar { width: 180px; height: 180px; box-shadow: 0 0 0 8px <%= partyColor %>22; margin: 0 auto; }
    .profile-top { justify-content: center; }
    .profile-meta { justify-content: center; }
    .profile-subinfo > div { flex-basis: 100%; }
    .profile-subinfo { text-align: left; }
    .profile-actions { display: none; }
    .overview-grid { grid-template-columns: 1fr; }
    .overview-grid.two { grid-template-columns: 1fr; }
    .eval-layout { grid-template-columns: 1fr; }
    .bill-table-header, .bill-table-row {
      grid-template-columns: 1fr 80px 80px;
    }
    .bill-table-header span:nth-child(3),
    .bill-table-header span:nth-child(5),
    .bill-table-row > *:nth-child(3),
    .bill-table-row > *:nth-child(5) { display: none; }
  }
</style>

<!-- PROFILE HERO -->
<div class="profile-hero">
  <div class="profile-hero-inner">
    <div class="breadcrumb">
      <a href="/">홈</a> / <a href="/politician">의원</a> / <%= politician.name %>
    </div>

    <div class="profile-identity">
      <div class="profile-avatar">
        <%- avatarHtml(politician.name, politician.photo_url, 240) %>
      </div>
      <div class="profile-content">
        <div class="profile-top">
          <h1 class="profile-name"><%= politician.name %></h1>
          <span class="profile-party-badge"><%= politician.party_name || '무소속' %></span>
          <%# 현역 API 에 없는 의원. 목록의 칩 줄과 같은 자리(정당 배지 옆)에 둔다.
              ⚠️ 이유는 쓰지 않는다 — 사퇴·퇴임·당선무효가 섞여 있고 원천이 사유를 안 준다 %>
          <% if (politician.active_yn === false) { %>
            <span class="profile-retired">퇴임</span>
          <% } %>
          <%# 특수 직위 — politician_titles (수동 관리). 한 사람이 여러 개를 가질 수 있다
              (정책위의장 겸 최고위원 등). 정렬은 쿼리가 공적 지위 → 정당 지위 순으로 해준다.
              상임위 직위(위원장·간사)는 여기가 아니라 아래 위원회 칩이 담당한다.
              값 갱신은 ddl/seeds/politician_titles.sql %>
          <% (locals.titles || []).forEach((t) => { %>
            <span class="profile-title-badge<%= t.category === '당직' ? ' is-party' : '' %>"
                  title="<%= t.category %><%= t.updated_at ? ` · ${t.updated_at} 확인` : '' %>"><%= t.title %></span>
          <% }); %>
        </div>
        <div class="profile-meta">
          <span class="profile-meta-item">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <%= politician.electoral_district || '—' %>
          </span>
          <% if (politician.elect_gbn_nm) { %>
            <span class="profile-meta-item">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <%= politician.elect_gbn_nm %><% if (politician.reele_gbn_nm) { %> · <%= politician.reele_gbn_nm %><% } %>
            </span>
          <% } %>
        </div>

        <%# 소속 위원회 — politician_committees (열린국회정보 위원회 위원 명단).
            ⚠️ 이전엔 politician.cmit_nm 을 meta 한 줄로 찍었는데 그 컬럼은 **309명 전원 NULL** 이라
               렌더된 적이 없다. 되살리지 말 것.
            위원회는 의원이 실제로 일하는 자리라 지역구·선수와 같은 급의 정체 정보로 다룬다. %>
        <% const cmts = locals.committees || []; %>
        <% if (cmts.length) { %>
          <div class="profile-cmt">
            <span class="profile-cmt-label">소속 위원회</span>
            <div class="profile-cmt-list">
              <% cmts.forEach((c) => {
                   const role = c.job_res_nm || '위원';
                   const lead = (role === '위원장' || role === '간사');
                   const cls = 'cmt-chip'
                     + (lead ? ' is-lead' : '')
                     + (c.is_special ? ' is-special' : '');
                   // 링크는 bills.committee 에 실제로 있는 이름에만 (특위는 대개 회부 대상이 아님)
                   const href = c.has_bills ? `/bill?committee=${encodeURIComponent(c.dept_nm)}` : null;
              %>
                <% if (href) { %>
                  <a class="<%= cls %>" href="<%= href %>" title="<%= c.dept_nm %> 회부 법안 보기">
                    <span class="cmt-name"><%= c.dept_nm %></span>
                    <% if (lead) { %><span class="cmt-role"><%= role %></span><% } %>
                  </a>
                <% } else { %>
                  <span class="<%= cls %>">
                    <span class="cmt-name"><%= c.dept_nm %></span>
                    <% if (lead) { %><span class="cmt-role"><%= role %></span><% } %>
                  </span>
                <% } %>
              <% }); %>
            </div>
          </div>
        <% } %>

        <dl class="profile-subinfo">
          <% if (politician.birthday) { %>
            <div><dt>생년월일</dt><dd><%= politician.birthday %> (<%= politician.age %>세)</dd></div>
          <% } %>
          <% if (politician.sex_gbn_nm) { %>
            <div><dt>성별</dt><dd><%= politician.sex_gbn_nm %></dd></div>
          <% } %>
          <% if (politician.e_mail) { %>
            <div class="full"><dt>이메일</dt><dd class="mono"><%= politician.e_mail %></dd></div>
          <% } %>
          <% if (politician.homepage) { %>
            <div><dt>홈페이지</dt><dd><a href="<%= politician.homepage %>" target="_blank" rel="noopener">바로가기 →</a></dd></div>
          <% } %>
          <% const engSlug = (politician.eng_nm || '').toUpperCase().replace(/\s+/g, ''); %>
          <% if (engSlug) { %>
            <div><dt>국회 프로필</dt><dd><a href="https://www.assembly.go.kr/members/22nd/<%= engSlug %>" target="_blank" rel="noopener">바로가기 →</a></dd></div>
          <% } %>
        </dl>
      </div>
    </div>
  </div>
</div>

<!-- TABS -->
<div class="tab-bar">
  <div class="tab-bar-inner">
    <button class="tab-btn active" data-tab="overview">분석</button>
    <button class="tab-btn" data-tab="bills">
      법안 활동 <span class="tab-count"><%= nf(billsTabCount) %></span>
    </button>
    <button class="tab-btn" data-tab="votes">
      표결 내역 <span class="tab-count"><%= nf(votesTabCount) %></span>
    </button>
    <button class="tab-btn" data-tab="comments">국민 평가</button>
  </div>
</div>

<div class="content-wrap">
  <div>

    <!-- ===== 법안 활동 탭 ===== -->
    <div class="tab-panel" id="tab-bills">
      <div class="bill-filter-tabs">
        <button class="bill-filter-tab active" data-bf="all">
          <span class="dot" style="background:var(--accent)"></span>
          전체 <span style="font-family:'JetBrains Mono';font-size:12px;margin-left:2px"><%= nf(billsTabCount) %></span>
        </button>
        <% const repCnt = (bills || []).filter(b => b.proposer_yn).length;
           const coCnt  = (bills || []).filter(b => !b.proposer_yn).length; %>
        <button class="bill-filter-tab" data-bf="rep">
          <span class="dot" style="background:var(--accent)"></span>
          대표발의 <span style="font-family:'JetBrains Mono';font-size:12px;margin-left:2px"><%= nf(repCnt) %></span>
        </button>
        <button class="bill-filter-tab" data-bf="co">
          <span class="dot" style="background:var(--sub2)"></span>
          공동발의 <span style="font-family:'JetBrains Mono';font-size:12px;margin-left:2px"><%= nf(coCnt) %></span>
        </button>
      </div>

      <% if (bills && bills.length > 0) { %>
        <div class="bill-table">
          <div class="bill-table-header">
            <span>법안명</span>
            <span>구분</span>
            <span>제안일</span>
            <span>처리결과</span>
            <span>표결</span>
          </div>
          <div id="bills-container">
            <% bills.forEach(b => { %>
              <a href="/bill/<%= b.bill_id %>"
                 class="bill-table-row bills-row"
                 data-kind="<%= b.proposer_yn ? 'rep' : 'co' %>">
                <div class="bill-row-name">
                  <%= b.bill_name %>
                  <% if (b.committee) { %><small><%= b.committee %></small><% } %>
                </div>
                <span>
                  <% if (b.proposer_yn) { %>
                    <span class="pb-badge pb-badge-category">대표발의</span>
                  <% } else { %>
                    <span class="pb-badge pb-badge-alt">공동발의</span>
                  <% } %>
                </span>
                <div style="font-family:'JetBrains Mono';font-size:12px;color:var(--sub2)"><%= b.propose_dt || '—' %></div>
                <span>
                  <% const statusLabel = b.proc_result_name || '계류';
                     const termAnchor = !b.proc_result_name ? 'pending' :
                         b.proc_result_name === '원안가결' ? 'original' :
                         b.proc_result_name === '수정가결' ? 'modified' :
                         b.proc_result_name === '대안반영폐기' ? 'alt-dropped' :
                         b.proc_result_name === '수정안반영폐기' ? 'mod-dropped' :
                         b.proc_result_name === '철회' ? 'withdrawn' :
                         b.proc_result_name === '부결' ? 'rejected' :
                         b.proc_result_name === '폐기' ? 'dropped' : 'pending';
                  %>
                  <span class="pb-badge <%= resultClass(b.proc_result_name) %>"><%= statusLabel %></span>
                  <% if (!b.proc_result_name && b.days_elapsed != null) {
                       const d = Number(b.days_elapsed);
                       const color = d >= 200 ? 'var(--red)' : d >= 100 ? 'var(--accent)' : 'var(--sub2)';
                  %>
                    <span style="display:block;font-size:12px;color: <%= color %>;font-family:'JetBrains Mono';margin-top:4px">+<%= d %>일</span>
                  <% } %>
                </span>
                <div>
                  <% if (b.my_vote_result) { %>
                    <span class="vote-result-chip v-<%= b.my_vote_result === '찬성' ? 'for' : b.my_vote_result === '반대' ? 'against' : b.my_vote_result === '기권' ? 'abstain' : 'absent' %>">
                      <%= b.my_vote_result %>
                    </span>
                  <% } else { %>
                    <span class="v-none">—</span>
                  <% } %>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <div class="pagination-inline" id="bills-pagination"></div>
      <% } else { %>
        <div class="comments-empty">해당 의원의 법안 활동 데이터가 없습니다.</div>
      <% } %>
    </div>

    <!-- ===== 표결 내역 탭 ===== -->
    <div class="tab-panel" id="tab-votes">
      <% if (votes && votes.length > 0) { %>
        <div class="bill-table">
          <div class="bill-table-header">
            <span>법안명</span>
            <span>표결결과</span>
            <span>표결일</span>
            <span>처리결과</span>
            <span>카테고리</span>
          </div>
          <% votes.slice(0, 50).forEach(v => { %>
            <a href="/bill/<%= v.bill_id %>" class="bill-table-row">
              <div class="bill-row-name"><%= v.bill_name || v.bill_id %></div>
              <div>
                <span class="vote-result-chip v-<%= v.vote_result === '찬성' ? 'for' : v.vote_result === '반대' ? 'against' : v.vote_result === '기권' ? 'abstain' : 'absent' %>">
                  <%= v.vote_result %>
                </span>
              </div>
              <div style="font-family:'JetBrains Mono';font-size:12px;color:var(--sub2)"><%= v.vote_date %></div>
              <span><span class="pb-badge <%= resultClass(v.proc_result_name) %>"><%= v.proc_result_name || '—' %></span></span>
              <span><% if (v.bill_topic_nm) { %><span class="pb-badge pb-badge-category"><%= v.bill_topic_nm %></span><% } %></span>
            </a>
          <% }); %>
        </div>
        <% if (votes.length > 50) { %>
          <div style="text-align:center;padding:16px;color:var(--sub2);font-size:12px">
            최근 50건만 표시. 전체 <%= nf(votes.length) %>건.
          </div>
        <% } %>
      <% } else { %>
        <div class="comments-empty">해당 의원의 표결 내역이 없습니다.</div>
      <% } %>
    </div>

    <!-- ===== 분석 탭 ===== -->
    <div class="tab-panel active" id="tab-overview">
      <div class="profile-kpis-row">
        <div class="profile-kpi">
          <div class="profile-kpi-val kpi-blue"><%= nf(proposeCnt) %></div>
          <div class="profile-kpi-label">법안 발의 <span class="pb-help" data-help-href="/glossary#rep-proposer" title="대표발의 설명">?</span></div>
          <div class="profile-kpi-sub">공동발의 <%= nf(coProposeCnt) %>건</div>
        </div>
        <div class="profile-kpi">
          <% if (voteParticipateRate == null) { %>
            <div class="profile-kpi-val em-dash" title="추후 제공 예정">—</div>
          <% } else { %>
            <div class="profile-kpi-val kpi-amber"><%= voteParticipateRate.toFixed(0) %>%</div>
          <% } %>
          <div class="profile-kpi-label">표결 참여율 <span class="pb-help" data-help-href="/glossary#vote-absent" title="(찬성+반대+기권) / 전체 표결">?</span></div>
          <% if (vsTotal > 0) { %>
            <div class="profile-kpi-sub"><%= nf(vsAttended) %> / <%= nf(vsTotal) %></div>
          <% } else { %>
            <div class="profile-kpi-sub">표결 데이터 수집 전</div>
          <% } %>
        </div>
        <div class="profile-kpi">
          <% if (passRate == null) { %>
            <div class="profile-kpi-val em-dash">—</div>
          <% } else { %>
            <div class="profile-kpi-val kpi-green"><%= passRate.toFixed(0) %>%</div>
          <% } %>
          <div class="profile-kpi-label">가결율 <span class="pb-help" data-help-href="/glossary#original" title="가결 법안 수 / 대표발의 법안 수">?</span></div>
          <div class="profile-kpi-sub">
            <% if (proposeCnt === 0) { %>
              대표발의 없음
            <% } else { %>
              <%= nf(passedCnt) %> / <%= nf(proposeCnt) %>
            <% } %>
          </div>
        </div>
      </div>

      <!-- ===== 당신과의 비교 (D 레이어 본체, 펼침 컴포넌트) =====
           헤더(닫힌 상태) = 카드의 일치도 한 줄을 흡수.
           바디(펼친 상태) = 4축 다이아몬드 + 축별 해석 + 전체 일치도 박스.
           첫 진입 시 자동 펼침 (사용자가 카드의 일치도 보고 들어왔으므로 자연 첫 인상). -->
      <%
        const _userAxis = locals.userAxis || null;
        let _detailDist = null;
        let _detailSim = null;
        if (_userAxis && politician.axis_economy !== null && politician.axis_economy !== undefined) {
          const _s =
            (_userAxis.economy     - parseFloat(politician.axis_economy))     ** 2 +
            (_userAxis.social      - parseFloat(politician.axis_social))      ** 2 +
            (_userAxis.security    - parseFloat(politician.axis_security))    ** 2 +
            (_userAxis.institution - parseFloat(politician.axis_institution)) ** 2;
          _detailDist = Math.sqrt(_s) / 2;
          // 일치도 분모 1.5 (politician.ejs 와 동일 — 실측 거리 분포 보정)
          _detailSim = Math.max(0, Math.round((1 - _detailDist / 1.5) * 100));
        }
        const _detailTitle = _detailDist !== null
          ? `당신 좌표와 4축 거리 ${_detailDist.toFixed(2)}. 매핑 ${politician.axis_version} 기준.`
          : '';
      %>

      <% if (locals.balanceGameCompleted === true && _detailSim !== null) {
        // === 본체 — 사용자·의원 좌표 + 4축 해석 (펼침 가능) ===
        const ua = _userAxis;
        const pa = {
          economy:     parseFloat(politician.axis_economy),
          social:      parseFloat(politician.axis_social),
          security:    parseFloat(politician.axis_security),
          institution: parseFloat(politician.axis_institution),
        };
        const cx = 180, cy = 180, R = 130;
        const pt = (val, dir) => {
          const r = R * Math.abs(val);
          if (dir === 'top')    return { x: cx,         y: cy - r };
          if (dir === 'right')  return { x: cx + r,     y: cy     };
          if (dir === 'bottom') return { x: cx,         y: cy + r };
          return                       { x: cx - r,     y: cy     };
        };
        const myPts = [pt(ua.security,'top'),    pt(ua.economy,'right'),  pt(ua.institution,'bottom'),  pt(ua.social,'left')];
        const poPts = [pt(pa.security,'top'),    pt(pa.economy,'right'),  pt(pa.institution,'bottom'),  pt(pa.social,'left')];
        const polyStr = pts => pts.map(p => `${p.x},${p.y}`).join(' ');

        const SIDE = {
          economy:     { L: '시장', R: '개입' },
          social:      { L: '전통', R: '자율' },
          security:    { L: '동맹', R: '자주' },
          institution: { L: '안정', R: '개혁' },
        };
        const interpret = (axis, uV, pV) => {
          const diff = Math.abs(uV - pV);
          let intensity;
          if      (diff < 0.25) intensity = '거의 같음';
          else if (diff < 0.75) intensity = '약간 차이';
          else if (diff < 1.25) intensity = '뚜렷한 차이';
          else                  intensity = (uV * pV < 0) ? '정반대 입장' : '큰 차이';
          const uMid = Math.abs(uV) < 0.1, pMid = Math.abs(pV) < 0.1;
          let direction;
          if (uMid && pMid)        direction = '둘 다 중도 근처';
          else if (uMid || pMid)   direction = '한쪽 중도 근처';
          else if (uV > 0 && pV > 0) direction = `같은 방향 (둘 다 ${SIDE[axis].R} 쪽)`;
          else if (uV < 0 && pV < 0) direction = `같은 방향 (둘 다 ${SIDE[axis].L} 쪽)`;
          else                       direction = '반대 방향';
          return `${direction}, ${intensity}`;
        };
        const fmt = (n) => (n >= 0 ? '+' : '') + n.toFixed(2);
        const POL_AXES = [
          { name:'안보·외교', val: pa.security },
          { name:'경제',     val: pa.economy },
          { name:'정치제도', val: pa.institution },
          { name:'사회·문화', val: pa.social },
        ];
        const ME_AXES = [
          { val: ua.security }, { val: ua.economy }, { val: ua.institution }, { val: ua.social },
        ];
      %>
        <div class="bg-vs-collapsible" id="bg-vs-collapsible" data-open="true">
          <button type="button" class="bg-vs-collapse-header" id="bg-vs-collapse-header" aria-expanded="true" title="<%= _detailTitle %>">
            <span class="bg-vs-collapse-text">나의 성향 진단과 <strong><%= _detailSim %>%</strong> 일치</span>
            <a href="/balance-game/mapping" class="bg-vs-collapse-mapping" onclick="event.stopPropagation()" title="매핑이 갱신되면 분석 결과가 달라질 수 있어요">매핑 <%= politician.axis_version %> →</a>
            <span class="bg-vs-collapse-icon" aria-hidden="true">▼</span>
          </button>
          <div class="bg-vs-collapse-body" id="bg-vs-collapse-body">
            <div class="bg-vs-body">
              <div class="bg-vs-diamond-wrap">
                <svg class="bg-vs-diamond" viewBox="0 0 360 360" xmlns="http://www.w3.org/2000/svg">
                  <% [0.25, 0.50, 0.75, 1.00].forEach(scale => {
                       const r = R * scale;
                  %>
                    <polygon class="bg-vs-grid"
                      points="<%= cx %>,<%= cy - r %> <%= cx + r %>,<%= cy %> <%= cx %>,<%= cy + r %> <%= cx - r %>,<%= cy %>"/>
                  <% }); %>
                  <line class="bg-vs-axis-line" x1="<%= cx %>" y1="<%= cy - R %>" x2="<%= cx %>" y2="<%= cy + R %>"/>
                  <line class="bg-vs-axis-line" x1="<%= cx - R %>" y1="<%= cy %>" x2="<%= cx + R %>" y2="<%= cy %>"/>
                  <polygon class="bg-vs-fill-pol" points="<%= polyStr(poPts) %>"/>
                  <polygon class="bg-vs-fill-mine" points="<%= polyStr(myPts) %>"/>
                  <% poPts.forEach((p, i) => { %>
                    <circle class="bg-vs-dot-pol" cx="<%= p.x %>" cy="<%= p.y %>" r="4">
                      <title>의원 <%= POL_AXES[i].name %> <%= fmt(POL_AXES[i].val) %></title>
                    </circle>
                  <% }); %>
                  <% myPts.forEach((p, i) => { %>
                    <circle class="bg-vs-dot-mine" cx="<%= p.x %>" cy="<%= p.y %>" r="4">
                      <title>나 <%= POL_AXES[i].name %> <%= fmt(ME_AXES[i].val) %></title>
                    </circle>
                  <% }); %>
                  <text class="bg-vs-axis-label"        x="<%= cx %>"          y="<%= cy - R - 14 %>">안보·외교</text>
                  <text class="bg-vs-axis-label"        x="<%= cx + R + 28 %>" y="<%= cy + 4 %>">경제</text>
                  <text class="bg-vs-axis-label bottom" x="<%= cx %>"          y="<%= cy + R + 14 %>">정치제도</text>
                  <text class="bg-vs-axis-label"        x="<%= cx - R - 28 %>" y="<%= cy + 4 %>">사회·문화</text>
                </svg>
                <div class="bg-vs-diamond-help">중심은 중도, 가장자리는 뚜렷한 입장</div>
                <div class="bg-vs-legend">
                  <span class="bg-vs-legend-item bg-vs-legend-mine"><span class="bg-vs-legend-swatch"></span>나의 좌표</span>
                  <span class="bg-vs-legend-item bg-vs-legend-pol"><span class="bg-vs-legend-swatch"></span><%= politician.name %> 의원</span>
                </div>
              </div>
              <div class="bg-vs-axes">
                <div><span class="axis-name">경제</span><span class="axis-line"><%= interpret('economy', ua.economy, pa.economy) %></span></div>
                <div><span class="axis-name">사회·문화</span><span class="axis-line"><%= interpret('social', ua.social, pa.social) %></span></div>
                <div><span class="axis-name">안보·외교</span><span class="axis-line"><%= interpret('security', ua.security, pa.security) %></span></div>
                <div><span class="axis-name">정치제도</span><span class="axis-line"><%= interpret('institution', ua.institution, pa.institution) %></span></div>
              </div>
            </div>
          </div>
        </div>
      <% } else if (locals.balanceGameCompleted === false) { %>
        <a href="/balance-game?next=<%= encodeURIComponent(locals.currentUrl || '/politician/' + politician.mona_cd) %>" class="bg-vs-collapse-header is-pending">
          <span class="bg-vs-collapse-text">성향 진단 후 표시됩니다</span>
          <span class="bg-vs-collapse-mapping">진단하러 가기 →</span>
        </a>
      <% } else { %>
        <%# 게임 완료지만 의원 좌표 미산출 %>
        <div class="bg-vs-collapse-header is-missing" title="이 의원의 표결 참여 기록이 부족하여 4축 좌표를 산출할 수 없습니다">
          <span class="bg-vs-collapse-text">⚠️ 분석 데이터 부족</span>
          <span class="bg-vs-collapse-mapping">표결 참여 부족</span>
        </div>
      <% } %>

      <div class="overview-grid">
        <!-- 레이더 (4축 다이아몬드) -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">활동 레이더 <span class="card-title-mono">4개 지표</span></span>
          </div>
          <div class="card-body radar-big">
            <%
              const MINI_R = 90;
              const miniPt = (val, idx) => {
                const r = (val / 100) * MINI_R;
                const rad = radarAngles[idx] * Math.PI / 180;
                return `${(r * Math.cos(rad)).toFixed(1)},${(r * Math.sin(rad)).toFixed(1)}`;
              };
              const miniRadarPts = radarValues.map((v, i) => miniPt(v, i)).join(' ');
              const miniGridPt = (scale) => radarAngles.map(a => {
                const rad = a * Math.PI / 180;
                const r = MINI_R * scale;
                return `${(r * Math.cos(rad)).toFixed(1)},${(r * Math.sin(rad)).toFixed(1)}`;
              }).join(' ');
            %>
            <svg width="240" height="240" viewBox="-120 -120 240 240" overflow="visible">
              <polygon points="<%= miniGridPt(1.0) %>"  fill="none" stroke="#E2DFD4" stroke-width="1"/>
              <polygon points="<%= miniGridPt(0.75) %>" fill="none" stroke="#E2DFD4" stroke-width="1"/>
              <polygon points="<%= miniGridPt(0.5) %>"  fill="none" stroke="#E2DFD4" stroke-width="1"/>
              <polygon points="<%= miniGridPt(0.25) %>" fill="none" stroke="#E2DFD4" stroke-width="1"/>
              <% radarAngles.forEach(a => {
                   const rad = a * Math.PI / 180;
                   const ex = (MINI_R * Math.cos(rad)).toFixed(1);
                   const ey = (MINI_R * Math.sin(rad)).toFixed(1);
              %>
                <line x1="0" y1="0" x2="<%= ex %>" y2="<%= ey %>" stroke="#E2DFD4" stroke-width="1"/>
              <% }); %>
              <polygon points="<%= miniRadarPts %>" fill="rgba(184,116,12,0.1)" stroke="var(--accent)" stroke-width="1.5"/>
              <% radarValues.forEach((v, i) => {
                   const rad = radarAngles[i] * Math.PI / 180;
                   const r = (v / 100) * MINI_R;
                   const cx = (r * Math.cos(rad)).toFixed(1);
                   const cy = (r * Math.sin(rad)).toFixed(1);
              %>
                <circle cx="<%= cx %>" cy="<%= cy %>" r="3.5" fill="#B8740C"/>
              <% }); %>
              <text x="0"    y="-102" text-anchor="middle" fill="#4B5362" font-size="11" font-family="Noto Sans KR" font-weight="500"><%= radarLabels[0] %></text>
              <text x="102"  y="4"    text-anchor="start"  fill="#4B5362" font-size="11" font-family="Noto Sans KR" font-weight="500"><%= radarLabels[1] %></text>
              <text x="0"    y="112"  text-anchor="middle" fill="#4B5362" font-size="11" font-family="Noto Sans KR" font-weight="500"><%= radarLabels[2] %></text>
              <text x="-102" y="4"    text-anchor="end"    fill="#4B5362" font-size="11" font-family="Noto Sans KR" font-weight="500"><%= radarLabels[3] %></text>
            </svg>
          </div>
        </div>

        <!-- 표결 성향 (요약) -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">표결 성향 <span class="card-title-mono">데이터 기반</span></span>
          </div>
          <div class="card-body">
            <% if (vsTotal > 0) { %>
              <div class="category-bars">
                <div>
                  <div class="cat-bar-label">찬성 비율<span class="cat-bar-val" style="color:var(--green)"><%= pct(vs.for_cnt, vsAttended).toFixed(1) %>% (<%= nf(vs.for_cnt) %>건)</span></div>
                  <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= pct(vs.for_cnt, vsAttended) %>%;background:var(--green)"></div></div>
                </div>
                <div>
                  <div class="cat-bar-label">반대 비율<span class="cat-bar-val" style="color:var(--red)"><%= pct(vs.against_cnt, vsAttended).toFixed(1) %>% (<%= nf(vs.against_cnt) %>건)</span></div>
                  <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= pct(vs.against_cnt, vsAttended) %>%;background:var(--red)"></div></div>
                </div>
                <div>
                  <div class="cat-bar-label">기권 비율<span class="cat-bar-val" style="color:var(--accent)"><%= pct(vs.abstain_cnt, vsAttended).toFixed(1) %>% (<%= nf(vs.abstain_cnt) %>건)</span></div>
                  <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= pct(vs.abstain_cnt, vsAttended) %>%;background:var(--accent)"></div></div>
                </div>
                <div>
                  <div class="cat-bar-label">불참 비율<span class="cat-bar-val"><%= pct(vs.absent_cnt, vsTotal).toFixed(1) %>% (<%= nf(vs.absent_cnt) %>건)</span></div>
                  <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= pct(vs.absent_cnt, vsTotal) %>%;background:var(--sub2)"></div></div>
                </div>
              </div>
              <%
                /* 교차 표결 성향 — "당을 보고 투표하나, 법안을 보고 투표하나"
                   정당색은 쓰지 않는다(중립성). 자당/타당 프레이밍 + 골드 단일 강조. */
                const cpv = locals.crossPartyVote;
                const hasCpv = cpv && cpv.own_total > 0 && cpv.other_total > 0;
                const cpvGap = hasCpv ? Number(cpv.gap) : 0;
                const cpvMedian = hasCpv && cpv.cohort_median != null ? Number(cpv.cohort_median) : null;
                const cpvRank = hasCpv && cpv.in_cohort ? Number(cpv.gap_rank) : null;
                const cpvCohort = hasCpv ? Number(cpv.cohort_size) : 0;
                const cpvPctile = cpvRank ? Math.round(cpvRank / cpvCohort * 100) : null;
                const cpvDissent = hasCpv ? Number(cpv.dissent_total) : 0;
                const cpvDissentOther = hasCpv ? Number(cpv.dissent_other) : 0;
              %>
              <% if (hasCpv) { %>
                <div class="cpv-block">
                  <div class="cpv-head">
                    <span class="cpv-title">발의 정당별 찬성률</span>
                    <span class="cpv-hint" title="본회의 표결 중 불참을 제외하고, 대표발의자의 소속 정당을 기준으로 나눈 값입니다. 대표발의자가 확인되지 않는 위원장 대안 등은 제외했습니다.">?</span>
                  </div>

                  <div class="cpv-rows">
                    <div class="cpv-row">
                      <span class="cpv-lab">자당 발의</span>
                      <span class="cpv-track"><span class="cpv-fill is-own" style="width:<%= cpv.own_rate %>%"></span></span>
                      <span class="cpv-val"><%= Number(cpv.own_rate).toFixed(1) %>%</span>
                      <span class="cpv-n"><%= nf(cpv.own_total) %>건</span>
                    </div>
                    <div class="cpv-row">
                      <span class="cpv-lab">타당 발의</span>
                      <span class="cpv-track"><span class="cpv-fill is-other" style="width:<%= cpv.other_rate %>%"></span></span>
                      <span class="cpv-val"><%= Number(cpv.other_rate).toFixed(1) %>%</span>
                      <span class="cpv-n"><%= nf(cpv.other_total) %>건</span>
                    </div>
                  </div>

                  <div class="cpv-gap">
                    <span class="cpv-gap-num"><%= (cpvGap > 0 ? '+' : '') + cpvGap.toFixed(1) %><small>%p</small></span>
                    <span class="cpv-gap-desc">
                      자당·타당 격차
                      <% if (cpvMedian !== null) { %>
                        <em>의원 중앙값 <%= cpvMedian.toFixed(1) %>%p</em>
                      <% } %>
                    </span>
                  </div>

                  <% if (cpvRank) { %>
                    <div class="cpv-rank">
                      격차가 큰 순으로 <strong><%= nf(cpvCohort) %>명 중 <%= nf(cpvRank) %>위</strong>
                      <span class="cpv-rank-note">(상위 <%= cpvPctile %>%)</span>
                    </div>
                  <% } %>

                  <% if (cpvDissent > 0) { %>
                    <div class="cpv-dissent">
                      반대·기권한 <strong><%= nf(cpvDissent) %>건</strong> 중
                      <strong><%= nf(cpvDissentOther) %>건</strong>이 타당 발의 법안입니다.
                    </div>
                  <% } %>

                  <p class="cpv-caveat">
                    격차가 클수록 소속 정당에 따라 표결이 갈렸다는 뜻입니다. 다만 다수당·소수당의 의사일정 구조가
                    달라 수치만으로 단정하기는 어렵습니다.
                  </p>
                </div>
              <% } %>

              <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border);font-size:11px;color:var(--sub2);line-height:1.7">
                총 <strong style="color:var(--text)"><%= nf(vsTotal) %>건</strong>의 본회의 표결 기록 분석.
              </div>
            <% } else { %>
              <div class="notice-block">
                표결 기록이 아직 수집되지 않았습니다. 데이터 배치 완료 후 표시됩니다.
              </div>
            <% } %>
          </div>
        </div>

        <!-- 관심분야 -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">대표발의 관심분야 <span class="card-title-mono">TOP 5</span></span>
          </div>
          <div class="card-body">
            <% if (topics5.length > 0) { %>
              <div class="category-bars">
                <% topics5.forEach(t => {
                     const w = maxTopicCnt > 0 ? (Number(t.cnt) / maxTopicCnt * 100) : 0;
                %>
                  <div>
                    <div class="cat-bar-label"><%= t.topic_name %><span class="cat-bar-val"><%= t.cnt %>건</span></div>
                    <div class="cat-bar-track"><div class="cat-bar-fill" style="width:<%= w %>%"></div></div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="notice-block">아직 대표발의 법안이 없습니다.</div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- 월별 발의 + 타임라인 -->
      <div class="overview-grid two">
        <div class="card">
          <div class="card-header">
            <span class="card-title">월별 발의 현황 <span class="card-title-mono">최근 12개월</span></span>
          </div>
          <div class="card-body">
            <% if (monthly && monthly.length > 0) { %>
              <div class="monthly-chart">
                <% monthly.forEach(m => {
                     const cnt = Number(m.cnt);
                     const h = (cnt / monthlyMax) * 100;
                     const isHigh = cnt >= monthlyMax * 0.8 && cnt > 0;
                %>
                  <div class="month-col">
                    <div class="month-bar-wrap">
                      <% if (cnt > 0) { %>
                        <div class="month-bar <%= isHigh ? 'highlight' : '' %>" style="height:<%= h %>%">
                          <span class="month-val"><%= cnt %></span>
                        </div>
                      <% } else { %>
                        <span class="month-val-zero">0</span>
                      <% } %>
                    </div>
                    <div class="month-label"><%= parseInt(m.mm, 10) %>월</div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="notice-block">월별 발의 데이터가 없습니다.</div>
            <% } %>

            <% if (partyCoopTop.length > 0) { %>
              <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border)">
                <div class="party-coop">
                  <div style="font-size:11px;color:var(--sub2);margin-bottom:4px">정당별 공동발의 협력 (대표발의 법안 기준)</div>
                  <% partyCoopTop.forEach(pc => {
                       const w = partyCoopTotal > 0 ? (Number(pc.cnt) / partyCoopTotal * 100) : 0;
                       const color = partyColorOf(pc.party_name);
                  %>
                    <div class="party-coop-item">
                      <span class="party-coop-name" style="color: <%= color %>"><%= pc.party_name %></span>
                      <div class="party-coop-bar-wrap"><div class="party-coop-bar" style="width:<%= w %>%;background:<%= color %>;opacity:0.7"></div></div>
                      <span class="party-coop-val"><%= nf(pc.cnt) %>건</span>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title">주요 법안 이력 <span class="card-title-mono">타임라인</span></span>
          </div>
          <div class="card-body">
            <% if (timeline && timeline.length > 0) { %>
              <div class="timeline">
                <% timeline.forEach(t => {
                     const r = t.proc_result_name || '';
                     let dotClass = 'pending';
                     if (r.indexOf('가결') > -1) dotClass = 'passed';
                     else if (r.indexOf('대안') > -1 || r === '폐기') dotClass = 'alt';
                     else if (r === '부결' || r === '철회') dotClass = 'rejected';
                     let lblColor = 'var(--sub2)';
                     if (r.indexOf('가결') > -1) lblColor = 'var(--green)';
                     else if (r === '부결' || r === '폐기' || r === '철회') lblColor = 'var(--red)';
                     else if (!r) { lblColor = 'var(--accent)'; }
                %>
                  <div class="tl-item">
                    <div class="tl-dot <%= dotClass %>"></div>
                    <div class="tl-content">
                      <div class="tl-name"><%= t.bill_name %></div>
                      <div class="tl-meta">
                        <span class="tl-date"><%= t.propose_dt %></span>
                        <span style="color: <%= lblColor %>"><%= r || '계류중' %></span>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="notice-block">대표발의 법안이 없습니다.</div>
            <% } %>
          </div>
        </div>
      </div>

    </div>

    <!-- ===== 국민 평가 탭 ===== -->
    <div class="tab-panel" id="tab-comments">
      <!-- 별점 요약 + 나의 별점 (PB.mountRating 이 렌더) -->
      <div id="rating-widget"></div>

      <!-- 댓글 작성 + 목록 (PB.mountComments 가 렌더) -->
      <div id="comment-widget"></div>
    </div>

  </div>
</div>


<script>
(() => {
  const MONA_CD = '<%= politician.mona_cd %>';
  let commentsMounted = false;

  const mountCommentsIfNeeded = () => {
    if (commentsMounted || !window.PB) return;
    commentsMounted = true;
    PB.mountRating({ containerId: 'rating-widget', monaCd: MONA_CD });
    PB.mountComments({ containerId: 'comment-widget', type: 'politician', targetId: MONA_CD });
  };

  // Tab switching
  const tabs = document.querySelectorAll('.tab-btn');
  const panels = document.querySelectorAll('.tab-panel');
  tabs.forEach(t => t.addEventListener('click', () => {
    const key = t.dataset.tab;
    tabs.forEach(x => x.classList.toggle('active', x === t));
    panels.forEach(p => p.classList.toggle('active', p.id === 'tab-' + key));
    if (key === 'comments') mountCommentsIfNeeded();
  }));

  // URL hash 로 국민 평가 바로 열기: /politician/XXX#comments
  if (location.hash === '#comments') {
    const btn = document.querySelector('[data-tab="comments"]');
    if (btn) btn.click();
  }

  // "당신과의 비교" 펼침 토글 — 첫 진입은 자동 펼침 (data-open="true" 서버렌더)
  // 헤더 클릭 시 토글, 매핑 링크 클릭은 stopPropagation 으로 토글 안 됨
  const vsWrap   = document.getElementById('bg-vs-collapsible');
  const vsHeader = document.getElementById('bg-vs-collapse-header');
  if (vsWrap && vsHeader) {
    vsHeader.addEventListener('click', () => {
      const open = vsWrap.dataset.open !== 'false';
      const next = open ? 'false' : 'true';
      vsWrap.dataset.open = next;
      vsHeader.setAttribute('aria-expanded', next);
    });
  }

  // Bill filter tabs — 필터 상태는 dataset.filtered 로만 추적 (display 와 분리)
  document.querySelectorAll('.bill-filter-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.bill-filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const kind = btn.dataset.bf;
      document.querySelectorAll('.bills-row').forEach(row => {
        const matches = (kind === 'all') || (row.dataset.kind === kind);
        row.dataset.filtered = matches ? '' : 'true';
      });
      resetBillsPaging();
    });
  });

  // 클라이언트 페이지네이션 (법안 탭)
  const PER = 20;
  let currentPage = 1;
  const billsContainer = document.getElementById('bills-container');
  const pagerEl = document.getElementById('bills-pagination');

  function resetBillsPaging() {
    if (!billsContainer || !pagerEl) return;
    currentPage = 1;
    renderPage();
  }

  function renderPage() {
    const allRows = Array.from(document.querySelectorAll('.bills-row'));
    // 필터 통과 행만 후보 (dataset.filtered === 'true' 는 필터 제외)
    const filtered = allRows.filter(r => r.dataset.filtered !== 'true');
    const total = filtered.length;
    const pages = Math.max(1, Math.ceil(total / PER));
    if (currentPage > pages) currentPage = pages;

    // 필터에서 빠진 행 + 현재 페이지 밖 행 → 숨김
    const start = (currentPage - 1) * PER;
    const pageSet = new Set(filtered.slice(start, start + PER));
    allRows.forEach(r => {
      r.style.display = pageSet.has(r) ? '' : 'none';
    });

    // pager
    pagerEl.innerHTML = '';
    if (pages <= 1) return;
    const mk = (label, page, opts = {}) => {
      const b = document.createElement('button');
      b.className = 'pg' + (opts.active ? ' active' : '');
      b.textContent = label;
      b.disabled = !!opts.disabled;
      b.onclick = () => { currentPage = page; renderPage(); };
      pagerEl.appendChild(b);
    };
    mk('←', Math.max(1, currentPage - 1), { disabled: currentPage === 1 });
    const maxBtns = 7;
    const startPage = Math.max(1, currentPage - 3);
    const endPage = Math.min(pages, startPage + maxBtns - 1);
    for (let p = startPage; p <= endPage; p++) mk(String(p), p, { active: p === currentPage });
    mk('→', Math.min(pages, currentPage + 1), { disabled: currentPage === pages });
  }

  // Hook: when filter changes we re-render. We already reset in filter handler.
  // On first load: ensure filter didn't hide anything, then render page.
  if (billsContainer && pagerEl) {
    renderPage();
  }

})();
</script>
