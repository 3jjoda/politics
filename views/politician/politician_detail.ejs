  .profile-identity {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 32px;
    align-items: center;
  }
  .profile-content { min-width: 0; }

  /* 소속 위원회 칩 — 정당색 배제 원칙에 따라 정당이 아니라 **직위**로만 강조한다
     (위원장·간사만 골드, 나머지는 무채색). */
  .profile-cmt {
    margin-top: 16px;
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .profile-cmt-label {
    font-size: 12px;
    color: var(--sub2);
    flex-shrink: 0;
  }
  .profile-cmt-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 0;
  }
  .cmt-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border: 1px solid var(--border2);
    border-radius: 7px;
    background: var(--bg2);
    font-size: 12.5px;
    color: var(--text);
    text-decoration: none;
    line-height: 1.45;
    word-break: keep-all;
    max-width: 100%;
    /* ⚠️ 특위 이름 중에 **공백이 하나도 없는 50자짜리**가 있다
       ("제9회전국동시지방선거투표용지부족사태등국민참정권침해진상규명및선거관리개혁을위한국정조사특별위원회").
       keep-all 만 두면 끊을 자리가 없어 375px 에서 scrollWidth 581 / clientWidth 325 로 **잘려서 안 보인다**
       (문서 가로 스크롤은 안 생겨서 눈치채기 어렵다). bill_detail 의 .tl-label 과 같은 함정.
       anywhere 는 다른 줄바꿈 기회가 없을 때만 강제로 쪼개므로 평소 한글 가독성은 그대로다. */
    overflow-wrap: anywhere;
  }
