<style>
  .auth-wrap {
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
  }
  .auth-card {
    width: 100%;
    max-width: 420px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px 32px;
    box-shadow: var(--shadow);
    text-align: center;
  }
  /* nav 와 같은 마크 분리형 조립. 카드는 세로 여유가 있어 태그라인을 아래로 내림.
     nav 대비 배율만 키움 (마크 36→48 / 워드마크 h30→40 / 태그라인 h18→24). */
  .auth-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .auth-logo-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .auth-logo-mark {
    display: block;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }
  .auth-logo-wordmark {
    display: block;
    height: 40px;
    width: auto;
    flex-shrink: 0;
  }
  .auth-logo-tagline {
    display: block;
    height: 24px;
    width: auto;
    flex-shrink: 0;
  }

  .auth-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
  }
  .auth-lead {
    font-size: 14px;
    color: var(--sub);
    margin-bottom: 32px;
    line-height: 1.7;
  }

  .auth-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 14px 18px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--border);
    transition: all 0.15s;
    text-decoration: none;
    margin-bottom: 10px;
  }
  .auth-btn svg { width: 20px; height: 20px; }
  .auth-btn:hover { border-color: var(--border2); transform: translateY(-1px); }

  .auth-btn.google {
    background: #fff;
    color: #1f1f1f;
    border-color: #e0e0e0;
  }
  .auth-btn.google:hover { border-color: #bdbdbd; box-shadow: var(--shadow-sm); }

  .auth-btn.kakao {
    background: #FEE500;
    color: #000000D8;
    border-color: #FEE500;
  }
  .auth-btn.kakao:hover { background: #f4d900; box-shadow: var(--shadow-sm); }

  .auth-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .auth-note {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--sub2);
    line-height: 1.7;
  }
  .auth-note a { color: var(--accent); }

  .auth-error {
    background: rgba(208,58,58,0.08);
    border: 1px solid rgba(208,58,58,0.2);
    color: var(--red);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    margin-bottom: 18px;
  }

  .auth-back {
    display: inline-block;
    margin-top: 20px;
    font-size: 13px;
    color: var(--sub);
  }
  .auth-back:hover { color: var(--text); }
</style>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-logo" role="img" aria-label="당말사 — 당 말고 사람">
      <span class="auth-logo-brand">
        <img src="<%= asset('/assets/imgs/mark-only.svg') %>" alt="" aria-hidden="true" class="auth-logo-mark">
        <img src="<%= asset('/assets/imgs/wordmark-nav.svg') %>" alt="" aria-hidden="true" class="auth-logo-wordmark">
      </span>
      <img src="<%= asset('/assets/imgs/tagline.svg') %>" alt="" aria-hidden="true" class="auth-logo-tagline">
    </div>

    <h1 class="auth-title">로그인 / 가입</h1>
    <p class="auth-lead">
      구글 또는 카카오 계정으로 간편하게 시작하세요.<br>
      댓글·별점·찬반 투표에 참여할 수 있습니다.
    </p>

    <% if (error) { %>
      <div class="auth-error">
        <%= error === 'google' ? '구글 로그인에 실패했습니다.' :
            error === 'kakao' ? '카카오 로그인에 실패했습니다.' :
            '로그인에 실패했습니다.' %>
      </div>
    <% } %>

    <% if (providers.google) { %>
      <a href="/auth/google" class="auth-btn google">
        <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
          <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
          <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
          <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571.001-.001.002-.001.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
        </svg>
        <span>구글로 계속하기</span>
      </a>
    <% } else { %>
      <div class="auth-btn google disabled">구글 로그인 준비 중</div>
    <% } %>

    <% if (providers.kakao) { %>
      <a href="/auth/kakao" class="auth-btn kakao">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path fill="currentColor" d="M12 3C6.48 3 2 6.48 2 10.8c0 2.82 1.86 5.28 4.62 6.6-.18.66-.66 2.46-.78 2.88 0 0-.03.24.12.33.15.09.33 0 .33 0 .42-.06 2.85-1.86 3.9-2.55.6.09 1.23.12 1.8.12 5.52 0 10-3.48 10-7.8S17.52 3 12 3z"/>
        </svg>
        <span>카카오로 계속하기</span>
      </a>
    <% } else { %>
      <div class="auth-btn kakao disabled">카카오 로그인 준비 중</div>
    <% } %>

    <div class="auth-note">
      로그인 시 <a href="#">이용약관</a> 및 <a href="#">개인정보처리방침</a>에 동의하는 것으로 간주됩니다.<br>
      저장되는 정보는 이메일·프로필 이름으로 한정됩니다.
    </div>

    <a href="/" class="auth-back">← 로그인 없이 둘러보기</a>
  </div>
</div>
