<%# 03 당 성향 격차 분포 — 데이터: x.gapDist (loader: gapdist)
     politician_cross_party_vote MV 를 읽는다. 의원 상세의 "N명 중 M위" 가 이 분포 위에서 나옴 %>
<% const gd = x.gapDist || { bins: [], total: 0 }; %>
<% if (gd.total > 0) { %>
  <p class="xr-desc" style="margin-bottom:20px">
    의원마다 <strong>자기 당이 낸 법안</strong>과 <strong>다른 당이 낸 법안</strong>에 찬성하는 비율이 다릅니다.
    그 차이(격차)가 클수록 발의한 정당에 따라 표결이 갈렸다는 뜻입니다.
  </p>
  <div class="xr-stats">
    <div class="xr-stat"><div class="v"><%= nf(gd.total) %></div><div class="l">집계 대상 의원 (자·타당 각 50표 이상)</div></div>
    <div class="xr-stat"><div class="v"><em><%= gd.median %></em><small style="font-size:16px">%p</small></div><div class="l">격차 중앙값 — 절반은 이보다 작습니다</div></div>
    <div class="xr-stat"><div class="v"><%= gd.neutralPct %>%</div><div class="l">격차 2%p 미만 — 발의 정당을 거의 안 가림 (<%= nf(gd.neutralCnt) %>명)</div></div>
    <div class="xr-stat"><div class="v"><%= gd.partisanPct %>%</div><div class="l">격차 10%p 이상 — 당 성향이 뚜렷 (<%= nf(gd.partisanCnt) %>명)</div></div>
  </div>
  <%
    const gMax = Math.max(1, ...gd.bins.map(b => b.cnt));
    const gW = 1000, gH = 240, gPadL = 40, gPadB = 30, gPadT = 18;
    const gbw = (gW - gPadL - 8) / gd.bins.length;
    const gx = (v) => gPadL + (v - (-2)) / 34 * (gbw * gd.bins.length); // -2 ~ 32 스케일
  %>
  <div class="xr-svg-box">
    <svg viewBox="0 0 <%= gW %> <%= gH %>" style="width:100%;height:auto">
      <% gd.bins.forEach((b, i) => {
           const bh = Math.round(b.cnt / gMax * (gH - gPadT - gPadB));
           const bx = gPadL + i * gbw;
           const by = gH - gPadB - bh; %>
        <rect x="<%= (bx + 1).toFixed(1) %>" y="<%= by %>" width="<%= (gbw - 2).toFixed(1) %>"
              height="<%= Math.max(bh, b.cnt > 0 ? 2 : 0) %>" rx="3"
              fill="#B8740C" opacity="<%= b.from >= 10 ? 1 : 0.45 %>">
          <title><%= b.from %>~<%= b.to %>%p · <%= nf(b.cnt) %>명</title>
        </rect>
        <% if (b.cnt === gMax) { %>
          <text x="<%= (bx + gbw / 2).toFixed(1) %>" y="<%= by - 5 %>" text-anchor="middle" font-size="11" font-family="JetBrains Mono" fill="#4B5362"><%= nf(b.cnt) %>명</text>
        <% } %>
      <% }) %>

      <!-- 중앙값 표시선 -->
      <line x1="<%= gx(gd.median).toFixed(1) %>" y1="<%= gPadT - 6 %>" x2="<%= gx(gd.median).toFixed(1) %>" y2="<%= gH - gPadB %>"
            stroke="#1A1D24" stroke-width="1.5" stroke-dasharray="4 3"/>
      <text x="<%= (gx(gd.median) + 6).toFixed(1) %>" y="<%= gPadT %>" font-size="11" font-family="JetBrains Mono" fill="#1A1D24">중앙값 <%= gd.median %>%p</text>

      <line x1="<%= gPadL %>" y1="<%= gH - gPadB %>" x2="<%= gW - 8 %>" y2="<%= gH - gPadB %>" stroke="#C9C5B6" stroke-width="1"/>
      <% [0, 5, 10, 15, 20, 25, 30].forEach(t => { %>
        <text x="<%= gx(t).toFixed(1) %>" y="<%= gH - 10 %>" text-anchor="middle" font-size="11" font-family="JetBrains Mono" fill="#7A8090"><%= t %></text>
      <% }) %>
      <text x="<%= gW - 8 %>" y="<%= gH - 10 %>" text-anchor="end" font-size="11" font-family="JetBrains Mono" fill="#7A8090">%p →</text>
    </svg>
  </div>
  <p class="xr-svg-hint">← 그래프를 옆으로 밀어서 볼 수 있습니다</p>

  <% if (gd.byParty && gd.byParty.length > 0) { %>
    <div class="xr-cols" style="grid-template-columns:1fr;margin-top:20px">
      <div>
        <div class="xr-col-h">정당별 평균 격차</div>
        <% const pMax = Math.max(0.1, ...gd.byParty.map(p => p.avgGap)); %>
        <% gd.byParty.forEach(p => { %>
          <div class="xr-hbar-row">
            <span class="lb"><%= p.party %></span>
            <span class="track"><span class="fill" style="width:<%= Math.max(2, p.avgGap / pMax * 100) %>%"></span></span>
            <span class="num"><b><%= p.avgGap %>%p</b> · <%= nf(p.cnt) %>명</span>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <div class="xr-note">
    집계: 불참 제외, 대표발의자 기준. 자당·타당 각 50표 이상인 의원만 (<%= nf(gd.total) %>명). 실측 범위 <%= gd.gapMin %> ~ <%= gd.gapMax %>%p, 사분위 <%= gd.q1 %> / <%= gd.median %> / <%= gd.q3 %>.
    <br>
    <strong>해석 주의</strong> — 정당별 평균 차이를 그대로 "어느 당이 더 당파적" 으로 읽으면 안 됩니다. 다수당은 자기 당 법안이 무난히 통과되는 의사일정 구조라 격차가 낮게 나오는 경향이 있습니다. 격차는 성향의 <em>한 단면</em>일 뿐입니다.
  </div>
<% } else { %>
  <div class="xr-empty">집계 가능한 표결 데이터가 부족합니다.</div>
<% } %>
