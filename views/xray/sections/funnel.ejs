<%# 05 생존율 깔때기 — 데이터: x.funnel + x.committeeRate (loader: funnel) %>
<% const fn = x.funnel; %>
<% if (fn && Number(fn.total) > 0) { %>
  <%
    const fnRows = [
      { label: '발의', v: Number(fn.total), sub: '' },
      { label: '처리 완료', v: Number(fn.processed), sub: '가결·부결·폐기·철회 포함' },
      { label: '가결', v: Number(fn.passed), sub: '원안+수정' }
    ];
  %>
  <% fnRows.forEach(r => { %>
    <div class="xr-hbar-row">
      <span class="lb"><%= r.label %></span>
      <span class="track"><span class="fill" style="width:<%= Math.max(1, Math.round(r.v / Number(fn.total) * 100)) %>%"></span></span>
      <span class="num"><b><%= nf(r.v) %>건</b> · <%= pct(r.v, Number(fn.total)) %>%</span>
    </div>
  <% }) %>
  <div class="xr-note" style="border-top:none;padding-top:8px;margin-top:4px">
    처리 완료 중 대안반영폐기 <%= nf(fn.alt_reflected) %>건. 폐기로 분류되지만 내용은 대안에 흡수된 "사실상 반영". 부결·폐기·철회는 <%= nf(fn.rejected) %>건.
  </div>
  <% const cr = x.committeeRate || []; %>
  <% if (cr.length >= 6) { %>
    <div class="xr-cols">
      <div>
        <div class="xr-col-h">처리율 높은 위원회 5곳</div>
        <% cr.slice(0, 5).forEach(c => { %>
          <div class="xr-hbar-row">
            <span class="lb" style="font-size:12px"><%= c.committee.replace('위원회', '') %></span>
            <span class="track" style="height:10px"><span class="fill" style="width:<%= pct(c.processed, c.total) %>%"></span></span>
            <span class="num" style="width:110px"><b><%= pct(c.processed, c.total) %>%</b> (<%= nf(c.total) %>건)</span>
          </div>
        <% }) %>
      </div>
      <div>
        <div class="xr-col-h">처리율 낮은 위원회 5곳</div>
        <% cr.slice(-5).reverse().forEach(c => { %>
          <div class="xr-hbar-row">
            <span class="lb" style="font-size:12px"><%= c.committee.replace('위원회', '') %></span>
            <span class="track" style="height:10px"><span class="fill" style="width:<%= Math.max(1, pct(c.processed, c.total)) %>%;opacity:0.5"></span></span>
            <span class="num" style="width:110px"><b><%= pct(c.processed, c.total) %>%</b> (<%= nf(c.total) %>건)</span>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
  <div class="xr-note">위원회 처리율은 접수 100건 이상 위원회만. 처리율이 낮다 = 법안이 계류 중이라는 뜻이며, 위원회 업무 태만과 동의어는 아닙니다 (상정 시기·법안 난이도 차이).</div>
<% } else { %>
  <div class="xr-empty">법안 데이터가 없습니다.</div>
<% } %>
