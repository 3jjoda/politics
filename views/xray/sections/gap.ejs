<%# 09 여론 괴리 — 데이터: x.citizenGap (loader: gap)
     bill_citizen_votes × bill_votes. 우리 서비스에서만 나오는 지표 %>
<% const gap = x.citizenGap || []; %>
<% if (gap.length > 0) { %>
  <% gap.forEach(g => {
       const cRate = pct(g.c_agree, g.c_agree + g.c_disagree);
       const aRate = pct(g.a_yes, g.a_yes + g.a_no); %>
    <a class="xr-gap-item" href="/bill/<%= g.bill_id %>">
      <div class="xr-gap-name"><%= g.bill_name %></div>
      <div class="xr-gap-bars">
        <div class="xr-gap-line">
          <span class="who">국민</span>
          <span class="track"><span class="fill citizen" style="width:<%= cRate %>%"></span></span>
          <span class="v">찬성 <%= cRate %>% (<%= nf(g.c_agree + g.c_disagree) %>표)</span>
        </div>
        <div class="xr-gap-line">
          <span class="who">본회의</span>
          <span class="track"><span class="fill assembly" style="width:<%= aRate %>%"></span></span>
          <span class="v">찬성 <%= aRate %>% (<%= nf(g.a_yes + g.a_no) %>표)</span>
        </div>
      </div>
    </a>
  <% }) %>
  <div class="xr-note">국민 투표 3표 이상 + 본회의 찬반 30인 이상인 법안만. 국민 표본은 아직 작아 대표성이 없습니다 — 참여가 쌓일수록 정확해지는 지표입니다.</div>
<% } else { %>
  <%# 🔴 이 지표는 이용자 참여로만 채워진다 — 데이터가 없다고 목록에서 감추지 말 것
      (감추면 데이터가 생겨도 수동으로 풀어야 하고, 그건 잊힌다).
      대신 빈 상태가 **"고장" 이 아니라 "아직"** 으로 읽히게 한다:
      ① 왜 비었는지 ② 무엇이 있어야 채워지는지 ③ 지금 할 수 있는 행동 %>
  <div class="xr-empty is-guide">
    <p style="margin:0 0 6px">아직 비교할 수 있는 법안이 없습니다. <strong>이 지표는 이용자 참여로 채워집니다.</strong></p>
    <p style="margin:0 0 12px; font-size:13px">
      한 법안에 <strong>국민 찬반 3표 이상</strong>이 모이고, 그 법안이 <strong>본회의 표결</strong>까지 가면
      국민 여론과 국회 표결을 나란히 놓고 볼 수 있습니다.
    </p>
    <a class="xr-empty-cta" href="/bill">법안 보러 가기 →</a>
  </div>
<% } %>
