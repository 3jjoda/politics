<%# 01 표결 합의 분포 — 데이터: x.consensus (loader: consensus) %>
<% const cs = x.consensus || { bins: [], total: 0 }; %>
<% if (cs.total > 0) { %>
  <div class="xr-stats">
    <div class="xr-stat"><div class="v"><%= nf(cs.total) %></div><div class="l">본회의 표결 법안 (표결 30인 이상)</div></div>
    <div class="xr-stat"><div class="v"><em><%= cs.nearUnanimousPct %>%</em></div><div class="l">찬성률 90% 이상 · 사실상 합의 처리</div></div>
    <div class="xr-stat"><div class="v"><%= cs.contestedPct %>%</div><div class="l">찬성률 70% 미만 · 실제로 맞붙은 표결</div></div>
  </div>
  <%
    const maxBin = Math.max(1, ...cs.bins.map(b => b.cnt));
    const hW = 1000, hH = 220, hPadL = 40, hPadB = 28, hPadT = 14;
    const bw = (hW - hPadL - 8) / 20;
  %>
  <div class="xr-svg-box">
    <svg viewBox="0 0 <%= hW %> <%= hH %>" style="width:100%;height:auto">
      <% cs.bins.forEach((b, i) => {
           const bh = Math.round(b.cnt / maxBin * (hH - hPadT - hPadB));
           const bx = hPadL + i * bw;
           const by = hH - hPadB - bh; %>
        <rect x="<%= (bx + 1).toFixed(1) %>" y="<%= by %>" width="<%= (bw - 2).toFixed(1) %>" height="<%= Math.max(bh, b.cnt > 0 ? 2 : 0) %>"
              rx="3" fill="#B8740C" opacity="<%= b.from >= 90 ? 1 : 0.45 %>">
          <title>찬성률 <%= b.from %>~<%= b.to %>% · <%= nf(b.cnt) %>건</title>
        </rect>
        <% if (b.cnt === maxBin) { %>
          <text x="<%= (bx + bw / 2).toFixed(1) %>" y="<%= by - 5 %>" text-anchor="middle" font-size="11" font-family="JetBrains Mono" fill="#4B5362"><%= nf(b.cnt) %></text>
        <% } %>
      <% }) %>
      <line x1="<%= hPadL %>" y1="<%= hH - hPadB %>" x2="<%= hW - 8 %>" y2="<%= hH - hPadB %>" stroke="#C9C5B6" stroke-width="1"/>
      <% [0, 25, 50, 75, 100].forEach(t => { %>
        <text x="<%= (hPadL + t / 100 * (bw * 20)).toFixed(1) %>" y="<%= hH - 8 %>" text-anchor="middle" font-size="11" font-family="JetBrains Mono" fill="#7A8090"><%= t %>%</text>
      <% }) %>
    </svg>
  </div>
  <p class="xr-svg-hint">← 그래프를 옆으로 밀어서 볼 수 있습니다</p>
  <div class="xr-note">집계: 법안별 찬성 ÷ (찬성+반대), 기권·불참 제외. 짙은 막대 = 찬성률 90% 이상 구간. 가결·부결 모두 포함.</div>
<% } else { %>
  <div class="xr-empty">표결 데이터가 아직 수집되지 않았습니다.</div>
<% } %>
