<%# 08 본회의 참여 — 데이터: x.absentRank (loader: absent) %>
<% const ab = x.absentRank || []; const as = x.absentStats; %>
<% if (ab.length > 0) { %>
  <%# 🔴 순위표만 두면 "1위 83%" 를 보고 국회 전체가 그런 줄 알게 된다. 중앙값을 먼저 놓는다.
      ⚠️ "대부분은 잘 나온다" 로 쓰지 말 것 — 실측 중앙값이 20.7% 다 (5번 중 1번은 빠진다).
         데이터를 확인하기 전에 그렇게 적을 뻔했다 %>
  <% if (as) { %>
    <p class="xr-desc" style="margin-bottom:16px">
      본회의 표결에서 불참으로 기록된 비율입니다. 의원 <strong><%= nf(as.total) %>명</strong>의
      중앙값이 <strong><%= as.median_pct %>%</strong> — 대략 <strong>다섯 번 중 한 번</strong>은 표결에 빠집니다.
      아래는 그중 비율이 높은 15명입니다.
    </p>
    <div class="xr-stats" style="margin-bottom:20px">
      <div class="xr-stat"><div class="v"><%= as.median_pct %>%</div><div class="l">불참률 중앙값 — 절반은 이보다 낮습니다</div></div>
      <div class="xr-stat"><div class="v"><%= nf(as.low_cnt) %><small style="font-size:16px">명</small></div><div class="l">불참 10% 미만 — 거의 빠지지 않음</div></div>
      <div class="xr-stat"><div class="v"><em><%= nf(as.high_cnt) %></em><small style="font-size:16px">명</small></div><div class="l">불참 40% 이상 — 사유는 구분되지 않습니다</div></div>
    </div>
  <% } %>
  <% const abMax = Math.max(0.001, ...ab.map(r => r.absent_cnt / r.total_cnt)); %>
  <div class="xr-rank">
    <% ab.forEach((r, i) => { %>
      <a class="xr-row" href="/politician/<%= r.mona_cd %>">
        <span class="idx"><%= i + 1 %></span>
        <span class="ava"><%- avatarHtml(r.name, r.photo_url, 28) %></span>
        <span class="who"><span class="nm"><%= r.name %></span><br><span class="pt"><%= r.party_name || '무소속' %></span></span>
        <span class="barwrap"><span class="bar" style="width:<%= Math.round((r.absent_cnt / r.total_cnt) / abMax * 100) %>%"></span></span>
        <span class="val"><b><%= pct(r.absent_cnt, r.total_cnt) %>%</b> · <%= nf(r.total_cnt) %>회 중 <%= nf(r.absent_cnt) %>회</span>
      </a>
    <% }) %>
  </div>
  <div class="xr-note">표결 기록 100회 이상 현직 의원만. 불참 사유(공무 출장·사보임·청가 등)는 API가 제공하지 않아 구분하지 못합니다 — 높은 수치가 곧 태만을 뜻하지는 않습니다.</div>
<% } else { %>
  <div class="xr-empty">표결 데이터가 부족합니다.</div>
<% } %>
