<%#
  숫자로 본 국회 — 접힌 목록 페이지.
  ⚠️ 표시명은 "숫자로 본 국회"(구 "국회 X레이")지만 내부 식별자는 xray / .xr-* / URL /xray 를 그대로 쓴다.
     `.pb-*` 와 같은 판단 — 사용자에게 안 보이는 식별자를 223곳 치환하는 건 회귀 위험만 크다.

  이 페이지는 DB 를 한 번도 조회하지 않는다. 섹션 정의는 services/xraySections.js 가 단일 소스이고,
  사용자가 펼친 섹션만 GET /xray/s/:id 로 HTML 조각을 받아온다.

  섹션 추가 방법: xraySections.js 에 한 줄 + views/xray/sections/<id>.ejs + XrayService 의 로더 한 개.
  이 파일은 손댈 필요 없다.
%>

<style>
  .xr-wrap { max-width: 1080px; margin: 0 auto; padding: 36px 24px 80px; }

  /* 그룹 헤딩 */
  .xr-group { margin-bottom: 34px; }
  .xr-group-head { margin-bottom: 12px; padding-left: 2px; }
  .xr-group-label {
    font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 15px;
    color: var(--text); display: inline; margin: 0;
  }
  .xr-group-label::before {
    content: ''; display: inline-block; width: 3px; height: 14px; border-radius: 2px;
    background: var(--accent); margin-right: 8px; vertical-align: -2px;
  }
  .xr-group-desc { display: inline; font-size: 12px; color: var(--sub2); margin-left: 8px; }

  /* 2열 그리드 — 펼친 항목만 전체폭으로 확장.
     차트가 1000px 폭 SVG 라 열릴 땐 전체폭이 필요하고, 접힌 상태는 밀도가 중요하다. */
  /* align-items 기본값(stretch) — 같은 행 카드 높이를 맞춰 들쭉날쭉하지 않게.
     열이 많을수록 행 수가 줄어 접힌 목록이 짧아진다 (그룹 헤딩이 자리를 먹는 걸 상쇄) */
  /* 커스텀 차트 진입 — page-header 우측 액션 자리 (커뮤니티 글쓰기 버튼과 같은 패턴) */
  .xr-make {
    display: flex; flex-direction: column; gap: 2px;
    padding: 12px 18px; border: 1px solid var(--accent); border-radius: 10px;
    background: #FBF5EA; text-decoration: none; white-space: nowrap;
    transition: background 0.15s;
  }
  .xr-make:hover { background: #F6EBD8; }
  .xr-make-t { font-size: 14px; font-weight: 700; color: #8F5800; }
  .xr-make-s { font-size: 11.5px; color: var(--sub); }
  @media (max-width: 768px) { .xr-make { white-space: normal; } }

  .xr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  @media (max-width: 1100px) { .xr-grid { grid-template-columns: repeat(2, 1fr); } }

  .xr-item {
    background: var(--bg2); border: 1px solid var(--border); border-radius: 16px;
    overflow: hidden;
    scroll-margin-top: calc(var(--nav-h) + 24px);
    transition: border-color 0.15s;
  }
  .xr-item:hover { border-color: var(--border2); }
  .xr-item[data-open="true"] { grid-column: 1 / -1; border-color: var(--accent); }

  .xr-toggle {
    width: 100%; display: flex; align-items: flex-start; gap: 12px;
    padding: 18px 20px; background: none; border: 0; cursor: pointer;
    text-align: left; font: inherit; color: inherit;
  }
  .xr-toggle:hover { background: var(--bg3); }
  .xr-toggle .no {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.18em;
    color: var(--accent); flex-shrink: 0; padding-top: 4px;
  }
  .xr-toggle .tx { flex: 1; min-width: 0; }
  .xr-toggle .ttl {
    font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 18px;
    color: var(--text); margin: 0 0 5px; line-height: 1.3; word-break: keep-all;
  }
  /* 접힌 카드는 2행까지만 — 카드 높이를 고르게 유지 */
  .xr-toggle .dsc {
    font-size: 12.5px; color: var(--sub); line-height: 1.6; word-break: keep-all;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .xr-item[data-open="true"] .xr-toggle .dsc { -webkit-line-clamp: unset; overflow: visible; }
  .xr-caret {
    flex-shrink: 0; width: 20px; height: 20px; color: var(--sub2);
    transition: transform 0.25s ease; margin-top: 4px;
  }
  .xr-item[data-open="true"] .xr-caret { transform: rotate(180deg); color: var(--accent); }

  .xr-body { padding: 0 24px 24px; }
  .xr-body[hidden] { display: none; }
  .xr-loading { padding: 32px 0; display: flex; justify-content: center; }

  /* 전체 펼침/접기 */
  .xr-bulk { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 14px; }
  .xr-bulk button {
    padding: 6px 14px; border: 1px solid var(--border2); border-radius: 999px;
    background: var(--bg2); color: var(--sub); font-size: 12px; cursor: pointer;
  }
  .xr-bulk button:hover { border-color: var(--accent); color: var(--accent); }

  /* ↓ 아래는 섹션 조각(views/xray/sections/*.ejs)이 쓰는 공용 스타일 ↓ */
  .xr-desc { font-size: 14px; color: var(--sub); line-height: 1.7; max-width: 720px; }
  .xr-note { margin-top: 16px; font-size: 12px; color: var(--sub2); line-height: 1.7; border-top: 1px dashed var(--border); padding-top: 12px; }
  .xr-empty { padding: 40px 24px; text-align: center; color: var(--sub2); font-style: italic; }
  /* 안내형 빈 상태 — "고장" 이 아니라 "아직" 으로 읽혀야 하는 지표용 (이용자 참여로 채워지는 것).
     기본 .xr-empty 의 이탤릭·흐린 회색은 한 줄짜리 문구용이라 여러 줄 + CTA 에는 안 맞는다 */
  .xr-empty.is-guide { font-style: normal; color: var(--sub); padding: 32px 24px; }
  .xr-empty-cta {
    display: inline-block; font-weight: 700; font-size: 13.5px;
    color: var(--accent2);              /* 11~14px 소형 텍스트라 --accent(3.79) 대신 --accent2(5.59) */
    text-decoration: none; border-bottom: 1.5px solid currentColor; padding-bottom: 2px;
  }
  .xr-empty-cta:hover { color: #6E4400; }

  /* 스탯 타일 */
  .xr-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 24px; }
  .xr-stat { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 16px 18px; }
  .xr-stat .v { font-family: 'Bebas Neue', sans-serif; font-size: 36px; line-height: 1; color: var(--text); }
  .xr-stat .v em { font-style: normal; color: var(--accent); }
  .xr-stat .l { font-size: 12px; color: var(--sub); margin-top: 6px; line-height: 1.5; }

  /* 랭킹 행 (공용) */
  .xr-rank { display: flex; flex-direction: column; }
  .xr-row {
    display: flex; align-items: center; gap: 12px;
    padding: 9px 4px; text-decoration: none; border-bottom: 1px solid var(--border);
  }
  .xr-row:last-child { border-bottom: none; }
  .xr-row:hover { background: var(--bg3); }
  .xr-row .idx { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--sub2); width: 20px; text-align: right; flex-shrink: 0; }
  .xr-row .ava { width: 28px; height: 28px; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
  .xr-row .who { width: 150px; flex-shrink: 0; }
  .xr-row .who .nm { font-size: 13px; font-weight: 700; color: var(--text); }
  .xr-row .who .pt { font-size: 11px; color: var(--sub2); }
  .xr-row .barwrap { display: block; flex: 1; height: 8px; background: var(--bg3); border-radius: 4px; overflow: hidden; }
  .xr-row .bar { display: block; height: 100%; background: var(--accent); border-radius: 4px; }
  .xr-row .val { width: 120px; text-align: right; font-size: 12px; color: var(--sub); flex-shrink: 0; }
  .xr-row .val b { color: var(--text); font-size: 13px; }

  /* 가로 막대 (깔때기·카테고리 공용) */
  .xr-hbar-row { display: flex; align-items: center; gap: 12px; padding: 6px 0; }
  .xr-hbar-row .lb { width: 120px; font-size: 13px; color: var(--sub); text-align: right; flex-shrink: 0; }
  .xr-hbar-row .track { display: block; flex: 1; height: 18px; background: var(--bg3); border-radius: 4px; overflow: hidden; }
  .xr-hbar-row .fill { display: block; height: 100%; background: var(--accent); border-radius: 4px; }
  .xr-hbar-row .num { width: 150px; font-size: 12px; color: var(--sub); flex-shrink: 0; }
  .xr-hbar-row .num b { color: var(--text); }

  /* 위원회 2열 */
  .xr-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 20px; }
  .xr-col-h { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
  @media (max-width: 768px) { .xr-cols { grid-template-columns: 1fr; } }

  /* 국민 vs 국회 */
  .xr-gap-item { padding: 12px 4px; border-bottom: 1px solid var(--border); text-decoration: none; display: block; }
  .xr-gap-item:last-child { border-bottom: none; }
  .xr-gap-item:hover { background: var(--bg3); }
  .xr-gap-name { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
  .xr-gap-bars { display: flex; flex-direction: column; gap: 4px; }
  .xr-gap-line { display: flex; align-items: center; gap: 10px; }
  .xr-gap-line .who { width: 46px; font-size: 11px; color: var(--sub2); flex-shrink: 0; }
  .xr-gap-line .track { display: block; flex: 1; height: 8px; background: var(--bg3); border-radius: 4px; overflow: hidden; }
  .xr-gap-line .fill { display: block; height: 100%; border-radius: 4px; }
  .xr-gap-line .fill.citizen { background: var(--accent); }
  .xr-gap-line .fill.assembly { background: var(--text); }
  .xr-gap-line .v { width: 90px; font-size: 11px; color: var(--sub); flex-shrink: 0; }

  /* 스펙트럼 */
  .xr-axis-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .xr-axis-chip {
    padding: 7px 14px; border: 1px solid var(--border2); border-radius: 999px;
    background: var(--bg2); color: var(--sub); font-size: 13px; cursor: pointer; transition: all 0.15s;
  }
  .xr-axis-chip.active { background: var(--text); border-color: var(--text); color: #fff; }
  .xr-strip-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .xr-strip-row:last-child { border-bottom: none; }
  .xr-strip-row .party { width: 130px; font-size: 13px; font-weight: 700; color: var(--text); text-align: right; flex-shrink: 0; }
  .xr-strip-row .party small { display: block; font-weight: 400; font-size: 11px; color: var(--sub2); }
  .xr-strip { flex: 1; position: relative; height: 28px; }
  .xr-strip .mid { position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--border2); }
  .xr-strip .dot {
    position: absolute; top: 50%; width: 8px; height: 8px; border-radius: 50%;
    background: rgba(184, 116, 12, 0.35); transform: translate(-50%, -50%);
  }
  .xr-strip .avg {
    position: absolute; top: 3px; bottom: 3px; width: 2px; border-radius: 1px;
    background: var(--text); transform: translateX(-50%);
  }
  .xr-strip-ends { display: flex; justify-content: space-between; font-size: 11px; color: var(--sub2); margin-top: 6px; padding-left: 142px; }

  .xr-svg-box { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 16px; overflow: hidden; }
  /* 가로 스크롤 안내 — 모바일에서만 켜진다 (아래 미디어 쿼리) */
  .xr-svg-hint { display: none; }

  @media (max-width: 768px) {
    /* 🔴 모바일에서 차트 글자가 2.6~2.8px 이던 문제 (2026-08-15).
       전 차트가 viewBox 1000 유저단위에 font-size 10~13 을 쓰는데, 화면 폭이 259px 이면
       0.26 배로 눌려 **아무것도 읽을 수 없었다.** 6개 SVG 섹션 전부 같은 증상이었다.
       → 축소를 막고(min-width) 박스 안에서 가로 스크롤시킨다. 문서 스크롤이 아니라
         박스 내부라 페이지 레이아웃은 그대로다 (`.status-tabs-inner` 와 같은 수법).
       ⚠️ `overflow: hidden` 을 되돌리지 말 것 — 그러면 스크롤이 막혀 오른쪽이 잘린다.
       ⚠️ 860px 은 "font-size 11 → 화면 9.5px" 이 되는 하한이다. 더 줄이면 다시 안 읽힌다.
          근본 해결은 차트를 세로형으로 다시 그리는 것이지만 그건 섹션별 재설계다 */
    .xr-svg-box {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
    }
    .xr-svg-box > svg { min-width: 860px; }
    /* 스크롤된다는 걸 알려준다 — 안 알리면 오른쪽 절반이 없는 것처럼 보인다 */
    .xr-svg-hint {
      display: block; font-size: 11.5px; color: var(--sub2); margin-top: 6px;
    }

    .xr-grid { grid-template-columns: 1fr; }   /* 모바일은 1열 */
    /* 1열이라 세로가 길어진다 — 접힌 카드 설명은 1행까지만
       (펼친 카드는 위쪽 [data-open] 규칙이 우선순위로 이겨서 전문 노출) */
    .xr-toggle .dsc { -webkit-line-clamp: 1; }
    .xr-toggle { padding: 16px; gap: 12px; }
    .xr-toggle .ttl { font-size: 17px; }
    .xr-body { padding: 0 16px 20px; }
    .xr-row .who { width: 104px; }
    .xr-row .val { width: 92px; }
    .xr-hbar-row .lb { width: 84px; font-size: 12px; }
    .xr-hbar-row .num { width: 100px; }
    .xr-strip-row .party { width: 88px; }
    .xr-strip-ends { padding-left: 100px; }
  }
</style>

<!-- 페이지 헤더 -->
<div class="pb-page-header">
  <div class="pb-page-header-inner">
    <div>
      <h1 class="pb-page-title">숫자로 본 국회</h1>
      <p class="pb-page-desc">뉴스에 나오지 않는 국회의 구조를 공식 데이터 집계로 보여줍니다. 해석은 당신의 몫입니다.</p>
    </div>
    <%# 커스텀 차트 진입점. 아래 12개는 손으로 고른 "기본 지표(샘플)" 이고,
        여기 들어가면 같은 데이터를 사용자가 직접 조합한다. 한 메뉴 안의 두 영역. %>
    <a class="xr-make" href="/xray/chart">
      <span class="xr-make-t">직접 만들어보기</span>
      <span class="xr-make-s">축과 지표를 골라 나만의 차트 →</span>
    </a>
  </div>
</div>

<div class="xr-wrap">

  <div class="xr-bulk">
    <button type="button" id="xr-expand-all">전체 펼치기</button>
    <button type="button" id="xr-collapse-all">전체 접기</button>
  </div>

  <div id="xr-list">
    <% groups.forEach(g => { %>
      <section class="xr-group">
        <div class="xr-group-head">
          <h2 class="xr-group-label"><%= g.label %></h2>
          <span class="xr-group-desc"><%= g.desc %></span>
        </div>
        <div class="xr-grid">
          <% g.sections.forEach(s => { %>
            <section class="xr-item" id="xr-<%= s.id %>" data-section="<%= s.id %>" data-open="false">
              <button type="button" class="xr-toggle" aria-expanded="false" aria-controls="xr-body-<%= s.id %>">
                <span class="no"><%= s.no %></span>
                <%# 🔴 kicker(제목 앞 작은 분류 라벨)는 2026-08-15 제거.
                    제목 앞의 요약이 시선을 나눠서, 제목이 혼자 무슨 차트인지 말하게 했다. 되살리지 말 것 %>
                <span class="tx">
                  <span class="ttl"><%= s.title %></span>
                  <span class="dsc"><%= s.desc %></span>
                </span>
                <svg class="xr-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </button>
              <div class="xr-body" id="xr-body-<%= s.id %>" hidden></div>
            </section>
          <% }) %>
        </div>
      </section>
    <% }) %>
  </div>

  <p style="font-size:12px;color:var(--sub2);line-height:1.8;margin-top:24px">
    모든 지표는 열린국회정보 공공 API 원자료를 당말사가 집계한 것입니다. 지표는 구조를 보여줄 뿐, 좋은 의원·나쁜 의원의 순위가 아닙니다.
    집계 방식에 대한 의견은 <a href="/community" style="color:var(--accent)">커뮤니티</a>로 보내주세요.
  </p>
</div>

<script>
(function () {
  var list = document.getElementById('xr-list');
  if (!list) return;

  /* innerHTML 로 삽입한 <script> 는 실행되지 않는다.
     동일 내용으로 새 script 엘리먼트를 만들어 교체해야 실행된다.
     (스펙트럼 섹션이 축 전환 로직을 인라인 script 로 갖고 있음) */
  function runScripts(container) {
    container.querySelectorAll('script').forEach(function (old) {
      var s = document.createElement('script');
      for (var i = 0; i < old.attributes.length; i++) {
        s.setAttribute(old.attributes[i].name, old.attributes[i].value);
      }
      s.textContent = old.textContent;
      old.parentNode.replaceChild(s, old);
    });
  }

  function spinnerHtml() {
    if (window.PB && typeof PB.spinner === 'function') {
      return '<div class="xr-loading">' + PB.spinner({ size: 32, label: '집계 불러오는 중…' }) + '</div>';
    }
    return '<div class="xr-loading" style="color:var(--sub2);font-size:13px">집계 불러오는 중…</div>';
  }

  function load(item) {
    var id = item.dataset.section;
    var body = item.querySelector('.xr-body');
    if (item.dataset.loaded === 'true' || item.dataset.loading === 'true') return Promise.resolve();

    item.dataset.loading = 'true';
    body.innerHTML = spinnerHtml();

    return fetch('/xray/s/' + encodeURIComponent(id), { headers: { 'Accept': 'text/html' } })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        body.innerHTML = html;
        runScripts(body);
        item.dataset.loaded = 'true';
      })
      .catch(function () {
        body.innerHTML = '<div class="xr-empty">불러오지 못했습니다. 잠시 후 다시 시도해 주세요.</div>';
      })
      .finally(function () { item.dataset.loading = 'false'; });
  }

  function open(item, opts) {
    var body = item.querySelector('.xr-body');
    var btn = item.querySelector('.xr-toggle');
    item.dataset.open = 'true';
    btn.setAttribute('aria-expanded', 'true');
    body.hidden = false;
    var p = load(item);
    if (opts && opts.scroll) {
      p.then(function () { item.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    }
    return p;
  }

  function close(item) {
    var body = item.querySelector('.xr-body');
    var btn = item.querySelector('.xr-toggle');
    item.dataset.open = 'false';
    btn.setAttribute('aria-expanded', 'false');
    body.hidden = true;   /* 내용은 남겨둔다 — 다시 펼칠 때 재요청 안 함 */
  }

  list.addEventListener('click', function (e) {
    var btn = e.target.closest('.xr-toggle');
    if (!btn) return;
    var item = btn.closest('.xr-item');
    if (item.dataset.open === 'true') {
      close(item);
      if (location.hash === '#xr-' + item.dataset.section) {
        history.replaceState(null, '', location.pathname);
      }
    } else {
      open(item);
      history.replaceState(null, '', location.pathname + '#xr-' + item.dataset.section);
    }
  });

  document.getElementById('xr-expand-all').addEventListener('click', function () {
    list.querySelectorAll('.xr-item').forEach(function (it) { open(it); });
  });
  document.getElementById('xr-collapse-all').addEventListener('click', function () {
    list.querySelectorAll('.xr-item').forEach(close);
    history.replaceState(null, '', location.pathname);
  });

  /* /xray#xr-dissent 로 들어오면 해당 섹션 자동 펼침 — 링크 공유 가능 */
  function openFromHash() {
    var m = (location.hash || '').match(/^#xr-([\w-]+)$/);
    if (!m) return false;
    var item = list.querySelector('.xr-item[data-section="' + m[1] + '"]');
    if (!item) return false;
    open(item, { scroll: true });
    return true;
  }

  /* 기본은 전부 접힌 상태 — 해시로 들어온 경우에만 그 섹션을 펼친다.
     자동 펼침을 두지 않으므로 페이지 진입 시 DB 조회가 정말로 0회다. */
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
})();
</script>
