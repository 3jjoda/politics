<%
  // 관리자 SNS 콘텐츠 허브 — 매일·주간 루틴에서 쓰는 도구를 한 화면에서 (2026-08-26)
  // 🔴 전략·루틴의 원문은 SNS.md 다. 여기의 요일 표는 그 요약 — 어긋나면 SNS.md 가 맞다.
%>
<style>
  .ad-wrap { max-width: 1100px; margin: 0 auto; padding: calc(var(--nav-h) + 28px) 24px 80px; }
  .ad-head h1 { font-size: 26px; font-weight: 800; margin: 0 0 8px; }
  .ad-desc { font-size: 13.5px; color: var(--sub); line-height: 1.7; margin: 0 0 26px; word-break: keep-all; }
  .ad-desc strong { color: var(--text); }
  .sns-h { font-size: 16px; font-weight: 700; margin: 30px 0 12px; }
  .sns-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .sns-card { background: var(--bg2); border: 1px solid var(--border); border-top: 3px solid var(--accent);
              border-radius: 10px; padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .sns-card h3 { margin: 0; font-size: 15px; font-weight: 800; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sns-when { font-size: 11px; font-weight: 700; color: var(--accent2); border: 1px solid var(--accent);
              border-radius: 5px; padding: 2px 7px; background: #FAF6EB; }
  .sns-card p { margin: 0; font-size: 13px; color: var(--sub); line-height: 1.65; word-break: keep-all; }
  .sns-links { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
  .sns-links a { font-size: 12.5px; font-weight: 700; color: var(--accent2); text-decoration: none;
                 border: 1px solid var(--accent); border-radius: 7px; padding: 6px 12px; }
  .sns-links a:hover { background: #FAF6EB; }
  .sns-links a.plain { color: var(--sub); border-color: var(--border2); font-weight: 500; }

  .bf-table { width: 100%; border-collapse: collapse; background: var(--bg2); border: 1px solid var(--border);
              border-radius: 10px; overflow: hidden; font-size: 13px; }
  .bf-table th { text-align: left; font-size: 11.5px; color: var(--sub2); padding: 9px 14px;
                 border-bottom: 1px solid var(--border); font-weight: 700; }
  .bf-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .bf-table tr:last-child td { border-bottom: none; }
  .bf-hl { max-width: 420px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bf-skip { font-size: 11.5px; color: var(--sub2); border: 1px dashed var(--border2); border-radius: 5px; padding: 2px 7px; }
  .bf-a { color: var(--accent2); font-weight: 700; text-decoration: none; margin-right: 10px; white-space: nowrap; }

  .wk-table { width: 100%; border-collapse: collapse; background: var(--bg2); border: 1px solid var(--border);
              border-radius: 10px; overflow: hidden; font-size: 13px; }
  .wk-table th { text-align: left; font-size: 11.5px; color: var(--sub2); padding: 9px 14px; border-bottom: 1px solid var(--border); }
  .wk-table td { padding: 9px 14px; border-bottom: 1px solid var(--border); color: var(--sub); word-break: keep-all; }
  .wk-table tr:last-child td { border-bottom: none; }
  .wk-table b { color: var(--text); }
  .sns-note { font-size: 12.5px; color: var(--sub2); line-height: 1.7; margin-top: 10px; word-break: keep-all; }
  .tblwrap { overflow-x: auto; border-radius: 10px; }

  .ad-msg { padding: 11px 15px; border-radius: 9px; font-size: 13.5px; margin: 0 0 16px; }
  .ad-msg.is-ok  { background: #EAF6F0; border: 1px solid #B9E0CD; color: #0B6B4B; }
  .ad-msg.is-err { background: #FBEDED; border: 1px solid #E7C3C3; color: #A32B2B; }
  .lg-form { background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px;
             display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin-bottom: 14px; }
  .lg-f { display: flex; flex-direction: column; gap: 4px; }
  .lg-f label { font-size: 11px; color: var(--sub2); font-weight: 700; }
  .lg-f input, .lg-f select { font: inherit; font-size: 13px; padding: 7px 9px; border: 1px solid var(--border2);
                              border-radius: 7px; background: var(--bg2); color: var(--text); }
  .lg-f input[type="number"] { width: 72px; }
  .lg-f input[name="format"] { width: 190px; }
  .lg-f input[name="note"] { width: 220px; }
  .lg-btn { background: var(--accent); color: #fff; border: 0; border-radius: 8px; font-weight: 800;
            font-size: 13px; padding: 9px 16px; cursor: pointer; font-family: inherit; }
  .lg-table { width: 100%; border-collapse: collapse; background: var(--bg2); border: 1px solid var(--border);
              border-radius: 10px; overflow: hidden; font-size: 12.5px; }
  .lg-table th { text-align: left; font-size: 11px; color: var(--sub2); padding: 8px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .lg-table td { padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .lg-table tr:last-child td { border-bottom: none; }
  .lg-table input { font: inherit; font-size: 12.5px; padding: 4px 6px; border: 1px solid var(--border2);
                    border-radius: 6px; background: var(--bg2); color: var(--text); }
  .lg-table input[type="number"] { width: 58px; }
  .lg-table input[name="note"] { width: 170px; }
  .lg-save { background: transparent; color: var(--accent2); border: 1px solid var(--accent); border-radius: 6px;
             font-weight: 700; font-size: 11.5px; padding: 4px 10px; cursor: pointer; font-family: inherit; }
  .lg-del { background: transparent; color: var(--sub2); border: 1px solid var(--border2); border-radius: 6px;
            font-size: 11.5px; padding: 4px 8px; cursor: pointer; font-family: inherit; }
  .lg-chip { font-size: 11px; font-weight: 700; color: var(--accent2); border: 1px solid var(--accent);
             border-radius: 5px; padding: 2px 7px; background: #FAF6EB; white-space: nowrap; }
  .lg-chip.q { color: var(--sub); border-color: var(--border2); background: transparent; }
  .lg-empty { color: var(--sub2); }
</style>

<div class="ad-wrap">
  <div class="ad-head"><h1>SNS 콘텐츠</h1></div>
  <p class="ad-desc">
    매일·주간 루틴에서 쓰는 도구를 모았습니다. 전략·루틴의 원문은 저장소의 <strong>SNS.md</strong>.
    캐러셀의 숫자는 전부 <strong>여는 순간의 DB 값</strong>이라 게시 직전에 페이지를 새로 열면 됩니다.<br>
    <strong>브리핑은 오전, 주간 슬롯은 점심</strong> — 인스타·쓰레드가 같은 리듬을 씁니다 (아래 표).
  </p>

  <div class="sns-h">캐러셀 · 문안 도구</div>
  <div class="sns-grid">
    <div class="sns-card">
      <h3>브랜드 소개 캐러셀 <span class="sns-when">1주차 · 필요할 때</span></h3>
      <p>당말사가 뭐 하는 곳인지 6장. 훅 → 정체 → 기능 → 하지 않는 것 → 한계 → 마무리.</p>
      <div class="sns-links"><a href="/promo/intro">열기 · PNG 저장</a></div>
    </div>
    <div class="sns-card">
      <h3>숫자 캐러셀 <span class="sns-when">월요일 점심</span></h3>
      <p>계류 · 반대표 · 불참 3시리즈. 시리즈 하나 골라 PNG 전부 저장 → 인스타 캐러셀 + 캡션 복사.</p>
      <div class="sns-links">
        <a href="/promo/numbers?series=pending">계류</a>
        <a href="/promo/numbers?series=oppose">반대표</a>
        <a href="/promo/numbers?series=absent">불참</a>
      </div>
    </div>
    <div class="sns-card">
      <h3>진단 캐러셀 <span class="sns-when">수 · 목 중 하루</span></h3>
      <p>성향 진단 홍보 6장. 익명 점구름 지도 + 마스킹 목업 결과. 의원 수·문항 수는 DB 값.</p>
      <div class="sns-links"><a href="/promo/balance">열기 · PNG 저장</a></div>
    </div>
    <div class="sns-card">
      <h3>쓰레드 문안 뱅크 <span class="sns-when">월 · 화 · 수/목</span></h3>
      <p>대화형 포스트 10개 + <b>대화 답글 화법 7종</b> + <b>쟁점 문안 6종</b>. 첫 포스트에 링크 금지 — 본문을 올린 뒤 <b>곧바로 내가 답글을 달아</b> 거기에 링크를 둡니다 (남의 댓글을 기다리지 않습니다).</p>
      <div class="sns-links"><a href="/promo/threads">열기 · 복사</a></div>
    </div>
  </div>

  <div class="sns-h">매일 · 브리핑 카드 &amp; 쓰레드 체인</div>
  <div class="tblwrap"><table class="bf-table">
    <tr><th>날짜</th><th>헤드라인</th><th></th></tr>
    <% briefings.forEach((b) => { %>
      <tr>
        <td style="white-space:nowrap"><%= b.date %></td>
        <td class="bf-hl"><%= b.headline || '(활동 없음)' %></td>
        <td style="white-space:nowrap">
          <% if (b.publishable) { %>
            <a class="bf-a" href="/briefing/<%= b.id %>/card">인스타 카드</a>
            <a class="bf-a" href="/briefing/<%= b.id %>/threads?mode=short">쓰레드 체인</a>
            <%# 원클릭 성과표 기록 — 올린 직후 누른다. 게시일은 누른 날(오늘)이다 (브리핑 날짜가 아니라 — 보통 다음 날 아침에 올리니까) %>
            <form method="post" action="/admin/sns/log" style="display:inline">
              <input type="hidden" name="postedOn" value="<%= todayKst %>">
              <input type="hidden" name="slot" value="아침">
              <input type="hidden" name="channel" value="인스타">
              <input type="hidden" name="axis" value="오늘">
              <input type="hidden" name="format" value="브리핑 캐러셀 (<%= b.date.slice(5) %>)">
              <button type="submit" class="lg-save" title="성과표에 오늘 날짜로 기록">+기록 인스타</button>
            </form>
            <form method="post" action="/admin/sns/log" style="display:inline">
              <input type="hidden" name="postedOn" value="<%= todayKst %>">
              <input type="hidden" name="slot" value="아침">
              <input type="hidden" name="channel" value="쓰레드">
              <input type="hidden" name="axis" value="오늘">
              <input type="hidden" name="format" value="브리핑 체인 (<%= b.date.slice(5) %>)">
              <button type="submit" class="lg-save" title="성과표에 오늘 날짜로 기록">+기록 쓰레드</button>
            </form>
          <% } else { %>
            <span class="bf-skip">폴백·활동 없음 — 올리지 않는 카드</span>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </table></div>
  <p class="sns-note">
    쇼츠 · 릴스 영상은 <strong>보류 중</strong>입니다 (완성도 검토 — 2026-08-26). 사람 퀴즈는 맥에서 매일 08:00
    <code>out/video/daily/</code> 에 계속 생성되니, 재개할 때 잘 나온 편을 골라 올리면 됩니다. 브리핑 쇼츠는 <code>npm run video</code>.
  </p>

  <div class="sns-h" id="sns-log">성과표 · 기록</div>
  <% if (flash) { %><div class="ad-msg is-ok"><%= flash %></div><% } %>
  <% if (error) { %><div class="ad-msg is-err"><%= error %></div><% } %>
  <p class="sns-note" style="margin:0 0 10px">
    게시하면 바로 한 줄 적습니다 (지표는 비워두고). 브리핑은 위 표의 <b>+기록</b> 버튼이 오늘 날짜·아침으로 자동 입력합니다. <b>저장·도달·답글은 금요일에</b> 행의 칸을 채우고 <b>채우기</b>를 누르면 됩니다.
    팔로워 수는 적지 않습니다 — 보는 건 저장 · 답글 · 진단 시작 셋뿐.
  </p>
  <form class="lg-form" method="post" action="/admin/sns/log">
    <div class="lg-f"><label>게시일</label><input type="date" name="postedOn" value="<%= todayKst %>" required></div>
    <div class="lg-f"><label>시각</label><select name="slot"><option value="아침">아침</option><option value="점심" selected>점심</option><option value="저녁">저녁</option><option value="">모름</option></select></div>
    <div class="lg-f"><label>채널</label><select name="channel"><option>인스타</option><option>쓰레드</option><option>유튜브</option><option>기타</option></select></div>
    <div class="lg-f"><label>축</label><select name="axis"><option>당신</option><option>숫자</option><option>오늘</option><option>사람</option><option>브랜드</option></select></div>
    <div class="lg-f"><label>포맷</label><input name="format" placeholder="예: 문안 8 · 브리핑 캐러셀" required></div>
    <div class="lg-f"><label>저장</label><input type="number" name="saves" min="0" placeholder="나중에"></div>
    <div class="lg-f"><label>도달</label><input type="number" name="reach" min="0" placeholder="나중에"></div>
    <div class="lg-f"><label>답글</label><input type="number" name="replies" min="0" placeholder="나중에"></div>
    <div class="lg-f"><label>비고</label><input name="note" placeholder="유기적 공유·인상적 댓글 등"></div>
    <button type="submit" class="lg-btn">기록</button>
  </form>
  <div class="tblwrap"><table class="lg-table">
    <tr><th>게시일</th><th>채널</th><th>축</th><th>포맷</th><th>저장</th><th>도달</th><th>답글</th><th>비고</th><th></th><th></th></tr>
    <% if (!logRows.length) { %><tr><td colspan="10" class="lg-empty">아직 기록이 없습니다. 첫 게시물부터 적어보세요.</td></tr><% } %>
    <% logRows.forEach((r) => { %>
      <tr>
        <td style="white-space:nowrap"><%= r.posted_on %><% if (r.slot) { %> <span style="color:var(--sub2)"><%= r.slot %></span><% } %></td>
        <td><span class="lg-chip q"><%= r.channel %></span></td>
        <td><span class="lg-chip"><%= r.axis %></span></td>
        <td style="min-width:150px"><%= r.format %></td>
        <%# 지표 셋 + 비고는 인라인 수정 — 금요일에 채운다. input 의 form 속성으로 아래 form 에 묶는다 (테이블 안 중첩 form 회피) %>
        <td><input form="lg-u-<%= r.id %>" type="number" name="saves" min="0" value="<%= r.saves ?? '' %>"></td>
        <td><input form="lg-u-<%= r.id %>" type="number" name="reach" min="0" value="<%= r.reach ?? '' %>"></td>
        <td><input form="lg-u-<%= r.id %>" type="number" name="replies" min="0" value="<%= r.replies ?? '' %>"></td>
        <td><input form="lg-u-<%= r.id %>" name="note" value="<%= r.note %>"></td>
        <td><form id="lg-u-<%= r.id %>" method="post" action="/admin/sns/log/<%= r.id %>"><button type="submit" class="lg-save">채우기</button></form></td>
        <td><form method="post" action="/admin/sns/log/<%= r.id %>/delete" onsubmit="return confirm('이 기록을 지울까요?')"><button type="submit" class="lg-del">삭제</button></form></td>
      </tr>
    <% }) %>
  </table></div>

  <% if (axisAgg.length) { %>
    <div class="sns-h">축별 집계 (지표를 채운 행만 평균에 들어갑니다)</div>
    <div class="tblwrap"><table class="lg-table">
      <tr><th>축</th><th>게시 수</th><th>평균 저장</th><th>평균 도달</th><th>평균 답글</th></tr>
      <% axisAgg.forEach((a) => { %>
        <tr><td><span class="lg-chip"><%= a.axis %></span></td><td><%= a.cnt %></td>
            <td><%= a.avg_saves ?? '·' %></td><td><%= a.avg_reach ?? '·' %></td><td><%= a.avg_replies ?? '·' %></td></tr>
      <% }) %>
      <% weekAgg.forEach((w) => { %>
        <tr><td style="color:var(--sub2)">주간 <%= w.wk %>~</td><td><%= w.cnt %></td>
            <td><%= w.saves ?? '·' %></td><td>·</td><td><%= w.replies ?? '·' %></td></tr>
      <% }) %>
    </table></div>
    <p class="sns-note">4주 치가 쌓이면 이 표의 축 평균이 곧 순위입니다. 상위 2개가 5주차부터의 주력 (SNS.md 5장).</p>
  <% } %>

  <div class="sns-h">주간 루틴 요약 (원문 SNS.md)</div>
  <div class="tblwrap"><table class="wk-table">
    <tr><th>언제</th><th>시각</th><th>인스타</th><th>쓰레드</th><th>유튜브</th></tr>
    <tr><td><b>매일</b></td><td>오전 8~9시</td><td>브리핑 캐러셀</td><td>브리핑 체인 3개 (연달아)</td><td>(영상 보류)</td></tr>
    <tr><td><b>월</b></td><td>점심 12~13시</td><td>숫자 캐러셀</td><td>상식 뒤집기 1 + 셀프 답글</td><td></td></tr>
    <tr><td><b>화</b></td><td>점심 12~13시</td><td>—</td><td>쟁점 1 + 셀프 답글 (문안 뱅크 하단)</td><td></td></tr>
    <tr><td><b>수 · 목 중 하루</b></td><td>점심 12~13시</td><td>진단 캐러셀</td><td>"당신이라면?" 1 + 셀프 답글</td><td></td></tr>
    <tr><td><b>매일</b></td><td>밤 21시</td><td colspan="3">달린 댓글에 답글 몰아서 대응 (기준 제시 화법)</td></tr>
    <tr><td><b>금</b></td><td colspan="4">성과 기록 10분 — 저장 수(인스타) · 답글 수(쓰레드) · <a href="/admin/stats" style="color:var(--accent2)">방문 통계</a>의 성향 진단 뷰. 기록은 아래 <a href="#sns-log" style="color:var(--accent2)">성과표</a>에, <b>게시 시각</b>도 같이</td></tr>
  </table></div>
  <p class="sns-note">
    바쁜 날은 브리핑 캐러셀 하나만이라도. 끊기는 것이 제일 나쁩니다.<br>
    브리핑과 슬롯 사이는 <b>최소 4시간</b> — 체인 3개를 먼저 끝내고, 슬롯은 점심에. 붙여 올리면 우리 글끼리 도달을 먹습니다.
    점심인 이유는 답글이 오후~저녁에 쌓여 <b>그날 밤 한 번에 대응</b>할 수 있어서입니다 (저녁에 올리면 대응이 다음 날로 밀립니다).
    이건 실측이 아니라 출발값이라, 성과 기록의 <b>시각</b> 칸으로 4주 뒤에 검증합니다.
  </p>
</div>
