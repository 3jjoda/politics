<%
  // 날짜 포맷은 app.locals 의 전역 헬퍼(utils/datetime.js)를 쓴다 — KST 명시.
  // 이전엔 여기서 Date.getFullYear()/getHours() 로 직접 조립했는데, 그 계열은
  // 서버 프로세스 타임존(Railway=UTC)을 따라가 새벽 데이터가 하루 밀렸다.
  const fmtDateOnly = fmtDate;
  const providerLabel = user.provider === 'google' ? 'Google'
                      : user.provider === 'kakao'  ? 'Kakao'
                      : '로컬';
  const genderLabel   = user.gender === 'male' ? '남성'
                      : user.gender === 'female' ? '여성'
                      : user.gender === 'other'  ? '기타' : '—';
  const ageLabel      = user.age_group === '10s' ? '14~19세' : user.age_group === '60s' ? '60대 이상' : user.age_group ? user.age_group.replace('s', '대') : '—';
%>

<style>
  .my-wrap {
    max-width: 920px;
    margin: 0 auto;
    padding: calc(var(--nav-h) + 36px) 24px 80px;
  }

  .my-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    margin-bottom: 14px;
  }
  .my-breadcrumb a { color: var(--sub); text-decoration: none; }
  .my-breadcrumb a:hover { color: var(--accent); }
  .my-breadcrumb .sep { color: var(--border2); margin: 0 6px; }

  .my-head {
    margin-bottom: 28px;
  }
  .my-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    color: var(--text);
    margin: 0 0 6px;
    letter-spacing: 0.02em;
  }
  .my-sub {
    font-size: 13px;
    color: var(--sub);
  }

  /* ====== 공통 카드 ====== */
  .my-section {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px 26px;
    margin-bottom: 18px;
  }
  .my-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .my-section-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }
  .my-section-title .icon { color: var(--accent); margin-right: 6px; }
  .my-section-link {
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .my-section-link:hover { text-decoration: underline; }

  /* ====== 1. 프로필 ====== */
  .pf-row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 22px;
    align-items: center;
  }
  .pf-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .pf-avatar svg, .pf-avatar img { width: 100%; height: 100%; display: block; }
  .pf-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px 22px;
  }
  .pf-field { font-size: 13px; }
  .pf-label {
    color: var(--sub2);
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }
  .pf-value {
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
  }
  .pf-value.muted { color: var(--sub); font-weight: 400; }

  /* 닉네임 인라인 편집 */
  .pf-nick {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pf-nick-text {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
  }
  .pf-nick-edit-btn {
    background: transparent;
    border: 1px solid var(--border2);
    color: var(--sub);
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 11px;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
  }
  .pf-nick-edit-btn:hover { border-color: var(--accent); color: var(--accent); }
  .pf-nick-form {
    display: none;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pf-nick-form.editing { display: flex; }
  .pf-nick.editing .pf-nick-text,
  .pf-nick.editing .pf-nick-edit-btn { display: none; }
  .pf-nick-input {
    border: 1px solid var(--border2);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 14px;
    color: var(--text);
    background: var(--bg);
    width: 180px;
    font-family: inherit;
  }
  .pf-nick-input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .pf-nick-save, .pf-nick-cancel {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
    font-family: inherit;
    border: 1px solid var(--border2);
  }
  .pf-nick-save { background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 600; }
  .pf-nick-save:hover { background: var(--accent2); }
  .pf-nick-save:disabled { opacity: 0.5; cursor: not-allowed; }
  .pf-nick-cancel { background: transparent; color: var(--sub); }
  .pf-nick-cancel:hover { background: var(--bg3); }
  .pf-nick-msg {
    font-size: 12px;
    margin-top: 6px;
    flex-basis: 100%;
  }
  .pf-nick-msg.ok    { color: var(--green); }
  .pf-nick-msg.error { color: var(--red); }

  /* ====== 2. 성향 카드 — invite/reveal 과 같은 파샬(_result_axes) · 같은 .bg-* 규칙 (2026-08-16)
        🔴 구 |값| 다이아몬드로 되돌리지 말 것 — 시장 −0.5 와 개입 +0.5 가 같은 모양이었다 (사이트 전체에서 버린 도형) ====== */
  .ax-card { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 28px; align-items: start; }
  .ax-side { display: flex; flex-direction: column; gap: 10px; }
  .ax-side .ax-cta { width: 100%; justify-content: center; margin: 0; }
  .ax-side-note { font-size: 12px; color: var(--sub2); line-height: 1.6; word-break: keep-all; margin: 2px 0 0; }
  .ax-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .ax-tag { display: inline-flex; align-items: center; padding: 3px 9px; border-radius: 999px; font-family: 'JetBrains Mono', monospace; font-size: 11px; background: var(--bg3); color: var(--sub); }
  .ax-tag.done { background: rgba(15,157,110,0.10); color: var(--green); border: 1px solid var(--green); font-weight: 700; }
  .ax-tag.part { background: #FAF6EB; color: var(--accent2); border: 1px solid var(--accent); font-weight: 700; }
  .bg-res-kicker { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--accent2); letter-spacing: .08em; margin-bottom: 8px; }
  .bg-res-headline { font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 26px; line-height: 1.3; color: var(--text); margin: 0 0 6px; word-break: keep-all; border-left: 4px solid var(--accent); padding-left: 14px; }
  .bg-res-desc { font-size: 14px; color: var(--sub); line-height: 1.7; margin: 0 0 4px; padding-left: 18px; word-break: keep-all; }
  .bg-res-desc .bg-res-line { color: var(--text); font-weight: 600; }
  .bg-res-types { color: var(--accent2); font-weight: 600; text-decoration: none; white-space: nowrap; margin-left: 4px; }
  .bg-res-types:hover { text-decoration: underline; }
  .bg-res-sub { font-size: 13px; color: var(--sub2); margin: 0 0 22px; padding-left: 18px; }
  .bg-ax { display: flex; flex-direction: column; gap: 16px; }
  .bg-ax-row { display: grid; grid-template-columns: 1fr; gap: 6px; }
  .bg-ax-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .bg-ax-name { font-family: 'Noto Serif KR', serif; font-weight: 700; font-size: 15px; color: var(--text); }
  .bg-ax-name small { font-family: 'Noto Sans KR', sans-serif; font-weight: 400; font-size: 12px; color: var(--sub2); margin-left: 8px; }
  .bg-ax-phrase { font-size: 12.5px; font-weight: 700; color: var(--accent2); white-space: nowrap; }
  .bg-ax-phrase.is-mid { color: var(--sub); font-weight: 500; }
  .bg-ax-track { position: relative; height: 8px; border-radius: 4px; background: var(--border); margin: 2px 8px; }
  .bg-ax-track::before { content: ''; position: absolute; left: 50%; top: -4px; width: 2px; height: 16px; background: var(--border2); transform: translateX(-1px); }
  .bg-ax-band { position: absolute; top: 0; height: 100%; background: rgba(184,116,12,0.28); border-radius: 4px; }
  .bg-ax-dot { position: absolute; top: 50%; width: 16px; height: 16px; border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%); box-shadow: 0 0 0 3px var(--bg2); }
  .bg-ax-ends { display: flex; justify-content: space-between; font-size: 12px; color: var(--sub); }

  .ax-cta { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 16px; background: var(--accent); color: #fff; border-radius: 8px; font-size: 13.5px; font-weight: 700; text-decoration: none; transition: background .15s; }
  .ax-cta:hover { background: var(--accent2); }
  .ax-cta.secondary { background: var(--bg2); color: var(--accent2); border: 1px solid var(--accent); }
  .ax-cta.secondary:hover { background: #FAF6EB; }

  /* 미완료 — 진행 상태를 숫자로 (16/20 처럼). 빈 상자만 두면 "왜 카드가 없지" 가 된다 */
  .ax-empty { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: center; padding: 6px 4px; }
  .ax-empty-title { font-family: 'Noto Serif KR', serif; font-weight: 700; font-size: 18px; color: var(--text); margin: 0 0 6px; }
  .ax-empty p { margin: 0; color: var(--sub); font-size: 13.5px; line-height: 1.7; word-break: keep-all; }
  .ax-progress { height: 8px; border-radius: 4px; background: var(--bg3); overflow: hidden; margin: 10px 0 6px; max-width: 360px; }
  .ax-progress > i { display: block; height: 100%; background: var(--accent); border-radius: 4px; }
  .ax-progress-txt { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--sub2); }

  /* ====== 3. 게임팩 — 행 전체가 링크. 상태별로 버튼 라벨이 다르다 (시작 / 이어서 / 다시) ====== */
  .hist-list { display: flex; flex-direction: column; gap: 8px; }
  .hist-row { display: grid; grid-template-columns: 1fr auto; gap: 14px; padding: 14px 18px; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; align-items: center; text-decoration: none; color: inherit; transition: border-color .15s, background .15s; }
  .hist-row:hover { border-color: var(--accent); background: var(--bg2); }
  .hist-row.completed { border-left: 3px solid var(--green); }
  .hist-row.partial   { border-left: 3px solid var(--accent); }
  .hist-title { font-size: 14.5px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
  .hist-title .general-tag { display: inline-block; background: rgba(184,116,12,0.12); color: var(--accent2); font-size: 10px; padding: 2px 6px; border-radius: 3px; margin-left: 6px; vertical-align: middle; font-family: 'JetBrains Mono', monospace; }
  .hist-desc { font-size: 12.5px; color: var(--sub); line-height: 1.55; word-break: keep-all; margin-bottom: 4px; }
  .hist-meta { font-size: 11px; color: var(--sub2); font-family: 'JetBrains Mono', monospace; }
  .hist-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .hist-bar { width: 120px; height: 6px; border-radius: 3px; background: var(--bg3); overflow: hidden; }
  .hist-bar > i { display: block; height: 100%; background: var(--accent); }
  .hist-row.completed .hist-bar > i { background: var(--green); }
  .hist-counts { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--sub); }
  .hist-counts strong { color: var(--text); font-weight: 700; }
  .hist-go { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 6px; font-size: 12.5px; font-weight: 700; white-space: nowrap; }
  .hist-go.start    { background: var(--accent); color: #fff; }
  .hist-go.resume   { background: #FAF6EB; color: var(--accent2); border: 1px solid var(--accent); }
  .hist-go.redo     { background: var(--bg2); color: var(--sub); border: 1px solid var(--border2); }
  .hist-note { font-size: 12px; color: var(--sub2); line-height: 1.6; margin: 10px 0 0; word-break: keep-all; }

  .pf-demo-form { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 6px; }
  .pf-demo-form select { padding: 6px 8px; border: 1px solid var(--border2); border-radius: 6px; font-size: 13px; background: var(--bg2); color: var(--text); font-family: inherit; }
  .pf-demo-form[hidden] { display: none; }

  /* ====== 내 활동 ====== */
  .act-counts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px; }
  .act-count { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; text-align: left; cursor: pointer; font-family: inherit; transition: border-color .15s, background .15s; }
  .act-count:hover { border-color: var(--accent); }
  .act-count[aria-selected="true"] { border-color: var(--accent); background: #FAF6EB; box-shadow: inset 0 0 0 1px var(--accent); }
  .act-count[aria-selected="true"] b { color: var(--accent2); }
  .pagination-inline { display: flex; justify-content: center; gap: 4px; margin-top: 14px; }
  .pagination-inline:empty { display: none; }
  .pagination-inline .pg { width: 36px; height: 36px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg2); color: var(--sub); font-size: 13px; cursor: pointer; font-family: 'JetBrains Mono', monospace; }
  .pagination-inline .pg.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pagination-inline .pg:disabled { opacity: 0.3; cursor: not-allowed; }
  .act-list.is-loading { opacity: .5; pointer-events: none; }
  .act-count b { display: block; font-family: 'JetBrains Mono', monospace; font-size: 22px; font-weight: 700; color: var(--text); line-height: 1.1; }
  .act-count span { font-size: 11.5px; color: var(--sub2); }
  .act-list { display: flex; flex-direction: column; gap: 6px; }
  .act-row { display: grid; grid-template-columns: 74px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 14px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; }
  .act-row:hover { border-color: var(--accent); }
  .act-kind { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--accent2); background: rgba(184,116,12,0.10); border-radius: 4px; padding: 3px 7px; text-align: center; white-space: nowrap; }
  .act-kind.vote-agree, .act-kind.vote-disagree { background: var(--bg3); color: var(--sub); }
  .act-title { font-size: 13.5px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .act-detail { font-size: 12px; color: var(--sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
  .act-time { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--sub2); white-space: nowrap; }
  .act-note { font-size: 12px; color: var(--sub2); margin: 10px 0 0; line-height: 1.6; word-break: keep-all; }
  .act-empty { color: var(--sub); font-size: 13.5px; padding: 6px 4px; }
  .act-empty a { color: var(--accent2); font-weight: 600; text-decoration: none; }

  /* ====== 계정 관리 ====== */
  .acct-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; padding-top: 16px; border-top: 1px dashed var(--border); }
  .acct-btn { display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; background: var(--bg2); color: var(--sub); border: 1px solid var(--border2); cursor: pointer; font-family: inherit; }
  .acct-btn:hover { border-color: var(--accent); color: var(--accent2); }
  .acct-btn.danger:hover { border-color: var(--red); color: var(--red); }

  /* ====== 4. 분석 요청 요약 ====== */
  .req-summary-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 16px;
  }
  .req-stat {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 18px;
    text-align: center;
  }
  .req-stat-num {
    font-family: 'Noto Serif KR', serif;
    font-size: 28px;
    font-weight: 900;
    color: var(--text);
    line-height: 1;
    margin-bottom: 4px;
  }
  .req-stat.done    .req-stat-num { color: var(--green); }
  .req-stat.pending .req-stat-num { color: var(--accent); }
  .req-stat-label {
    font-size: 12px;
    color: var(--sub);
  }
  .req-recent {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .req-recent a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    color: var(--text);
    text-decoration: none;
    gap: 10px;
  }
  .req-recent a:hover { border-color: var(--accent); }
  .req-recent .name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .req-recent .pill {
    flex-shrink: 0;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
  }
  .req-recent .pill.done    { background: rgba(15,157,110,0.10); color: var(--green); }
  .req-recent .pill.pending { background: #FAF6EB;                color: var(--accent); }

  .req-empty {
    text-align: center;
    padding: 24px;
    color: var(--sub);
    font-size: 13px;
  }
  .req-empty a { color: var(--accent); }

  @media (max-width: 768px) {
    .my-wrap { padding: calc(var(--nav-h) + 20px) 16px 60px; }
    .my-title { font-size: 28px; }
    .my-section { padding: 20px 18px; }
    .pf-row { grid-template-columns: 64px 1fr; gap: 16px; }
    .pf-avatar { width: 64px; height: 64px; }
    .ax-card { grid-template-columns: 1fr; gap: 18px; }
    .bg-res-headline { font-size: 22px; }
    .bg-ax-phrase { white-space: normal; text-align: right; }
    .ax-empty { grid-template-columns: 1fr; }
    .ax-empty .ax-cta { width: 100%; }
    .hist-row { grid-template-columns: 1fr; gap: 10px; padding: 12px 14px; }
    .hist-right { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; }
    .hist-bar { display: none; }
    .req-summary-row { grid-template-columns: 1fr; gap: 8px; }
    .act-counts { grid-template-columns: repeat(2, 1fr); }
    .act-row { grid-template-columns: 62px minmax(0, 1fr); }
    .act-time { display: none; }
  }
</style>

<div class="my-wrap">
  <nav class="my-breadcrumb">
    <a href="/">홈</a>
    <span class="sep">/</span>
    <span>마이페이지</span>
  </nav>

  <header class="my-head">
    <h1 class="my-title">마이페이지</h1>
    <p class="my-sub"><strong style="color:var(--text)"><%= user.nickname %></strong>님, 환영합니다.</p>
  </header>

  <!-- ============ 1. 프로필 ============ -->
  <section class="my-section">
    <div class="my-section-head">
      <h2 class="my-section-title"><span class="icon">👤</span>프로필</h2>
    </div>
    <div class="pf-row">
      <div class="pf-avatar"><%- avatarHtml(user.nickname, null, 80) %></div>
      <div>
        <div class="pf-nick" id="pf-nick">
          <span class="pf-nick-text" id="pf-nick-text"><%= user.nickname %></span>
          <button type="button" class="pf-nick-edit-btn" id="pf-nick-edit-btn">변경</button>
          <div class="pf-nick-form" id="pf-nick-form">
            <input type="text" class="pf-nick-input" id="pf-nick-input"
                   value="<%= user.nickname %>"
                   maxlength="20"
                   autocomplete="off">
            <button type="button" class="pf-nick-save"   id="pf-nick-save">저장</button>
            <button type="button" class="pf-nick-cancel" id="pf-nick-cancel">취소</button>
            <div class="pf-nick-msg" id="pf-nick-msg"></div>
          </div>
        </div>
        <div class="pf-fields" style="margin-top:14px">
          <div class="pf-field">
            <div class="pf-label">계정</div>
            <div class="pf-value"><%= providerLabel %></div>
          </div>
          <div class="pf-field">
            <div class="pf-label">이메일</div>
            <div class="pf-value muted"><%= user.email || '—' %></div>
          </div>
          <div class="pf-field">
            <div class="pf-label">성별 · 연령대 <button type="button" class="pf-nick-edit-btn" id="pf-demo-edit">변경</button></div>
            <div class="pf-value muted" id="pf-demo-text"><%= genderLabel %> · <%= ageLabel %></div>
            <%# 통계용 값이라 본인이 고칠 수 있어야 한다 (2026-08-16). 선택지는 auth/setup.ejs 와 같아야 한다 — 14세 미만 항목 없음 %>
            <form class="pf-demo-form" id="pf-demo-form" hidden>
              <select id="pf-demo-gender" aria-label="성별">
                <option value="male"   <%= user.gender === 'male'   ? 'selected' : '' %>>남성</option>
                <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>여성</option>
                <option value="other"  <%= user.gender === 'other'  ? 'selected' : '' %>>기타</option>
              </select>
              <select id="pf-demo-age" aria-label="연령대">
                <% [['10s','14~19세'],['20s','20대'],['30s','30대'],['40s','40대'],['50s','50대'],['60s','60대 이상']].forEach(([v,l]) => { %>
                  <option value="<%= v %>" <%= user.age_group === v ? 'selected' : '' %>><%= l %></option>
                <% }); %>
              </select>
              <button type="submit" class="pf-nick-save">저장</button>
              <button type="button" class="pf-nick-cancel" id="pf-demo-cancel">취소</button>
              <div class="pf-nick-msg" id="pf-demo-msg"></div>
            </form>
          </div>
          <div class="pf-field">
            <div class="pf-label">가입일</div>
            <div class="pf-value muted"><%= fmtDateOnly(user.created_at) %></div>
          </div>
        </div>
        <div class="acct-row">
          <a href="/auth/logout" class="acct-btn" data-no-loader>로그아웃</a>
          <button type="button" class="acct-btn danger pb-withdraw-trigger">회원 탈퇴</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 2. 성향 카드 — invite/reveal 과 같은 파샬 ============ -->
  <%
    const META = (locals.AXIS && AXIS.AXIS_META) || {};
    const generalPack = packHistory.find(p => p.is_general) || null;
    const gAnswered = generalPack ? generalPack.response_count : 0;
    const gTotal    = generalPack ? generalPack.question_count : 20;
    const gStarted  = gAnswered > 0;
    const respondUrl = generalPack ? `/balance-game/respond?pack=${generalPack.id}` : '/balance-game';
  %>
  <section class="my-section">
    <div class="my-section-head">
      <h2 class="my-section-title"><span class="icon">📊</span>내 성향 카드</h2>
      <% if (completed) { %>
        <a href="/balance-game/reveal" class="my-section-link">카드 페이지 →</a>
      <% } %>
    </div>
    <% if (completed && axisScore) { %>
      <div class="ax-card">
        <div>
          <div class="ax-tags">
            <span class="ax-tag done">✓ 진단 완료</span>
            <span class="ax-tag"><%= fmtDateOnly(axisScore.computed_at) %></span>
            <span class="ax-tag">응답 <%= axisScore.total_responses %></span>
          </div>
          <%- include('../balance/_result_axes', { axisScore, META }) %>
        </div>
        <aside class="ax-side">
          <a href="/balance-game/share" class="ax-cta">결과 이미지로 공유 →</a>
          <a href="/politician?sort=match-desc" class="ax-cta secondary">가까운 의원 보기</a>
          <a href="/balance-game/compare" class="ax-cta secondary">의원과 비교</a>
          <a href="<%= respondUrl %>" class="ax-cta secondary">다시 풀기</a>
          <p class="ax-side-note">공유 카드에는 좌표와 가까운 의원 3명만 담기고, 닉네임 등 개인정보는 들어가지 않습니다.
            <a href="/balance-game/types" style="color:var(--accent2);text-decoration:none;font-weight:600">유형 9종 →</a></p>
        </aside>
      </div>
    <% } else { %>
      <div class="ax-empty">
        <div>
          <p class="ax-empty-title"><%= gStarted ? '풀다 만 진단이 있어요' : '아직 성향 진단을 하지 않았어요' %></p>
          <% if (gStarted) { %>
            <p>종합팩 <%= gTotal %>문항 중 <strong><%= gAnswered %>문항</strong>에 답했습니다. 남은 문항을 마치면 카드가 만들어집니다.
              <% if (gAnswered >= 16) { %>(문항이 일부 바뀌어 다시 열린 것일 수 있어요. 새 문항만 이어서 풀면 됩니다.)<% } %></p>
            <div class="ax-progress"><i style="width:<%= Math.round(gAnswered / gTotal * 100) %>%"></i></div>
            <div class="ax-progress-txt"><%= gAnswered %> / <%= gTotal %></div>
          <% } else { %>
            <p>종합팩 <%= gTotal %>문항(약 5분)을 풀면 네 축 좌표와 유형, 좌표가 가까운 의원이 나옵니다.</p>
          <% } %>
        </div>
        <a href="<%= respondUrl %>" class="ax-cta"><%= gStarted ? '이어서 풀기 →' : '진단 시작하기 →' %></a>
      </div>
    <% } %>
  </section>

  <!-- ============ 3. 게임팩 — 행을 누르면 바로 그 팩으로 ============ -->
  <section class="my-section">
    <div class="my-section-head">
      <h2 class="my-section-title"><span class="icon">🎮</span>게임팩</h2>
      <a href="/balance-game" class="my-section-link">성향 진단 →</a>
    </div>
    <div class="hist-list">
      <% packHistory.forEach(p => {
           const total = p.question_count || 0;
           const done  = Math.min(p.response_count, total);
           const status = (total > 0 && done >= total) ? 'completed' : done > 0 ? 'partial' : 'unstarted';
           const go = status === 'completed' ? { cls: 'redo',   txt: '다시 풀기' }
                    : status === 'partial'   ? { cls: 'resume', txt: '이어서 풀기' }
                    :                          { cls: 'start',  txt: '시작하기' };
      %>
        <a class="hist-row <%= status %>" href="/balance-game/respond?pack=<%= p.id %>">
          <div>
            <div class="hist-title">
              <%= p.title %>
              <% if (p.is_general) { %><span class="general-tag">종합 · 의원 매칭 기준</span><% } %>
            </div>
            <% if (p.description) { %><div class="hist-desc"><%= p.description %></div><% } %>
            <div class="hist-meta">
              <% if (p.last_responded_at) { %>마지막 응답 <%= fmtDateTime(p.last_responded_at) %><% } else { %>아직 풀지 않음<% } %>
            </div>
          </div>
          <div class="hist-right">
            <span class="hist-go <%= go.cls %>"><%= go.txt %> →</span>
            <div class="hist-bar"><i style="width:<%= total ? Math.round(done / total * 100) : 0 %>%"></i></div>
            <div class="hist-counts"><strong><%= done %></strong> / <%= total %>문항</div>
          </div>
        </a>
      <% }); %>
      <% if (packHistory.length === 0) { %>
        <div class="ax-empty"><p>아직 활성화된 게임팩이 없습니다.</p></div>
      <% } %>
    </div>
    <p class="hist-note">종합팩이 의원 매칭의 기준입니다. 주제팩은 같은 네 축을 더 깊이 묻는 것으로, 풀수록 내 좌표에 반영됩니다.</p>
  </section>

  <!-- ============ 내 활동 — 카드(종류)를 고르면 아래 목록, 페이징. 본인에게만 보인다 ============ -->
  <%
    const ac = activity && activity.counts;
    const actKind = (activity && activity.kind) || 'comment';
    const actPage = activity && activity.page;
    const ACT_CARDS = [['comment', 'comments', '댓글'], ['vote', 'votes', '법안 찬반'], ['rating', 'ratings', '의원 별점'], ['post', 'posts', '게시글']];
    const actTotal = ac ? ACT_CARDS.reduce((n, [, k]) => n + (ac[k] || 0), 0) : 0;
  %>
  <section class="my-section" id="my-activity">
    <div class="my-section-head">
      <h2 class="my-section-title"><span class="icon">✍️</span>내 활동</h2>
    </div>
    <% if (ac) { %>
      <div class="act-counts" role="tablist" aria-label="활동 종류">
        <% ACT_CARDS.forEach(([kind, key, label]) => { %>
          <button type="button" class="act-count" role="tab" data-kind="<%= kind %>" aria-selected="<%= kind === actKind ? 'true' : 'false' %>">
            <b><%= ac[key] %></b><span><%= label %></span>
          </button>
        <% }); %>
      </div>
    <% } %>
    <% if (!actTotal) { %>
      <p class="act-empty">아직 남긴 활동이 없어요. <a href="/bill">법안에 찬반을 남기거나</a> <a href="/politician">의원에게 별점을</a> 주면 여기에 쌓입니다.</p>
    <% } else { %>
      <div class="act-list" id="act-list" aria-live="polite">
        <% (actPage ? actPage.items : []).forEach(it => { %>
          <%- include('_activity_row', { it }) %>
        <% }); %>
        <% if (actPage && !actPage.items.length) { %><p class="act-empty">이 종류의 활동이 없어요.</p><% } %>
      </div>
      <div class="pagination-inline" id="act-pager"></div>
      <p class="act-note" id="act-note"><%= actPage ? `${actPage.total}건 · ${activity.per}건씩` : '' %> · 행을 누르면 그 글로 이동합니다. 이 기록은 본인에게만 보이며, 다른 사람의 활동 기록은 만들지 않습니다.</p>
    <% } %>
  </section>

  <!-- ============ 4. 분석 요청 ============ -->
  <section class="my-section">
    <div class="my-section-head">
      <h2 class="my-section-title"><span class="icon">🤖</span>내가 요청한 AI 분석</h2>
      <% if (analysisSummary.total > 0) { %>
        <a href="/my/analysis-requests" class="my-section-link">전체 보기 →</a>
      <% } %>
    </div>
    <% if (analysisSummary.total === 0) { %>
      <div class="req-empty">
        아직 요청한 법안이 없어요. <a href="/bill">법안 둘러보기 →</a>
      </div>
    <% } else { %>
      <div class="req-summary-row">
        <div class="req-stat">
          <div class="req-stat-num"><%= analysisSummary.total %></div>
          <div class="req-stat-label">총 요청</div>
        </div>
        <div class="req-stat done">
          <div class="req-stat-num"><%= analysisSummary.done %></div>
          <div class="req-stat-label">분석 완료</div>
        </div>
        <div class="req-stat pending">
          <div class="req-stat-num"><%= analysisSummary.pending %></div>
          <div class="req-stat-label">대기</div>
        </div>
      </div>
      <div class="req-recent">
        <% analysisSummary.recent.forEach(r => { %>
          <a href="/bill/<%= r.bill_id %>">
            <span class="name"><%= r.bill_name %></span>
            <span class="pill <%= r.has_ai_analysis ? 'done' : 'pending' %>">
              <%= r.has_ai_analysis ? '✓ 분석 완료' : '⏳ 대기' %>
            </span>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>
</div>

<script>
(() => {
  const root      = document.getElementById('pf-nick');
  const text      = document.getElementById('pf-nick-text');
  const form      = document.getElementById('pf-nick-form');
  const editBtn   = document.getElementById('pf-nick-edit-btn');
  const input     = document.getElementById('pf-nick-input');
  const saveBtn   = document.getElementById('pf-nick-save');
  const cancelBtn = document.getElementById('pf-nick-cancel');
  const msg       = document.getElementById('pf-nick-msg');

  let originalNick = text.textContent.trim();

  const setMsg = (kind, txt) => {
    msg.className = 'pf-nick-msg ' + (kind || '');
    msg.textContent = txt || '';
  };
  const startEdit = () => {
    root.classList.add('editing');
    form.classList.add('editing');
    input.value = originalNick;
    input.focus();
    input.select();
    setMsg('', '');
  };
  const stopEdit = () => {
    root.classList.remove('editing');
    form.classList.remove('editing');
    setMsg('', '');
  };
  const save = async () => {
    const v = input.value.trim();
    if (!v) { setMsg('error', '닉네임을 입력해주세요.'); return; }
    if (v === originalNick) { stopEdit(); return; }
    saveBtn.disabled = true;
    setMsg('', '저장 중...');
    try {
      const res = await fetch('/api/auth/nickname', {
        method: 'PUT',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ nickname: v })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        setMsg('error', data.error || `오류 (HTTP ${res.status})`);
        saveBtn.disabled = false;
        return;
      }
      originalNick = data.nickname;
      text.textContent = data.nickname;
      setMsg('ok', '저장되었습니다.');
      setTimeout(stopEdit, 800);
    } catch (err) {
      setMsg('error', '네트워크 오류: ' + err.message);
      saveBtn.disabled = false;
    } finally {
      // saveBtn 활성화 복구는 성공 케이스에선 stopEdit 후 자동 reset
      saveBtn.disabled = false;
    }
  };

  editBtn.addEventListener('click', startEdit);
  cancelBtn.addEventListener('click', stopEdit);
  saveBtn.addEventListener('click', save);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter')  { e.preventDefault(); save(); }
    if (e.key === 'Escape') { e.preventDefault(); stopEdit(); }
  });

  // ── 내 활동: 카드(종류) 탭 + 페이징 (GET /my/activity JSON) ──
  const actList = document.getElementById('act-list'), actPager = document.getElementById('act-pager'), actNote = document.getElementById('act-note');
  const actTabs = [...document.querySelectorAll('.act-count[data-kind]')];
  if (actList && actTabs.length) {
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const KIND = { comment: '댓글', vote: '찬반', rating: '별점', post: '게시글' };
    const SUB_C = { politician: '의원', bill: '법안', post: '게시글', briefing: '브리핑' };
    const hrefOf = (it) => it.kind === 'comment'
        ? ({ politician: '/politician/', bill: '/bill/', post: '/community/', briefing: '/briefing/' }[it.sub] || '/') + encodeURIComponent(it.target_id) + '#comments'
        : it.kind === 'vote' ? '/bill/' + encodeURIComponent(it.target_id)
        : it.kind === 'rating' ? '/politician/' + encodeURIComponent(it.target_id)
        : '/community/' + encodeURIComponent(it.target_id);
    const subOf = (it) => it.kind === 'vote' ? (it.sub === 'agree' ? '찬성' : '반대') : it.kind === 'rating' ? '★ ' + it.sub : it.kind === 'comment' ? (SUB_C[it.sub] || '') : '';
    const row = (it) => `<a class="act-row" href="${hrefOf(it)}"><span class="act-kind ${it.kind === 'vote' ? 'vote-' + esc(it.sub) : ''}">${KIND[it.kind]}${subOf(it) ? ' · ' + esc(subOf(it)) : ''}</span><span><div class="act-title">${esc(it.title || '(삭제되었거나 찾을 수 없음)')}</div>${it.detail ? '<div class="act-detail">' + esc(it.detail) + '</div>' : ''}</span><span class="act-time">${esc(it.created_at)}</span></a>`;
    // 공용 페이저와 같은 모양 (의원 상세 renderPager) — « ← 1..7 → »
    const drawPager = (cur, pages, onGo) => {
      actPager.innerHTML = '';
      if (pages <= 1) return;
      const mk = (label, p, o = {}) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'pg' + (o.active ? ' active' : ''); b.textContent = label; b.disabled = !!o.disabled; if (o.title) b.title = o.title; b.onclick = () => onGo(p); actPager.appendChild(b); };
      const first = cur === 1, last = cur === pages;
      mk('«', 1, { disabled: first, title: '첫 페이지' }); mk('←', Math.max(1, cur - 1), { disabled: first });
      const start = Math.max(1, cur - 3), end = Math.min(pages, start + 6);
      for (let p = start; p <= end; p++) mk(String(p), p, { active: p === cur });
      mk('→', Math.min(pages, cur + 1), { disabled: last }); mk('»', pages, { disabled: last, title: '마지막 페이지 (' + pages + ')' });
    };
    let cur = { kind: '<%= actKind %>', page: 1 };
    const state = { pages: <%= actPage ? actPage.pages : 1 %> };
    const load = async (kind, page) => {
      actList.classList.add('is-loading');
      try {
        const res = await fetch(`/my/activity?kind=${encodeURIComponent(kind)}&page=${page}`, { credentials: 'include', headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const d = await res.json();
        cur = { kind: d.kind, page: d.page }; state.pages = d.pages;
        actList.innerHTML = d.items.length ? d.items.map(row).join('') : '<p class="act-empty">이 종류의 활동이 없어요.</p>';
        actNote.textContent = `${d.total}건 · ${d.per}건씩 · 행을 누르면 그 글로 이동합니다. 이 기록은 본인에게만 보이며, 다른 사람의 활동 기록은 만들지 않습니다.`;
        drawPager(d.page, d.pages, (p) => load(cur.kind, p));
        actTabs.forEach(t => t.setAttribute('aria-selected', t.dataset.kind === d.kind ? 'true' : 'false'));
        if (page > 1 || kind !== cur.kind) actList.scrollIntoView({ block: 'nearest' });
      } catch (err) {
        actList.innerHTML = `<p class="act-empty">불러오지 못했습니다 (${esc(err.message)}). <a href="#" onclick="location.reload();return false;">새로고침</a></p>`;
      } finally { actList.classList.remove('is-loading'); }
    };
    actTabs.forEach(t => t.addEventListener('click', () => { if (t.dataset.kind !== cur.kind) load(t.dataset.kind, 1); }));
    drawPager(1, state.pages, (p) => load(cur.kind, p));   // 첫 페이지는 SSR — 요청 0회
  }

  // ── 성별·연령대 변경 (PUT /api/auth/profile) ──
  const dEdit = document.getElementById('pf-demo-edit'), dForm = document.getElementById('pf-demo-form'),
        dText = document.getElementById('pf-demo-text'), dCancel = document.getElementById('pf-demo-cancel'),
        dMsg = document.getElementById('pf-demo-msg'), dG = document.getElementById('pf-demo-gender'), dA = document.getElementById('pf-demo-age');
  if (dEdit && dForm) {
    const LABEL_G = { male: '남성', female: '여성', other: '기타' };
    const LABEL_A = { '10s': '14~19세', '20s': '20대', '30s': '30대', '40s': '40대', '50s': '50대', '60s': '60대 이상' };
    dEdit.addEventListener('click', () => { dForm.hidden = false; dEdit.hidden = true; dMsg.textContent = ''; });
    dCancel.addEventListener('click', () => { dForm.hidden = true; dEdit.hidden = false; });
    dForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      dMsg.className = 'pf-nick-msg'; dMsg.textContent = '저장 중...';
      try {
        const res = await fetch('/api/auth/profile', { method: 'PUT', credentials: 'include',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ gender: dG.value, ageGroup: dA.value }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) { dMsg.className = 'pf-nick-msg error'; dMsg.textContent = data.error || `오류 (HTTP ${res.status})`; return; }
        dText.textContent = `${LABEL_G[data.gender] || data.gender} · ${LABEL_A[data.ageGroup] || data.ageGroup}`;
        dMsg.className = 'pf-nick-msg ok'; dMsg.textContent = '저장되었습니다.';
        setTimeout(() => { dForm.hidden = true; dEdit.hidden = false; }, 700);
      } catch (err) { dMsg.className = 'pf-nick-msg error'; dMsg.textContent = '네트워크 오류: ' + err.message; }
    });
  }
})();
</script>
