<%
  const total = (requests || []).length;
  const done  = (requests || []).filter(r => r.has_ai_analysis).length;
  const pending = total - done;
%>

<style>
  .my-wrap {
    max-width: 920px;
    margin: 0 auto;
    padding: calc(var(--nav-h) + 36px) 24px 80px;
  }

  .my-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    margin-bottom: 14px;
  }
  .my-breadcrumb a { color: var(--sub); text-decoration: none; }
  .my-breadcrumb a:hover { color: var(--accent); }
  .my-breadcrumb .sep { color: var(--border2); margin: 0 6px; }

  .my-head {
    margin-bottom: 24px;
  }
  .my-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    color: var(--text);
    margin: 0 0 6px;
    letter-spacing: 0.02em;
  }
  .my-summary {
    font-size: 13px;
    color: var(--sub);
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .my-summary strong { color: var(--text); font-family: 'JetBrains Mono', monospace; }
  .my-summary .pill-done    { color: var(--green); }
  .my-summary .pill-pending { color: var(--accent); }

  /* 빈 상태 */
  .empty {
    background: var(--bg2);
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 60px 24px;
    text-align: center;
    color: var(--sub);
  }
  .empty a {
    color: var(--accent);
    margin-top: 12px;
    display: inline-block;
    font-weight: 600;
  }

  /* 요청 카드 리스트 */
  .req-list { display: flex; flex-direction: column; gap: 10px; }
  .req-item {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 22px;
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }
  .req-item:hover { border-color: var(--border2); transform: translateX(2px); }
  .req-item.done { border-left: 3px solid var(--green); }
  .req-item.pending { border-left: 3px solid var(--accent); }

  .req-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-family: inherit;
  }
  .status-pill.done    { background: rgba(15,157,110,0.10); color: var(--green); border: 1px solid var(--green); }
  .status-pill.pending { background: #FAF6EB; color: var(--accent); border: 1px solid var(--accent); }
  .req-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 6px;
    line-height: 1.5;
  }
  .req-summary {
    font-family: 'Noto Serif KR', serif;
    font-weight: 500;
    font-size: 14px;
    color: var(--text);
    line-height: 1.55;
    margin: 6px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .req-info {
    font-size: 12px;
    color: var(--sub);
    margin-top: 6px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .req-info .ai-cat { color: var(--accent); }
  .req-info .req-cnt { color: var(--accent); font-family: 'JetBrains Mono', monospace; }

  @media (max-width: 768px) {
    .my-wrap { padding: calc(var(--nav-h) + 20px) 16px 60px; }
    .my-title { font-size: 28px; }
    .req-item { padding: 14px 16px; }
  }
</style>

<div class="my-wrap">
  <nav class="my-breadcrumb">
    <a href="/">홈</a>
    <span class="sep">/</span>
    <span>내가 요청한 분석</span>
  </nav>

  <header class="my-head">
    <h1 class="my-title">내가 요청한 분석</h1>
    <div class="my-summary">
      <span>총 <strong><%= total %></strong>건 요청</span>
      <% if (total > 0) { %>
        <span class="pill-done">완료 <strong><%= done %></strong></span>
        <span class="pill-pending">대기 <strong><%= pending %></strong></span>
      <% } %>
      <span style="color:var(--sub2)">우선 분석 임계값 <%= requestThreshold %>명</span>
    </div>
  </header>

  <% if (total === 0) { %>
    <div class="empty">
      아직 요청한 법안이 없어요.<br>
      <a href="/bill">법안 둘러보기 →</a>
    </div>
  <% } else { %>
    <div class="req-list">
      <% requests.forEach(r => { %>
        <a href="/bill/<%= r.bill_id %>" class="req-item <%= r.has_ai_analysis ? 'done' : 'pending' %>">
          <div class="req-meta">
            <% if (r.has_ai_analysis) { %>
              <span class="status-pill done">✓ 분석 완료</span>
            <% } else { %>
              <span class="status-pill pending">⏳ 분석 대기</span>
            <% } %>
            <span>#<%= r.bill_no || r.bill_id %></span>
            <span style="color:var(--border2)">·</span>
            <span><%= r.requested_at %> 요청</span>
            <% if (r.proc_result_name) { %>
              <span style="color:var(--border2)">·</span>
              <span><%= r.proc_result_name %></span>
            <% } %>
          </div>
          <div class="req-title"><%= r.bill_name %></div>
          <% if (r.has_ai_analysis && r.ai_summary) { %>
            <div class="req-summary"><%= r.ai_summary %></div>
          <% } %>
          <div class="req-info">
            <% if (r.proposer_name) { %><span>대표발의 <%= r.proposer_name %></span><% } %>
            <% if (r.committee) { %><span>·</span><span><%= r.committee %></span><% } %>
            <% if (r.propose_dt) { %><span>·</span><span><%= r.propose_dt %></span><% } %>
            <% if (r.ai_category_main) { %>
              <span>·</span>
              <span class="ai-cat">
                <%= r.ai_category_main %><% if (r.ai_category_sub) { %><span style="color:var(--sub);font-weight:400"> · <%= r.ai_category_sub %></span><% } %>
              </span>
            <% } %>
            <% if (!r.has_ai_analysis && Number(r.request_count) > 0) { %>
              <span>·</span><span class="req-cnt">💡 AI 분석 <%= r.request_count %>명 요청</span>
            <% } %>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>
