        비로그인은 DB 에 아무것도 안 쌓인다 (utils/anonAxis.js). 로그인은 그 POST 가 곧 저장이라
        `/balance-game/respond` 가 2번 문항부터 이어진다 — 둘 다 같은 엔드포인트를 탄다. */
  .hero-q { margin-top: 24px; background: var(--bg2); border: 1px solid var(--border2); border-top: 3px solid var(--accent); padding: 19px 22px 17px; }
  .hero-q-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .hero-q-n { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; color: var(--accent2); }
  .hero-q-meta { font-size: 11.5px; color: var(--sub2); }
  .hero-q-t { margin: 9px 0 15px; font-size: 18.5px; font-weight: 800; line-height: 1.5; word-break: keep-all; }
  .hero-q-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .hero-opt {
