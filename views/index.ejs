<%- include('partials/header', { pageTitle: '메인', pageStyles: null, currentUrl: '/' }) %>

<section class="hero">
    <div class="hero-content">
        <h1>데이터로 검증하고, 투표로 평가하세요.</h1>
        <div class="search-bar">
            <input type="text" placeholder="국회의원 이름을 검색하세요">
            <button><i class="fas fa-search"></i></button>
        </div>
    </div>
    <div class="kpi-cards">
        <a href="/politician" class="kpi-card-link">
            <div class="kpi-card">
                <span class="value">300</span>
                <span class="label">전체 국회의원</span>
            </div>
        </a>
        <div class="kpi-card">
            <span class="value">8,974</span>
            <span class="label">계류중인 법안</span>
        </div>
        <div class="kpi-card">
            <span class="value">89.5%</span>
            <span class="label">평균 출석률</span>
        </div>
    </div>
</section>

<section class="trending-politician">
    <div class="section-header">
        <h2>화제의 인물</h2>
        <a href="/politician" class="view-more-link">전체보기 &rarr;</a>
    </div>
    <div class="card-scroll-container">
        <article class="politician-card">
            <img src="https://via.placeholder.com/80" alt="의원 사진">
            <div class="card-info">
                <div class="name">김민국</div>
                <div class="party">데이터당</div>
            </div>
        </article>
        <article class="politician-card">
            <img src="https://via.placeholder.com/80" alt="의원 사진">
            <div class="card-info">
                <div class="name">이하나</div>
                <div class="party">미래당</div>
            </div>
        </article>
    </div>
</section>

<section class="recent-activity">
    <h2>최근 주요 의정활동</h2>
    <div class="activity-list">
        <article class="bill-item">
            <div class="bill-info">
                <h3>미래산업 육성 특별법</h3>
                <span>2025-09-18 가결</span>
            </div>
            <div class="vote-result">
                <div class="vote-bar">
                    <div class="bar-yes" style="width: 65%;"></div>
                    <div class="bar-no" style="width: 25%;"></div>
                    <div class="bar-abs" style="width: 10%;"></div>
                </div>
                <div class="vote-labels">
                    <span class="label-yes">찬성 195</span>
                    <span class="label-no">반대 75</span>
                    <span class="label-abs">기권 30</span>
                </div>
            </div>
        </article>
    </div>
</section>

<section class="data-insight">
    <h2>데이터 인사이트</h2>
    <div class="insight-content">
        <p>정당별 법안 발의 분야 비교 (인포그래픽)</p>
    </div>
</section>

<%- include('partials/footer') %>