  .hero-q-foot { margin: 13px 0 0; padding-top: 12px; border-top: 1px dashed var(--border2); font-size: 12.5px; color: var(--sub2); }
  /* 답한 뒤 — 같은 자리에서 상태만 바뀐다 (화면이 튀지 않게) */
  /* ⚠️ `display: flex` 는 `[hidden]` 을 이긴다 — 명시적으로 꺼야 한다
     (`.bf-rest`·`.ba-proposers-grid`·`.sp-mts` 에서 반복해 겪은 함정) */
  .hero-q-done { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .hero-q-done[hidden] { display: none; }
  .hero-q-done b { font-size: 14px; font-weight: 800; }
  .hero-q-done span { font-size: 13px; color: var(--sub); }
  .hero-q-done a { margin-left: auto; font-size: 13.5px; font-weight: 800; color: var(--accent2); text-decoration: none; border-bottom: 2px solid var(--accent); padding-bottom: 2px; }

