  .hero-mine-lab { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; color: var(--accent2); }
  .hero-mine-t { margin: 8px 0 0; font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 24px; line-height: 1.35; letter-spacing: -0.01em; word-break: keep-all; }
  .hero-mine-s { margin: 7px 0 0; font-size: 13.5px; color: var(--sub); line-height: 1.7; word-break: keep-all; }
  .hero-mine-links { margin: 14px 0 0; padding-top: 13px; border-top: 1px dashed var(--border2); display: flex; flex-wrap: wrap; gap: 8px 16px; font-size: 13.5px; }
  .hero-mine-links a { color: var(--sub); text-decoration: none; border-bottom: 1px solid var(--border2); padding-bottom: 2px; }
  .hero-mine-links a:hover { color: var(--accent2); border-color: var(--accent2); }
  .hero-mine-links a.is-primary { color: var(--accent2); font-weight: 800; border-bottom: 2px solid var(--accent); }

  /* ── 지도 ────────────────────────────────────────────────
     ⚠️ 점에 정당색을 입히지 말 것. 두 덩어리로 갈리는 게 보이는데 색을 주면 그게 곧 정당 대비 구도가 된다
        (공유 카드 지도형과 같은 규칙 — 익명 회색이라 성립하는 그림이다) */
  .hero-map { background: var(--bg2); border: 1px solid var(--border); padding: 18px 20px 14px; min-width: 0; }
  .hero-map-h { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 11px; border-bottom: 1px solid var(--border); }
  .hero-map-h b { font-size: 14px; font-weight: 800; }
  .hero-map-h span { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--sub2); white-space: nowrap; }
  .hero-map svg { display: block; width: 100%; height: auto; }
  .hero-map-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: center; margin-top: 8px; padding-top: 10px; border-top: 1px solid var(--border); font-size: 11.5px; color: var(--sub2); }
  .hero-map-legend i { display: inline-block; vertical-align: middle; margin-right: 6px; border-radius: 50%; }
  .hero-lg-p { width: 7px; height: 7px; background: #8E8778; }
  .hero-lg-y { width: 11px; height: 11px; background: var(--accent); box-shadow: 0 0 0 3px rgba(184,116,12,0.18); }
  .hero-map[hidden] { display: none; }
  /* 점이 착지하는 연출 — 데이터가 자리를 찾는 움직임이라 장식이 아니다.
     ⚠️ prefers-reduced-motion 이면 JS 가 아예 클래스를 안 붙인다 (아래 스크립트) */
  .hero-map.is-anim .hp { opacity: 0; animation: hpIn 0.5s ease-out forwards; animation-delay: var(--d); }
  .hero-map.is-anim .hme { opacity: 0; animation: hmeIn 0.5s ease-out forwards; animation-delay: 820ms; }
  @keyframes hpIn  { from { opacity: 0; transform: translateY(6px); } to { opacity: 0.55; transform: none; } }
  @keyframes hmeIn { from { opacity: 0; } to { opacity: 1; } }

  /* ── 히어로 아래 날짜 스트립 — 구 마스트헤드의 날짜줄이 여기로 왔다 ──
     ⚠️ 브리핑 **헤드라인은 쓰지 않는다.** 바로 아래 「오늘의 1면」이 그 문장을 리드 기사로 크게 쓴다 */
  .hero-strip { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg3); }
  .hero-strip-in { max-width: 1280px; margin: 0 auto; padding: 12px 24px; display: flex; align-items: center; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; color: var(--sub); }
  .hero-strip .d { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; color: var(--accent2); }
  .hero-strip .sep { color: var(--border2); }
  .hero-strip b { color: var(--text); font-weight: 700; }
  /* nav 와 목적지가 겹치는 링크(의원·법안·차트·읽는 법)는 데스크톱에서 숨긴다 - 바로 위 메뉴줄과 중복이다.
     768px 이하는 .pb-nav-menu 가 통째로 display:none 이고 햄버거만 남아(main.css 반응형),
