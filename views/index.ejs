  .mine-pick-form button { padding: 7px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 700;
                           cursor: pointer; font-family: inherit;
                           border: 1px solid var(--accent); background: var(--accent); color: #fff; }
  .mine-pick-form button#mine-cancel { background: var(--bg2); color: var(--sub); border-color: var(--border2); }
  .mine-pick-msg { margin: 6px 0 0; font-size: 12px; color: var(--sub); }
  .mine-pick-msg:empty { display: none; }

  /* ===== 히어로 우측 — 무작위 의원 3명의 축 좌표 (.spot-*) (2026-08-16 2차) =====
     막대 문법은 의원 상세 `.pv-band` 와 같다 (왼끝 L · 오른끝 R · 골드 점 = 의원). 여기선 비교 대상이 "나" 가 아니라
     **소속 정당 평균**이라 눈금(세로 선)으로 그린다. 정당색 금지 — 골드·무채색만 */
  .spot { margin-top: 30px; padding-top: 18px; border-top: 1px solid var(--border); }
  .spot-cards { display: grid; grid-template-columns: 1fr; gap: 12px; margin-top: 12px; }
  /* 제목 바로 옆에 범례 — 양끝으로 갈라두면 제목과 무관해 보인다 */
  .spot-head { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .spot-title { font-size: 15px; font-weight: 800; color: var(--text); }
  .spot-legend { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--sub); }
  /* 🔴 `position: static` 이면 안 된다 — `.spot-tick::before`(삼각캡)가 absolute 라 자기 부모가 아니라
     **가장 가까운 positioned 조상(.pb-section)** 을 기준으로 잡힌다. 그러면 `top:-1px; left:50%` 가
     섹션 맨 위 한가운데가 되어, 범례에 붙어 있어야 할 작은 ▾ 가 **섹션 사이 허공에 혼자 떠 있었다**
     (2026-08-24 사용자 발견). `relative` 로 두면 캡이 마커 자신에게 붙는다. */
  .spot-legend .spot-dot, .spot-legend .spot-tick { position: relative; margin: 0 4px 0 10px; }
  /* 카드 = 가로 전체폭. 왼쪽 인적사항 220px | 오른쪽 막대 3줄. 3단(399px)은 글자가 10px 까지 내려가 안 읽혔다 (사용자 지적) */
  .spot-card {
    display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 20px; align-items: center;
    padding: 14px 20px;
    background: var(--bg2); border: 1px solid var(--border); border-radius: 12px;
    text-decoration: none; color: inherit;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  /* 🔴 카드·행의 hover 는 공용 `.pb-boxlink` 가 맡는다 (main.css).
     구 규칙들은 `transform: translateY(-2px)` 로 홈에서만 카드가 떠올랐고, 같은 특이도라
     뒤에 있는 이쪽이 이겨 공용 채움을 덮어썼다. 여기서 다시 정하지 말 것.
     `.mine` 은 <div> 라 카드 전체가 링크가 아니었는데 hover 만 있어 거짓 신호였다 → 아래 클릭 위임으로 해결. */
  .spot-who { display: grid; grid-template-columns: 48px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 12px; align-items: center; min-width: 0; }
  .spot-avatar { grid-row: 1 / 3; width: 48px; height: 48px; border-radius: 50%; overflow: hidden; }
  .spot-name { font-size: 17px; font-weight: 800; color: var(--text); white-space: nowrap; }
  .spot-meta { font-size: 12.5px; color: var(--sub2); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .spot-more { grid-column: 2; font-size: 12px; color: var(--accent2); white-space: nowrap; margin-top: 2px; }
  .spot-rows { display: grid; gap: 8px; }
  .spot-row { display: grid; grid-template-columns: 150px 84px minmax(0, 1fr) 84px; align-items: center; column-gap: 10px; }
  .spot-ax { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .spot-ax b { font-size: 14px; font-weight: 800; color: var(--text); }
  .spot-ax small { font-size: 12px; color: var(--sub2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .spot-end { font-size: 12.5px; color: var(--sub); white-space: nowrap; font-weight: 600; }
  .spot-end:nth-child(2) { text-align: right; }
  .spot-end .ls { display: none; }   /* 짧은 라벨은 모바일 전용 */
  .spot-track { position: relative; display: block; height: 22px; }
  .spot-track::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 6px; margin-top: -3px; background: var(--bg3); border: 1px solid var(--border); border-radius: 3px; }
  .spot-mid  { position: absolute; left: 50%; top: 3px; bottom: 3px; border-left: 1px dashed var(--border2); }
  /* 정당 평균 — 막대 위아래로 삐져나오는 진한 선 + 위 삼각캡. 상임위 참여율·격차 눈금의 평균 마커와 같은 언어 */
  .spot-tick { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--text); box-shadow: 0 0 0 1.5px var(--bg2); display: inline-block; height: 22px; }
  .spot-tick::before { content: ''; position: absolute; top: -1px; left: 50%; width: 0; height: 0; margin-left: -4px; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid var(--text); }
  .spot-dot  { position: absolute; top: 50%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg2); box-shadow: 0 0 0 1.5px var(--accent); display: inline-block; z-index: 1; }
  .spot-note { margin: 10px 0 0; font-size: 12px; line-height: 1.6; color: var(--sub2); word-break: keep-all; }

  /* 결론 3숫자 스트립 — 히어로에서 내려온 것 (「숫자로 본 국회」 머리). 순서 = 논리 (계류 → 반대 → 불참) */
  .facts-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }
  .fact-cell {
    display: flex; flex-direction: column; gap: 3px; padding: 14px 16px;
    background: var(--bg2); border: 1px solid var(--border); border-radius: 12px;
    text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s;
  }
  /* ⚠️ 큰 숫자는 mono 로. 한글이 안 섞이는 자리라 폴백 걱정이 없다 */
  .fact-num { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 30px; line-height: 1; color: var(--accent2); letter-spacing: -0.02em; }
  .fact-num small { font-size: 15px; margin-left: 2px; }
  .fact-title { font-size: 13px; font-weight: 800; color: var(--text); }
  .fact-desc { font-size: 12px; line-height: 1.6; color: var(--sub); word-break: keep-all; }
  .fact-desc strong { color: var(--text); font-weight: 700; }

  /* 섹션 공통 각주 — 숫자 옆 한계 표기는 이 사이트의 기본 규칙이다 */
  .pb-sec-note {
    margin: 14px 0 0; font-size: 12px; line-height: 1.7;
    color: var(--sub2); word-break: keep-all;
  }

  /* ===== B · 국회는 이렇게 굴러갑니다 (2026-08-25) =====================================
     🔴 이 세 숫자는 원래 문서 **맨 끝** 「숫자로 본 국회」 위의 작은 스트립(`.facts-strip`)이었다.
        이 사이트에서 가장 충격적인 사실인데 아무도 거기까지 스크롤하지 않는다. 히어로 바로 다음으로 올렸다.
     🔴 **순서가 곧 논리다**: 계류 → 반대 → 불참 ("발의는 넘치는데 대부분 심사 중이고, 본회의에 온 건
        거의 다 통과하며, 그마저도 다섯 번 중 한 번은 빠진다"). 하나를 빼거나 순서를 바꾸면 이야기가 끊긴다.
     🔴 숫자를 키우기만 하지 않는다 — **숫자를 그림으로** 만든다 (100칸 그리드 · 147개 눈금 · 중앙값 마커).
        읽지 않고도 크기가 오게 하는 게 목적이라 장식이 아니다.
     ⚠️ 숫자는 전부 `getHomeFacts` 산출값이다. 화면에 하드코딩하지 말 것 — 배치가 매일 움직인다. */
  .nums-kick { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; padding-bottom: 15px; border-bottom: 2px solid var(--text); }
  .nums-kick .t { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; font-weight: 700; letter-spacing: 0.16em; color: var(--text); }
  .nums-kick .s { font-size: 12.5px; color: var(--sub2); }
  .nums-kick .go { margin-left: auto; font-size: 13px; color: var(--sub); text-decoration: none; border-bottom: 1px solid var(--border2); padding-bottom: 2px; }
  .nums-kick .go:hover { color: var(--accent2); border-color: var(--accent2); }

  .nums-main { display: grid; grid-template-columns: auto 1fr; gap: 46px; align-items: center; padding: 32px 0 28px; text-decoration: none; color: inherit; }
  .nums-num { font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: clamp(74px, 10vw, 140px); line-height: 0.86; letter-spacing: -0.045em; font-variant-numeric: tabular-nums; color: var(--text); }
  .nums-num small { font-size: 0.38em; letter-spacing: -0.02em; color: var(--accent); }
  /* ⚠️ 마크업이 <a> 안이라 전부 <span> 이다. `display:block` 을 빼면 max-width·margin·height 가
     통째로 무시된다 (인라인 상자에는 안 먹는다). 아래 .nums-bar·.say·.fn 도 같은 이유 */
  .nums-said { display: block; font-size: clamp(19px, 1.9vw, 25px); font-weight: 800; line-height: 1.55; letter-spacing: -0.01em; max-width: 21ch; word-break: keep-all; }
  .nums-said em { font-style: normal; color: var(--accent2); box-shadow: inset 0 -10px 0 rgba(184,116,12,0.14); }
  /* 🔴 「그래서 뭐?」 에 답하는 줄. 큰 문장(`.nums-said`)이 뜻을 말하고 여기가 **결과**를 말한다.
     mono 를 쓰지 않는다 — 산문이고, JetBrains Mono 는 한글 글리프가 없어 폴백된다 */
  .nums-so { display: block; margin: 16px 0 0; max-width: 46ch; font-size: 14.5px; line-height: 1.8; color: var(--sub); word-break: keep-all; }
  .nums-so b { color: var(--text); font-weight: 700; }
  .nums-sub { display: block; margin: 10px 0 0; font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: var(--sub2); }
  /* 해석 주의 — 숫자와 세트다. `.pb-note`(main.css)가 타이포를 정하고 여기는 자리만 잡는다 */
  /* ⚠️ 아래 여백을 빼지 말 것 — `.nums-band` 의 위 테두리에 글자가 그대로 붙는다 (실측 간격 0) */
  /* ⚠️ 바로 위 카드 각주(`.fn`, 11.5px)와 크기가 비슷해 그냥 두면 한 덩어리로 읽힌다.
     하나는 **그 카드의 각주**, 이건 **섹션 전체의 각주**라 가는 선으로 층을 가른다 */
  .nums-note { margin: 0; padding: 18px 0 0; border-top: 1px solid var(--border); max-width: 64ch; }
  .nums-note a { color: var(--accent2); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  /* 100칸 = 법안 100건. 채워진 칸이 곧 계류 비율이라 숫자와 그림이 같은 값이다 */
  .nums-grid { display: grid; grid-template-columns: repeat(25, 1fr); gap: 5px; max-width: 520px; margin-top: 20px; }
  .nums-grid i { aspect-ratio: 1; background: var(--border); display: block; }
  .nums-grid i.on { background: var(--accent); }

  /* 🔴 두 칸을 **균등하게 두지 말 것** (2026-08-26 디자인 평). 카드 1 만 크고 2·3 이 나란하면
     읽는 사람이 "그래서 뭐가 제일 중요한데" 를 못 잡는다. 뒤로 갈수록 무거워져 다크 밴드로 이어지게 한다.
     🔴 **순서(계류 → 반대 → 불참)는 바꾸지 않는다.** 셋은 하나의 사슬이고(getHomeFacts.sql 머리 주석),
        무엇보다 불참을 맨 앞에 세우면 홈 첫 주장이 사실상 **"국회의원들이 자리에 없다"** 가 된다 —
        장관 겸직·의장 관례·보이콧이 섞인 값이라 평가로 읽히면 안 된다. 위계는 순서가 아니라 **크기**로 준다 */
  .nums-band { border-top: 1px solid var(--border2); display: grid; grid-template-columns: 1fr 1.28fr; }
  .nums-cell { padding: 24px 30px 26px; text-decoration: none; color: inherit; }
  .nums-cell:first-child { border-right: 1px solid var(--border2); }
  /* 마지막 칸이 사람 이야기로 넘어가는 자리다 — 숫자와 문장을 한 단계 크게 */
  .nums-cell:last-child .v { font-size: 52px; }
  .nums-cell:last-child .say { font-size: 17px; }
  .nums-cell .h { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .nums-cell .v { font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 44px; line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .nums-cell .k { font-size: 13px; font-weight: 700; color: var(--sub); }
  .nums-cell .say { display: block; margin: 11px 0 0; font-size: 15px; font-weight: 700; line-height: 1.6; word-break: keep-all; }
  .nums-cell .fn { display: block; margin: 7px 0 0; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--sub2); line-height: 1.6; }
  /* 눈금 147개 중 하나 = 반대표 0.68%. 희소함 자체가 정보다 */
  .nums-ticks { display: flex; gap: 1px; margin-top: 15px; height: 26px; align-items: flex-end; }
  .nums-ticks i { flex: 1 1 0; min-width: 1px; height: 13px; background: var(--border2); display: block; }
  .nums-ticks i.on { height: 26px; background: var(--accent); }
  .nums-bar { display: block; position: relative; margin-top: 15px; height: 12px; background: var(--bg3); border: 1px solid var(--border); }
  .nums-bar span { position: absolute; top: 0; bottom: 0; left: 0; background: var(--accent); }
  /* 중앙값 마커 — 사이트 공통 평균 마커 언어 (막대 위아래로 삐치게). `em` 이라 기울임을 끈다 */
  .nums-bar em { position: absolute; top: -5px; bottom: -5px; width: 2px; background: var(--text); font-style: normal; }
  .nums-scale { display: flex; justify-content: space-between; gap: 8px; margin-top: 5px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--sub2); }

  /* 다크 밴드 — 스크롤 전체에서 유일하게 어두운 면이다. 여기가 A(당신) 와 C(오늘) 를 잇는 논지.
     ⚠️ 골드는 선·글자에만. 면을 골드로 채우면 다크 위에서 탁한 갈색이 된다 (공유 카드에서 겪은 것) */
  .nums-thesis { background: var(--text); color: #F7F6F1; margin-top: 0; }
  .nums-thesis-in { max-width: 1280px; margin: 0 auto; padding: 28px 24px; display: flex; align-items: center; gap: 26px; flex-wrap: wrap; }
  .nums-thesis b { display: block; font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: clamp(21px, 2.2vw, 27px); letter-spacing: -0.01em; line-height: 1.4; word-break: keep-all; }
  .nums-thesis b em { font-style: normal; color: #D9A040; }
  .nums-thesis p { margin: 9px 0 0; font-size: 13.5px; color: #B9B4A8; max-width: 42ch; line-height: 1.7; word-break: keep-all; }
  .nums-thesis .cta { margin-left: auto; display: flex; gap: 10px; flex-wrap: wrap; }
  .nums-btn { padding: 12px 22px; font-size: 14px; font-weight: 700; background: #D9A040; color: #1A1D24; text-decoration: none; white-space: nowrap; }
  .nums-btn:hover { background: #E8B25A; }
  .nums-btn.ghost { background: transparent; color: #F7F6F1; box-shadow: inset 0 0 0 1px #4A4740; }
  .nums-btn.ghost:hover { box-shadow: inset 0 0 0 1px #8B8579; background: rgba(255,255,255,0.04); }
  /* ⚠️ nav 가 고정이라 `#mine` 으로 뛰면 섹션 머리가 그 뒤로 들어간다. main.css 에 전역 규칙이 없어 여기서 준다.
     🔴 60px 을 하드코딩하지 말 것 — `--nav-h` 는 반응형이다 (데스크톱 100 · 모바일 60) */
  #mine { scroll-margin-top: calc(var(--nav-h) + 16px); }

  /* ===== C · 오늘의 1면 — 브리핑 (2026-08-25 재구성) ==================================
     🔴 구 버전은 24px 헤드라인 카드 + 목록이었다. 매일 쌓이는 **유일한 신규 콘텐츠**인데
        여섯 섹션 중 하나로 묻혔다. 리드 기사 크기로 키우고 2단 조판·드롭캡을 준다.
     ⚠️ 사이드바(오늘의 숫자)를 여기 다시 두지 말 것 — 바로 위 B 가 그 셋을 크게 말한다. */
  .bf-mast { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 9px 0; border-top: 3px solid var(--text); border-bottom: 1px solid var(--text); margin-bottom: 22px; }
  .bf-mast .d { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; font-weight: 700; letter-spacing: 0.13em; }
  .bf-mast .x { color: var(--border2); }
  .bf-mast .s { font-size: 12px; color: var(--sub2); }
  .bf-mast .go { margin-left: auto; font-size: 12.5px; color: var(--sub); text-decoration: none; border-bottom: 1px solid var(--border2); padding-bottom: 2px; }
  .bf-mast .go:hover { color: var(--accent2); border-color: var(--accent2); }

  .home-bf { display: grid; grid-template-columns: 1.62fr 1fr; gap: 0; align-items: start; }
  .bf-lead { display: block; padding: 0 34px 0 0; border-right: 1px solid var(--border2); text-decoration: none; color: inherit; min-width: 0; }
  .bf-lead-top { display: flex; align-items: center; gap: 10px; }
  .bf-stamp { display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; font-weight: 700; letter-spacing: 0.13em; color: var(--accent2); border: 1px solid var(--accent); padding: 4px 9px; }
  .bf-stamp.is-fallback, .bf-stamp.is-none { color: var(--sub2); border-color: var(--border2); }
  .bf-lead-title {
    margin: 13px 0 0; font-family: 'Noto Serif KR', serif; font-weight: 900;
    font-size: clamp(24px, 2.8vw, 37px); line-height: 1.28; letter-spacing: -0.022em;
    color: var(--text); word-break: keep-all; text-wrap: balance;
  }
  /* 2단 + 드롭캡 — 지면 문법. ⚠️ `column-count` 안에서는 line-clamp 가 안 먹으므로 서버가 길이를 자른다 */
  .bf-lead-body {
    margin: 14px 0 0; font-size: 14.5px; line-height: 1.85; color: var(--sub); word-break: keep-all;
    column-count: 2; column-gap: 26px; column-rule: 1px solid var(--border);
  }
  .bf-lead-body::first-letter { font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 40px; float: left; line-height: 0.9; padding: 3px 8px 0 0; color: var(--text); }
  /* `pb-boxlink` 을 안 쓴다 (그건 카드용 셰브론·테두리 문법이다). 리드 기사는 제목 색으로만 반응한다 */
  .bf-lead:hover .bf-lead-title { color: var(--accent2); }
  .bf-side { padding-left: 30px; min-width: 0; }
  .bf-side-h { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; font-weight: 700; letter-spacing: 0.15em; color: var(--sub2); padding-bottom: 9px; border-bottom: 1px solid var(--border2); }
  .bf-list { list-style: none; margin: 0; padding: 0; }
  .bf-list a {
    display: grid; grid-template-columns: 44px 1fr auto; gap: 12px; align-items: baseline;
    padding: 12px 0; border-bottom: 1px solid var(--border);
    text-decoration: none; color: inherit;
  }
  .bf-list a:hover .bf-item-title { color: var(--accent2); }
  .bf-list a:hover .bf-item-ar { color: var(--accent); }
  .bf-item-date { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; color: var(--sub2); }
  .bf-item-title {
    min-width: 0; font-size: 14px; line-height: 1.55; color: var(--text); word-break: keep-all;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .bf-item-ar { color: var(--border2); font-size: 13px; }

  /* 나와 맞는 의원 */
  .match-links { display: flex; gap: 16px; flex-wrap: wrap; justify-content: flex-end; }
  .match-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .match-card {
    display: flex; align-items: center; gap: 14px; padding: 16px 18px;
    background: var(--bg2); border: 1px solid var(--border); border-radius: 12px;
    text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s;
  }
  /* ⚠️ 크기는 래퍼에 준다 — avatarHtml 이 width/height 100% 인라인으로 부모를 채운다
     (자식에 CSS 로 px 을 걸면 인라인이 이겨서 무시된다. 법안 카드 아바타에서 겪었다) */
  .match-avatar { flex: 0 0 56px; width: 56px; height: 56px; border-radius: 50%; overflow: hidden; }
  .match-body { flex: 1 1 auto; min-width: 0; }
  .match-name { font-size: 15px; font-weight: 700; color: var(--text); }
  .match-retired {
    font-style: normal; font-size: 10.5px; font-weight: 700; color: var(--sub2);
    border: 1px solid var(--border2); border-radius: 4px; padding: 1px 5px; margin-left: 4px;
  }
  .match-meta { margin-top: 3px; font-size: 12px; color: var(--sub2); overflow-wrap: anywhere; }
  /* 순번(1·2·3) — 일치도 %가 아니다. 왜인지는 마크업 주석에 */
  .match-pct {
    flex: 0 0 auto; font-family: 'JetBrains Mono', monospace; font-weight: 700;
    font-size: 24px; color: var(--accent2); line-height: 1;
    display: flex; align-items: baseline; gap: 2px;
  }
  .match-pct small { font-size: 11px; font-family: 'Noto Sans KR', sans-serif; color: var(--sub2); }
  .match-cta {
    padding: 32px 28px; text-align: center;
    background: var(--bg2); border: 1px dashed var(--border2); border-radius: 14px;
  }
  .match-cta-lead {
    margin: 0 auto; max-width: 620px; font-size: 15px; line-height: 1.8;
    color: var(--text); word-break: keep-all;
  }
  .match-cta-sub {
    margin: 8px auto 20px; max-width: 620px; font-size: 13px; line-height: 1.7;
    color: var(--sub2); word-break: keep-all;
  }

  /* 숫자로 본 국회 / 차트 만들기 */
  .explore-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .explore-card {
    display: block; padding: 22px; text-decoration: none; color: inherit;
    background: var(--bg2); border: 1px solid var(--border); border-radius: 14px;
    transition: border-color 0.15s, transform 0.15s;
  }
  .explore-kicker {
    font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700;
    letter-spacing: 0.1em; color: var(--accent2);
  }
  .explore-title {
    margin: 10px 0 0; font-size: 17px; font-weight: 800; color: var(--text);
    line-height: 1.4; word-break: keep-all;
  }
  .explore-desc {
    margin: 8px 0 0; font-size: 13px; line-height: 1.75; color: var(--sub); word-break: keep-all;
  }

  /* 히어로 2열 → 1열. 지도를 글 **위**로 올린다 — 첫 화면에 그림이 먼저 와야 이 개편의 뜻이 산다.
     ⚠️ 1024px 에서 접는 이유: 그 아래로 가면 지도 칸이 400px 미만이 되어 사분면 라벨이 점과 겹친다 */
  /* ⚠️ 1024 가 아니라 940 이다. 1024 에서 접으면 지도가 620px, 글이 그 아래로 내려가 히어로가
     1,195px 이 된다 — 2열로 두면 706px 이고 지도도 여전히 읽힌다 (실측). 940 아래에서만 접는다 */
  @media (max-width: 940px) {
    .hero-grid { grid-template-columns: 1fr; gap: 26px; }
    .hero-left { order: 2; }
    .hero-map { order: 1; }
    .hero-deck { max-width: none; }
    /* 🔴 1열이 되면 지도 폭을 반드시 조일 것. 판이 거의 정사각(520×460)이라 976px 폭이면
       **863px 높이**가 되어 히어로가 한 화면을 통째로 먹는다 (1024px 실측). 620px 이면 약 511px */
    .hero-map { max-width: 620px; width: 100%; margin-inline: auto; }
  }
  @media (max-width: 900px) {
    .spot-card { grid-template-columns: 1fr; gap: 12px; }
    .spot-row { grid-template-columns: 110px 70px minmax(0, 1fr) 70px; }
    .match-grid, .explore-grid, .facts-strip { grid-template-columns: 1fr; }
    /* B — 거대 숫자 옆에 문장을 두면 둘 다 좁아진다. 위아래로 쌓는다 */
    .nums-main { grid-template-columns: 1fr; gap: 18px; }
    .nums-band { grid-template-columns: 1fr; }
    .nums-cell:first-child { border-right: 0; border-bottom: 1px solid var(--border2); }
    .nums-thesis .cta { margin-left: 0; }
    /* C — 1면 2단이 무너지는 폭. 리드가 위, 목록이 아래 */
    .home-bf { grid-template-columns: 1fr; gap: 24px; }
    .bf-lead { padding-right: 0; border-right: 0; }
    .bf-side { padding-left: 0; }
  }
  @media (max-width: 768px) {
    .fact-num { font-size: 26px; }
    /* 모바일 스크롤 피로 — 진입 카드 설명은 2줄, 브리핑 본문은 3줄까지만. 진입 카드는 세로 여백도 조인다 */
    .explore-card { padding: 16px 18px; }
    .explore-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .bf-lead-body { -webkit-line-clamp: 3; }
    .facts-strip { gap: 8px; }
    .fact-cell { padding: 12px 14px; }
    .fact-desc { display: none; }   /* 모바일은 큰 숫자 + 제목만 — 설명은 누르면 나오는 페이지가 한다 */
    /* ⚠️ 900px 블록 뒤에 있어야 한다 — 같은 특이도라 파일 순서가 우선순위다.
       모바일은 축 행을 **한 줄** 유지 (세 줄로 접으면 카드가 337px, 3장 1,197px 로 홈의 1/4 을 먹었다 — 실측).
       양끝은 짧은 라벨(시장/개입)로, 긴 형은 .spot-end 의 data-long 을 ::after 로… 대신 축 이름 아래 설명이 남는다 */
    .spot-card { padding: 12px 14px; gap: 10px; }
    .spot-who { grid-template-columns: 40px minmax(0, 1fr); }
    .spot-avatar { width: 40px; height: 40px; }
    .spot-name { font-size: 15px; }
    .spot-more { display: none; }
    .spot-rows { gap: 6px; }
    .spot-row { grid-template-columns: 82px 30px minmax(0, 1fr) 30px; column-gap: 6px; }
    .spot-ax b { font-size: 13px; }
    .spot-ax small { font-size: 10.5px; }
    .spot-end { font-size: 11px; }
    .spot-end .lx { display: none; }
    .spot-end .ls { display: inline; }
    /* C — 모바일에서 2단 조판은 한 단에 8글자가 된다. 1단 + 드롭캡 유지.
       ⚠️ 1단이 되면 `-webkit-line-clamp` 가 다시 먹는다 (2단에서는 안 먹어 서버가 잘랐다).
          여기서는 리드 문단이 전부 보일 필요가 없다 — 전문은 누르면 나오는 브리핑 페이지가 한다 */
    /* ⚠️ `column-count: 1` 이 아니라 `auto` 여야 한다 — 값이 있으면 다단 컨테이너로 취급돼
       브라우저가 `-webkit-box` 를 `flow-root` 로 바꾸고 클램프가 통째로 무시된다 (실측으로 잡았다) */
    .bf-lead-body { column-count: auto; column-rule: 0;
                    display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
    .bf-lead-body::first-letter { font-size: 34px; }
    /* B — 100칸 그리드는 25열이면 칸이 3px 이 된다. 20열 5줄로 (여전히 100칸) */
    .nums-grid { grid-template-columns: repeat(20, 1fr); gap: 4px; }
    /* 🔴 눈금은 `min-width:1px` 이라 더 못 줄어든다. 간격 1px 을 유지하면 147개일 때 최소 293px 이 필요한데
       320px 화면의 안쪽 폭이 **296px** 이다 (여유 3px). 반대표 비율이 더 낮아져 눈금이 200개가 되면
       그대로 넘친다 → 좁은 화면에서는 간격을 0 으로 (200개여도 200px) */
    .nums-ticks { gap: 0; }
    .nums-main { padding: 22px 0 20px; }
    .nums-cell { padding: 18px 0 20px; }
    /* 1열이 되면 두 칸의 폭이 같아진다 — 데스크톱의 확대 배율을 되돌린다 */
    .nums-cell:last-child .v { font-size: 36px; }
    .nums-cell:last-child .say { font-size: 15px; }
    /* 줄이 접히면 `margin-left:auto` 가 링크만 오른쪽 끝으로 밀어 홀로 떨어져 보인다 */
    .nums-kick .go { margin-left: 0; }
    .nums-cell .v { font-size: 36px; }
    .nums-thesis-in { padding: 24px 16px; gap: 18px; }
    .nums-btn { padding: 11px 18px; font-size: 13.5px; }
    /* 🔴 SVG 글자는 viewBox 와 함께 줄어든다. 520 유저단위 판이 343px 로 그려지면 배율이 0.66 이라
       font-size 11 이 **7.3px** 이 된다 (`/xray` 차트에서 2.6px 까지 뭉개졌던 것과 같은 문제).
       유저단위를 키워 화면에서 약 10.5px 이 되게 맞춘다. ⚠️ 값을 내리기 전에 실제 렌더 크기를 잴 것 */
    .hero-map svg text { font-size: 18px; }
    /* A — 문항 옵션은 세로로 (가로 2칸이면 한 칸에 6글자가 된다) */
    .hero-q-opts { grid-template-columns: 1fr; }
    .hero-q, .hero-mine { padding: 16px 16px 15px; }
    .hero-strip-in { padding: 11px 16px; }
  }

  /* (구 홈 전용 CSS 40개 규칙 삭제 — KPI 5칸(.kpi-*) · 정당 이동(.pm-*) · 표결 표(.vote-*) ·
     발의 랭킹(.politician*). 2026-08-16 홈 재구성으로 마크업이 사라져 참조 0.
     되살리기 전에 CLAUDE.md "홈 재구성" 의 실측을 읽을 것) */
</style>

<%
  /* JSON → 스크립트. 법안명·문항 문구가 그대로 들어가므로 `<` 를 반드시 막는다
     (respond.ejs·bill_detail.ejs 와 같은 헬퍼) */
  const escape = (s) => JSON.stringify(s).replace(/</g, '\\u003c');

  /* 날짜줄 — 서버 시각을 KST 로 (로컬 getter 금지 규칙). 어제 브리핑이 있으면 발의 수를 같이 */
  const _kst = new Intl.DateTimeFormat('ko-KR', { timeZone: 'Asia/Seoul', year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }).format(new Date());
  const _bfs = locals.briefings || [];
  const _lead = _bfs[0] || null;
  const _leadDate = _lead ? String(_lead.briefing_date || '').slice(5).replace('-', '.') : null;
  const _st = _lead && _lead.stats ? (typeof _lead.stats === 'string' ? JSON.parse(_lead.stats) : _lead.stats) : null;

  /* 히어로 지도 — 평면은 경제(x) × 사회·문화(y) 두 축만. 제도축은 안 그린다 (공유 카드 지도형과 같은 규칙).
     ⚠️ 소수점 2자리로 줄여 내보낸다. 269점 × 원본 정밀도면 페이로드가 세 배가 되는데 화면에서 1px 도 안 달라진다 */
  const _cloud = (locals.axisCloud || [])
      .filter((p) => p && p[0] != null && p[1] != null)
      .map((p) => [Math.round(Number(p[0]) * 100) / 100, Math.round(Number(p[1]) * 100) / 100]);
  const _q1 = locals.firstQuestion || null;
  /* 완료자의 내 좌표 — 미들웨어가 로그인·익명(쿠키) 어느 쪽이든 채워 준다 */
  const _me = (locals.balanceGameCompleted && locals.userAxis) ? locals.userAxis : null;
  const _mePt = _me && _me.economy != null && _me.social != null
      ? [Math.round(Number(_me.economy) * 100) / 100, Math.round(Number(_me.social) * 100) / 100] : null;
  const _myType = _me && AXIS.typeOf ? AXIS.typeOf(_me) : null;
  const _near = (locals.matches || [])[0] || null;
%>

<!-- ═══ A · HERO — 좌표 위의 당신 (2026-08-25) ═══════════════════════════════════
     좌 = 헤드라인·데크·첫 문항 / 우 = 좌표 있는 의원 전원의 익명 점구름.
     🔴 완료자에겐 문항 대신 **내 좌표**가 그 자리에 온다. 방금 20문항을 푼 사람에게
        다시 1번 문항을 보여주면 안 된다 (`/auth/welcome` 에서 겪은 것과 같은 실수) -->
<section class="home-hero">
  <div class="home-hero-inner">
    <div class="hero-grid">
      <div class="hero-left">
        <% if (_cloud.length) { %>
          <div class="hero-eyebrow">좌표가 있는 의원 <%= nf(_cloud.length) %>명</div>
        <% } else { %>
          <div class="hero-eyebrow">22대 국회 · 국회 공개 자료</div>
        <% } %>

        <% if (_me) { %>
          <h1 class="hero-title">이 안에서 당신은 <em>여기</em>에 있습니다.</h1>
          <p class="hero-deck">국회의원 한 사람 한 사람이 <strong>어떤 법안에 이름을 올렸는지</strong>로 좌표를 만들었습니다.
            점 하나가 의원 한 명이고, 골드 점이 당신입니다.</p>
        <% } else { %>
          <h1 class="hero-title">이 안에서 당신은 <em>어디쯤</em>입니까?</h1>
          <p class="hero-deck">국회의원 한 사람 한 사람이 <strong>어떤 법안에 이름을 올렸는지</strong>로 좌표를 만들었습니다.
            점 하나가 의원 한 명입니다. 문항에 답하면 그 사이에 <strong>당신의 점</strong>이 찍힙니다.</p>
        <% } %>

        <% if (_me) { %>
          <%# ── 완료자 — 문항 카드와 같은 자리·같은 상자 ── %>
          <div class="hero-mine">
            <div class="hero-mine-lab">내 성향 좌표</div>
            <% if (_myType && _myType.name) { %>
              <p class="hero-mine-t"><%= _myType.name %></p>
              <% if (_myType.sub) { %><p class="hero-mine-s"><%= _myType.sub %></p><% } %>
            <% } else { %>
              <p class="hero-mine-t">진단을 마쳤습니다.</p>
            <% } %>
            <% if (_near) { %>
              <p class="hero-mine-s">좌표가 가장 가까운 의원은 <strong><%= _near.name %></strong><%
                %><% if (_near.electoral_district) { %> (<%= _near.electoral_district %>)<% } %> 입니다.</p>
            <% } %>
            <div class="hero-mine-links">
              <a class="is-primary" href="/balance-game/reveal">내 카드 보기</a>
              <a href="/politician?sort=match-desc">가까운 의원 전체</a>
              <a href="/balance-game/compare">의원과 비교</a>
              <a href="/balance-game/respond?redo=1">다시 진단</a>
            </div>
          </div>
        <% } else if (_q1) { %>
          <%# ── 미완료 — 첫 문항. 답하면 같은 상자 안에서 상태만 바뀐다 (화면이 튀지 않게).
              🔴 **시작만 하고 안 끝낸 사람**(`balanceGameAnswered > 0`)에게는 1번 문항을 보여주지 않는다.
                 서버가 아는 건 로그인 사용자뿐이라, 비로그인은 아래 스크립트가 localStorage 를 보고 같은 판정을 한다 ── %>
          <div class="hero-q" id="hero-q" data-qid="<%= _q1.id %>"
               data-axis="<%= _q1.axis %>"
               data-score-a="<%= _q1.option_a_score %>"
               data-score-b="<%= _q1.option_b_score %>"
               <%= (locals.balanceGameAnswered > 0) ? 'data-resume="1"' : '' %>>
            <div id="hero-q-ask"<%= (locals.balanceGameAnswered > 0) ? ' hidden' : '' %>>
              <div class="hero-q-top">
                <span class="hero-q-n">Q1 / 20 · <%= (AXIS.AXIS_META[_q1.axis] || {}).name || _q1.axis %></span>
                <span class="hero-q-meta">가입 없이 · 약 4분</span>
              </div>
              <p class="hero-q-t"><%= _q1.prompt %></p>
              <div class="hero-q-opts">
                <button type="button" class="hero-opt" data-opt="A"><%= _q1.option_a_text %></button>
                <button type="button" class="hero-opt" data-opt="B"><%= _q1.option_b_text %></button>
                <button type="button" class="hero-opt is-skip" data-opt="C">잘 모르겠다 / 관심 없음</button>
              </div>
              <p class="hero-q-foot">답변은 이 브라우저에 저장됩니다. 20문항을 마치면 가장 가까운 의원 3명이 나옵니다.</p>
            </div>
            <%# 답한 뒤 상태. JS 가 켜거나, 서버가 "이미 시작함" 을 알면 SSR 로 켠 채 나간다 %>
            <div id="hero-q-done" class="hero-q-done"<%= (locals.balanceGameAnswered > 0) ? '' : ' hidden' %>>
              <b id="hero-q-done-b"><%= (locals.balanceGameAnswered > 0) ? '진단을 시작했습니다.' : '1문항 반영됨.' %></b>
              <span id="hero-q-done-s">남은 문항에 답하면 가장 가까운 의원 3명이 나옵니다.</span>
              <a href="/balance-game/respond" id="hero-q-go">이어서 풀기 →</a>
            </div>
          </div>
        <% } else { %>
          <%# 문항 조회 실패 폴백 — 진단으로 가는 길은 남긴다 %>
          <div class="hero-links">
            <a class="is-primary" href="/balance-game">성향 진단 시작하기 →</a>
          </div>
        <% } %>

        <div class="hero-links">
          <a class="is-navdup" href="/politician">의원</a>
          <span class="sep is-navdup">·</span><a class="is-navdup" href="/bill">법안</a>
          <span class="sep is-navdup">·</span><a class="is-navdup" href="/xray">숫자로 본 국회</a>
          <span class="sep is-navdup">·</span><a class="is-navdup" href="/guide">읽는 법</a>
        </div>
      </div>

      <%# ⚠️ 좌표가 하나도 없으면(배치 미실행·조회 실패) 지도를 통째로 안 그린다. 빈 판은 고장으로 읽힌다 %>
      <% if (_cloud.length) { %>
        <div class="hero-map" id="hero-map">
          <div class="hero-map-h">
            <b>22대 국회의원 좌표</b>
            <span>경제 × 사회·문화</span>
          </div>
          <svg id="hero-cloud" viewBox="0 0 520 460" role="img"
               aria-label="좌표가 있는 국회의원 <%= nf(_cloud.length) %>명을 경제·사회 두 축 평면에 익명 점으로 그린 산점도<%= _mePt ? ' (내 위치 포함)' : '' %>"></svg>
          <div class="hero-map-legend">
            <span><i class="hero-lg-p"></i>의원 <%= nf(_cloud.length) %>명</span>
            <span id="hero-lg-me" <%= _mePt ? '' : 'hidden' %>><i class="hero-lg-y"></i><span id="hero-lg-me-t"><%= _mePt ? '나' : '' %></span></span>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%# 구 마스트헤드의 날짜줄. ⚠️ 브리핑 **헤드라인은 쓰지 않는다** — 아래 「오늘의 1면」이 크게 쓴다 %>
<div class="hero-strip">
  <div class="hero-strip-in">
    <span class="d"><%= _kst %></span>
    <span class="sep">·</span><span>22대 국회</span>
    <% if (_st && _st.proposed != null) { %><span class="sep">·</span><span><%= _leadDate %> 발의 <b><%= nf(_st.proposed) %>건</b></span><% } %>
    <span class="sep">·</span><span>국회 공개 자료 매일 갱신</span>
  </div>
</div>

<%# ═══ B · 국회는 이렇게 굴러갑니다 (2026-08-25) ═══════════════════════════════════
    🔴 이 세 숫자는 원래 문서 **맨 끝** 「숫자로 본 국회」 위의 작은 스트립이었다. 히어로 다음으로 올렸다.
    🔴 순서가 곧 논리다: 계류 → 반대 → 불참. 하나를 빼거나 순서를 바꾸면 이야기가 끊긴다.
    ⚠️ 실패하면 f 가 null 이라 이 섹션만 통째로 빠지고 홈은 산다 %>
<% if (f) { %>
  <%
    /* 그림용 파생값 — 전부 f 에서 나온다. 화면에 상수를 박지 말 것 */
    const _pendCells = Math.max(0, Math.min(100, Math.round(Number(f.pending_rate) || 0)));
    /* 반대표 1건이 나오려면 표결 몇 건이 필요한가. 0.68% → 147.
       ⚠️ 40~200 으로 조인다 — 눈금이 40개 미만이면 희소해 보이지 않고, 200 을 넘으면 한 칸이 1px 미만이 된다 */
    const _oppOf = Number(f.oppose_rate) > 0 ? Math.round(100 / Number(f.oppose_rate)) : 0;
    const _ticks = _oppOf >= 40 && _oppOf <= 200 ? _oppOf : 0;
    const _absent = Math.max(0, Math.min(100, Number(f.absent_median) || 0));
  %>
  <section class="pb-section">
    <div class="pb-section-inner">
      <div class="nums-kick">
        <span class="t">국회는 이렇게 굴러갑니다</span>
        <span class="s">22대 국회 · 전건 집계 · 매일 갱신</span>
        <a class="go" href="/guide">이 숫자를 읽는 법 →</a>
      </div>

      <%# 🔴 큰 문장은 **상태가 아니라 결과**를 말한다 (2026-08-25 재작성).
          구 문안 `발의된 법안 100건 중 75건은 아직 위원회에 있습니다` 는 숫자를 한 번 더 읽어준 것뿐이라
          "그래서 뭐?" 가 남았다 (사용자 지적). 게다가 `아직` 이 **곧 처리될 것**처럼 읽혀 사실과 멀어진다.
          지금은 ① 뜻(법안을 냈다고 심사되는 건 아니다) ② 시간(1년 넘게 그대로) ③ 끝(임기 만료 폐기) 순.
          ⚠️ 100칸 그리드가 75/100 을 이미 보여주므로 문장에서 그 비율을 다시 쓰지 않는다 %>
      <a class="nums-main" href="/bill?status=%EA%B3%84%EB%A5%98">
        <span class="nums-num"><%= f.pending_rate %><small>%</small></span>
        <span>
          <span class="nums-said">법안을 냈다고 <em>심사되는 건 아닙니다.</em></span>
          <span class="nums-grid" aria-hidden="true"><% for (let i = 0; i < 100; i++) { %><i<%- i < _pendCells ? ' class="on"' : '' %>></i><% } %></span>
          <span class="nums-so">발의된 법안 100건 중 <b><%= _pendCells %>건</b>은 위원회에서 결론이 나지 않았습니다.<%
            if (f.bill_pending_over_1y) { %> 그렇게 멈춰 있는 법안 <b><%= nf(f.bill_pending_over_1y) %>건</b>은
            발의된 지 <b>1년이 넘었고</b>, 국회의원 임기가 끝나면 심사받지 못한 법안은 그대로 폐기됩니다.<% } %></span>
          <span class="nums-sub">발의 <%= nf(f.bill_total) %>건 · 계류 <%= nf(f.bill_pending) %>건 · 본회의 통과 <%= nf(f.bill_passed) %>건</span>
        </span>
      </a>
      <div class="nums-band">
        <%# ⚠️ 여기도 같은 규칙 — `say` 는 숫자를 되읽지 않고 **뜻**을 말한다.
            구 문안 `표결 147번에 한 번꼴로 반대표가 나옵니다` 는 눈금 그림이 이미 하는 말이었다 %>
        <a class="nums-cell" href="/xray#xr-consensus">
          <span class="h"><span class="v"><%= f.oppose_rate %>%</span><span class="k">본회의 반대표</span></span>
          <span class="say">본회의까지 온 법안은 거의 그대로 통과합니다.</span>
          <% if (_ticks) { %>
            <span class="nums-ticks" aria-hidden="true"><% for (let i = 0; i < _ticks; i++) { %><i<%- i === Math.floor(_ticks / 2) ? ' class="on"' : '' %>></i><% } %></span>
          <% } %>
          <span class="fn"><% if (_ticks) { %>표결 <%= _ticks %>번에 한 번꼴 · <% } %><%= nf(f.vote_total) %>건 중 반대 <%= nf(f.vote_oppose) %>건 ·
            걸러지는 곳은 본회의가 아니라 위원회입니다</span>
        </a>
        <a class="nums-cell" href="/xray#xr-absent">
          <span class="h"><span class="v"><%= f.absent_median %>%</span><span class="k">불참률 중앙값</span></span>
          <span class="say">의원 절반은 다섯 번 중 한 번 이상 자리에 없습니다.</span>
          <span class="nums-bar" aria-hidden="true">
            <span style="width: <%= _absent %>%"></span>
            <em style="left: <%= _absent %>%"></em>
          </span>
          <span class="nums-scale"><span>0%</span><span>중앙값 <%= f.absent_median %>%</span><span>100%</span></span>
          <%# 🔴 `게으름이 아니다` 를 빼지 말 것 — 장관 겸직·의장 관례·표결 보이콧이 전부 여기 섞인다.
              SNS 카드(`/promo/numbers`)의 불참 편에도 같은 각주가 붙어 있어야 한다 %>
          <span class="fn">표결 모수 100건 이상인 의원 <%= nf(f.absent_cohort) %>명 기준 ·
            게으름이 아니라 장관 겸직·의장 관례·표결 보이콧이 섞여 있습니다</span>
        </a>
      </div>

      <%# 🔴 세 숫자를 **다 보여준 뒤** 한 번에 붙는 각주다 (2026-08-26 이동).
          카드 1 바로 아래 있던 시절엔 첫 숫자의 임팩트를 곧바로 깎고 2·3번으로 가는 리듬도 끊었다
          (디자인 평). 그렇다고 지우면 안 된다 — 없으면 이 섹션이 "국회가 일을 안 한다" 로 읽힌다
          (「월별 추이」에 처리 지연 각주를 반드시 붙이는 것과 같은 이유). **위치만** 옮긴 것이다.
          ⚠️ `.nums-main`·`.nums-cell` 이 전부 <a> 라 중첩 링크가 안 된다. 그래서 상자 **밖**에 있다 %>
      <p class="nums-note pb-note">계류가 곧 방치는 아닙니다. 심사가 진행 중인 법안도, 비슷한 법안 여러 건이
        하나의 대안으로 묶여 정리되는 경우도 여기 들어 있습니다. 세 숫자 모두 좋고 나쁨의 평가가 아니라
        국회가 굴러가는 방식입니다.
        <a href="/guide/how-a-bill-moves">법안이 국회를 통과하기까지 →</a></p>
    </div>
  </section>

  <%# 스크롤 전체에서 유일하게 어두운 면. A(당신) 와 C(오늘) 를 잇는 논지가 여기 있다 %>
  <div class="nums-thesis">
    <div class="nums-thesis-in">
      <div>
        <b>그래서 <em>당이 아니라 사람</em>을 봅니다.</b>
        <p>이 숫자들은 정당별로 갈리지 않습니다. 갈리는 건 사람입니다.
          의원 한 명씩의 기록을 그대로 펼쳐 두었습니다.</p>
      </div>
      <div class="cta">
        <a class="nums-btn" href="#mine">내 지역구 의원 보기</a>
        <a class="nums-btn ghost" href="/politician">의원 한 명씩 보기</a>
      </div>
    </div>
  </div>
<% } %>

<%# 🔴 자리: **다크 밴드 바로 뒤 · 브리핑 앞** (2026-08-26 이동).
    구 08-24 배치에서는 브리핑 다음(세 번째)이었는데, B·C 가 들어오면서 문서 아래로 밀렸다 —
    홈에서 가장 개인적인 후크가 페이지 하단에 있다는 지적을 받았고, 그건 이 개편이 만든 회귀다.
    지금 순서라야 다크 밴드의 `그래서 당이 아니라 사람을 봅니다` 가 곧바로 **내가 뽑은 사람**으로 이어진다.
    ⚠️ 그 밴드의 `내 지역구 의원 보기` 버튼이 `#mine` 으로 여기를 가리킨다. 위로 올리면 링크가 뒤를 가리키게 된다 %>
<%# ⚠️ id="mine" 은 B 다크 밴드의 `내 지역구 의원 보기` 앵커다. 지우면 그 버튼이 죽는다 %>
<section class="pb-section" id="mine">
  <div class="pb-section-inner">
    <div class="pb-section-header">
      <div>
        <div class="pb-section-label">내가 뽑은 사람</div>
        <div class="pb-section-title">내 지역구 의원</div>
      </div>
    </div>
      <%# ===== 내 지역구 의원 (2026-08-23) =====
          🔴 개인화 진입점이 **성향 진단(20문항)뿐**이었는데 실측 완료자가 3명이다.
             지역구는 로그인 후 클릭 두 번이라 장벽이 압도적으로 낮고, "당 말고 사람" 축에 정확히 맞는다
             (내가 뽑은 사람이 지금 뭐 하고 있나).
          🔴 **무작위 3명 위**에 둔다 — 등록한 사람에겐 이게 홈에서 가장 먼저 볼 것이다.
          ⚠️ 로그인 안 했으면 아무것도 그리지 않는다 (홈에 로그인 유도를 하나 더 붙이지 않는다).
             등록 안 한 로그인 사용자에게만 한 줄 CTA %>
      <%# ===== 내 지역구 의원 (2026-08-23) =====
          🔴 상태 셋을 한 컨테이너가 관리한다: **미등록(피커) / 등록됨(카드) / 변경중(피커)**.
             카드만 그리고 끝내면 **바꿀 방법이 없다** — 특히 비로그인은 `/my` 에 못 가므로
             localStorage 를 직접 지우지 않는 한 영영 못 바꾼다 (사용자 지적).
          🔴 카드를 `<a>` 로 감싸지 않는다 — 안에 `변경` 버튼을 넣어야 하는데 중첩 인터랙티브가 안 된다
             (`.same-name-chip` 에서 겪은 것과 같은 제약). 컨테이너는 div, 링크는 안쪽 `<a>` 하나.
          ⚠️ 서버 렌더 카드와 JS 가 그리는 카드의 **마크업이 같아야 한다** — 다르면 로그인/비로그인이 달라 보인다 %>
      <div class="mine-wrap" id="mine-wrap"
           data-logged-in="<%= locals.currentUser ? '1' : '' %>"
           data-district="<%= locals.currentUser && locals.myMember ? myMember.electoral_district : '' %>">
  
        <% if (locals.currentUser && locals.myMember) { const mm = myMember; %>
          <div class="mine" id="mine-card">
            <span class="mine-photo"><%- avatarHtml(mm.name, mm.photo_url, 44) %></span>
            <a class="mine-body" href="/politician/<%= encodeURIComponent(mm.mona_cd) %>">
              <b><%= mm.name %></b>
              <span class="mine-meta"><%= mm.party_name %> · <%= mm.electoral_district %><% if (mm.reelected) { %> · <%= mm.reelected %><% } %></span>
            </a>
            <a class="mine-go" href="/politician/<%= encodeURIComponent(mm.mona_cd) %>">기록 보기 →</a>
            <button type="button" class="mine-edit" id="mine-change">변경</button>
          </div>
        <% } else { %>
          <div class="mine" id="mine-card" hidden></div>
        <% } %>
  
        <%# 피커 — 항상 마크업에 있고 JS 가 상태에 따라 연다 (JS 없으면 아예 안 보인다) %>
        <div class="mine-pick" id="mine-pick" hidden>
          <div class="mine-pick-head">
            <button type="button" class="mine-pick-open" id="mine-open">지역구 고르기</button>
          </div>
          <p class="mine-pick-sub" id="mine-sub">내가 뽑은 사람이 지금 어떻게 일하고 있는지 홈에서 바로 봅니다.</p>
          <form class="mine-pick-form" id="mine-form" hidden>
            <select id="mine-select" aria-label="지역구"><option value="">불러오는 중…</option></select>
            <button type="submit">저장</button>
            <button type="button" id="mine-cancel">취소</button>
          </form>
          <p class="mine-pick-msg" id="mine-msg"></p>
        </div>
      </div>
  
      <script>
      /* 내 지역구 — 상태 셋: 미등록(피커) / 등록됨(카드) / 변경중(피커)  (2026-08-23)
         🔴 비로그인 선택은 **localStorage 에만** 남고 서버로 가지 않는다 (방문 통계가 개인 열람 기록을
            안 남기는 원칙과 같은 판단). 로그인 사용자만 users.district 에 저장한다 — 본인이 준 값이다.
         🔴 **카드만 그리고 끝내지 말 것.** 바꿀 길이 없으면 비로그인은 영영 못 바꾼다 (사용자 지적). */
      (function () {
        var wrap = document.getElementById('mine-wrap');
        if (!wrap) return;
        var KEY = 'pb.district';
        var logged = wrap.dataset.loggedIn === '1';
        var card = document.getElementById('mine-card');
        var pick = document.getElementById('mine-pick');
        var form = document.getElementById('mine-form');
        var sel  = document.getElementById('mine-select');
        var msg  = document.getElementById('mine-msg');
        var sub  = document.getElementById('mine-sub');
        var openBtn = document.getElementById('mine-open');
        var cancel  = document.getElementById('mine-cancel');
        var current = wrap.dataset.district || null;
        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}
  
        var esc = function (v) { return String(v == null ? '' : v)
          .replace(/[&<>"']/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); };
  
      /* 사진 — 없으면 이니셜 아바타. ⚠️ `PB.avatarSvg` 는 서버 `utils/avatar.js` 와 팔레트·해시·이니셜 규칙이 같다
         (한쪽만 고치면 로그인/비로그인 카드의 아바타 색이 갈린다) */
      function avatar(m) {
        if (m.photo_url) return '<img src="' + esc(m.photo_url) + '" alt="" loading="lazy">';
        return (window.PB && PB.avatarSvg) ? PB.avatarSvg(m.name, 44) : '';
      }
        /* ⚠️ 위 EJS 카드와 **같은 마크업**이어야 한다 */
        function cardHtml(m) {
          var href = '/politician/' + encodeURIComponent(m.mona_cd);
          return '<span class="mine-photo">' + avatar(m) + '</span>'
            + '<a class="mine-body" href="' + href + '"><b>' + esc(m.name) + '</b>'
            + '<span class="mine-meta">' + esc(m.party_name) + ' · ' + esc(m.electoral_district)
            + (m.reelected ? ' · ' + esc(m.reelected) : '') + '</span></a>'
            + '<a class="mine-go" href="' + href + '">기록 보기 →</a>'
            + '<button type="button" class="mine-edit" id="mine-change">변경</button>';
        }
        /* 카드 전체를 클릭 영역으로 — 다른 목록의 행·카드와 같은 규칙(평상시 셰브론, hover 에 골드).
           🔴 `.mine` 은 <div> 다. 안에 링크 둘(이름·기록 보기)과 <button>(변경)이 있어 <a> 로 감쌀 수 없다.
              그래서 오버레이가 아니라 **클릭 위임** — 오버레이는 드래그가 링크 드래그로 잡혀 화면이 멈춘 것처럼 된다.
           🔴 `pb-boxlink` 를 **JS 가 붙인다.** JS 가 죽으면 셰브론·hover 도 없어야 한다 (빛나는데 안 눌리는 거짓 신호 방지). */
        (function () {
          if (!card) return;
          card.classList.add('pb-boxlink');
          card.addEventListener('click', function (e) {
            if (e.target.closest('a, button')) return;
            var sel = window.getSelection && window.getSelection();
            if (sel && String(sel).trim()) return;
            var a = card.querySelector('.mine-body');
            var href = a && a.getAttribute("href");
            if (!href) return;
            if (e.metaKey || e.ctrlKey || e.button === 1) window.open(href, "_blank", "noopener");
            else window.location.assign(href);
          });
        })();
  
        function bindChange() {
          var b = document.getElementById('mine-change');
          if (b) b.addEventListener('click', function () { showPicker(true); });
        }
        function showCard(m, d) {
          card.innerHTML = cardHtml(m); card.hidden = false; pick.hidden = true;
          msg.textContent = ''; form.hidden = true; current = d; bindChange();
        }
        function showPicker(isChange) {
          card.hidden = true; pick.hidden = false; msg.textContent = '';
          openBtn.textContent = isChange ? '다른 지역구 고르기' : '지역구 고르기';
          sub.textContent = isChange
            ? '지금은 ' + current + ' 입니다. 바꾸거나 등록을 해제할 수 있습니다.'
            : '내가 뽑은 사람이 지금 어떻게 일하고 있는지 홈에서 바로 봅니다.';
          if (isChange) loadList().then(function () { form.hidden = false; sel.value = current || ''; sel.focus(); });
        }
        var loaded = false;
        function loadList() {
          if (loaded) return Promise.resolve();
          return fetch('/api/district/list').then(function (r) { return r.json(); }).then(function (d) {
            sel.innerHTML = '<option value="">등록 안 함</option>'
              + (d.groups || []).map(function (g) {
                  return '<optgroup label="' + esc(g.sido) + '">'
                    + g.districts.map(function (x) { return '<option value="' + esc(x) + '">' + esc(x) + '</option>'; }).join('')
                    + '</optgroup>';
                }).join('');
            loaded = true;
          }).catch(function () { msg.textContent = '지역구 목록을 불러오지 못했습니다.'; });
        }
        function fetchMember(d) {
          return fetch('/api/district/member?d=' + encodeURIComponent(d))
            .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
        }
  
        if (current) { bindChange(); }
        else if (stored && !logged) {
          fetchMember(stored).then(function (m) { showCard(m, stored); })
            .catch(function () { try { localStorage.removeItem(KEY); } catch (e) {} showPicker(false); });
        } else { showPicker(false); }
  
        openBtn.addEventListener('click', function () {
          if (!form.hidden) { form.hidden = true; return; }
          loadList().then(function () { form.hidden = false; sel.value = current || ''; sel.focus(); });
        });
        cancel.addEventListener('click', function () {
          form.hidden = true; msg.textContent = '';
          if (current && card.innerHTML.trim()) { card.hidden = false; pick.hidden = true; }
        });
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var d = sel.value;
          msg.textContent = '저장 중…';
          if (!logged) {
            try { d ? localStorage.setItem(KEY, d) : localStorage.removeItem(KEY); } catch (err) {}
            if (!d) { current = null; card.innerHTML = ''; showPicker(false); return; }
            fetchMember(d).then(function (m) { showCard(m, d); })
              .catch(function () { msg.textContent = '불러오지 못했습니다.'; });
            return;
          }
          fetch('/api/auth/district', { method: 'PUT', credentials: 'include',
              headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ district: d }) })
            .then(function (r) { if (!r.ok) throw new Error(r.status); location.reload(); })
            .catch(function () { msg.textContent = '저장하지 못했습니다.'; });
        });
  
        /* 🔴 로그인했는데 서버에 없고 브라우저에만 있으면 한 번 올려준다 */
        if (logged && !current && stored) {
          fetch('/api/auth/district', { method: 'PUT', credentials: 'include',
              headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ district: stored }) })
            .then(function (r) { if (r.ok) { try { localStorage.removeItem(KEY); } catch (e) {} location.reload(); } })
            .catch(function () {});
        }
      })();
      </script>
  </div>
</section>

  <div class="pb-divider"></div>

<%# ═══ C · 오늘의 1면 — 브리핑 =====
    🔴 매일 쌓이는 유일한 신규 콘텐츠인데 24px 카드 하나로 묻혀 있었다 (2026-08-25 리드 기사로 승격).
    ⚠️ 카드 종류가 셋이다 — AI 브리핑 / 데이터 요약(폴백) / 활동 없음. 배지를 그대로 가져온다 %>
<% const bfs = locals.briefings || []; %>
<%# ⚠️ `briefing_date` 는 'YYYY-MM-DD' **문자열**이다. new Date() 로 파싱하지 말 것 —
    실행 환경 타임존을 타서 하루 밀린다 (프로젝트 공통 규칙). 문자열 그대로 자른다 %>
<% const bfDate = (d) => String(d || '').slice(5).replace('-', '.'); %>
<%# 🔴 헤드라인이 가운뎃점에서 줄바꿈되는 것을 막는다 (2026-08-25).
    `야간노동 보호·농협 개혁·폐교 활용 등 32건 발의` 가 `개혁 / ·폐교` 로 끊겨 둘째 줄이 점으로 시작했다.
    `word-break: keep-all` 은 한글끼리만 막아서 `·` 앞뒤에는 안 먹는다 — U+2060(word joiner)으로 그 자리만 붙인다.
    ⚠️ 폭이 0인 보이지 않는 문자다. **제목 표시에만** 쓸 것 (복사하면 따라간다) %>
<% const noBreakDot = (s) => String(s || '').replace(/·/g, '⁠·⁠'); %>
<% if (bfs.length) { %>
  <section class="pb-section">
    <div class="pb-section-inner">
      <div class="pb-section-header">
        <div>
          <div class="pb-section-label">매일 아침 새로 씁니다</div>
          <div class="pb-section-title">국회 브리핑</div>
        </div>
      </div>

      <%# 마스트헤드 괘선 — 지면 문법. 아래 리드 기사가 "오늘의 1면" 이라는 신호다.
          🔴 **날짜·출처를 여기 쓰지 말 것** (2026-08-26 디자인 평). 히어로 아래 `.hero-strip` 이
             `2026년 8월 26일 수요일 · 22대 국회 · 국회 공개 자료 매일 갱신` 을 이미 말한다 —
             같은 문장이 한 화면 안에서 두 번 나오면 리듬이 끊긴다. 신문도 마스트헤드는 한 번뿐이다.
             날짜가 필요한 건 **이 브리핑의 날짜**이고 그건 아래 스탬프(`AI 브리핑 · 08.21`)가 갖는다.
          ⚠️ `지난 브리핑` 링크도 섹션 헤더에서 뺐다 (같은 목적지가 두 줄 위에 또 있었다) %>
      <div class="bf-mast">
        <span class="d">오늘의 1면</span>
        <%# ⚠️ `지난 브리핑` 이라 쓰지 말 것 — 바로 오른쪽 목록의 머리가 그 말이다 (한 화면 두 번) %>
        <a class="go" href="/briefing">전체 보기 →</a>
      </div>

      <%
        const lead = bfs[0]; const rest = bfs.slice(1);
        /* 🔴 2단 조판(`column-count`) 안에서는 `-webkit-line-clamp` 가 안 먹는다. 길이는 여기서 자른다.
           ⚠️ 문장 중간에서 끊기지 않게 마지막 마침표까지만 남긴다 — 자른 티가 나면 지면이 아니라 오류로 보인다 */
        const LEAD_MAX = 340;
        let leadBody = String(lead.body || '').trim();
        if (leadBody.length > LEAD_MAX) {
          const cut = leadBody.slice(0, LEAD_MAX);
          const dot = cut.lastIndexOf('.');
          leadBody = (dot > LEAD_MAX * 0.5 ? cut.slice(0, dot + 1) : cut.trim() + '…');
        }
      %>
      <div class="home-bf">
        <a class="bf-lead" href="/briefing/<%= lead.id %>">
          <div class="bf-lead-top">
            <span class="bf-stamp<%= lead.isEmpty ? ' is-none' : (lead.isAi ? ' is-ai' : ' is-fallback') %>"><%=
              lead.isEmpty ? '활동 없음' : (lead.isAi ? 'AI 브리핑' : '데이터 요약') %> · <%= bfDate(lead.briefing_date) %></span>
          </div>
          <h3 class="bf-lead-title"><%= noBreakDot(lead.headline) %></h3>
          <% if (leadBody) { %><p class="bf-lead-body"><%= leadBody %></p><% } %>
        </a>

        <% if (rest.length) { %>
          <div class="bf-side">
            <div class="bf-side-h">지난 브리핑</div>
            <ul class="bf-list">
              <% rest.forEach((b) => { %>
                <li><a href="/briefing/<%= b.id %>">
                  <span class="bf-item-date"><%= bfDate(b.briefing_date) %></span>
                  <span class="bf-item-title"><%= noBreakDot(b.headline) %></span>
                  <span class="bf-item-ar">→</span>
                </a></li>
              <% }); %>
            </ul>
          </div>
        <% } %>
      </div>
      <p class="pb-sec-note">AI 가 정리한 내용으로 사실과 다를 수 있습니다. 숫자는 국회 자료를 직접 집계한 값입니다.</p>
    </div>
  </section>
  <div class="pb-divider"></div>
<% } %>


<%# ===== 나와 맞는 의원 (D 레이어) =====
    🔴 성향 진단이 이 사이트의 핵심 기능인데 홈에서 진입로가 없었다.
    🔴 **미완료자에겐 이 섹션을 아예 그리지 않는다** (2026-08-25). 구 버전은 여기에 큰 CTA
       (`.match-cta` — "성향 진단 시작하기")를 뒀는데, 이제 **히어로가 첫 문항을 직접 물어본다**.
       둘을 같이 두면 한 페이지에서 같은 행동을 두 번 조르는 꼴이고, 히어로에서 이미 답한 사람에게
       "시작하기" 버튼이 다시 나온다. `.match-cta` CSS 는 남겨 뒀다 (참조 0).
    ⚠️ 일치도 식은 의원 상세·목록과 **같은 값**이어야 한다 (getTopMatches.sql 주석 참조) %>
<% if (locals.balanceGameCompleted) { %>
<div class="pb-divider"></div>
<section class="pb-section">
  <div class="pb-section-inner">
    <div class="pb-section-header">
      <div>
        <div class="pb-section-label">정당이 아니라 좌표로</div>
        <div class="pb-section-title">나와 맞는 의원</div>
      </div>
      <% if (locals.balanceGameCompleted) { %>
        <div class="match-links">
          <%# 히어로에 있던 `나와 맞는 의원 찾기 →` 를 여기로 내렸다 (2026-08-24) — 결과가 바로 아래 있는 자리가
              버튼의 제자리다. 완료자에겐 `다시 진단하기`, 미완료자에겐 아래 큰 CTA 가 따로 있다 %>
          <a href="/balance-game?redo=1" class="pb-section-link">다시 진단하기</a>
          <a href="/balance-game/share" class="pb-section-link">결과 이미지로 공유</a>
          <a href="/politician?sort=match-desc" class="pb-section-link">전체 일치도 보기 →</a>
        </div>
      <% } %>
    </div>

    <% const ms = locals.matches || []; %>
    <% if (locals.balanceGameCompleted && ms.length) { %>
      <%# 🔴 카드에 일치도 **%를 쓰지 않는다** (2026-08-16 로직 점검).
          그 %는 분모 1.5 라는 임의 보정에 의존해 실측 23~90% 가 나오는데 그 값을 설명할 방법이 없다.
          다만 **정렬(가장 가까운 순)은 보정과 무관**하므로 순번(1·2·3)만 쓴다.
          근거는 `daos/queries/politician/getMatchContext.sql` 머리 주석에 %>
      <div class="match-grid">
        <% ms.forEach((m, mi) => { %>
          <a class="match-card pb-boxlink" href="/politician/<%= m.mona_cd %>">
            <div class="match-avatar"><%- avatarHtml(m.name, m.photo_url, 72) %></div>
            <div class="match-body">
              <div class="match-name"><%= m.name %><% if (m.active_yn === false) { %> <em class="match-retired">퇴임</em><% } %></div>
              <%# 🔴 정당명을 쓰지 않는다 — 바로 아래 「나와 다른 의원」과 나란히 놓이는 자리라
                  정당이 붙으면 "가까운 = ○○당 / 먼 = △△당" 대비 구도가 된다 (공유 카드와 같은 규칙) %>
              <div class="match-meta"><%= m.electoral_district || "비례대표" %></div>
            </div>
            <div class="match-pct"><%= m.rank_near || (mi + 1) %><small>위</small></div>
          </a>
        <% }); %>
      </div>
      <%# 🔴 이 각주를 빼면 "가장 가까운 3명" 이 정밀한 결과로 읽힌다 %>
      <p class="pb-sec-note">방향을 매긴 법안 약 <strong>4,900건</strong> 중 의원이 <strong>공동발의로 이름을 올린 법안</strong>으로 만든
        경제·사회·정치제도 세 축 좌표를 견준 결과입니다. 안보축은 입법 기록으로 읽을 수 없어 빼고,
        AI 1차 매핑이라 <strong>가까운 몇 명 사이의 차이는 크지 않습니다.</strong></p>
    <% } %>
  </div>
</section>
<% } %>

<%# ===== 나와 다른 의원 (2026-08-24 신규) — 가까운 3명 바로 아래.
    🔴 가까운 쪽만 보여주면 "내 편 목록" 으로 읽힌다. 반대쪽을 나란히 두면 그게 **좌표**라는 게 드러난다
       (공유 카드가 먼 3명을 같이 싣는 것과 같은 판단).
    ⚠️ 같은 쿼리(getMatchSpread)의 far 라 추가 조회가 없다 %>
<% const fs_ = locals.farMatches || []; const _tot = locals.matchTotal; %>
<% if (locals.balanceGameCompleted && fs_.length) { %>
  <div class="pb-divider"></div>
  <section class="pb-section">
    <div class="pb-section-inner">
      <div class="pb-section-header">
        <div>
          <div class="pb-section-label">같은 자로 잰 반대쪽</div>
          <div class="pb-section-title">나와 다른 의원</div>
        </div>
        <a href="/politician?sort=match-asc" class="pb-section-link">전체 보기 →</a>
      </div>
      <div class="match-grid">
        <% fs_.forEach((m) => { %>
          <a class="match-card pb-boxlink" href="/politician/<%= m.mona_cd %>">
            <div class="match-avatar"><%- avatarHtml(m.name, m.photo_url, 72) %></div>
            <div class="match-body">
              <div class="match-name"><%= m.name %><% if (m.active_yn === false) { %> <em class="match-retired">퇴임</em><% } %></div>
              <div class="match-meta"><%= m.electoral_district || "비례대표" %></div>
            </div>
            <%# 순위는 뒤에서부터다 — 292명 중 292위가 가장 먼 사람. 숫자를 그대로 쓰면 "몇 명 중" 이 없어 안 읽힌다 %>
            <div class="match-pct"><%= (_tot || m.total) ? ((_tot || m.total) - m.rank_far + 1) : m.rank_far %><small>위</small></div>
          </a>
        <% }); %>
      </div>
      <p class="pb-sec-note">가장 가까운 쪽과 <strong>같은 자로 잰 반대쪽</strong>입니다<% if (_tot) { %> (좌표가 있는 의원 <strong><%= nf(_tot) %>명</strong> 중)<% } %>.
        여기 있다고 해서 생각이 틀렸다는 뜻이 아니라, <strong>같은 축에서 반대편에 있다</strong>는 뜻입니다.
        어느 쪽에도 이름을 붙이지 않습니다.</p>
    </div>
  </section>
<% } %>


<%# ===== 의원은 정당 평균과 얼마나 다를까 — 히어로에서 독립 섹션으로 (2026-08-24 재배치) %>
<section class="pb-section">
  <div class="pb-section-inner">
      <%# ===== 히어로 우측 — 무작위 의원 3명의 축 좌표 (2026-08-16 2차) =====
          🔴 결론 숫자 3개(계류·반대·불참)가 있던 자리다. 그 숫자는 아래 「숫자로 본 국회」 스트립으로 내렸다 (지우지 않았다).
          왜 바꿨나: 홈이 "국회는 이렇다" 로 시작했는데 이 사이트의 차별점은 "의원 한 명 한 명이 이렇다" 다.
          🔴 좌표만 보여주면 아무 뜻이 없다 — **소속 정당 평균 눈금**을 같이 찍어야 "당 말고 사람" 이 보인다.
          🔴 무작위다 (편집 개입 없음). 정당 안배도 하지 않는다 — 안배가 곧 편집이다.
          막대 문법은 의원 상세 `.pv-band` 와 같다: 왼끝 L · 오른끝 R · 골드 점 = 의원 · 세로 눈금 = 정당 평균 %>
      <% const sp = locals.spotlight || []; const AM = AXIS.AXIS_META; const pct = (v) => ((Number(v) + 1) / 2 * 100).toFixed(1); %>
      <% if (sp.length) { %>
        <div class="spot">
          <div class="spot-head">
            <span class="spot-title">의원은 정당 평균과 얼마나 다를까</span>
            <span class="spot-legend"><i class="spot-dot"></i>의원 <i class="spot-tick"></i>소속 정당 평균</span>
          </div>
          <div class="spot-cards">
          <% sp.forEach((m) => { %>
            <a class="spot-card pb-boxlink is-tall" href="/politician/<%= m.mona_cd %>">
              <div class="spot-who">
                <span class="spot-avatar"><%- avatarHtml(m.name, m.photo_url, 44) %></span>
                <span class="spot-name"><%= m.name %></span>
                <span class="spot-meta"><%= m.party_name %><% if (m.electoral_district) { %> · <%= m.electoral_district %><% } %></span>
                <span class="spot-more">상세 →</span>
              </div>
              <div class="spot-rows">
                <% AXIS.MATCH_AXES.forEach((k) => { const v = Number(m[k]); const pv = Number(m['party_' + k]); const showAvg = Number(m.party_n) >= 3; %>
                  <div class="spot-row">
                    <span class="spot-ax"><b><%= AM[k].name %></b><small><%= AM[k].short %></small></span>
                    <span class="spot-end"><span class="lx"><%= AM[k].Lx %></span><span class="ls"><%= AM[k].L %></span></span>
                    <span class="spot-track" title="<%= AM[k].name %> · 왼쪽 <%= AM[k].Lx %> ↔ 오른쪽 <%= AM[k].Rx %> · 의원 <%= (v >= 0 ? '+' : '') + v.toFixed(2) %><%= showAvg ? ' · ' + m.party_name + ' 평균 ' + (pv >= 0 ? '+' : '') + pv.toFixed(2) : '' %>">
                      <i class="spot-mid"></i>
                      <% if (showAvg) { %><i class="spot-tick" style="left:<%= pct(pv) %>%"></i><% } %>
                      <i class="spot-dot" style="left:<%= pct(v) %>%"></i>
                    </span>
                    <span class="spot-end"><span class="lx"><%= AM[k].Rx %></span><span class="ls"><%= AM[k].R %></span></span>
                  </div>
                <% }); %>
              </div>
            </a>
          <% }); %>
          </div>
          <p class="spot-note">공동발의한 법안 × 방향 매핑 약 4,900건(AI 1차)으로 만든 좌표 · 안보축은 입법 기록으로 읽을 수 없어 없음 ·
            새로고침하면 다른 의원이 나옵니다.</p>
        </div>
      <% } %>
  </div>
</section>
<div class="pb-divider"></div>
<%# ===== 숫자로 본 국회 / 차트 만들기 =====
    🔴 홈에서 `/xray`(지표 12종)와 `/xray/chart`(차트 빌더) 진입로가 아예 없었다 (2026-08-16 추가).
    결론 3숫자 스트립(히어로에서 내려옴, 2026-08-16 2차) + 진입 카드 3장. 스트립 외에 지표 숫자를 더 그리지 말 것 %>
<section class="pb-section">
  <div class="pb-section-inner">
    <div class="pb-section-header">
      <div>
        <div class="pb-section-label">직접 확인하고 싶다면</div>
        <div class="pb-section-title">숫자로 본 국회</div>
      </div>
      <a href="/xray" class="pb-section-link">전체 지표 →</a>
    </div>

    <%# 🔴 결론 3숫자(`.facts-strip`)는 여기 있었지만 2026-08-25 에 **히어로 다음(B 섹션)** 으로 올렸다.
        여기에 다시 그리지 말 것 — 같은 숫자를 한 페이지에서 두 번 말하게 된다.
        `.facts-strip`/`.fact-*` CSS 는 남겨 뒀다 (B 가 다른 클래스를 쓰므로 참조 0. 되살릴 때 필요) %>
    <div class="explore-grid">
      <a class="explore-card pb-boxlink is-tall is-solid" href="/xray">
        <div class="explore-kicker">지표 12종</div>
        <h3 class="explore-title">합의는 얼마나, 이탈은 언제</h3>
        <p class="explore-desc">당론 이탈·불참률·초당 협력·법안 생존율까지, 표결과 발의를 여러 각도로 잘라 봅니다.
          각 지표에는 어떻게 읽어야 하는지와 한계가 같이 붙어 있습니다.</p>
      </a>
      <a class="explore-card pb-boxlink is-tall is-solid" href="/xray/chart">
        <div class="explore-kicker">직접 만들기</div>
        <h3 class="explore-title">원하는 축으로 차트 만들기</h3>
        <p class="explore-desc">축·지표·필터를 골라 조합하면 그대로 그래프가 됩니다.
          만든 차트는 주소가 곧 공유 링크라 링크만 보내면 같은 화면이 열립니다.</p>
      </a>
      <a class="explore-card pb-boxlink is-tall is-solid" href="/politician">
        <div class="explore-kicker">22대 국회의원</div>
        <h3 class="explore-title">한 사람씩 뜯어보기</h3>
        <p class="explore-desc">표결 성향·대표발의 특화 분야·정당별 공동발의·상임위 발언 기록까지
          한 페이지에 모아 두었습니다.</p>
      </a>
    </div>
  </div>
</section>
<%# ═══ A · 히어로 스크립트 — 좌표 지도 + 첫 문항 (2026-08-25) ═══════════════════════
    🔴 답변은 localStorage('pb.bg.answers') 에 쓰고 POST /api/balance-game/answers 로 채점만 받는다.
       비로그인은 DB 에 아무것도 안 쌓이고(utils/anonAxis.js), 로그인은 그 POST 가 곧 저장이라
       `/balance-game/respond` 가 2번 문항부터 이어진다. **둘 다 같은 엔드포인트를 탄다.**
    ⚠️ 키 이름 `pb.bg.answers` 는 respond.ejs · utils/anonAxis.js · interactions.js 승격 코드와
       **같아야 한다.** 하나만 바꾸면 로그인해도 답변이 안 올라가고 조용히 사라진다 %>
<script>
(function () {
  'use strict';

  var CLOUD  = <%- escape(_cloud) %>;      /* [[경제, 사회], …] 익명 좌표 */
  var ME     = <%- escape(_mePt) %>;       /* 완료자의 내 좌표 · 아니면 null */
  var LS_KEY = 'pb.bg.answers';
  var REDUCE = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── 지도 ────────────────────────────────────────────────
     ⚠️ 점에 정당색을 입히지 말 것 — 두 덩어리로 갈리는 게 보이는데 색을 주면 그게 곧 정당 대비 구도가 된다 */
  var mapEl = document.getElementById('hero-map');
  var svg   = document.getElementById('hero-cloud');
  var W = 520, H = 460, P = 34;
  var sx = function (v) { return P + (Number(v) + 1) / 2 * (W - P * 2); };
  var sy = function (v) { return (H - P) - (Number(v) + 1) / 2 * (H - P * 2); };
  var esc = function (s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };

  function drawMap(me, provisional) {
    if (!svg || !CLOUD.length) return;
    var p = [];
    p.push('<rect x="' + P + '" y="' + P + '" width="' + (W - P * 2) + '" height="' + (H - P * 2) + '" fill="#FCFBF8" stroke="#E2DFD4"/>');
    /* 🔴 사분면 이름이 이 판을 읽는 법이다. 극 라벨(시장/개입)만 두면 가로·세로가 뭘 뜻하는지 안 온다
       (공유 카드 지도형에서 같은 지적을 받았다) */
    [['시장 · 자율', P + 10, P + 20, 'start'], ['개입 · 자율', W - P - 10, P + 20, 'end'],
     ['시장 · 전통', P + 10, H - P - 12, 'start'], ['개입 · 전통', W - P - 10, H - P - 12, 'end']]
      .forEach(function (o) {
        p.push('<text x="' + o[1] + '" y="' + o[2] + '" text-anchor="' + o[3] + '" font-size="11" fill="#A8A095" font-family="JetBrains Mono, monospace" letter-spacing="1">' + o[0] + '</text>');
      });
    p.push('<line x1="' + sx(0) + '" y1="' + P + '" x2="' + sx(0) + '" y2="' + (H - P) + '" stroke="#E2DFD4" stroke-dasharray="3 4"/>');
    p.push('<line x1="' + P + '" y1="' + sy(0) + '" x2="' + (W - P) + '" y2="' + sy(0) + '" stroke="#E2DFD4" stroke-dasharray="3 4"/>');
    p.push('<text x="' + (W / 2) + '" y="' + (H - 8) + '" text-anchor="middle" font-size="11" fill="#5F6674" font-family="Noto Sans KR, sans-serif">경제 ← 시장 자율 · 정부 개입 →</text>');
    /* ⚠️ x=22 이다. 13 으로 두면 모바일에서 글자 상자가 SVG 왼쪽 밖으로 3px 나가 잘린다 (실측) */
    p.push('<text x="22" y="' + (H / 2) + '" text-anchor="middle" font-size="11" fill="#5F6674" font-family="Noto Sans KR, sans-serif" transform="rotate(-90 22 ' + (H / 2) + ')">사회·문화 ↓ 전통 · 자율 ↑</text>');

    CLOUD.forEach(function (pt, i) {
      p.push('<circle class="hp" cx="' + sx(pt[0]).toFixed(1) + '" cy="' + sy(pt[1]).toFixed(1) + '" r="3.6" fill="#8E8778" opacity="0.55" style="--d:' + (i * 3) + 'ms"/>');
    });

    if (me) {
      var mx = sx(me[0]), my = sy(me[1]);
      p.push('<g class="hme">');
      p.push('<circle cx="' + mx + '" cy="' + my + '" r="15" fill="#B8740C" opacity="0.14"/>');
      p.push('<circle cx="' + mx + '" cy="' + my + '" r="7" fill="#B8740C" stroke="#FCFBF8" stroke-width="2"/>');
      p.push('<text x="' + (mx + 15) + '" y="' + (my + 5) + '" font-size="13" font-weight="800" fill="#925C09" font-family="Noto Sans KR, sans-serif">나</text>');
      p.push('</g>');
      var lg = document.getElementById('hero-lg-me');
      var lgt = document.getElementById('hero-lg-me-t');
      /* ⚠️ 문항 1개로 찍은 점은 **임시**라고 반드시 밝힌다. 안 밝히면 20문항 결과처럼 읽힌다 */
      if (lgt) lgt.textContent = provisional ? '당신 (문항 1개 기준 임시 위치)' : '나';
      if (lg) lg.hidden = false;
    }
    svg.innerHTML = p.join('');
    /* 착지 연출은 데이터가 자리를 찾는 움직임이라 장식이 아니다. 다시 그릴 때는 켜지 않는다 (점이 두 번 튄다) */
    if (!REDUCE && mapEl && !mapEl.dataset.drawn) mapEl.classList.add('is-anim');
    if (mapEl) mapEl.dataset.drawn = '1';
  }
  drawMap(ME, false);

  /* ── 첫 문항 ─────────────────────────────────────────── */
  var q = document.getElementById('hero-q');
  if (!q) return;

  var QID    = q.dataset.qid;
  var QAXIS  = q.dataset.axis;
  var SCORE  = { A: Number(q.dataset.scoreA), B: Number(q.dataset.scoreB), C: 0 };
  var askEl  = document.getElementById('hero-q-ask');
  var doneEl = document.getElementById('hero-q-done');
  var goEl   = document.getElementById('hero-q-go');
  var bEl    = document.getElementById('hero-q-done-b');
  var sEl    = document.getElementById('hero-q-done-s');

  var readLocal = function () {
    try {
      var r = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
      return (r && typeof r === 'object' && !Array.isArray(r)) ? r : {};
    } catch (e) { return {}; }
  };
  var writeLocal = function (o) { try { localStorage.setItem(LS_KEY, JSON.stringify(o)); } catch (e) {} };

  /* 문항 1개 답으로 찍는 임시 좌표.
     ⚠️ 평면은 경제 × 사회 두 축뿐이다 — 안보·제도 문항이면 평면에 찍을 자리가 없으므로 점을 안 찍는다 */
  function provisionalPoint(answer) {
    var v = SCORE[answer];
    if (!isFinite(v) || v === 0) return null;
    v = Math.max(-1, Math.min(1, v));
    if (QAXIS === 'economy') return [v, 0];
    if (QAXIS === 'social')  return [0, v];
    return null;
  }

  function showDone(answeredNow) {
    if (askEl) askEl.hidden = true;
    if (doneEl) doneEl.hidden = false;
    if (answeredNow && bEl) bEl.textContent = '1문항 반영됨.';
    if (sEl) sEl.textContent = answeredNow
      ? '19문항 더 답하면 가장 가까운 의원 3명이 나옵니다.'
      : '남은 문항에 답하면 가장 가까운 의원 3명이 나옵니다.';
  }

  /* 이미 답했으면(새로고침·이어하기) 문항을 다시 묻지 않는다 */
  var stored = readLocal();
  var already = Object.keys(stored).length > 0;
  if (already) showDone(false);

  var pending = null;   /* 진행 중인 채점 POST — "이어서 풀기" 가 이걸 기다린다 */

  function send(answers) {
    return fetch('/api/balance-game/answers', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ answers: answers })
    }).then(function (r) { return r.ok ? r.json() : null; })
      .catch(function () { return null; });
  }

  q.addEventListener('click', function (e) {
    var btn = e.target.closest('.hero-opt');
    if (!btn || btn.disabled) return;
    var opt = btn.dataset.opt;
    if (!opt || !QID) return;

    Array.prototype.forEach.call(q.querySelectorAll('.hero-opt'), function (b) { b.disabled = true; });

    /* 🔴 채점 요청 **전에** 로컬에 쓴다 — 요청이 실패해도 답이 남아야 이어 풀 수 있다 (respond.ejs 와 같은 순서) */
    var answers = readLocal();
    answers[QID] = opt;
    writeLocal(answers);

    showDone(true);
    var pt = provisionalPoint(opt);
    if (pt) drawMap(pt, true);

    /* 로그인 사용자는 이 POST 가 곧 저장이다 — 이게 안 끝나면 respond 가 1번부터 다시 묻는다.
       그래서 아래 링크 클릭이 이 약속을 기다린다 */
    pending = send(answers);
  });

  if (goEl) {
    goEl.addEventListener('click', function (e) {
      if (!pending) return;                       /* 보낼 게 없으면 그냥 이동 */
      e.preventDefault();
      var href = goEl.getAttribute('href');
      var done = false;
      var jump = function () { if (!done) { done = true; window.location.assign(href); } };
      /* ⚠️ 네트워크가 느려도 1.2초 넘게 잡아두지 않는다. 저장이 늦어도 최악은 문항 하나를 다시 묻는 것뿐이다 */
      setTimeout(jump, 1200);
      pending.then(jump, jump);
    });
  }
})();
</script>
