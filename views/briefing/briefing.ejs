<%
  const s = b.summary;
  const avgPerDay = s.active_days > 0 ? Math.round(s.proposed / s.active_days * 10) / 10 : 0;
  const stageWhen = (st) => `${st.day.replace(/-/g, '.')} · ${st.daysAgo === 0 ? '오늘' : st.daysAgo + '일 전'}`;
%>

<div class="pb-page-header">
  <div class="pb-page-header-inner">
    <div>
      <h1 class="pb-page-title">BRIEFING</h1>
      <p class="pb-page-desc">
        최근 <%= b.windowDays %>일 국회에 어떤 법안이 올라왔는지 정리했습니다.
        <% if (locals.dataFreshness && dataFreshness.relative) { %>
          <span class="bf-fresh">· 데이터 <%= dataFreshness.relative %> 갱신</span>
        <% } %>
      </p>
    </div>
  </div>
</div>

<div class="bf-wrap">

  <!-- ===== 요약 스트립 =====
       구 버전은 큰 KPI 카드 4개 + 큰 막대 차트였는데, 그러면 /xray 의 7일판이 된다.
       숫자는 맥락 제공용으로 한 줄로 압축하고 지면을 법안에 준다. -->
  <section class="bf-strip">
    <div class="bf-strip-nums">
      <span class="bf-strip-item"><b><%= nf(s.proposed) %></b>건 발의</span>
      <span class="bf-strip-sep">·</span>
      <span class="bf-strip-item"><b><%= nf(s.proposers) %></b>명 대표발의</span>
      <span class="bf-strip-sep">·</span>
      <span class="bf-strip-item">활동일 <b><%= s.active_days %></b>일 (하루 평균 <%= avgPerDay %>건)</span>
      <% if (s.awaiting_referral > 0) { %>
        <span class="bf-strip-sep">·</span>
        <span class="bf-strip-item bf-dim"><b><%= nf(s.awaiting_referral) %></b>건 회부 전</span>
      <% } %>
    </div>
    <%# 스파크라인 — 큰 차트를 줄인 것. 주말(회색)이 보여야 "평일에만 움직인다" 가 읽힌다 %>
    <div class="bf-spark" role="img" aria-label="최근 <%= b.trendDays %>일 일별 발의 추이">
      <% b.daily.forEach((d) => { %>
        <span class="bf-spark-col<%= d.isWeekend ? ' is-weekend' : '' %>" title="<%= d.day %> · <%= d.cnt %>건">
          <span class="bf-spark-bar" style="height: <%= b.dailyMax > 0 ? Math.max(2, Math.round(d.cnt / b.dailyMax * 100)) : 2 %>%"></span>
        </span>
      <% }); %>
      <span class="bf-spark-cap"><%= b.trendDays %>일</span>
    </div>
  </section>

  <!-- ===== 이번 주 몰린 법률 =====
       /xray 에도 /bill 에도 없는 브리핑 고유 정보. AI 없이 SQL 만으로 서사가 나오는 지점. -->
  <% if (b.hotLaws.length) { %>
    <section class="bf-sec" id="bf-hot">
      <div class="bf-sec-head">
        <h2 class="bf-h">이번 주 몰린 법률</h2>
        <p class="bf-sub">
          같은 법률에 개정안이 여럿 올라왔습니다. 그 주의 관심사가 어디에 있었는지 보여줍니다.
        </p>
      </div>
      <ul class="bf-hot-list">
        <% b.hotLaws.forEach((h) => { %>
          <li>
            <a class="bf-hot" href="/bill?bill_name=<%= encodeURIComponent(h.bill_name) %>">
              <span class="bf-hot-cnt"><%= h.week_cnt %></span>
              <span class="bf-hot-body">
                <span class="bf-hot-name"><%= h.bill_name %></span>
                <span class="bf-hot-meta">
                  <% if (h.committee) { %><%= h.committee %> · <% } %>22대 누적 <%= nf(h.series_total) %>건
                </span>
              </span>
              <span class="bf-hot-go">계열 보기 →</span>
            </a>
          </li>
        <% }); %>
      </ul>
    </section>
  <% } %>

  <!-- ===== 본체: 위원회별 새 법안 ===== -->
  <section class="bf-sec" id="bf-bills">
    <div class="bf-sec-head">
      <h2 class="bf-h">새로 올라온 법안</h2>
      <p class="bf-sub">
        위원회별로 묶었습니다. 그룹 안에서는 공동발의 의원이 많은 순 —
        <strong>이름을 얼마나 걸었는지일 뿐, 중요도나 통과 가능성과는 다릅니다.</strong>
      </p>
    </div>

    <% if (!b.featured.length) { %>
      <p class="bf-empty">최근 <%= b.windowDays %>일간 발의된 법안이 없습니다.</p>
    <% } else { %>
      <%
        // 그룹 하나를 그리는 헬퍼. featured(기본 노출)와 rest(전체 보기에서만)의 마크업이 같아야
        // 토글이 일관되게 동작한다. isHiddenGroup 이면 그룹 통째로 접힌다.
        const renderGroup = (g, isHiddenGroup) => { %>
          <div class="bf-group<%= isHiddenGroup ? ' bf-hidden-group' : '' %>"<%= isHiddenGroup ? ' hidden' : '' %>>
            <div class="bf-group-head">
              <h3 class="bf-group-name">
                <%= g.isPending ? '아직 회부 전' : g.committee %>
                <span class="bf-group-cnt"><%= nf(g.total) %>건</span>
              </h3>
              <% if (!g.isPending) { %>
                <a class="bf-group-more" href="/bill?committee=<%= encodeURIComponent(g.committee) %>">이 위원회 전체 법안 →</a>
              <% } else { %>
                <span class="bf-group-note">위원회 배정 대기 중</span>
              <% } %>
            </div>
            <ul class="bf-bill-list">
              <% g.bills.forEach((bill, i) => { %>
                <%# 기본 5건만 노출. 나머지는 접어두되 **마크업은 이미 있다** — 토글이 서버 왕복 없이 편다 %>
                <li class="<%= i >= b.billsPerGroup ? 'bf-extra' : '' %>"<%= i >= b.billsPerGroup ? ' hidden' : '' %>>
                  <a class="bf-bill" href="/bill/<%= bill.bill_id %>">
                    <span class="bf-bill-avatar"><%- avatarHtml(bill.proposer_name || '', bill.proposer_photo, 38) %></span>
                    <span class="bf-bill-body">
                      <span class="bf-bill-name"><%= bill.bill_name %></span>
                      <%# 2줄 클램프라 실제로 보이는 건 90자 남짓 — 더 뽑아봐야 전송만 늘어난다 %>
                      <% const prev = summaryPreview(bill.summary, 95); %>
                      <% if (prev) { %><span class="bf-bill-sum"><%= prev %></span><% } %>
                      <span class="bf-bill-foot">
                        <b><%= bill.proposer_name || '—' %></b>
                        <% if (bill.proposer_party) { %><span class="bf-bill-party"><%= bill.proposer_party %></span><% } %>
                        <span class="bf-dot">·</span>공동발의 <%= nf(bill.co_proposer_count) %>인
                        <span class="bf-dot">·</span><%= bill.propose_dt.replace(/-/g, '.') %>
                        <% if (bill.has_ai_analysis) { %><span class="bf-ai">🤖 AI 분석</span><% } %>
                      </span>
                    </span>
                  </a>
                </li>
              <% }); %>
            </ul>
            <% if (g.total > b.billsPerGroup) { %>
              <button type="button" class="bf-group-toggle" aria-expanded="false"
                      data-more="이 위원회 <%= nf(g.total - b.billsPerGroup) %>건 더 ▾" data-less="접기 ▴">
                이 위원회 <%= nf(g.total - b.billsPerGroup) %>건 더 ▾
              </button>
            <% } %>
          </div>
      <% }; %>

      <% b.featured.forEach((g) => { renderGroup(g, false); }); %>

      <%# 나머지 위원회 — 기본은 요약 스트립, "전체 보기" 를 누르면 아래 그룹들이 펼쳐진다 %>
      <% if (b.restGroups.length) { %>
        <div class="bf-rest" id="bf-rest-strip">
          <span class="bf-rest-cap">그 외</span>
          <% b.restGroups.forEach((g) => { %>
            <a class="bf-rest-item" href="/bill?committee=<%= encodeURIComponent(g.committee) %>"><%= g.committee %> <b><%= nf(g.total) %></b></a>
          <% }); %>
        </div>
        <% b.restGroups.forEach((g) => { renderGroup(g, true); }); %>
      <% } %>

      <% if (b.totalBills > b.visibleBills) { %>
        <div class="bf-showall-wrap">
          <button type="button" class="bf-showall" id="bf-showall" aria-expanded="false"
                  data-more="이번 주 발의 <%= nf(b.totalBills) %>건 전체 보기 ▾"
                  data-less="접기 ▴">
            이번 주 발의 <%= nf(b.totalBills) %>건 전체 보기 ▾
          </button>
          <p class="bf-showall-note">지금 <%= nf(b.visibleBills) %>건 보이는 중 · 나머지 <%= nf(b.totalBills - b.visibleBills) %>건은 접혀 있습니다</p>
        </div>
      <% } %>

      <p class="bf-cta">
        내용이 더 궁금한 법안은 상세 페이지에서 <strong>AI 분석을 요청</strong>할 수 있습니다.
        요청이 모이면 우선 분석됩니다.
      </p>
    <% } %>
  </section>

  <!-- ===== 누가 냈나 (정당) =====
       ⚠️ 정당 "표시" 와 정당색 사용은 다르다. 중립성 원칙은 파랑·빨강 금지지 정당 언급 금지가 아니다.
          막대는 정당 불문 **골드 단색** — 정당별로 색을 나누지 말 것. -->
  <% if (b.parties.length) { %>
    <section class="bf-sec" id="bf-party">
      <div class="bf-sec-head">
        <h2 class="bf-h">누가 냈나</h2>
        <p class="bf-sub">대표발의자 소속 정당 기준입니다. 의석수가 다르므로 건수를 그대로 비교하면 오해가 됩니다.</p>
      </div>
      <ul class="bf-party-list">
        <% b.parties.forEach((p) => { %>
          <li class="bf-party">
            <span class="bf-party-name"><%= p.party %></span>
            <span class="bf-party-bar"><span style="width: <%= b.partyMax > 0 ? Math.round(p.cnt / b.partyMax * 100) : 0 %>%"></span></span>
            <span class="bf-party-cnt"><%= nf(p.cnt) %></span>
          </li>
        <% }); %>
      </ul>
    </section>
  <% } %>

  <!-- ===== 마지막으로 처리된 날 =====
       ⚠️ 기간 창을 걸지 않는다. 처리는 드물어서(본회의 월 1~2회) 7일로 자르면 늘 빈다. -->
  <section class="bf-sec" id="bf-processed">
    <div class="bf-sec-head">
      <h2 class="bf-h">마지막으로 처리된 날</h2>
      <p class="bf-sub">법안 처리는 매일 있지 않습니다. 가장 최근에 결론이 난 날을 보여줍니다.</p>
    </div>
    <div class="bf-stages">
      <% [['본회의', b.floor, b.floorBills], ['위원회', b.committeeStage, b.committeeBills]].forEach(([title, st, bills]) => { %>
        <div class="bf-stage">
          <div class="bf-stage-head">
            <span class="bf-stage-title"><%= title %></span>
            <% if (st) { %><span class="bf-stage-date"><%= stageWhen(st) %></span><% } %>
          </div>
          <% if (!st) { %>
            <p class="bf-empty">기록이 없습니다.</p>
          <% } else { %>
            <div class="bf-stage-total"><%= nf(st.total) %><span>건</span></div>
            <ul class="bf-results">
              <% st.results.forEach((r) => { %>
                <li><span class="bf-result-label"><%= r.label %></span><span class="bf-result-cnt"><%= nf(r.cnt) %></span></li>
              <% }); %>
            </ul>
            <% if (bills.length) { %>
              <ul class="bf-stage-bills">
                <% bills.forEach((bl) => { %>
                  <li><a href="/bill/<%= bl.bill_id %>"><%= bl.bill_name %></a></li>
                <% }); %>
              </ul>
            <% } %>
          <% } %>
        </div>
      <% }); %>
    </div>
  </section>

  <p class="bf-foot">
    출처: 열린국회정보 · 발의일·처리일 기준 집계입니다.
    이 페이지는 AI 해석 없이 <strong>데이터만</strong> 보여줍니다.
  </p>
</div>

<style>
  .bf-wrap { max-width: 1000px; margin: 0 auto; padding: 32px 24px 80px; }
  .bf-fresh { color: var(--sub2); }
  .bf-dot { color: var(--border2); margin: 0 2px; }
  .bf-dim { color: var(--sub2); }
  .bf-empty { font-size: 14px; color: var(--sub2); font-style: italic; margin: 0; }

  .bf-sec { margin-bottom: 48px; }
  .bf-sec-head { margin-bottom: 16px; }
  .bf-h { font-family: 'Noto Serif KR', serif; font-size: 23px; font-weight: 700; color: var(--text); margin: 0 0 6px; }
  .bf-sub { font-size: 13.5px; line-height: 1.7; color: var(--sub); margin: 0; word-break: keep-all; }
  .bf-sub strong { font-weight: 700; color: var(--text); }

  /* ── 요약 스트립 ── */
  .bf-strip {
    display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap;
    background: var(--bg2); border: 1px solid var(--border); border-radius: 12px;
    padding: 16px 20px; margin-bottom: 40px;
  }
  .bf-strip-nums { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-size: 14px; color: var(--sub); }
  .bf-strip-item b { font-family: 'JetBrains Mono', monospace; font-size: 19px; color: var(--accent); font-weight: 700; margin-right: 1px; }
  .bf-strip-sep { color: var(--border2); }
  .bf-spark { display: flex; align-items: flex-end; gap: 3px; height: 34px; flex-shrink: 0; }
  .bf-spark-col { width: 7px; height: 100%; display: flex; align-items: flex-end; }
  .bf-spark-bar { width: 100%; background: var(--accent); border-radius: 2px 2px 0 0; min-height: 2px; }
  /* 주말은 값이 0이라도 자리를 지킨다 — "평일에만 움직인다" 가 이 그래프의 요점 */
  .bf-spark-col.is-weekend .bf-spark-bar { background: var(--border2); }
  .bf-spark-cap { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--sub2); align-self: flex-end; margin-left: 4px; }

  /* ── 몰린 법률 ── */
  .bf-hot-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .bf-hot {
    display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center;
    background: #FBF5EA; border: 1px solid #EFE3CC; border-radius: 10px;
    padding: 12px 16px; text-decoration: none; color: inherit; transition: border-color 0.15s;
  }
  .bf-hot:hover { border-color: var(--accent); }
  .bf-hot-cnt {
    font-family: 'JetBrains Mono', monospace; font-size: 20px; font-weight: 700;
    color: #8F5800; min-width: 24px; text-align: center;
  }
  .bf-hot-body { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .bf-hot-name { font-size: 14.5px; font-weight: 600; color: var(--text); word-break: keep-all; }
  .bf-hot-meta { font-size: 12px; color: var(--sub); }
  .bf-hot-go { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #8F5800; white-space: nowrap; }

  /* ── 위원회 그룹 ── */
  .bf-group { margin-bottom: 26px; }
  .bf-group-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 9px; padding-bottom: 7px; border-bottom: 1px solid var(--border); }
  .bf-group-name { font-size: 15px; font-weight: 700; color: var(--text); margin: 0; word-break: keep-all; }
  .bf-group-cnt { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--accent); margin-left: 7px; }
  .bf-group-more { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--sub2); text-decoration: none; white-space: nowrap; }
  .bf-group-more:hover { color: var(--accent); }
  .bf-group-note { font-size: 11.5px; color: var(--sub2); }
  .bf-group-rest { font-size: 12px; color: var(--sub2); margin: 6px 0 0; padding-left: 2px; }

  .bf-bill-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .bf-bill {
    display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start;
    background: var(--bg2); border: 1px solid var(--border); border-radius: 10px;
    padding: 13px 15px; text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s;
  }
  .bf-bill:hover { border-color: var(--border2); transform: translateX(2px); }
  .bf-bill-avatar { width: 38px; height: 38px; border-radius: 50%; overflow: hidden; border: 1px solid var(--border); background: var(--bg3); line-height: 0; flex-shrink: 0; }
  .bf-bill-body { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .bf-bill-name { font-size: 14.5px; font-weight: 600; color: var(--text); line-height: 1.5; word-break: keep-all; }
  .bf-bill-sum {
    font-size: 13px; color: var(--sub); line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .bf-bill-foot { font-size: 12.5px; color: var(--sub); display: flex; align-items: center; gap: 3px; flex-wrap: wrap; }
  .bf-bill-foot b { color: var(--text); font-weight: 600; }
  /* 정당은 텍스트로만 — 정당색을 쓰지 않는다 */
  .bf-bill-party { color: var(--sub2); }
  .bf-ai { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #8F5800; border: 1px solid currentColor; border-radius: 4px; padding: 1px 5px; margin-left: 3px; }

  /* 그룹별 "더 보기" — 접힌 법안이 이미 DOM 에 있으므로 서버 왕복 없음 */
  .bf-group-toggle, .bf-showall {
    background: none; border: 0; cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    color: #8F5800; padding: 8px 0 0;
  }
  .bf-group-toggle {
    font-size: 11.5px;
    min-height: 44px;              /* 터치 타깃 (실측 24px 였음) */
    display: inline-flex; align-items: center;
  }
  .bf-group-toggle:hover { color: #6B4200; }

  .bf-showall-wrap { text-align: center; padding: 22px 0 0; border-top: 1px solid var(--border); margin-top: 20px; }
  .bf-showall {
    font-size: 13px; font-weight: 700;
    border: 1px solid #8F5800; border-radius: 999px;
    padding: 10px 22px; min-height: 44px;      /* 터치 타깃 */
  }
  .bf-showall:hover { background: #FBF5EA; }
  .bf-showall-note { font-size: 12px; color: var(--sub2); margin: 8px 0 0; }

  .bf-rest { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; padding: 14px 0 0; border-top: 1px solid var(--border); }
  /* ⚠️ display:flex 는 [hidden] 을 덮어쓴다 — 명시적으로 꺼줘야 JS 의 hidden 토글이 먹는다
     (bill_detail 의 .ba-proposers-grid 에서 이미 겪은 함정) */
  .bf-rest[hidden] { display: none; }
  .bf-rest-cap { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.2em; color: #746C5D; text-transform: uppercase; }
  .bf-rest-item { font-size: 12.5px; color: var(--sub); text-decoration: none; }
  a.bf-rest-item:hover { color: var(--accent); }
  .bf-rest-item b { font-family: 'JetBrains Mono', monospace; color: var(--text); }

  .bf-cta { font-size: 13px; color: var(--sub); line-height: 1.7; margin: 18px 0 0; padding: 14px 16px; background: var(--bg3); border-radius: 10px; word-break: keep-all; }
  .bf-cta strong { color: var(--text); font-weight: 700; }

  /* ── 정당 ── */
  .bf-party-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .bf-party { display: grid; grid-template-columns: minmax(0, 130px) 1fr auto; gap: 12px; align-items: center; }
  .bf-party-name { font-size: 13.5px; color: var(--text); word-break: keep-all; }
  .bf-party-bar { height: 9px; background: var(--bg3); border-radius: 5px; overflow: hidden; }
  /* 모든 정당 동일한 골드 — 정당별 색 구분 금지 */
  .bf-party-bar span { display: block; height: 100%; background: var(--accent); border-radius: 5px; }
  .bf-party-cnt { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--sub); min-width: 30px; text-align: right; }

  /* ── 최근 처리 ── */
  .bf-stages { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .bf-stage { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 18px; min-width: 0; }
  .bf-stage-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
  .bf-stage-title { font-size: 14.5px; font-weight: 700; color: var(--text); }
  .bf-stage-date { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--sub2); }
  .bf-stage-total { font-family: 'JetBrains Mono', monospace; font-size: 26px; font-weight: 700; line-height: 1; color: var(--accent); }
  .bf-stage-total span { font-size: 14px; color: var(--sub); margin-left: 3px; font-weight: 400; }
  .bf-results { list-style: none; margin: 11px 0 0; padding: 0; display: flex; flex-direction: column; gap: 5px; }
  .bf-results li { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; }
  .bf-result-label { color: var(--sub); word-break: keep-all; }
  .bf-result-cnt { font-family: 'JetBrains Mono', monospace; color: var(--text); font-weight: 600; flex-shrink: 0; }
  .bf-stage-bills { list-style: none; margin: 13px 0 0; padding: 11px 0 0; border-top: 1px dashed var(--border); display: flex; flex-direction: column; gap: 6px; }
  .bf-stage-bills a { font-size: 12.5px; color: var(--sub); text-decoration: none; line-height: 1.5;
                      display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .bf-stage-bills a:hover { color: var(--accent); }

  .bf-foot { font-size: 12.5px; color: var(--sub2); line-height: 1.7; margin: 0; padding-top: 20px; border-top: 1px solid var(--border); word-break: keep-all; }
  .bf-foot strong { color: var(--sub); }

  @media (max-width: 768px) {
    .bf-wrap { padding: 24px 16px 80px; }
    .bf-strip { padding: 14px 16px; }
    .bf-strip-nums { font-size: 13px; }
    .bf-strip-item b { font-size: 17px; }
    .bf-spark { width: 100%; justify-content: space-between; gap: 2px; }
    .bf-spark-col { flex: 1; width: auto; }
    .bf-stages { grid-template-columns: 1fr; }
    .bf-party { grid-template-columns: minmax(0, 96px) 1fr auto; }
    .bf-hot { grid-template-columns: auto 1fr; }
    .bf-hot-go { display: none; }   /* 카드 전체가 링크라 없어도 동작이 명확하다 */
  }
</style>

<script>
(() => {
  /* 접기·펼치기 — 법안 마크업이 이미 DOM 에 있어서 서버 왕복이 없다.
     ⚠️ 데이터를 전부 내려보내는 대신(실측 98건) 상호작용을 즉시 만든 선택이다.
        건수가 크게 늘면 그때 서버 페이징으로 바꿀 것. */
  const swap = (btn, expanded) => {
    btn.textContent = expanded ? btn.dataset.less : btn.dataset.more;
    btn.setAttribute('aria-expanded', String(expanded));
  };

  /* 그룹별 "N건 더" */
  document.querySelectorAll('.bf-group-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.bf-group');
      const open = btn.getAttribute('aria-expanded') !== 'true';
      group.querySelectorAll('.bf-extra').forEach((li) => { li.hidden = !open; });
      swap(btn, open);
    });
  });

  /* 페이지 전체 보기 — 접힌 그룹 + 각 그룹의 나머지 법안을 한 번에 */
  const showAll = document.getElementById('bf-showall');
  if (showAll) {
    const strip = document.getElementById('bf-rest-strip');
    const note = document.querySelector('.bf-showall-note');
    showAll.addEventListener('click', () => {
      const open = showAll.getAttribute('aria-expanded') !== 'true';
      document.querySelectorAll('.bf-extra').forEach((li) => { li.hidden = !open; });
      document.querySelectorAll('.bf-hidden-group').forEach((g) => { g.hidden = !open; });
      // 그룹별 토글 버튼 상태도 같이 맞춘다 (안 맞추면 "더 보기" 인데 이미 펼쳐져 있는 상태가 된다)
      document.querySelectorAll('.bf-group-toggle').forEach((t) => swap(t, open));
      // 펼치면 "그 외" 요약 스트립은 중복이라 감춘다 (그 그룹들이 아래에 실제로 나오므로)
      if (strip) strip.hidden = open;
      // 안내 문구("지금 N건 보이는 중")는 접힘 상태 설명이라 펼치면 남겨두면 거짓말이 된다
      if (note) note.hidden = open;
      swap(showAll, open);
      if (!open) showAll.scrollIntoView({ block: 'center', behavior: 'smooth' });
    });
  }
})();
</script>
