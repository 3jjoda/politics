<%
  /* 인스타 카드 — 1080×1350 세로 캔버스 (4:5, 인스타 피드에서 가장 세로가 긴 비율)
   *
   * ⚠️ 두 모드가 **같은 .sl 마크업**을 쓴다. 미리보기와 캡처 결과가 달라지면
   *    "미리보기에서 멀쩡했는데 올린 게 깨지는" 상황이 생긴다.
   *      single=null → 축소 배열 + 툴바
   *      single=N    → 그 장만 1:1 (body 가 정확히 1080×1350 → 전체 페이지 캡처 = 카드)
   *
   * ⚠️ layout:false 라 폰트를 여기서 직접 로드한다. layout.ejs 를 고쳐도 안 따라온다.
   *    JetBrains Mono 700 은 layout 이 안 받는 굵기라 여기서만 추가로 받는다 (큰 숫자용).
   */
  const p = post;
  const st = p.stats || {};
  const D = p.briefing_date.replace(/-/g, '.');

  // 요일 — 날짜를 "기록" 처럼 읽히게 한다.
  // ⚠️ `new Date('YYYY-MM-DD').getDay()` 는 실행 환경 타임존을 탄다 (프로젝트 규칙: 로컬 getter 금지).
  //    Date.UTC 로 고정해 계산하면 어느 환경에서도 같은 값이 나온다.
  const [dY, dM, dD] = p.briefing_date.split('-').map(Number);
  const DOW = ['일', '월', '화', '수', '목', '금', '토'][new Date(Date.UTC(dY, dM - 1, dD)).getUTCDay()];
  const shown = story ? [] : (single ? [slides[single - 1]] : slides);
  // 1:1 캡처 모드 — 슬라이드 단건이거나 스토리 단건
  const one = story || !!single;

  // 헤드라인은 길이가 제각각이라 **서버가 크기를 정한다.**
  // JS 로 줄이면 캡처 타이밍에 따라 크기가 달라진다 (자동화가 폰트 로드 전에 찍을 수 있음).
  const hl = p.headline || '';
  const hlSize = hl.length <= 18 ? 112 : hl.length <= 30 ? 94 : hl.length <= 44 ? 76 : 62;
  // 스토리는 세로가 570px 더 길어 헤드라인을 키울 수 있다
  const hlStory = hl.length <= 18 ? 128 : hl.length <= 30 ? 108 : hl.length <= 44 ? 88 : 72;

  // 표지 하단 숫자 — 헤드라인만 두면 세로가 크게 남고, 무엇보다 **문장 옆에 근거가 붙는다.**
  // (AI 가 쓴 문장 바로 아래 SQL 집계 숫자가 오는 배치)
  const coverNums = p.isEmpty ? [] : [
    st.proposed !== undefined ? { v: st.proposed, l: '발의' } : null,
    st.proposers ? { v: st.proposers, l: '대표발의' } : null,
    st.cosign ? { v: st.cosign, l: '공동발의 서명' } : null,
  ].filter(Boolean);

  const badge = p.isAi ? 'AI 정리' : (p.isEmpty ? '활동 없음' : '데이터 집계');
%><!doctype html>
<html lang="ko" class="<%= one ? 'one' : '' %><%= story ? ' story' : '' %>">
<head>
<meta charset="utf-8">
<title><%= D %> 인스타 카드 · 당말사</title>
<meta name="robots" content="noindex">
<%# layout:false 라 파비콘도 여기서 직접 건다. 안 걸면 브라우저가 루트 /favicon.ico 로 떨어진다 (layout.ejs 와 같은 에셋) %>
<link rel="icon" type="image/svg+xml" href="/assets/imgs/favicon-32.svg">
<link rel="shortcut icon" href="/assets/imgs/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/imgs/apple-touch-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&family=Noto+Serif+KR:wght@700;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#F7F6F1; --bg2:#FFFFFF; --tint:#FBF5EA;
    --ink:#1A1D24; --sub:#4B5362; --sub2:#7A8090;
    --gold:#B8740C; --gold-d:#8F5800;
    --line:#E2DFD4; --line2:#C9C5B6;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: 'Noto Sans KR', sans-serif; background: #3A3833; }

  /* ── 캔버스 ───────────────────────────────────────────────
     크기를 절대 상대단위로 두지 말 것 — 뷰포트가 바뀌면 캡처 크기가 흔들린다. */
  .sl {
    width: 1080px; height: 1350px; flex: 0 0 auto;
    background: var(--bg); color: var(--ink);
    display: flex; flex-direction: column;
    position: relative; overflow: hidden;
  }
  .sl-rule { height: 14px; flex: 0 0 auto; background: var(--gold); }
  .sl.is-sub .sl-rule { height: 8px; background: var(--line); }
  .sl.is-sub .sl-rule::after { content:''; display:block; width: 160px; height: 100%; background: var(--gold); }

  .sl-in { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 62px 76px 56px; }

  /* 모든 텍스트에 두 줄바꿈 규칙을 같이 건다.
     keep-all 만 두면 공백 없는 긴 법안·위원회 이름이 통째로 삐져나간다 (사이트에서 반복된 함정). */
  .sl-in, .sl-in * { word-break: keep-all; overflow-wrap: anywhere; }

  .sl-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex: 0 0 auto; }
  .sl-head-r { display: flex; align-items: center; gap: 18px; flex: 0 0 auto; }
  /* 표지의 날짜는 **메타가 아니라 정체**다 (일간 기록물이라 날짜가 곧 제목의 일부).
     다른 장은 반복 노출이라 워터마크 수준으로 낮춘다 — 같은 크기로 두면 5장 내내 시끄럽다 */
  .sl-date { font-family:'JetBrains Mono',monospace; font-size: 34px; font-weight: 700; letter-spacing: .16em; color: var(--sub); }
  .sl-date.is-hero { font-size: 54px; letter-spacing: .08em; color: var(--ink); display: inline-flex; align-items: baseline; }
  <%# ⚠️ .sl-date 가 mono 라 물려받는다. JetBrains Mono 에 한글 글리프가 없어 '(수)' 만 폴백된다 %>
  .sl-dow { font-family:'Noto Sans KR',sans-serif; font-size: 30px; font-weight: 500;
            color: var(--sub2); letter-spacing: 0; margin-left: 14px; }
  .sl-tag {
    font-size: 26px; font-weight: 700; letter-spacing: .04em; color: var(--gold-d);
    border: 2px solid var(--gold-d); border-radius: 10px; padding: 7px 18px; background: var(--tint);
    white-space: nowrap;
  }
  .sl-tag.is-plain { color: var(--sub2); border-color: var(--line2); background: transparent; }
  .sl-label { font-size: 30px; font-weight: 700; letter-spacing: .1em; color: var(--gold-d); }

  /* 🔴 세 줄이 세트다. 하나라도 빠지면 긴 콘텐츠에서 조용히 깨진다:
       ① safe center — 그냥 center 면 넘칠 때 **위아래로 동시에** 삐져나가 제목이 잘린다.
                       safe 는 넘치는 순간 flex-start 로 떨어져 머리부터 보이게 한다
       ② overflow:hidden — 넘친 꼬리가 하단 브랜드 줄을 덮는 것을 막는다 (여기서 정확히 잘림)
       ③ 자식 flex:0 0 auto — 기본값(shrink:1)이면 목록이 찌그러져 **넘침이 측정에 안 잡힌다.**
                       실제로 스트레스 테스트에서 over=0 으로 나와 한 번 놓쳤다 */
  .sl-body { flex: 1; min-height: 0; display: flex; flex-direction: column;
             justify-content: center; justify-content: safe center;
             overflow: hidden; padding: 44px 0; }
  .sl-body > * { flex: 0 0 auto; }

  /* 간격 2단 분리: 브랜드 안쪽 12px / 구분선 바깥 16px.
     nav 기준(마크 36 · 안 9px · 밖 12px · 구분선 1×20 · 태그라인 h18)을 마크 46 배율로 옮긴 값 */
  .sl-foot { flex: 0 0 auto; display: flex; align-items: center; gap: 16px; border-top: 2px solid var(--line); padding-top: 26px; }
  .sl-brand { display: flex; align-items: center; gap: 12px; }
  .sl-mark { width: 46px; height: 46px; display: block; }
  .sl-wm { height: 34px; display: block; }
  /* ⚠️ 태그라인은 nav 비율(h18)을 그대로 옮기면 안 된다.
     nav 는 1:1 로 보지만 이 카드는 **폰에서 ~2.8배 축소**돼 h22 가 8px 로 뭉개진다.
     화면에서 읽히는 크기를 기준으로 잡을 것 (h28 → 폰 약 10px) */
  .sl-div { width: 1px; height: 30px; background: var(--line2); flex: 0 0 auto; }
  .sl-tagline { height: 28px; display: block; }
  .sl-url { margin-left: auto; font-family:'JetBrains Mono',monospace; font-size: 26px; font-weight: 500; color: var(--gold-d); letter-spacing: .02em; }
  .sl-src { font-size: 24px; color: var(--sub2); }

  /* ── 표지 ── */
  .sl-hl { font-family:'Noto Serif KR',serif; font-weight: 900; line-height: 1.34; margin: 0; padding-left: 34px; border-left: 12px solid var(--gold); }
  .sl-kicker { font-size: 32px; font-weight: 500; color: var(--sub); margin: 0 0 30px; letter-spacing: .02em; }
  .sl-cov { display: flex; gap: 56px; margin: 60px 0 0; padding: 36px 0 0; border-top: 2px solid var(--line2); }
  .sl-cov-i { display: flex; flex-direction: column; gap: 6px; }
  .sl-cov-v { font-family:'JetBrains Mono',monospace; font-size: 62px; font-weight: 700; color: var(--gold-d); line-height: 1; }
  .sl-cov-l { font-size: 28px; font-weight: 500; color: var(--sub2); }

  /* ── 숫자 ── */
  /* 행이 3~4개뿐이라 가운데 정렬만 하면 위아래가 텅 빈다 → 남는 높이를 행 사이로 흘린다.
     ⚠️ `flex: 1 0 auto` — grow 만 허용. shrink 를 열면 위에서 막아둔 찌그러짐이 되살아난다
     ⚠️ 2행 이하는 `is-few` 로 분배를 끈다 — space-evenly 가 366px 짜리 구멍을 만들어
        두 줄이 서로 남처럼 떨어져 보인다 (실측) */
  .sl-body > .nums, .sl-body > .laws { flex: 1 0 auto; }
  .nums, .laws { display: flex; flex-direction: column; justify-content: space-evenly; }
  .nums.is-few, .laws.is-few { justify-content: center; }
  .nums.is-few .num, .laws.is-few .law { padding: 44px 0; }
  .num { display: flex; align-items: baseline; gap: 24px; padding: 30px 0; border-bottom: 2px solid var(--line); }
  .num:last-child { border-bottom: 0; }
  .num-l { font-size: 40px; font-weight: 500; color: var(--sub); }
  .num-v { margin-left: auto; font-family:'JetBrains Mono',monospace; font-size: 96px; font-weight: 700; color: var(--gold-d); line-height: 1; }
  .num-u { font-size: 34px; font-weight: 500; color: var(--sub2); }
  .cmt { margin: 34px 0 0; font-size: 30px; line-height: 1.7; color: var(--sub); }

  /* ── 주제 묶음 ── */
  /* 줄 수를 고정해야 카드 높이가 예측된다 — AI 출력은 길이가 들쭉날쭉하다 */
  .th-theme { font-family:'Noto Serif KR',serif; font-size: 62px; font-weight: 900; line-height: 1.36; margin: 0 0 28px;
              display:-webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .th-what { font-size: 38px; line-height: 1.72; color: var(--sub); margin: 0;
             display:-webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden; }
  .th-cnt { font-family:'JetBrains Mono',monospace; font-size: 30px; font-weight: 700; color: var(--gold-d);
            border: 2px solid var(--gold-d); border-radius: 9px; padding: 5px 16px; background: var(--tint); white-space: nowrap; }
  .th-bills { list-style: none; margin: 40px 0 0; padding: 26px 0 0; border-top: 2px solid var(--line);
              display: flex; flex-direction: column; gap: 14px; }
  .th-bills li { font-size: 30px; line-height: 1.5; color: var(--sub); padding-left: 22px; border-left: 5px solid var(--line2);
                 display:-webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  <%# 이름만 — 정당은 넣지 않는다. 카드 한 장에 정당명이 늘어서면 그 자체가 대비 구도가 된다 %>
  .th-by { color: var(--sub2); margin-left: 12px; font-size: 26px; }

  /* ── 몰린 법률 ── */
  .law { display: flex; align-items: baseline; gap: 22px; padding: 26px 0; border-bottom: 2px solid var(--line); }
  <%# ⚠️ .law-c 안에 있어서 mono 를 물려받는다. JetBrains Mono 에는 한글 글리프가 없어
      그대로 두면 '건' 만 다른 폰트로 폴백된다 — 반드시 본문 폰트를 다시 지정할 것 %>
  .law-u { font-family:'Noto Sans KR',sans-serif; font-size: 30px; font-weight: 500; color: var(--sub2); margin-left: 6px; }
  .law:last-child { border-bottom: 0; }
  .law-n { font-size: 36px; font-weight: 500; line-height: 1.45;
           display:-webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .law-c { margin-left: auto; font-family:'JetBrains Mono',monospace; font-size: 72px; font-weight: 700; color: var(--gold-d); line-height: 1; white-space: nowrap; }

  /* ── 아웃트로 ── */
  .out { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 26px; }
  .out-mark { width: 128px; height: 128px; }
  .out-wm { height: 74px; }
  .out-tag { height: 40px; }
  .out-url { font-family:'JetBrains Mono',monospace; font-size: 42px; font-weight: 700; color: var(--gold-d); letter-spacing: .02em; margin-top: 10px; }
  .out-cta { font-size: 34px; line-height: 1.65; color: var(--sub); margin: 0; }
  .note { margin: 34px 0 0; font-size: 26px; line-height: 1.68; color: #6B4200;
          background: var(--tint); border: 2px solid #EFE3CC; border-radius: 16px; padding: 24px 28px; text-align: left; }
  .note strong { font-weight: 700; }

  /* ── 미리보기 모드 (캡처에는 안 들어감) ───────────────── */
  .tb { position: sticky; top: 0; z-index: 10; background: #26241F; color: #EDE9E0; padding: 18px 26px;
        display: flex; align-items: center; gap: 18px; flex-wrap: wrap; font-size: 14px; }
  .tb b { font-size: 15px; }
  .tb code { background: #3A3833; border-radius: 5px; padding: 2px 7px; font-family:'JetBrains Mono',monospace; }
  .tb .sp { margin-left: auto; color: #A8A095; }
  .tb a { color: #E8B562; }
  .pv { display: flex; flex-wrap: wrap; gap: 26px; padding: 26px; }
  .pv-item { width: 378px; }
  .pv-box { width: 378px; height: 472px; overflow: hidden; border-radius: 8px; box-shadow: 0 4px 18px rgba(0,0,0,.35); }
  .pv-box.is-story { height: 672px; }   /* 1920 × 0.35 */
  .pv-box .sl { transform: scale(.35); transform-origin: top left; }
  .pv-cap { display: flex; align-items: center; gap: 10px; margin-top: 10px; font-size: 13px; color: #C8C2B4; }
  .pv-cap a { margin-left: auto; color: #E8B562; text-decoration: none; border-bottom: 1px solid currentColor; }

  /* 캡션 블록 (미리보기 전용) */
  .cap { max-width: 900px; margin: 6px 26px 40px; background: #FFFFFF; border: 1px solid #E2DFD4; border-radius: 12px; overflow: hidden; }
  .cap-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 16px; border-bottom: 1px solid #E2DFD4; background: #F7F6F1; }
  .cap-head b { font-size: 14px; color: #1A1D24; }
  .cap-head span { font-size: 12px; color: #5F6674; flex: 1; min-width: 200px; }
  .cap-copy { font-family: inherit; font-size: 12.5px; font-weight: 700; color: #4B5362; background: #fff;
              border: 1px solid #C9C5B6; border-radius: 6px; padding: 5px 12px; cursor: pointer; }
  .cap-copy:hover { color: #8F5800; border-color: #8F5800; }
  .cap-copy.is-done { color: #0F9D6E; border-color: #0F9D6E; }
  .cap-text { margin: 0; padding: 16px 18px; font-family: inherit; font-size: 14px; line-height: 1.75; color: #1A1D24;
              white-space: pre-wrap; word-break: keep-all; }
  .cap-note { margin: 0; padding: 10px 18px 12px; font-size: 12px; color: #5F6674; border-top: 1px dashed #E2DFD4; }

  /* 1:1 모드 — 문서 자체가 곧 캔버스. 전체 페이지 캡처가 그대로 1080×1350 이 된다.
     ⚠️ body 에만 걸면 안 된다 — html 이 뷰포트 폭(예: 1280)까지 늘어나 오른쪽에 빈 띠가 붙는다 */
  html.one, body.one { width: 1080px; height: 1350px; overflow: hidden; background: var(--bg); }
  html.story, body.story { height: 1920px; }

  /* ── 스토리 (1080×1920, 9:16) ──────────────────────────────
     🔴 인스타 스토리 UI 가 **위아래를 덮는다** — 상단은 프로필·진행바, 하단은 답장 입력바.
        안전영역 밖에 글자를 두면 앱에서 가려진다. 그래서 위 250 / 아래 240 을 비운다.
     🔴 하단에 **링크 스티커 자리를 디자인에 포함**한다. 안 비워두면 사용자가 카드 위에
        스티커를 얹게 되고, 그러면 스티커가 카드 디자인의 일부처럼 보여 눌러야 할 것으로 안 읽힌다 */
  .sl.is-story { width: 1080px; height: 1920px; }
  .sl.is-story .sl-in { padding: 236px 76px 240px; }
  .sl-sticker {
    flex: 0 0 auto; height: 300px; margin-top: 44px;
    display: flex; align-items: center; justify-content: center;
  }
  /* 캡처에는 안 나오는 안내선 — 미리보기에서 "여기가 스티커 자리" 를 보여주기 위한 것 */
  .sl-sticker-hint {
    font-family:'JetBrains Mono',monospace; font-size: 26px; letter-spacing: .12em;
    color: #C9C5B6; border: 2px dashed #C9C5B6; border-radius: 14px; padding: 18px 34px;
  }
  body.story .sl-sticker-hint { display: none; }   /* 실제 캡처에서는 숨긴다 */
</style>
</head>
<body class="<%= one ? 'one' : '' %><%= story ? ' story' : '' %>">

<% if (story) { %>
  <%- include('_card_story', { p, D, DOW, badge, hlStory, coverNums }) %>
<% } %>

<% if (!one) { %>
  <div class="tb">
    <b><%= D %> 인스타 카드</b>
    <span>피드 <%= slides.length %>장 + 스토리 1장</span>
    <span>1080 × 1350 (4:5) · 스토리 1080 × 1920 (9:16)</span>
    <span class="sp">
      <%# 창 캡처는 화면 배율·DPI 를 타서 1080px 이 안 나온다. 노드 캡처가 항상 정확하다 %>
      캡처: <code>1:1로 열기</code> → F12 → Elements 에서 <code>&lt;section class="sl"&gt;</code> 우클릭 →
      <code>Capture node screenshot</code> ·
      <a href="/briefing/<%= p.id %>">← 브리핑으로</a>
    </span>
  </div>
  <div class="pv">
<% } %>

<% shown.forEach((s, i) => { const no = single || (i + 1); %>
  <% if (!one) { %><div class="pv-item"><div class="pv-box"><% } %>

  <section class="sl <%= s.kind === 'cover' ? '' : 'is-sub' %>" data-slide="<%= no %>">
    <div class="sl-rule"></div>
    <div class="sl-in">

      <% if (s.kind === 'cover') { %>
        <div class="sl-head">
          <span class="sl-date is-hero"><%= D %><span class="sl-dow">(<%= DOW %>)</span></span>
          <span class="sl-tag<%= p.isAi ? '' : ' is-plain' %>"><%= badge %></span>
        </div>
        <div class="sl-body">
          <p class="sl-kicker">이날 국회에서</p>
          <h1 class="sl-hl" style="font-size: <%= hlSize %>px"><%= p.headline %></h1>
          <% if (coverNums.length) { %>
            <div class="sl-cov">
              <% coverNums.forEach((n) => { %>
                <div class="sl-cov-i">
                  <span class="sl-cov-v"><%= nf(n.v) %></span>
                  <span class="sl-cov-l"><%= n.l %></span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

      <% } else if (s.kind === 'stats') { %>
        <div class="sl-head">
          <span class="sl-label">그날의 숫자</span>
          <span class="sl-date"><%= D %></span>
        </div>
        <div class="sl-body">
          <div class="nums<%= s.nums.length <= 2 ? ' is-few' : '' %>">
            <% s.nums.forEach((n) => { %>
              <div class="num">
                <span class="num-l"><%= n.l %></span>
                <span class="num-v"><%= nf(n.v) %></span><span class="num-u"><%= n.u %></span>
              </div>
            <% }); %>
          </div>
          <% if (s.committees.length) { %>
            <p class="cmt">위원회별 발의 — <%= s.committees.map((c) => `${c.committee} ${c.cnt}건`).join(' · ') %></p>
          <% } %>
        </div>

      <% } else if (s.kind === 'thread') { %>
        <%# 흐름 장에만 날짜가 없었다 — 캐러셀에서 한 장만 캡처돼 돌아다니면 언제 건지 알 수 없다 %>
        <div class="sl-head">
          <span class="sl-label">이날의 흐름 <%= s.idx %>/<%= s.of %></span>
          <span class="sl-head-r">
            <span class="sl-date"><%= D %></span>
            <span class="th-cnt"><%= nf(s.t.bill_count) %>건</span>
          </span>
        </div>
        <div class="sl-body">
          <h2 class="th-theme"><%= s.t.theme %></h2>
          <p class="th-what"><%= s.t.what %></p>
          <% if (s.bills.length) { %>
            <ul class="th-bills">
              <% s.bills.forEach((b) => { %>
                <li><%= b.name %><% if (b.by) { %><span class="th-by"><%= b.by %></span><% } %></li>
              <% }); %>
            </ul>
          <% } %>
        </div>

      <% } else if (s.kind === 'laws') { %>
        <div class="sl-head">
          <span class="sl-label">같은 법률에 몰린 개정안</span>
          <span class="sl-date"><%= D %></span>
        </div>
        <div class="sl-body">
          <%# .nums 와 같은 이유로 감싼다 — 2~5행뿐이라 안 감싸면 위아래가 텅 빈다 %>
          <div class="laws<%= s.laws.length <= 2 ? ' is-few' : '' %>">
            <% s.laws.forEach((l) => { %>
              <div class="law">
                <span class="law-n"><%= l.bill_name %></span>
                <span class="law-c"><%= nf(l.cnt) %><span class="law-u">건</span></span>
              </div>
            <% }); %>
          </div>
          <%# 여백을 메우려고 넣은 문장이 아니다 — "몰렸다" 가 무슨 뜻인지 모르면 이 장은 숫자 나열이다 %>
          <p class="cmt">하나의 법률을 고치는 개정안이 이날 하루에 여러 건 올라온 경우입니다.</p>
        </div>

      <% } else { %>
        <%# 라벨을 두지 않는다 — 바로 아래 tagline.svg 가 "당 말고 사람" 을 이미 말한다 %>
        <div class="sl-head">
          <span class="sl-date"><%= D %></span>
        </div>
        <div class="sl-body">
          <div class="out">
            <img class="out-mark" src="<%= asset('/assets/imgs/mark-only.svg') %>" alt="">
            <img class="out-wm" src="<%= asset('/assets/imgs/wordmark-nav.svg') %>" alt="당말사">
            <img class="out-tag" src="<%= asset('/assets/imgs/tagline.svg') %>" alt="당 말고 사람">
            <p class="out-url">dangmalsa.kr</p>
            <p class="out-cta">발의된 법안 전문과<br>의원별 표결 기록을 전부 볼 수 있습니다</p>
          </div>
          <%# 사이트에 붙인 것과 **같은 고지**다. 카드가 사이트 밖으로 나가므로 여기가 유일한 고지 지점이 된다 %>
          <p class="note">
            <% if (p.isAi) { %>
              숫자는 <strong>국회 공식 데이터 집계</strong>입니다.
              문장과 주제 묶음은 AI가 법안 원문을 읽고 정리한 것으로 <strong>사실과 다를 수 있습니다.</strong>
            <% } else if (p.isEmpty) { %>
              국회 공식 데이터에 <strong>이날 기록된 활동이 없어</strong> 자동으로 남긴 카드입니다.
            <% } else { %>
              AI 없이 <strong>국회 공식 데이터 집계만으로</strong> 만든 카드입니다.
            <% } %>
            출처: 열린국회정보
          </p>
        </div>
      <% } %>

      <% if (s.kind !== 'outro') { %>
        <%# nav 락업과 **같은 조립 규칙** — 마크↔워드마크는 한 덩어리라 좁게, 구분선 바깥은 넓게.
            단일 gap 으로는 이 위계가 안 나온다 (CLAUDE.md "nav 락업 조립 규칙" 참조) %>
        <div class="sl-foot">
          <span class="sl-brand">
            <img class="sl-mark" src="<%= asset('/assets/imgs/mark-only.svg') %>" alt="">
            <img class="sl-wm" src="<%= asset('/assets/imgs/wordmark-nav.svg') %>" alt="당말사">
          </span>
          <span class="sl-div"></span>
          <img class="sl-tagline" src="<%= asset('/assets/imgs/tagline.svg') %>" alt="당 말고 사람">
          <span class="sl-src">· 출처 열린국회정보</span>
          <span class="sl-url">dangmalsa.kr</span>
        </div>
      <% } %>

    </div>
  </section>

  <% if (!one) { %>
    </div>
    <div class="pv-cap">
      <span><%= no %>. <%= { cover:'표지', stats:'숫자', thread:'흐름', laws:'몰린 법률', outro:'마무리' }[s.kind] %></span>
      <a href="?slide=<%= no %>" target="_blank" rel="noopener">1:1로 열기 ↗</a>
    </div>
    </div>
  <% } %>
<% }); %>

<%# 미리보기 그리드 끝에 스토리도 붙인다 — 비율이 달라 박스만 세로로 길게 %>
<% if (!one) { %>
  <div class="pv-item">
    <div class="pv-box is-story">
      <%- include('_card_story', { p, D, DOW, badge, hlStory, coverNums }) %>
    </div>
    <div class="pv-cap">
      <span>스토리 (9:16)</span>
      <a href="?story=1" target="_blank" rel="noopener">1:1로 열기 ↗</a>
    </div>
  </div>
<% } %>

<% if (!one) { %></div>

  <%# ── 인스타 캡션 — 배치(genInstaCards)의 caption.txt 와 같은 함수(utils/instaCaption.js)로 만든다.
        배치를 안 돌려도 웹에서 미리 보고 그대로 복사해 붙일 수 있게. 캡처 모드(?slide·?story)에는 안 들어간다.
        ⚠️ 마지막 줄 해시태그는 길이 휴리스틱이라 올리기 전 눈으로 한 번 볼 것 (그래서 안내문에 적어둔다) %>
  <section class="cap">
    <div class="cap-head">
      <b>인스타 캡션</b>
      <span>그대로 복사해 캡션 칸에 붙여넣기 · 첫 2줄만 접기 전에 보입니다 · 캡션의 URL 은 눌리지 않아 프로필 링크로 유도합니다</span>
      <button type="button" class="cap-copy" id="cap-copy">복사</button>
    </div>
    <pre class="cap-text" id="cap-text"><%= caption %></pre>
    <p class="cap-note">마지막 줄 해시태그는 키워드 길이로만 거른 것이라 어색한 태그가 섞일 수 있습니다 — 올리기 전에 한 번 보고 손대세요. 정당·인물 태그는 넣지 않습니다.</p>
  </section>

  <script>
  (() => {
    const btn = document.getElementById('cap-copy');
    const el = document.getElementById('cap-text');
    if (!btn || !el) return;
    const flash = (msg) => { const o = btn.textContent; btn.textContent = msg; btn.classList.add('is-done');
      setTimeout(() => { btn.textContent = o; btn.classList.remove('is-done'); }, 1400); };
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(el.textContent); flash('복사됨 ✓'); }
      catch {  // clipboard API 는 HTTPS·localhost 에서만 — 실패하면 선택 상태로 만들어 손으로 복사하게
        const r = document.createRange(); r.selectNodeContents(el);
        const sel = getSelection(); sel.removeAllRanges(); sel.addRange(r);
        flash('직접 복사하세요');
      }
    });
  })();
  </script>
<% } %>
</body>
</html>
