<%
  /* 스토리 슬라이드 (1080×1920) — 카드 페이지와 **같은 .sl 마크업 계열**을 쓴다.
     ⚠️ 미리보기와 캡처가 갈리면 안 되므로 이 파일 하나만 두고 양쪽에서 include 한다.
     필요한 값은 부모에서 명시적으로 넘긴다 (EJS include 는 부모의 const 를 못 본다). */
%>
<section class="sl is-story" data-story="1">
  <div class="sl-rule"></div>
  <div class="sl-in">

    <div class="sl-head">
      <span class="sl-date is-hero"><%= D %><span class="sl-dow">(<%= DOW %>)</span></span>
      <span class="sl-tag<%= p.isAi ? '' : ' is-plain' %>"><%= badge %></span>
    </div>

    <div class="sl-body">
      <p class="sl-kicker">이날 국회에서</p>
      <h1 class="sl-hl" style="font-size: <%= (storyThreads && storyThreads.length) ? hlStoryFlow : hlStory %>px"><%= p.headline %></h1>
      <% if (coverNums.length) { %>
        <div class="sl-cov">
          <% coverNums.forEach((n) => { %>
            <div class="sl-cov-i">
              <span class="sl-cov-v"><%= nf(n.v) %></span>
              <span class="sl-cov-l"><%= n.l %></span>
            </div>
          <% }); %>
        </div>
      <% } %>

      <%# 「이날의 흐름」 — 헤드라인·숫자만 있던 자리의 아래를 채운다.
          스토리는 링크 스티커가 붙는 유일한 1탭 경로라, 여기서 "무엇이 발의됐는지" 가 구체적으로 보여야 탭한다.
          ⚠️ 캐러셀 흐름 장과 같은 재료지만 법안 목록은 뺀다 — 축소율이 커서 못 읽는다 %>
      <% if (storyThreads && storyThreads.length) { %>
        <div class="st-flow">
          <p class="st-flow-cap">이날의 흐름</p>
          <% storyThreads.forEach((t) => { %>
            <div class="st-item">
              <div class="st-top">
                <span class="st-theme"><%= t.theme %></span>
                <% if (t.cnt) { %><span class="st-cnt"><%= t.cnt %>건</span><% } %>
              </div>
              <% if (t.what) { %><p class="st-what"><%= t.what %></p><% } %>
            </div>
          <% }); %>
        </div>
      <% } %>

      <%# 활동 없음 카드에는 붙이지 않는다 — 그날 법안이 0건인데 "법안별 발의자" 로 유도하면 거짓이 된다 %>
      <% if (!p.isEmpty) { %>
        <p class="st-cta">법안별 발의자와 원문 <span>· 프로필 링크 또는 아래 스티커</span></p>
      <% } %>
    </div>

    <%# 링크 스티커 자리 — 비워두는 게 목적이다. 안 비우면 카드 위에 스티커를 얹게 되고
        그러면 스티커가 카드 디자인의 일부처럼 보여 "눌러야 할 것" 으로 안 읽힌다 %>
    <div class="sl-sticker"><span class="sl-sticker-hint" data-shot-omit>링크 스티커 자리</span></div>

    <div class="sl-foot">
      <span class="sl-brand">
        <img class="sl-mark" src="<%= asset('/assets/imgs/mark-only.svg') %>" alt="">
        <img class="sl-wm" src="<%= asset('/assets/imgs/wordmark-nav.svg') %>" alt="당말사">
      </span>
      <span class="sl-div"></span>
      <img class="sl-tagline" src="<%= asset('/assets/imgs/tagline.svg') %>" alt="당 말고 사람">
      <span class="sl-src">· 출처 열린국회정보</span>
      <span class="sl-url">dangmalsa.kr</span>
    </div>

  </div>
</section>
