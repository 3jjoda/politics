<%
  const nf = (n) => Number(n || 0).toLocaleString('ko-KR');
  const resultClass = (r) => {
    if (!r) return 'pb-badge-pending';
    if (r.indexOf('가결') > -1) return 'pb-badge-passed';
    if (r === '부결' || r === '폐기') return 'pb-badge-rejected';
    if (r === '철회') return 'pb-badge-withdrawn';
    if (r.indexOf('대안') > -1) return 'pb-badge-alt';
    return 'pb-badge-pending';
  };
  const { page, totalPages, totalCount } = pagination;

  const rows = locals.rows || [];
  const filter = locals.filter || 'all';
  const isPosts = filter === 'posts';

  /* 링크 조립 — 보기(on)·글유형(type)·페이지를 함께 들고 다닌다 */
  const qs = (o) => {
    const on = o.on !== undefined ? o.on : filter;
    const ty = o.type !== undefined ? o.type : locals.activeType;
    const q = [];
    if (on && on !== 'all') q.push(`on=${encodeURIComponent(on)}`);
    if (ty) q.push(`type=${encodeURIComponent(ty)}`);
    if (o.page && o.page > 1) q.push(`page=${o.page}`);
    return q.length ? `/community?${q.join('&')}` : '/community';
  };
  const buildHref = (pg) => qs({ page: pg });

  /* 대화 종류 → 라벨·원래 자리 링크.
     🔴 링크가 이 피드의 핵심이다 — 댓글을 **읽는 곳**이 아니라 원래 맥락으로 **돌려보내는 곳**이다.
     ⚠️ 앵커는 각 페이지의 실제 섹션 id 와 같아야 한다 (법안 #part-comments · 의원 #comments) */
  const TALK_KIND = {
    bill:       { label: '법안',   href: (t) => `/bill/${encodeURIComponent(t)}#part-comments` },
    politician: { label: '의원',   href: (t) => `/politician/${encodeURIComponent(t)}#comments` },
    briefing:   { label: '브리핑', href: (t) => `/briefing/${encodeURIComponent(t)}#part-comments` },
    post:       { label: '글',     href: (t) => `/community/${encodeURIComponent(t)}` },
  };
  const typeMeta = (k) => (locals.postTypes || []).find((t) => t.key === k) || null;
  const pagesAround = () => {
    const maxBtns = 7;
    let start = Math.max(1, page - 3);
    let end = Math.min(totalPages, start + maxBtns - 1);
    start = Math.max(1, end - maxBtns + 1);
    const arr = [];
    for (let p = start; p <= end; p++) arr.push(p);
    return arr;
  };
%>

<style>
  .cm-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 36px 24px 80px;
  }
  .cm-write-btn {
    padding: 10px 22px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s;
  }
  .cm-write-btn:hover { background: var(--accent2); }
  .cm-write-btn.disabled {
    background: var(--bg3);
    color: var(--sub2);
    border: 1px solid var(--border);
    cursor: not-allowed;
    pointer-events: none;
  }

  /* 유형 탭 — 서버 렌더 링크. 모르는 type 은 컨트롤러가 전체로 접는다 */
  .cm-tabs { display: flex; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--border2); margin: 0 0 18px; }
  .cm-tab {
    display: inline-flex; align-items: baseline; gap: 6px; padding: 10px 14px 12px; margin-bottom: -1px;
    font-size: 14.5px; font-weight: 700; color: var(--sub); text-decoration: none; border-bottom: 2px solid transparent;
  }
  .cm-tab small { font-size: 12px; font-weight: 600; color: var(--sub2); }
  .cm-tab:hover { color: var(--text); }
  .cm-tab.is-active { color: var(--accent2); border-bottom-color: var(--accent); }
  .cm-tab.is-active small { color: var(--accent2); }

  /* 🔴 보드(행) 형태 — 2026-08-19 카드에서 전환. 글에 썸네일·요약이 없어 카드는 여백만 컸다 (글 하나 110px).
     한 행: [유형] 제목 (법안칩) [댓글] | 닉네임 · 시간 · 조회. 모바일은 두 줄 */
  .cm-board { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .cm-row {
    display: grid; grid-template-columns: 84px minmax(0, 1fr) 220px; align-items: center; gap: 12px;
    padding: 13px 18px; border-top: 1px solid var(--border); text-decoration: none; color: inherit; transition: background .12s;
  }
  .cm-row:first-child { border-top: 0; }
  /* 🔴 hover 는 공용 `.pb-boxlink` 가 맡는다 (main.css). 여기서 background 를 다시 정하면
     같은 특이도라 **뒤에 있는 이 규칙이 이겨** 이 페이지만 혼자 다르게 보인다. 되살리지 말 것. */
  .cm-row.is-pinned { background: var(--accent-10); }
  .cm-row.is-pinned:hover { background: var(--accent-15); }   /* 고정 공지는 평상시가 이미 틴트라 한 단 더 */
  .cm-type { display: inline-flex; align-items: center; justify-content: center; padding: 3px 9px; border-radius: 6px; font-size: 12px; font-weight: 700; white-space: nowrap; color: var(--sub); background: var(--bg3); border: 1px solid var(--border); }
  .cm-type.is-gold { color: var(--accent2); background: var(--bg2); border-color: var(--accent); }
  .cm-main { min-width: 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .cm-title { font-size: 15px; font-weight: 600; color: var(--text); line-height: 1.5; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
  .cm-row.is-pinned .cm-title { font-weight: 700; }
  .cm-cmt { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--accent2); font-weight: 700; }
  .cm-bill-chip {
    display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; background: var(--bg3); border: 1px solid var(--border);
    border-radius: 6px; font-size: 12px; color: var(--sub); max-width: 100%;
  }
  .cm-bill-chip-ic { flex-shrink: 0; width: 12px; height: 12px; color: var(--accent); }
  .cm-bill-chip-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text); font-weight: 500; max-width: 260px; }
  .cm-meta { display: flex; align-items: center; justify-content: flex-end; gap: 10px; font-size: 12px; color: var(--sub2); white-space: nowrap; }
  .cm-meta .nick { color: var(--sub); font-weight: 500; overflow: hidden; text-overflow: ellipsis; max-width: 90px; }
  .cm-meta .date, .cm-meta .views { font-family: 'JetBrains Mono', monospace; }
  .cm-meta .views { display: inline-flex; align-items: center; gap: 4px; }
  .cm-stat-ic { width: 13px; height: 13px; color: var(--sub2); flex-shrink: 0; }
  @media (max-width: 720px) {
    .cm-row { grid-template-columns: 1fr; gap: 6px; padding: 12px 14px; }
    .cm-main { order: 1; }
    .cm-type { justify-self: start; }
    .cm-title { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .cm-meta { order: 2; justify-content: flex-start; }
    .cm-bill-chip-name { max-width: 180px; }
  }
  /* 둘째 줄 = 글 유형. 🔴 첫 줄(무엇을 보나)보다 가벼워야 위계가 읽힌다 —
     같은 무게로 두면 두 줄이 한 덩어리로 보여 무엇이 무엇의 하위인지 안 보인다 */
  .cm-tabs.is-sub { border-bottom: 0; margin: -14px 0 12px; padding-left: 2px; }
  .cm-tabs.is-sub .cm-tab { padding: 6px 10px; font-size: 12.5px; border-bottom-width: 2px; }
  .cm-tabs.is-sub .cm-tab small { font-size: 11px; }

  /* 댓글 행 — 제목 대신 [대상 이름] + [본문] 두 조각 */
  .cm-talk-lede { font-size: 12.5px; color: var(--sub); margin: -8px 0 14px; }
  .cm-talk-main { flex-wrap: nowrap; }
  .cm-talk-target { flex: 0 0 auto; max-width: 40%; font-size: 13px; font-weight: 700; color: var(--sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cm-talk-target::after { content: '·'; margin-left: 8px; color: var(--border2); font-weight: 400; }
  /* ⚠️ min-width:0 이 없으면 flex 아이템이 안 줄어 메타가 행 밖으로 나간다 */
  .cm-talk-body { flex: 1 1 auto; min-width: 0; font-size: 14px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 720px) {
    .cm-talk-main { flex-wrap: wrap; }
    .cm-talk-target { max-width: 100%; }
    .cm-talk-body { flex: 1 1 100%; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  }

  .cm-empty a { color: var(--accent2); font-weight: 600; text-decoration: underline; }
  .cm-empty {
    padding: 60px 24px;
    text-align: center;
    color: var(--sub);
    background: var(--bg2);
    border: 1px dashed var(--border);
    border-radius: 12px;
  }

  .cm-pagination {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .cm-pg-btn {
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--sub);
    font-size: 13px;
    font-family: 'JetBrains Mono', monospace;
    text-decoration: none;
  }
  .cm-pg-btn:hover { border-color: var(--border2); color: var(--text); }
  .cm-pg-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .cm-pg-ellipsis { color: var(--sub2); padding: 0 6px; }
</style>

<div class="pb-page-header">
  <div class="pb-page-header-inner">
    <div>
      <h1 class="pb-page-title">커뮤니티</h1>
      <%# ⚠️ 4단계에서 이 페이지는 게시판이 아니라 **통합 피드**가 됐다. 옛 설명(공지·잡담·질문…)은
          글 유형만 나열해 댓글이 여기 있다는 걸 말하지 못한다 %>
      <p class="pb-page-desc">법안·의원·브리핑에 남긴 의견과 커뮤니티 글이 한자리에 모입니다</p>
    </div>
    <% if (locals.currentUser) { %>
      <a href="/community/write<%= locals.activeType ? '?type=' + activeType : '' %>" class="cm-write-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
        글쓰기
      </a>
    <% } else { %>
      <a href="/auth/login?next=%2Fcommunity" class="cm-write-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
        로그인하고 글쓰기
      </a>
    <% } %>
  </div>
</div>

<div class="cm-wrap">
  <%# 🔴 **무엇을 보나** 한 줄. 글과 댓글을 가르지 않는다 — 첫 화면이 곧 통합 피드다.
      글 유형(공지·잡담…)은 「글」을 골랐을 때만 둘째 줄로 나온다 (글에만 있는 축이라) %>
  <nav class="cm-tabs" aria-label="보기">
    <% (locals.feedTabs || []).forEach((t) => { %>
      <a href="<%= qs({ on: t.key, type: null }) %>" class="cm-tab <%= filter === t.key ? 'is-active' : '' %>"><%= t.label %><% if (t.key === 'posts') { %> <small><%= nf(locals.allCount || 0) %></small><% } %></a>
    <% }); %>
  </nav>

  <% if (isPosts) { %>
    <nav class="cm-tabs is-sub" aria-label="글 유형">
      <a href="<%= qs({ type: null }) %>" class="cm-tab <%= !locals.activeType ? 'is-active' : '' %>">전체 <small><%= nf(locals.allCount || 0) %></small></a>
      <% (locals.postTypes || []).forEach((t) => { %>
        <a href="<%= qs({ type: t.key }) %>" class="cm-tab <%= locals.activeType === t.key ? 'is-active' : '' %>"><%= t.label %> <small><%= nf((locals.typeCounts || {})[t.key] || 0) %></small></a>
      <% }); %>
    </nav>
  <% } %>

  <p class="cm-talk-lede">
    <% if (filter === 'all') { %>법안·의원·브리핑에 달린 의견과 커뮤니티 글이 시간순으로 흐릅니다. 누르면 그 기록 옆으로 갑니다.
    <% } else if (isPosts) { %>커뮤니티에 올라온 글입니다. 글에 달린 의견은 「전체」에서 같이 흐릅니다.
    <% } else { %><%= (feedTabs.find((t) => t.key === filter) || {}).label %>에 달린 의견입니다. 누르면 그 기록 옆으로 갑니다.<% } %>
  </p>

  <% if (rows.length > 0) { %>
    <div class="cm-board">
      <%# 🔴 한 목록에 두 종류가 섞인다. 배지가 그 둘을 가른다 —
          글은 유형(공지·잡담…), 댓글은 어디에 달렸는지(법안·의원·브리핑·글) %>
      <% rows.forEach(p => {
           if (p.kind === 'comment') { const k = TALK_KIND[p.ctx_kind]; if (!k) return; %>
        <a href="<%= k.href(p.ctx_id) %>" class="cm-row pb-boxlink">
          <span class="cm-type"><%= k.label %></span>
          <span class="cm-main cm-talk-main">
            <span class="cm-talk-target"><%= p.ctx_label %></span>
            <span class="cm-talk-body"><%= p.text %></span>
          </span>
          <span class="cm-meta">
            <span class="nick"><%= p.nickname || '탈퇴한 사용자' %></span>
            <span class="date" title="<%= p.created_at %>"><%= timeAgo(p.created_at) %></span>
          </span>
        </a>
      <% } else { const tm = typeMeta(p.post_type); %>
        <a href="/community/<%= p.id %>" class="cm-row pb-boxlink <%= p.is_pinned ? 'is-pinned' : '' %>">
          <span class="cm-type <%= tm && tm.tone === 'gold' ? 'is-gold' : '' %>"><%= tm ? tm.label : '글' %></span>
          <span class="cm-main">
            <span class="cm-title"><%= p.text %></span>
            <% if (Number(p.comment_count) > 0) { %><span class="cm-cmt">[<%= nf(p.comment_count) %>]</span><% } %>
            <% if (p.linked_bill_id && p.linked_bill_name) { %>
              <span class="cm-bill-chip">
                <svg class="cm-bill-chip-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                <span class="cm-bill-chip-name"><%= p.linked_bill_name %></span>
                <% if (p.linked_bill_result) { %><span class="pb-badge <%= resultClass(p.linked_bill_result) %>"><%= p.linked_bill_result %></span><% } %>
              </span>
            <% } %>
          </span>
          <span class="cm-meta">
            <span class="nick"><%= p.nickname || '탈퇴한 사용자' %></span>
            <span class="date" title="<%= p.created_at %>"><%= timeAgo(p.created_at) %></span>
            <span class="views" title="조회"><svg class="cm-stat-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg><%= nf(p.view_count) %></span>
          </span>
        </a>
      <% } }); %>
    </div>

    <% if (totalPages > 1) {
         const pagesList = pagesAround();
    %>
      <div class="cm-pagination">
        <% if (page > 1) { %>
          <a href="<%= buildHref(page - 1) %>" class="cm-pg-btn">←</a>
        <% } %>
        <% if (pagesList[0] > 1) { %>
          <a href="<%= buildHref(1) %>" class="cm-pg-btn">1</a>
          <% if (pagesList[0] > 2) { %><span class="cm-pg-ellipsis">...</span><% } %>
        <% } %>
        <% pagesList.forEach(p => { %>
          <% if (p === page) { %>
            <span class="cm-pg-btn active"><%= p %></span>
          <% } else { %>
            <a href="<%= buildHref(p) %>" class="cm-pg-btn"><%= p %></a>
          <% } %>
        <% }); %>
        <% if (pagesList[pagesList.length - 1] < totalPages) { %>
          <% if (pagesList[pagesList.length - 1] < totalPages - 1) { %><span class="cm-pg-ellipsis">...</span><% } %>
          <a href="<%= buildHref(totalPages) %>" class="cm-pg-btn"><%= totalPages %></a>
        <% } %>
        <% if (page < totalPages) { %>
          <a href="<%= buildHref(page + 1) %>" class="cm-pg-btn">→</a>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <%# 🔴 비어 있어도 왜 비었는지 + 무엇을 하면 채워지는지를 말한다 (/xray 빈 지표와 같은 판단)
        ⚠️ **범위 밖 페이지를 "내용 없음" 이라고 하면 거짓말이다** — 내용은 있고 이 쪽이 없을 뿐이다 %>
    <div class="cm-empty">
      <% if (page > 1) { %>이 페이지에는 더 이상 없습니다. <a href="<%= qs({ page: 1 }) %>">처음으로 →</a>
      <% } else if (locals.activeType) { %>아직 「<%= (typeMeta(activeType) || {}).label %>」 글이 없습니다.
      <% } else if (isPosts) { %>아직 등록된 게시글이 없습니다. 첫 글의 주인공이 되어보세요.
      <% } else if (filter === 'all') { %>아직 오간 이야기가 없습니다. 법안·의원 페이지에서 남긴 의견과 커뮤니티 글이 여기에 모입니다.
      <% } else { %>아직 <%= (feedTabs.find((t) => t.key === filter) || {}).label %>에 달린 의견이 없습니다.<% } %>
    </div>
  <% } %>
</div>
