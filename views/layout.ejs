<script>
    window.__USER__ = <%- JSON.stringify(locals.currentUser ? { id: currentUser.user_id, nickname: currentUser.nickname } : null) %>;
    /* JS 안에서 만드는 <img> 도 캐시를 갈아야 해서 버전을 넘겨둔다 (interactions.js 의 스피너 등) */
    window.__ASSET_VER__ = <%- JSON.stringify(assetVer) %>;
</script>
<script src="<%= asset('/scripts/globalStore.js') %>"></script>
<script src="<%= asset('/scripts/interactions.js') %>"></script>
<script>
    /* 페이지 전환 로더 — 내부 링크 클릭/폼 submit 동안 풀스크린 오버레이.
       프로그래매틱 navigation 의 경우 window.pbShowLoader() 직접 호출 가능 */
    (function () {
        const loader = document.getElementById('pb-page-loader');
        if (!loader) return;
        const show = () => { loader.removeAttribute('hidden'); loader.setAttribute('aria-hidden', 'false'); };
        const hide = () => { loader.setAttribute('hidden', '');     loader.setAttribute('aria-hidden', 'true');  };
        window.pbShowLoader = show;
        window.pbHideLoader = hide;

        document.addEventListener('click', (e) => {
            if (e.defaultPrevented) return;          // JS 가 navigation 막은 경우
            if (e.button !== 0) return;              // 좌클릭만
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;  // 새 탭 등
            const link = e.target.closest('a[href]');
            if (!link) return;
            if (link.target === '_blank' || link.hasAttribute('download')) return;
            if (link.dataset.noLoader != null) return;
            const href = link.getAttribute('href') || '';
            if (!href || href.startsWith('#') || href.startsWith('mailto:') ||
                href.startsWith('tel:')   || href.startsWith('javascript:')) return;
            try {
                const u = new URL(href, location.href);
                if (u.origin !== location.origin) return;            // 외부
                if (u.pathname === location.pathname &&
                    u.search   === location.search) return;          // 동일 URL
            } catch { return; }
            show();
        });

        document.addEventListener('submit', (e) => {
            if (e.defaultPrevented) return;          // AJAX 폼
            const form = e.target;
            if (form?.dataset?.noLoader != null) return;
            show();
        });

        // 뒤로가기/앞으로 (bfcache 복원 포함) 시 로더 숨김
        window.addEventListener('pageshow', hide);
    })();

    document.addEventListener('DOMContentLoaded', () => {
        const serverData = <%- JSON.stringify(locals.initialData || null) %>;
        const storedData = sessionStorage.getItem('initialData');
        if (!storedData && serverData) {
            sessionStorage.setItem('initialData', JSON.stringify(serverData));
        }

        // Mobile panel toggle
        const btn = document.getElementById('pb-hamburger');
        const panel = document.getElementById('pb-mobile-panel');
        const closeBtn = document.getElementById('pb-mobile-close');
        const backdrop = document.getElementById('pb-mobile-backdrop');
        if (btn && panel) {
            // 열릴 때 body 스크롤을 잠근다 — 안 잠그면 패널을 밀 때 뒤 페이지가 같이 밀리고 (iOS 에서 특히)
            // 패널 자체는 안 밀리는 것처럼 느껴진다. 백드롭 탭·ESC 로도 닫힌다
            const openPanel = () => { panel.classList.add('open'); document.body.classList.add('pb-menu-open'); if (backdrop) backdrop.hidden = false; };
            const closePanel = () => { panel.classList.remove('open'); document.body.classList.remove('pb-menu-open'); if (backdrop) backdrop.hidden = true; };
            btn.addEventListener('click', openPanel);
            closeBtn.addEventListener('click', closePanel);
            backdrop?.addEventListener('click', closePanel);
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel.classList.contains('open')) closePanel(); });
        }

        // User dropdown
        const userBtn = document.getElementById('pb-user-btn');
        const dropdown = document.getElementById('pb-user-dropdown');
        if (userBtn && dropdown) {
            userBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                dropdown.classList.toggle('open');
                userBtn.setAttribute('aria-expanded', dropdown.classList.contains('open'));
            });
            document.addEventListener('click', (e) => {
                if (!dropdown.contains(e.target) && !userBtn.contains(e.target)) {
                    dropdown.classList.remove('open');
                    userBtn.setAttribute('aria-expanded', 'false');
                }
            });
        }

        // 회원 탈퇴 모달 — 데스크톱 dropdown / 모바일 panel 두 트리거 지원
        const wTriggers = document.querySelectorAll('.pb-withdraw-trigger');
        const wModal   = document.getElementById('pb-withdraw-modal');
        const wConfirm = document.getElementById('pb-withdraw-confirm');
        const openWithdraw  = () => { wModal?.removeAttribute('hidden'); };
        const closeWithdraw = () => { wModal?.setAttribute('hidden', ''); };
        if (wTriggers.length && wModal) {
            wTriggers.forEach(trigger => {
                trigger.addEventListener('click', (e) => {
                    e.stopPropagation();
                    dropdown?.classList.remove('open');
                    panel?.classList.remove('open');
                    openWithdraw();
                });
            });
            wModal.querySelectorAll('[data-withdraw-close]').forEach(el => {
                el.addEventListener('click', closeWithdraw);
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !wModal.hasAttribute('hidden')) closeWithdraw();
            });
            wConfirm?.addEventListener('click', async () => {
                wConfirm.disabled = true;
                wConfirm.textContent = '처리 중...';
                try {
                    const res = await fetch('/api/auth/withdraw', {
                        method: 'DELETE',
                        credentials: 'include',
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) {
                        const data = await res.json().catch(() => ({}));
                        throw new Error(data.error || `HTTP ${res.status}`);
                    }
                    const data = await res.json();
                    location.href = data.redirectTo || '/';
                } catch (err) {
                    alert('탈퇴 처리 실패: ' + err.message);
                    wConfirm.disabled = false;
                    wConfirm.textContent = '탈퇴';
                }
            });
        }
    });
</script>
</body>
</html>
