<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.pageTitle ? locals.pageTitle + ' - 정치 바로미터' : '정치 바로미터' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/common.css">
    <% if (locals.pageStyles) { %>
        <link rel="stylesheet" href="/styles/<%= locals.pageStyles %>.css">
    <% } %>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <header>
            <div>
                <a href="/"><img src="/assets/imgs/logo.png"></a>
            </div>
            <nav class="nav-pc" style="align-items: center">
                <ul>
                    <li><a href="/politician" class="<%= (locals.currentUrl === '/politician') ? 'active' : '' %>">정치인</a></li>
                    <li><a href="/bill" class="<%= (locals.currentUrl === '/bill') ? 'active' : '' %>">법안</a></li>
                    <li><a href="/about" class="<%= (locals.currentUrl === '/about') ? 'active' : '' %>">사이트 소개</a></li>
                </ul>
            </nav>
            <button class="hamburger-btn" style="margin-left: auto" id="hamburger-btn">☰</button>
        </header>

        <div class="nav-mobile-panel" id="nav-mobile-panel">
            <nav>
                <ul>
                    <li><a href="/politician">정치인</a></li>
                    <li><a href="/bill">법안</a></li>
                    <li><a href="/about">사이트 소개</a></li>
                </ul>
            </nav>
            <button class="nav-close-btn" id="nav-close-btn">×</button>
        </div>
        <main>
            <%- body %>
        </main>

        <footer>
            <div class="footer-links">
                <a href="/about">사이트 소개</a>
                <a href="#">이용약관</a>
                <a href="#">개인정보처리방침</a>
                <a href="#">데이터 출처</a>
            </div>
            <div class="copyright">
                &copy; 2025 정치 바로미터. All rights reserved.
            </div>
        </footer>
    </div>

    <script src="/scripts/globalStore.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="/scripts/main.js" type="module"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // initialData는 서버에서 내려준 전역 변수라고 가정
            // layout.ejs로 전달되는 locals.initialData를 사용합니다.
            const serverData = <%- JSON.stringify(locals.initialData || null) %>;
            
            let storedData = sessionStorage.getItem('initialData');

            if (!storedData && serverData) {
                sessionStorage.setItem('initialData', JSON.stringify(serverData));
                console.log('최초 세션데이터 초기화');
            } else if (storedData) {
                const parsedData = JSON.parse(storedData);
                console.log('저장된 세션데이터 초기화');
            }
        });
    </script>
</body>
</html>