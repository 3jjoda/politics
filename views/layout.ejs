<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.pageTitle ? locals.pageTitle : '정치 바로미터' %></title>

    <!-- Primary Meta -->
    <meta name="description" content="당신의 한 표가 어디로 갔는지 끝까지 봅니다. 22대 국회의 모든 법안, 의원, 표결을 국민이 직접 확인하는 정치 데이터 플랫폼.">
    <meta name="keywords" content="정치, 국회, 법안, 의원, 투표, 공약, 22대 국회, 정치 데이터">
    <meta name="theme-color" content="#B8740C">

    <!-- Favicon / App Icons -->
    <link rel="icon" type="image/svg+xml" href="/assets/imgs/favicon-32.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/imgs/favicon-32.svg">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/imgs/favicon-16.svg">
    <link rel="shortcut icon" href="/assets/imgs/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/imgs/apple-touch-180.png">
    <link rel="manifest" href="/manifest.json">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="정치 바로미터 — 내 한표의 바로미터">
    <meta property="og:description" content="당신의 한 표가 어디로 갔는지 끝까지 봅니다. 22대 국회의 모든 법안, 의원, 표결을 국민이 직접 확인하는 정치 데이터 플랫폼.">
    <meta property="og:url" content="<%= (process.env.BASE_URL || 'http://localhost:3000') + (locals.currentUrl || '/') %>">
    <meta property="og:image" content="<%= (process.env.BASE_URL || 'http://localhost:3000') %>/assets/imgs/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="정치 바로미터">
    <meta property="og:locale" content="ko_KR">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="정치 바로미터 — 내 한표의 바로미터">
    <meta name="twitter:description" content="당신의 한 표가 어디로 갔는지 끝까지 봅니다. 22대 국회의 모든 법안, 의원, 표결을 국민이 직접 확인하는 정치 데이터 플랫폼.">
    <meta name="twitter:image" content="<%= (process.env.BASE_URL || 'http://localhost:3000') %>/assets/imgs/og-image.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+KR:wght@300;400;500;700&family=Noto+Serif+KR:wght@400;700;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="/styles/main.css">
    <% if (locals.pageStyles) { %>
        <link rel="stylesheet" href="/styles/<%= locals.pageStyles %>.css">
    <% } %>
</head>
<body>

<nav class="pb-nav">
    <div class="pb-nav-top">
      <div class="pb-nav-top-inner">
        <a href="/" class="pb-logo" aria-label="정치 바로미터">
            <img src="/assets/imgs/mark-only.svg" alt="" class="pb-logo-mark-img" aria-hidden="true">
            <img src="/assets/imgs/wordmark-nav.svg" alt="정치 바로미터" class="pb-logo-wordmark-img">
        </a>
        <div class="pb-nav-right">
            <% if (locals.dataFreshness) { %>
                <span class="pb-nav-badge" title="법안 데이터 마지막 갱신: <%= dataFreshness.absolute %>">● 법안 <%= dataFreshness.relative %> 갱신</span>
            <% } %>
            <% if (locals.currentUser) { %>
                <div class="pb-user-menu" id="pb-user-menu">
                    <button class="pb-user-btn" id="pb-user-btn" aria-haspopup="true" aria-expanded="false">
                        <span class="pb-user-avatar">
                            <%- avatarHtml(currentUser.nickname, null, 28) %>
                        </span>
                        <span class="pb-user-name"><%= currentUser.nickname %></span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="pb-user-dropdown" id="pb-user-dropdown">
                        <div class="pb-user-meta">
                            <div class="pb-user-nick"><%= currentUser.nickname %></div>
                            <div class="pb-user-provider">
                                <%= currentUser.provider === 'google' ? 'Google' :
                                    currentUser.provider === 'kakao'  ? 'Kakao'  : '로컬' %> 계정
                            </div>
                        </div>
                        <a class="pb-user-item" href="/my">마이페이지</a>
                        <a class="pb-user-item" href="/my/analysis-requests">내가 요청한 분석</a>
                        <form method="post" action="/auth/logout" style="margin:0">
                            <button type="submit" class="pb-user-item pb-user-logout">로그아웃</button>
                        </form>
                        <button type="button" class="pb-user-item pb-user-withdraw pb-withdraw-trigger">회원 탈퇴</button>
                    </div>
                </div>
            <% } else { %>
                <a href="/auth/login" class="pb-nav-btn">로그인</a>
            <% } %>
            <button class="pb-hamburger" id="pb-hamburger" aria-label="menu">☰</button>
        </div>
      </div>
    </div>
    <div class="pb-nav-menu">
      <ul class="pb-nav-links">
        <li><a href="/" class="<%= (locals.currentUrl === '/') ? 'active' : '' %>">홈</a></li>
        <li><a href="/politician" class="<%= (locals.currentUrl && locals.currentUrl.indexOf('/politician') === 0) ? 'active' : '' %>">의원</a></li>
        <li><a href="/bill" class="<%= (locals.currentUrl && locals.currentUrl.indexOf('/bill') === 0) ? 'active' : '' %>">법안</a></li>
        <li><a href="/balance-game" class="<%= (locals.currentUrl && locals.currentUrl.indexOf('/balance-game') === 0) ? 'active' : '' %>">성향 진단</a></li>
        <li><a href="/community" class="<%= (locals.currentUrl && locals.currentUrl.indexOf('/community') === 0) ? 'active' : '' %>">커뮤니티</a></li>
        <li><a href="/glossary" class="<%= (locals.currentUrl === '/glossary') ? 'active' : '' %>">용어</a></li>
        <li><a href="/about" class="<%= (locals.currentUrl === '/about') ? 'active' : '' %>">소개</a></li>
      </ul>
    </div>
</nav>

<div class="pb-mobile-panel" id="pb-mobile-panel">
    <button class="pb-mobile-close" id="pb-mobile-close" aria-label="close">×</button>
    <% if (locals.dataFreshness) { %>
        <div class="pb-mobile-freshness" title="법안 데이터 마지막 갱신: <%= dataFreshness.absolute %>">
            <span class="pb-mobile-freshness-dot">●</span>
            법안 <%= dataFreshness.relative %> 갱신
        </div>
    <% } %>
    <ul>
        <li><a href="/">홈</a></li>
        <li><a href="/politician">의원</a></li>
        <li><a href="/bill">법안</a></li>
        <li><a href="/balance-game">성향 진단</a></li>
        <li><a href="/community">커뮤니티</a></li>
        <li><a href="/glossary">용어</a></li>
        <li><a href="/about">소개</a></li>
    </ul>
    <div class="pb-mobile-auth">
        <% if (locals.currentUser) { %>
            <div class="pb-mobile-user">
                <span class="pb-user-avatar"><%- avatarHtml(currentUser.nickname, null, 32) %></span>
                <div class="pb-mobile-user-meta">
                    <div class="pb-mobile-user-nick"><%= currentUser.nickname %></div>
                    <div class="pb-mobile-user-provider">
                        <%= currentUser.provider === 'google' ? 'Google' :
                            currentUser.provider === 'kakao'  ? 'Kakao'  : '로컬' %> 계정
                    </div>
                </div>
            </div>
            <a href="/my" class="pb-mobile-auth-link">마이페이지</a>
            <a href="/my/analysis-requests" class="pb-mobile-auth-link">내가 요청한 분석</a>
            <form method="post" action="/auth/logout" style="margin:0">
                <button type="submit" class="pb-mobile-auth-btn">로그아웃</button>
            </form>
            <button type="button" class="pb-mobile-auth-btn pb-mobile-auth-withdraw pb-withdraw-trigger">회원 탈퇴</button>
        <% } else { %>
            <a href="/auth/login" class="pb-mobile-auth-cta">로그인</a>
        <% } %>
    </div>
</div>

<main class="pb-main">
    <%- body %>
</main>

<!-- 페이지 전환 로더 — 링크 클릭/폼 submit 시 풀스크린 오버레이 -->
<div class="pb-page-loader" id="pb-page-loader" hidden aria-hidden="true">
    <img src="/assets/imgs/spinner.svg" width="48" height="48" alt="">
    <span class="pb-page-loader-label">불러오는 중…</span>
</div>

<% if (locals.currentUser) { %>
<!-- 회원 탈퇴 확인 모달 -->
<div class="pb-modal" id="pb-withdraw-modal" hidden>
    <div class="pb-modal-backdrop" data-withdraw-close></div>
    <div class="pb-modal-card" role="dialog" aria-modal="true" aria-labelledby="pb-withdraw-title">
        <h3 id="pb-withdraw-title" class="pb-modal-title">회원 탈퇴</h3>
        <p class="pb-modal-body">
            탈퇴해도 작성한 댓글과 게시글은 <strong>&lsquo;탈퇴한 사용자&rsquo;</strong>로
            익명 처리되어 유지됩니다.<br>
            정말 탈퇴하시겠습니까?
        </p>
        <div class="pb-modal-actions">
            <button type="button" class="pb-modal-btn" data-withdraw-close>취소</button>
            <button type="button" class="pb-modal-btn pb-modal-btn-danger" id="pb-withdraw-confirm">탈퇴</button>
        </div>
    </div>
</div>
<% } %>

<footer class="pb-footer">
    <div class="pb-footer-inner">
        <div class="pb-footer-copy">
            &copy; 2026 정치 바로미터 · 열린국회정보포털 공공데이터 기반
        </div>
        <ul class="pb-footer-links">
            <li><a href="/about">소개</a></li>
            <li><a href="/glossary">용어</a></li>
            <li><a href="#">데이터 출처</a></li>
            <li><a href="#">피드백</a></li>
            <li><a href="#">개인정보처리방침</a></li>
        </ul>
    </div>
</footer>

<script>
    window.__USER__ = <%- JSON.stringify(locals.currentUser ? { id: currentUser.user_id, nickname: currentUser.nickname } : null) %>;
</script>
<script src="/scripts/globalStore.js"></script>
<script src="/scripts/interactions.js"></script>
<script>
    /* 페이지 전환 로더 — 내부 링크 클릭/폼 submit 동안 풀스크린 오버레이.
       프로그래매틱 navigation 의 경우 window.pbShowLoader() 직접 호출 가능 */
    (function () {
        const loader = document.getElementById('pb-page-loader');
        if (!loader) return;
        const show = () => { loader.removeAttribute('hidden'); loader.setAttribute('aria-hidden', 'false'); };
        const hide = () => { loader.setAttribute('hidden', '');     loader.setAttribute('aria-hidden', 'true');  };
        window.pbShowLoader = show;
        window.pbHideLoader = hide;

        document.addEventListener('click', (e) => {
            if (e.defaultPrevented) return;          // JS 가 navigation 막은 경우
            if (e.button !== 0) return;              // 좌클릭만
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;  // 새 탭 등
            const link = e.target.closest('a[href]');
            if (!link) return;
            if (link.target === '_blank' || link.hasAttribute('download')) return;
            if (link.dataset.noLoader != null) return;
            const href = link.getAttribute('href') || '';
            if (!href || href.startsWith('#') || href.startsWith('mailto:') ||
                href.startsWith('tel:')   || href.startsWith('javascript:')) return;
            try {
                const u = new URL(href, location.href);
                if (u.origin !== location.origin) return;            // 외부
                if (u.pathname === location.pathname &&
                    u.search   === location.search) return;          // 동일 URL
            } catch { return; }
            show();
        });

        document.addEventListener('submit', (e) => {
            if (e.defaultPrevented) return;          // AJAX 폼
            const form = e.target;
            if (form?.dataset?.noLoader != null) return;
            show();
        });

        // 뒤로가기/앞으로 (bfcache 복원 포함) 시 로더 숨김
        window.addEventListener('pageshow', hide);
    })();

    document.addEventListener('DOMContentLoaded', () => {
        const serverData = <%- JSON.stringify(locals.initialData || null) %>;
        const storedData = sessionStorage.getItem('initialData');
        if (!storedData && serverData) {
            sessionStorage.setItem('initialData', JSON.stringify(serverData));
        }

        // Mobile panel toggle
        const btn = document.getElementById('pb-hamburger');
        const panel = document.getElementById('pb-mobile-panel');
        const closeBtn = document.getElementById('pb-mobile-close');
        if (btn && panel) {
            btn.addEventListener('click', () => panel.classList.add('open'));
            closeBtn.addEventListener('click', () => panel.classList.remove('open'));
        }

        // User dropdown
        const userBtn = document.getElementById('pb-user-btn');
        const dropdown = document.getElementById('pb-user-dropdown');
        if (userBtn && dropdown) {
            userBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                dropdown.classList.toggle('open');
                userBtn.setAttribute('aria-expanded', dropdown.classList.contains('open'));
            });
            document.addEventListener('click', (e) => {
                if (!dropdown.contains(e.target) && !userBtn.contains(e.target)) {
                    dropdown.classList.remove('open');
                    userBtn.setAttribute('aria-expanded', 'false');
                }
            });
        }

        // 회원 탈퇴 모달 — 데스크톱 dropdown / 모바일 panel 두 트리거 지원
        const wTriggers = document.querySelectorAll('.pb-withdraw-trigger');
        const wModal   = document.getElementById('pb-withdraw-modal');
        const wConfirm = document.getElementById('pb-withdraw-confirm');
        const openWithdraw  = () => { wModal?.removeAttribute('hidden'); };
        const closeWithdraw = () => { wModal?.setAttribute('hidden', ''); };
        if (wTriggers.length && wModal) {
            wTriggers.forEach(trigger => {
                trigger.addEventListener('click', (e) => {
                    e.stopPropagation();
                    dropdown?.classList.remove('open');
                    panel?.classList.remove('open');
                    openWithdraw();
                });
            });
            wModal.querySelectorAll('[data-withdraw-close]').forEach(el => {
                el.addEventListener('click', closeWithdraw);
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !wModal.hasAttribute('hidden')) closeWithdraw();
            });
            wConfirm?.addEventListener('click', async () => {
                wConfirm.disabled = true;
                wConfirm.textContent = '처리 중...';
                try {
                    const res = await fetch('/api/auth/withdraw', {
                        method: 'DELETE',
                        credentials: 'include',
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) {
                        const data = await res.json().catch(() => ({}));
                        throw new Error(data.error || `HTTP ${res.status}`);
                    }
                    const data = await res.json();
                    location.href = data.redirectTo || '/';
                } catch (err) {
                    alert('탈퇴 처리 실패: ' + err.message);
                    wConfirm.disabled = false;
                    wConfirm.textContent = '탈퇴';
                }
            });
        }
    });
</script>
</body>
</html>
