<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.pageTitle ? locals.pageTitle : '정치 바로미터' %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+KR:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="/styles/main.css">
    <% if (locals.pageStyles) { %>
        <link rel="stylesheet" href="/styles/<%= locals.pageStyles %>.css">
    <% } %>
</head>
<body>

<nav class="pb-nav">
    <div class="pb-nav-inner">
        <a href="/" class="pb-logo">
            <div class="pb-logo-mark"></div>
            <span class="pb-logo-text">정치<span>바로미터</span></span>
        </a>
        <ul class="pb-nav-links">
            <li><a href="/" class="<%= (locals.currentUrl === '/') ? 'active' : '' %>">홈</a></li>
            <li><a href="/politician" class="<%= (locals.currentUrl && locals.currentUrl.indexOf('/politician') === 0) ? 'active' : '' %>">의원</a></li>
            <li><a href="/bill" class="<%= (locals.currentUrl && locals.currentUrl.indexOf('/bill') === 0) ? 'active' : '' %>">법안</a></li>
            <li><a href="/about" class="<%= (locals.currentUrl === '/about') ? 'active' : '' %>">사이트 소개</a></li>
        </ul>
        <div class="pb-nav-right">
            <span class="pb-nav-badge">● LIVE</span>
            <button class="pb-nav-btn" onclick="alert('로그인 기능은 준비 중입니다.')">로그인</button>
            <button class="pb-hamburger" id="pb-hamburger" aria-label="menu">☰</button>
        </div>
    </div>
</nav>

<div class="pb-mobile-panel" id="pb-mobile-panel">
    <button class="pb-mobile-close" id="pb-mobile-close" aria-label="close">×</button>
    <ul>
        <li><a href="/">홈</a></li>
        <li><a href="/politician">의원</a></li>
        <li><a href="/bill">법안</a></li>
        <li><a href="/about">사이트 소개</a></li>
    </ul>
</div>

<main class="pb-main">
    <%- body %>
</main>

<footer class="pb-footer">
    <div class="pb-footer-inner">
        <div class="pb-footer-copy">
            &copy; 2026 정치 바로미터 · 열린국회정보포털 공공데이터 기반
        </div>
        <ul class="pb-footer-links">
            <li><a href="/about">사이트 소개</a></li>
            <li><a href="/glossary">용어 설명</a></li>
            <li><a href="#">데이터 출처</a></li>
            <li><a href="#">피드백</a></li>
            <li><a href="#">개인정보처리방침</a></li>
        </ul>
    </div>
</footer>

<script src="/scripts/globalStore.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const serverData = <%- JSON.stringify(locals.initialData || null) %>;
        const storedData = sessionStorage.getItem('initialData');
        if (!storedData && serverData) {
            sessionStorage.setItem('initialData', JSON.stringify(serverData));
        }

        // Mobile panel toggle
        const btn = document.getElementById('pb-hamburger');
        const panel = document.getElementById('pb-mobile-panel');
        const closeBtn = document.getElementById('pb-mobile-close');
        if (btn && panel) {
            btn.addEventListener('click', () => panel.classList.add('open'));
            closeBtn.addEventListener('click', () => panel.classList.remove('open'));
        }
    });
</script>
</body>
</html>
