<script>
    document.addEventListener('DOMContentLoaded', () => {
        // initialData는 서버에서 내려준 전역 변수라고 가정
        const serverData = <%- JSON.stringify(locals.initialData || null) %>;
        
        // 1. 세션 스토리지에 데이터가 있는지 확인
        let storedData = sessionStorage.getItem('initialData');

        if (!storedData && serverData) {
            // 2. 세션에 데이터가 없고, 서버가 데이터를 내려줬을 경우 (최초 방문)
            console.log('Initializing from Server Data...');
            // 2-1. 전역 스토어를 초기화합니다.
            // window.APP_STORE.initialize(serverData);
            // 2-2. 다음 페이지 이동을 위해 데이터를 문자열로 변환하여 세션에 저장합니다.
            sessionStorage.setItem('initialData', JSON.stringify(serverData));

        } else if (storedData) {
            // 3. 세션에 데이터가 이미 있을 경우 (페이지 이동)
            console.log('Initializing from Session Storage...');
            // 3-1. 저장된 문자열을 다시 객체로 변환합니다.
            const parsedData = JSON.parse(storedData);
            // 3-2. 전역 스토어를 초기화합니다.
            // window.APP_STORE.initialize(parsedData);
        }
    });
</script>
