<%
  const nf = (n) => Number(n || 0).toLocaleString('ko-KR');

  const resultClass = (r) => {
    if (!r) return 'pb-badge-pending';
    if (r.indexOf('가결') > -1) return 'pb-badge-passed';
    if (r === '부결' || r === '폐기') return 'pb-badge-rejected';
    if (r === '철회') return 'pb-badge-withdrawn';
    if (r.indexOf('대안') > -1) return 'pb-badge-alt';
    return 'pb-badge-pending';
  };
  const statusCardClass = (r) => {
    if (!r) return 'status-pending';
    if (r.indexOf('가결') > -1) return 'status-passed';
    if (r === '부결' || r === '폐기') return 'status-rejected';
    if (r === '철회') return 'status-withdrawn';
    if (r.indexOf('대안') > -1) return 'status-alt';
    return 'status-pending';
  };

  const sc = statusCounts || {};
  // 상태 스테퍼 단계 — 공식 DB에 "위원회 진행 중" 단계 플래그는 없어 계류/처리완료 2단계로 집계
  const totalBills    = Number(sc.total        || 0);
  const pendingCount  = Number(sc.pending      || 0);
  const passedOrig    = Number(sc.passed_orig  || 0);
  const passedMod     = Number(sc.passed_mod   || 0);
  const altDropped    = Number(sc.alt_dropped  || 0);
  const withdrawn     = Number(sc.withdrawn    || 0);
  const dropped       = Number(sc.dropped      || 0);
  const rejected      = Number(sc.rejected     || 0);
  const plenaryVoted  = passedOrig + passedMod + rejected;  // 본회의 표결 완료
  const committeeOnly = altDropped + withdrawn + dropped;    // 위원회 단계 처리
  const processedAll  = totalBills - pendingCount;

  const tabs = [
    { key: '',           label: '전체',          count: sc.total },
    { key: 'pending',    label: '계류',          count: sc.pending },
    { key: '원안가결',    label: '원안가결',      count: sc.passed_orig },
    { key: '수정가결',    label: '수정가결',      count: sc.passed_mod },
    { key: '대안반영폐기', label: '대안반영폐기', count: sc.alt_dropped },
    { key: '철회',        label: '철회',          count: sc.withdrawn },
    { key: '폐기',        label: '폐기',          count: sc.dropped },
    { key: '부결',        label: '부결',          count: sc.rejected }
  ];

  // 현재 선택된 status: 'pending' 특수 처리 (DB엔 NULL 로 저장됨 → 컨트롤러에서 null 로 매핑 필요)
  const currentStatus = query.status || '';

  // URL 빌더 — query 모든 키 보존 + 일부 override. 빈 값은 자동 제거.
  const qsBuild = (override = {}) => {
    const base = {
      search:           query.search,
      status:           query.status,
      committee:        query.committee,
      party:            query.party,
      bill_name:        query.bill_name,
      has_analysis:     query.has_analysis,
      ai_category_main: query.ai_category_main,
      request_status:   query.request_status,
      sort:             query.sort && query.sort !== 'recent' ? query.sort : '',
      page:             pagination.page > 1 ? pagination.page : ''
    };
    const merged = { ...base, ...override };
    return Object.entries(merged)
      .filter(([, v]) => v !== '' && v !== null && v !== undefined)
      .map(([k, v]) => `${k}=${encodeURIComponent(v)}`)
      .join('&');
  };
  const billHref = (override = {}) => {
    const qs = qsBuild(override);
    return '/bill' + (qs ? '?' + qs : '');
  };

  // 진행률
  const aTotal    = Number(analysisStats?.total_bills || 0);
  const aDone     = Number(analysisStats?.analyzed_bills || 0);
  const aPercent  = aTotal > 0 ? (aDone / aTotal * 100) : 0;

  const selectedAiCategories = (query.ai_category_main || '').split(',').filter(Boolean);
%>

<style>
  /* Status stepper */
  .stepper-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px 24px 16px;
  }
  .stepper-inner {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .stepper-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    text-align: center;
  }
  .stepper-dot {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--bg2);
    border: 2px solid var(--dot);
    color: var(--dot);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 700;
  }
  .stepper-label {
    font-size: 12px;
    color: var(--sub);
    margin-top: 6px;
    white-space: nowrap;
  }
  .stepper-val {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 20px;
    color: var(--text);
    line-height: 1;
  }
  .stepper-arrow {
    flex: 1;
    min-width: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-bottom: 36px;
  }
  .stepper-bar {
    width: 100%;
    height: 3px;
    border-radius: 2px;
    opacity: 0.4;
  }
  .stepper-arrow-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .stepper-label { font-size: 11px; }
    .stepper-arrow-label { display: none; }
    .stepper-val { font-size: 16px; }
  }

  /* Filter */
  /* 데스크톱(≥769px) 실측 높이. 사이드바가 검색바+상태탭 아래에 붙는 데만 쓴다 —
     모바일에선 사이드바가 바텀시트(position:fixed)라 이 값이 관여하지 않는다.
     ⚠️ 모바일 검색바는 높이가 유동적이라(768px→129 · 409px→180) 이 값으로 계산하면 안 된다 */
  :root { --filter-bar-h: 75px; --status-tabs-h: 57px; }

  /* 검색바 + 상태 탭을 통째로 고정. 둘을 따로 sticky 시키지 말 것 (마크업 주석 참조)
     ⚠️ `--nav-h` 는 데스크톱 100px · 모바일 60px 이다. 60px 을 하드코딩하면
     데스크톱에서 상단 40px 이 고정 nav 뒤로 들어가 필터바가 잘려 보인다. */
  .sticky-head {
    position: sticky;
    top: var(--nav-h);
    z-index: 50;
  }
  .filter-bar-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px 24px;
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .search-wrap { position: relative; flex: 1; min-width: 200px; max-width: 400px; }
  .search-icon {
    position: absolute;
    left: 12px; top: 50%;
    transform: translateY(-50%);
    color: var(--sub2);
  }
  .search-input {
    width: 100%;
    padding: 10px 14px 10px 38px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
  }
  .search-input:focus { border-color: var(--accent); }
  .search-input::placeholder { color: var(--sub2); }
  .search-btn {
    padding: 10px 20px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .filter-count {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
  }

  /* Status Tabs */
  .status-tabs-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .status-tabs-inner::-webkit-scrollbar { display: none; }
  .status-tab {
    flex-shrink: 0;
    padding: 14px 22px;
    border-bottom: 2px solid transparent;
    color: var(--sub);
    font-size: 14px;
    font-weight: 500;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    background: transparent;
  }
  /* hover 는 공용 규칙이 맡는다 (main.css 「밑줄 탭 바의 hover」) — 여기서 다시 정하지 말 것 */
  .status-tab.active { color: var(--text); border-bottom-color: var(--accent); }
  .tab-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 3px;
    background: var(--bg3);
    color: var(--sub2);
  }
  .status-tab.active .tab-badge { background: rgba(184,116,12,0.15); color: var(--accent); }

  /* Layout */
  .layout {
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    align-items: start;
  }

  .sidebar {
    position: sticky;
    /* nav + 검색바 + 상태탭 바로 아래. 130px 하드코딩이던 시절엔 데스크톱에서 필터바와 5px 겹쳤다 */
    top: calc(var(--nav-h) + var(--filter-bar-h) + var(--status-tabs-h));
    display: flex;
    flex-direction: column;
    gap: 16px;
    /* 뷰포트 넘어가면 사이드바 내부에서 스크롤 */
    max-height: calc(100vh - var(--nav-h) - var(--filter-bar-h) - var(--status-tabs-h) - 24px);
    overflow-y: auto;
    scrollbar-width: thin;              /* Firefox */
    scrollbar-color: var(--border2) transparent;
  }
  .sidebar::-webkit-scrollbar { width: 6px; }
  .sidebar::-webkit-scrollbar-track { background: transparent; }
  .sidebar::-webkit-scrollbar-thumb {
    background: var(--border2);
    border-radius: 6px;
  }
  .sidebar::-webkit-scrollbar-thumb:hover { background: var(--sub2); }
  .side-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .side-title {
    padding: 14px 18px;
    font-size: 11px;
    font-weight: 600;
    color: var(--sub2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--border);
    font-family: 'JetBrains Mono', monospace;
  }
  .side-list { padding: 6px 0; max-height: 400px; overflow-y: auto; }
  .side-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 10px 18px;
    font-size: 14px;
    gap: 8px;
    color: inherit;
    transition: background 0.15s;
    text-decoration: none;
  }
  .side-item:hover { background: var(--bg3); }
  .side-item.active { background: rgba(184,116,12,0.08); color: var(--accent); }
  .side-item-left {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
    flex: 1;
  }
  .side-item-name {
    flex: 1;
    min-width: 0;
    line-height: 1.35;
    /* 데스크톱: 한 줄로 유지 + 오버플로우 말줄임 (사이드바 폭 제한) */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .side-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--sub2); flex-shrink: 0; margin-top: 6px; }
  .side-item.active .side-dot { background: var(--accent); }
  .side-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub);
    flex-shrink: 0;
    margin-left: 8px;
  }
  .side-item.active .side-count { color: var(--accent); }

  /* AI 분석 진행률 배너 */
  .analysis-progress-banner {
    max-width: 1280px;
    margin: 0 auto 12px;
    padding: 14px 24px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .progress-text {
    font-size: 13px;
    color: var(--sub);
    flex: 1;
    min-width: 0;
  }
  .progress-text strong { color: var(--accent); font-family: 'JetBrains Mono', monospace; }
  .progress-bar-track {
    flex: 0 0 200px;
    height: 6px;
    background: var(--bg3);
    border-radius: 3px;
    overflow: hidden;
  }
  .progress-bar-fill {
    height: 100%;
    background: var(--accent);
    transition: width 0.3s;
  }
  .progress-pct {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--accent);
    flex-shrink: 0;
    min-width: 48px;
    text-align: right;
  }

  /* 정렬 드롭다운 (filter-bar 내부) */
  .sort-select {
    padding: 9px 30px 9px 12px;
    background: var(--bg3) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%237A8090' d='M5 6 0 0h10z'/></svg>") no-repeat right 10px center;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 13px;
    appearance: none;
    cursor: pointer;
  }
  .sort-select:focus { border-color: var(--accent); outline: none; }

  /* Bill cards */
  .bill-cards { display: flex; flex-direction: column; gap: 8px; }
  .bill-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    display: grid;
    /* [아바타] [본문] [표결·의안번호] — 아바타가 첫 열 */
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    align-items: start;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }
  .bill-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--card-accent, var(--sub2));
    opacity: 0;
    transition: opacity 0.2s;
  }
  /* 🔴 hover 는 공용 `.pb-boxlink` 가 맡는다 (main.css) — 옅은 골드 채움 + 골드 테두리 + 셰브론.
     구 규칙(`border-color: var(--border2)` + `translateX(2px)`)은 **공용을 덮어써** 이 페이지만
     혼자 다르게 보이게 했다 (같은 특이도라 뒤에 있는 쪽이 이긴다). 되살리지 말 것.
     좌측 처리결과 바(::before)만 이 페이지의 것으로 남긴다 — 상태 색은 여기서만 쓰는 정보다. */
  .bill-card:hover::before { opacity: 1; }
  .bill-card.status-passed    { --card-accent: var(--green); }
  .bill-card.status-pending   { --card-accent: var(--accent); }
  .bill-card.status-alt       { --card-accent: var(--sub2); }
  .bill-card.status-withdrawn { --card-accent: var(--red); }
  .bill-card.status-rejected  { --card-accent: var(--red); }

  /* 대표발의자 얼굴 — 동명 법안이 20장 붙어 있을 때, 글자를 읽기 전에 카드를 구분해주는 유일한 단서.
     법안명은 87%가 같고 요약은 2줄 클램프라 훑을 때 안 들어온다. 얼굴은 즉시 다르다. */
  /* ⚠️ 크기는 **래퍼**에 준다 — avatarHtml() 이 `style="width:100%;height:100%"` 인라인으로
     반환해서 부모를 채우는 설계라, 자식(img/svg)에 CSS 로 40px 을 줘봐야 인라인이 이긴다.
     (실제로 자식에 걸었다가 이미지가 676×946 으로 터졌다) */
  .bill-card-avatar {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    line-height: 0;         /* svg/img 하단 여백 제거 */
    margin-top: 2px;        /* 메타 배지행 광학 중심에 맞춤 */
    border-radius: 50%;
    overflow: hidden;       /* 채워 들어온 이미지를 원형으로 깎는다 */
    border: 1px solid var(--border);
    background: var(--bg3);
  }

  .bill-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .bill-card-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.55;
    margin-bottom: 10px;
  }
  .bill-card-info {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--sub);
    flex-wrap: wrap;
  }
  .bill-card-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    min-width: 100px;
  }
  .vote-mini {
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: flex-end;
  }
  .vote-mini-bar {
    width: 80px;
    height: 4px;
    background: var(--bg3);
    border-radius: 2px;
    overflow: hidden;
    display: flex;
  }
  .vb-for     { background: var(--green); }
  .vb-against { background: var(--red); }
  .vb-abs     { background: var(--sub2); }
  .vote-mini-nums {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub);
  }
  .vote-mini-nums .for { color: var(--green); }
  .vote-mini-nums .against { color: var(--red); }

  .bill-no {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--sub2);
    opacity: 0.7;
  }

  /* AI 분석 - 카드 강조 */
  .bill-card.has-analysis { border-left: 3px solid var(--accent); }
  .badge-ai-analysis {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    background: #FAF6EB;
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 2px 8px;
    white-space: nowrap;
  }
  .badge-priority {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    color: #fff;
    background: var(--accent);
    border-radius: 4px;
    padding: 2px 8px;
    white-space: nowrap;
  }
  .bill-card-summary {
    margin: 6px 0 10px;
    font-family: 'Noto Serif KR', serif;
    font-weight: 500;
    font-size: 14px;
    color: var(--text);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* 국회 원문(제안이유) — AI 요약과 시각적으로 구분한다.
     AI 요약은 세리프 + 본문색으로 무겁게, 원문은 산세리프 + 보조색으로 가볍게.
     "AI가 쓴 쉬운 말"과 "국회가 쓴 관 문체"를 톤으로 구분해주는 장치이고,
     분석 있는 카드가 계속 눈에 먼저 들어오도록 하는 위계이기도 하다.
     별도 라벨을 붙이지 않는 이유: 메타행의 🤖 배지가 이미 AI 여부를 말해주고,
     18,000장 카드에 같은 라벨이 반복되면 애초에 없애려던 "첫 줄이 다 똑같은" 문제가 돌아온다. */
  .bill-card-summary.is-raw {
    font-family: inherit;
    font-weight: 400;
    font-size: 13.5px;
    color: var(--sub);
    line-height: 1.6;
  }
  /* "같은 법률 N건 →" — 반복돼 보이는 것이 중복이 아니라 원래 그런 계열임을 알려준다.
     카드 전체가 <a> 라 중첩 링크가 불가능해서 span + JS 위임으로 동작한다
     (그래서 role/tabindex 로 버튼 시맨틱과 키보드 접근을 직접 얹어야 한다). */
  .same-name-chip {
    font-size: 12px;
    color: var(--sub2);
    border-bottom: 1px dashed var(--border2);
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .same-name-chip:hover,
  .same-name-chip:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
    outline: none;
  }

  /* 계열 필터가 켜졌을 때 상단에 뜨는 해제 바 — 왜 결과가 좁아졌는지 설명하고 빠져나갈 길을 준다 */
  .same-name-active {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
    padding: 12px 16px;
    background: #FAF6EB;
    border: 1px solid var(--accent);
    border-radius: 10px;
    font-size: 13px;
    color: var(--text);
  }
  .same-name-active .sn-name { font-weight: 600; }
  .same-name-active .sn-clear {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    white-space: nowrap;
  }

  .ai-category-tag {
    color: var(--accent);
    font-size: 12px;
    font-weight: 500;
  }
  .ai-sub-category {
    color: var(--sub);
    font-weight: 400;
  }
  .request-count-mini {
    font-size: 12px;
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .pg-btn {
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--sub);
    font-size: 13px;
    font-family: 'JetBrains Mono', monospace;
    text-decoration: none;
    transition: all 0.15s;
  }
  .pg-btn:hover { border-color: var(--border2); color: var(--text); }
  .pg-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pg-ellipsis { color: var(--sub2); padding: 0 6px; font-size: 13px; }

  .empty-state {
    padding: 60px 24px;
    text-align: center;
    color: var(--sub);
    background: var(--bg2);
    border: 1px dashed var(--border);
    border-radius: 12px;
  }

  /* 필터 시트 — 모바일 전용 오픈 버튼/백드롭, 헤더는 상시 노출 */
  .filter-sheet-btn { display: none; }
  .filter-sheet-backdrop { display: none; }

  /* 모바일에서 옮겨온 정렬 select 의 자리. 데스크톱에선 비어 있으므로 렌더하지 않는다 —
     ⚠️ `:empty` 는 공백 텍스트도 자식으로 치므로 마크업을 한 줄로 붙여 쓸 것 */
  .sheet-selects:empty { display: none; }
  .sheet-selects {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 14px;
  }
  .sheet-selects .sort-select { width: 100%; }
  .sheet-select-row { display: flex; flex-direction: column; gap: 6px; }
  .sheet-select-label { font-size: 12px; font-weight: 700; color: var(--sub); }

  /* 사이드바 내부 헤더 — 데스크톱/모바일 공통 */
  .filter-sheet-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 12px;
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .filter-sheet-title { font-size: 14px; font-weight: 700; color: var(--text); flex-shrink: 0; }
  .filter-sheet-actions {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }
  .filter-sheet-reset,
  .filter-sheet-apply {
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .filter-sheet-reset {
    background: var(--bg3);
    color: var(--sub);
    border-color: var(--border);
  }
  .filter-sheet-apply {
    background: var(--accent);
    color: #fff;
  }
  .filter-sheet-close {
    display: none;
    background: transparent;
    border: none;
    font-size: 24px;
    line-height: 1;
    color: var(--text);
    cursor: pointer;
    padding: 0 4px;
    flex-shrink: 0;
  }

  /* pending 시각 — 데스크톱/모바일 공통 */
  #filter-sidebar .side-item.sheet-pending {
    background: rgba(184,116,12,0.08);
    color: var(--accent);
  }
  #filter-sidebar .side-item.sheet-pending .side-dot { background: var(--accent); }

  @media (max-width: 768px) {
    .layout { grid-template-columns: 1fr; }
    /* 모바일: [아바타][본문] 한 줄, 표결·의안번호는 아래 줄 전체폭.
       아바타를 별도 행으로 떨구면 카드가 세로로 늘어나기만 하고 구분에 도움이 안 된다. */
    .bill-card { grid-template-columns: auto 1fr; gap: 14px; }
    .bill-card-right { grid-column: 1 / -1; flex-direction: row; align-items: center; }
    .bill-card-avatar { width: 34px; height: 34px; }

    /* 필터 버튼 노출 — 검색 바 위에 전체 폭 */
    .filter-sheet-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 14px;
      background: var(--bg2);
      border: 1px solid var(--border2);
      border-radius: 8px;
      color: var(--text);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      flex-basis: 100%;
    }
    .filter-sheet-btn:hover { border-color: var(--accent); }
    .filter-sheet-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 18px;
      height: 18px;
      padding: 0 5px;
      background: var(--accent);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      border-radius: 9px;
    }

    /* 사이드바를 바텀시트로 전환 */
    .sidebar {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      top: auto;
      max-height: 85vh;
      width: 100%;
      background: var(--bg2);
      border-top: 1px solid var(--border);
      border-top-left-radius: 16px;
      border-top-right-radius: 16px;
      padding: 0 16px 20px;
      overflow-y: auto;
      z-index: 150;
      box-shadow: 0 -8px 24px rgba(0,0,0,0.12);
      transform: translateY(100%);
      /* 🔴 닫힌 시트는 visibility 로도 잠근다 (2026-08-16). translateY(100%) 만으로는 iOS Safari 에서
         시트 안 sticky 헤더(.filter-sheet-header)가 뷰포트 기준으로 계산돼 화면 바닥에 `필터 · 적용 · ×` 줄이
         삐져나왔다 (fixed + transform + sticky 조합의 WebKit 동작). visibility 전환을 0.25s 지연시켜
         닫힘 애니메이션은 그대로 보이게 한다 */
      visibility: hidden;
      transition: transform 0.25s ease-out, visibility 0s linear 0.25s;
    }
    body.filter-sheet-open .sidebar { transform: translateY(0); visibility: visible; transition: transform 0.25s ease-out, visibility 0s; }
    /* interactions.js 가 닫힘 완료 후 hidden 을 건다 (iOS 흰 띠 대비). 클래스 규칙이 UA 의 [hidden] 을 이기므로 명시 */
    .sidebar[hidden] { display: none; }

    /* 모바일 시트 헤더 오버라이드 — 닫기 버튼 노출, 박스 스타일 → 구분선 스타일 */
    .filter-sheet-header {
      padding: 16px 14px 12px;
      border-radius: 0;
      border: none;
      border-bottom: 1px solid var(--border);
      margin-bottom: 12px;
    }
    .filter-sheet-title { font-size: 16px; }
    .filter-sheet-close { display: block; }

    .side-list { max-height: none; }

    /* 바텀시트는 폭 여유 있으니 말줄임 해제 — 긴 위원회명도 전체 노출(줄바꿈) */
    .side-item-name {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      word-break: keep-all;
    }

    /* 백드롭 */
    .filter-sheet-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      z-index: 140;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s;
    }
    body.filter-sheet-open .filter-sheet-backdrop {
      opacity: 1;
      pointer-events: auto;
    }
    body.filter-sheet-open { overflow: hidden; }
  }
</style>

<div class="pb-page-header">
  <div class="pb-page-header-inner">
    <div>
      <h1 class="pb-page-title">법안</h1>
      <p class="pb-page-desc">22대 국회 법안 <%= nf(sc.total) %>건. 발의부터 처리까지 한자리에서 볼 수 있습니다</p>
    </div>
  </div>
</div>

<!-- 상태 스테퍼 -->
<div class="stepper-wrap">
  <div class="stepper-inner">
    <div class="stepper-node" style="--dot: var(--sub);">
      <div class="stepper-dot">1</div>
      <div class="stepper-label">전체 발의</div>
      <div class="stepper-val"><%= nf(totalBills) %></div>
    </div>
    <div class="stepper-arrow" style="flex: <%= pendingCount %>">
      <div class="stepper-bar" style="background: var(--accent)"></div>
      <div class="stepper-arrow-label"><%= totalBills > 0 ? (pendingCount / totalBills * 100).toFixed(0) : 0 %>% 계류</div>
    </div>
    <div class="stepper-node" style="--dot: var(--accent);">
      <div class="stepper-dot">2</div>
      <div class="stepper-label">계류 중</div>
      <div class="stepper-val"><%= nf(pendingCount) %></div>
    </div>
    <div class="stepper-arrow" style="flex: <%= committeeOnly %>">
      <div class="stepper-bar" style="background: var(--sub2)"></div>
      <div class="stepper-arrow-label">위원회 단계 <%= nf(committeeOnly) %></div>
    </div>
    <div class="stepper-node" style="--dot: var(--accent);">
      <div class="stepper-dot">3</div>
      <div class="stepper-label">본회의 표결</div>
      <div class="stepper-val"><%= nf(plenaryVoted) %></div>
    </div>
    <div class="stepper-arrow" style="flex: <%= (passedOrig + passedMod) %>">
      <div class="stepper-bar" style="background: var(--green)"></div>
      <div class="stepper-arrow-label">가결 <%= nf(passedOrig + passedMod) %></div>
    </div>
    <div class="stepper-node" style="--dot: var(--green);">
      <div class="stepper-dot">4</div>
      <div class="stepper-label">처리 완료</div>
      <div class="stepper-val"><%= nf(processedAll) %></div>
    </div>
  </div>
</div>

<!-- AI 분석 진행률 배너 -->
<div class="analysis-progress-banner">
  <div class="progress-text">
    🤖 법안 <strong><%= nf(aTotal) %></strong>건 중 AI 분석 완료 <strong><%= nf(aDone) %></strong>건
  </div>
  <div class="progress-bar-track" aria-hidden="true">
    <div class="progress-bar-fill" style="width: <%= aPercent.toFixed(2) %>%"></div>
  </div>
  <div class="progress-pct"><%= aPercent.toFixed(1) %>%</div>
</div>

<!-- ⚠️ 검색바와 상태 탭을 한 컨테이너로 묶어 통째로 sticky 시킨다.
     따로 sticky 시키면 상태 탭의 top 을 `nav + 검색바높이` 로 계산해야 하는데,
     검색바는 모바일에서 내용이 2~3줄로 접혀 높이가 유동적이다 (실측 768px→129 · 409px→180).
     묶으면 그 계산이 통째로 사라져 어느 폭에서도 맞는다. -->
<div class="sticky-head">
<form class="filter-bar" method="get" action="/bill" id="bill-filter-form">
  <div class="filter-bar-inner">
    <!-- 모바일 전용: 필터 시트 오픈 (검색 바 위) -->
    <%
      const selectedCount =
        (query.committee || '').split(',').filter(Boolean).length +
        (query.party || '').split(',').filter(Boolean).length +
        (query.has_analysis ? 1 : 0) +
        (query.ai_category_main || '').split(',').filter(Boolean).length +
        (query.request_status ? 1 : 0);
    %>
    <button type="button" class="filter-sheet-btn" id="filter-sheet-btn" aria-label="필터 열기">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
      필터<% if (selectedCount > 0) { %><span class="filter-sheet-badge"><%= selectedCount %></span><% } %>
    </button>
    <div class="search-wrap">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input type="text" class="search-input" name="search" value="<%= query.search %>" placeholder="법안명, 발의자 이름, 법안번호 검색...">
    </div>
    <% if (query.status)       { %><input type="hidden" name="status"       value="<%= query.status %>"><% } %>
    <% if (query.committee)    { %><input type="hidden" name="committee"    value="<%= query.committee %>"><% } %>
    <% if (query.party)        { %><input type="hidden" name="party"        value="<%= query.party %>"><% } %>
    <% if (query.has_analysis)     { %><input type="hidden" name="has_analysis"     value="<%= query.has_analysis %>"><% } %>
    <% if (query.ai_category_main) { %><input type="hidden" name="ai_category_main" value="<%= query.ai_category_main %>"><% } %>
    <% if (query.request_status)   { %><input type="hidden" name="request_status"   value="<%= query.request_status %>"><% } %>
    <button type="submit" class="search-btn">검색</button>
    <%# ⚠️ form= 는 시트로 옮겨졌을 때(폼 바깥) 폼 소속을 유지하는 장치다. 지우지 말 것.
        onchange 인라인 제출도 뺐다 — 시트 안에서는 즉시 제출하면 아직 안 누른 필터 선택이 날아간다 %>
    <select class="sort-select" name="sort" form="bill-filter-form" id="bill-sort" aria-label="정렬">
      <option value="recent"      <%= query.sort === 'recent'      ? 'selected' : '' %>>최신순</option>
      <option value="ai_priority" <%= query.sort === 'ai_priority' ? 'selected' : '' %>>분석 있음 우선</option>
      <option value="requested"   <%= query.sort === 'requested'   ? 'selected' : '' %>>요청 많은 순</option>
    </select>
    <span class="filter-count">총 <%= nf(pagination.totalCount) %>건</span>
  </div>
</form>

<div class="status-tabs">
  <div class="status-tabs-inner">
    <% tabs.forEach(t => {
         const href = billHref({ status: t.key, page: '' });
         const active = (currentStatus === t.key) || (currentStatus === '' && t.key === '');
    %>
      <a href="<%= href %>" class="status-tab <%= active ? 'active' : '' %>">
        <%= t.label %> <span class="tab-badge"><%= nf(t.count) %></span>
      </a>
    <% }); %>
  </div>
</div>
</div><!-- /.sticky-head -->

<div class="filter-sheet-backdrop" id="filter-sheet-backdrop" hidden></div>

<div class="layout">
  <aside class="sidebar" id="filter-sidebar">
    <div class="filter-sheet-header">
      <span class="filter-sheet-title">필터</span>
      <div class="filter-sheet-actions">
        <button type="button" class="filter-sheet-reset" id="filter-sheet-reset">초기화</button>
        <button type="button" class="filter-sheet-apply" id="filter-sheet-apply">적용</button>
      </div>
      <button type="button" class="filter-sheet-close" id="filter-sheet-close" aria-label="닫기">×</button>
    </div>
    <!-- 모바일에서 상단 검색바의 정렬 select 가 여기로 옮겨온다 (데스크톱에선 비어 렌더 안 됨).
         ⚠️ 시트는 <form> **바깥**이라 옮기면 폼에서 빠진다 → select 에 form="bill-filter-form" 필수 -->
    <div class="sidebar-card sheet-selects" id="sheet-selects"></div>
    <!-- AI 분석 통합 카드 — 5항목 단일 라디오
         (has_analysis, request_status) 페어로 매핑:
           전체:        ('',  '')
           🤖 있음:      ('Y', '')
           없음:         ('N', '')
           💡 요청 있음:  ('N', 'any')
           🔥 우선 대기:  ('N', 'priority')
    -->
    <%
      const totalBillsCnt = Number(analysisStats?.total_bills || 0);
      const analyzedCnt   = Number(analysisStats?.analyzed_bills || 0);
      const unanalyzedCnt = Math.max(0, totalBillsCnt - analyzedCnt);
      const reqAny        = Number(analysisStats?.request_any_bills || 0);
      const reqPriority   = Number(analysisStats?.request_priority_bills || 0);
      const haCurrent     = query.has_analysis || '';
      const rsCurrent     = query.request_status || '';

      const items = [
        { ha: '',  rs: '',         label: '전체',                                      cnt: totalBillsCnt },
        { ha: 'Y', rs: '',         label: '🤖 있음',                                    cnt: analyzedCnt },
        { ha: 'N', rs: '',         label: '없음',                                       cnt: unanalyzedCnt },
        { ha: 'N', rs: 'any',      label: '💡 요청 있음',                                cnt: reqAny },
        { ha: 'N', rs: 'priority', label: `🔥 우선 분석 대기 (${requestThreshold}명+)`,    cnt: reqPriority }
      ];
    %>
    <div class="side-card">
      <div class="side-title">AI 분석</div>
      <div class="side-list">
        <% items.forEach(it => {
             const active = (haCurrent === it.ha) && (rsCurrent === it.rs);
             const href = billHref({ has_analysis: it.ha, request_status: it.rs, page: '' });
        %>
          <a href="<%= href %>" class="side-item <%= active ? 'active' : '' %>"
             data-analysis-ha="<%= it.ha %>"
             data-analysis-rs="<%= it.rs %>">
            <span class="side-item-left"><span class="side-dot"></span><span class="side-item-name"><%= it.label %></span></span>
            <span class="side-count"><%= nf(it.cnt) %></span>
          </a>
        <% }); %>
      </div>
    </div>

    <% if ((aiCategories || []).length > 0) { %>
      <div class="side-card">
        <div class="side-title">주제별</div>
        <div class="side-list">
          <a href="<%= billHref({ ai_category_main: '', page: '' }) %>" class="side-item <%= selectedAiCategories.length === 0 ? 'active' : '' %>" data-ai-category-value="">
            <span class="side-item-left"><span class="side-dot"></span><span class="side-item-name">전체</span></span>
            <span class="side-count"><%= nf(aiCategories.reduce((s, c) => s + Number(c.cnt || 0), 0)) %></span>
          </a>
          <% aiCategories.forEach(c => {
               const active = selectedAiCategories.includes(c.category);
               const href = billHref({ ai_category_main: c.category, page: '' });
          %>
            <a href="<%= href %>" class="side-item <%= active ? 'active' : '' %>" data-ai-category-value="<%= c.category %>">
              <span class="side-item-left"><span class="side-dot"></span><span class="side-item-name"><%= c.category %></span></span>
              <span class="side-count"><%= nf(c.cnt) %></span>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>

    <div class="side-card">
      <div class="side-title">카테고리</div>
      <div class="side-list">
        <%
          // "전체" 링크는 필터와 무관하게 전체 법안 수 (topicCounts 합계)
          const grandTotal = (topicCounts || []).reduce((s, tc) => s + Number(tc.cnt || 0), 0);
          // 복수선택 지원: 쉼표 분리된 committee 를 배열로 (서버사이드 active 판정용)
          const selectedCommittees = (query.committee || '').split(',').filter(Boolean);
          const isAllActive = selectedCommittees.length === 0;
        %>
        <a href="<%= billHref({ committee: '', page: '' }) %>" class="side-item <%= isAllActive ? 'active' : '' %>" data-committee-value="">
          <span class="side-item-left"><span class="side-dot"></span><span class="side-item-name">전체</span></span>
          <span class="side-count"><%= nf(grandTotal) %></span>
        </a>
        <%
          // 100건 이상 위원회는 개별 노출, 미만은 "기타/특별위원회"로 합산
          const MAJOR_THRESHOLD = 100;
          const majors = (topicCounts || []).filter(tc => Number(tc.cnt || 0) >= MAJOR_THRESHOLD);
          const minors = (topicCounts || []).filter(tc => Number(tc.cnt || 0) <  MAJOR_THRESHOLD);
          const minorNames  = minors.map(tc => tc.committee).filter(Boolean);
          const minorTotal  = minors.reduce((s, tc) => s + Number(tc.cnt || 0), 0);
          const minorValue  = minorNames.join(',');
          // 모든 minor 가 선택에 포함되어 있으면 그룹 active
          const isMinorActive = minorNames.length > 0 && minorNames.every(n => selectedCommittees.includes(n));
        %>
        <% majors.forEach(tc => {
             const fullName = tc.committee || '미지정';
             const href = billHref({ committee: tc.committee, page: '' });
             const active = selectedCommittees.includes(tc.committee);
        %>
          <a href="<%= href %>" class="side-item <%= active ? 'active' : '' %>" title="<%= fullName %>" data-committee-value="<%= tc.committee %>">
            <span class="side-item-left"><span class="side-dot"></span><span class="side-item-name"><%= fullName %></span></span>
            <span class="side-count"><%= nf(tc.cnt) %></span>
          </a>
        <% }); %>
        <% if (minorNames.length > 0) {
             const href = billHref({ committee: minorValue, page: '' });
        %>
          <a href="<%= href %>" class="side-item <%= isMinorActive ? 'active' : '' %>" title="<%= minorNames.join(', ') %>" data-committee-value="<%= minorValue %>">
            <span class="side-item-left"><span class="side-dot"></span><span class="side-item-name">기타/특별위원회</span></span>
            <span class="side-count"><%= nf(minorTotal) %></span>
          </a>
        <% } %>
      </div>
    </div>

    <div class="side-card">
      <div class="side-title">정당별 (대표발의)</div>
      <div class="side-list">
        <%
          const selectedParties = (query.party || '').split(',').filter(Boolean);
        %>
        <a href="<%= billHref({ party: '', page: '' }) %>" class="side-item <%= selectedParties.length === 0 ? 'active' : '' %>" data-party-value="">
          <span class="side-item-left"><span class="side-dot"></span><span class="side-item-name">전체</span></span>
          <span class="side-count"><%= nf(partyCounts.reduce((s, p) => s + Number(p.cnt || 0), 0)) %></span>
        </a>
        <% partyCounts.forEach(pc => {
             const href = billHref({ party: pc.party_name, page: '' });
             const active = selectedParties.includes(pc.party_name);
        %>
          <a href="<%= href %>" class="side-item <%= active ? 'active' : '' %>" data-party-value="<%= pc.party_name %>">
            <span class="side-item-left"><span class="side-dot"></span><span class="side-item-name"><%= pc.party_name %></span></span>
            <span class="side-count"><%= nf(pc.cnt) %></span>
          </a>
        <% }); %>
      </div>
    </div>
  </aside>

  <div>
    <%# 계열 필터가 켜져 있으면 왜 결과가 좁아졌는지 알리고 빠져나갈 길을 준다 %>
    <% if (query.bill_name) { %>
      <div class="same-name-active">
        <span><span class="sn-name"><%= query.bill_name %></span> 만 보는 중 · <%= pagination.totalCount %>건</span>
        <a class="sn-clear" href="<%= billHref({ bill_name: '', page: '' }) %>">전체 법안 보기 ✕</a>
      </div>
    <% } %>
    <% if (bills && bills.length > 0) { %>
      <div class="bill-cards">
        <% bills.forEach(b => {
             const scClass = statusCardClass(b.proc_result_name);
             const vFor     = Number(b.vote_for || 0);
             const vAgainst = Number(b.vote_against || 0);
             const vAbs     = Number(b.vote_abstain || 0);
             const vTotal   = vFor + vAgainst + vAbs;
             const hasVotes = vFor > 0 || vAgainst > 0;
        %>
          <%
            const isPending = !b.proc_result_name;
            const d = Number(b.days_elapsed || 0);
            const elapsedColor = d >= 200 ? 'var(--red)' : d >= 100 ? 'var(--accent)' : 'var(--sub2)';
            const termAnchor = !b.proc_result_name ? 'pending' :
                b.proc_result_name === '원안가결' ? 'original' :
                b.proc_result_name === '수정가결' ? 'modified' :
                b.proc_result_name === '대안반영폐기' ? 'alt-dropped' :
                b.proc_result_name === '수정안반영폐기' ? 'mod-dropped' :
                b.proc_result_name === '철회' ? 'withdrawn' :
                b.proc_result_name === '부결' ? 'rejected' :
                b.proc_result_name === '폐기' ? 'dropped' : 'pending';
          %>
          <%
            const reqCount = Number(b.analysis_request_count || 0);
            const isPriorityWaiting = !b.has_ai_analysis && reqCount >= requestThreshold;
          %>
          <a href="/bill/<%= b.bill_id %>" class="bill-card pb-boxlink is-tall <%= scClass %> <%= b.has_ai_analysis ? 'has-analysis' : '' %>">
            <%# 대표발의자 얼굴 — 카드 20장이 같은 이름일 때 글자를 읽기 전에 구분되는 유일한 단서 %>
            <div class="bill-card-avatar" aria-hidden="true">
              <%- avatarHtml(b.proposer_name || '', b.proposer_photo, 40) %>
            </div>
            <div>
              <div class="bill-card-meta">
                <% if (b.has_ai_analysis) { %><span class="badge-ai-analysis">🤖 AI 분석</span><% } %>
                <% if (isPriorityWaiting) { %><span class="badge-priority">🔥 우선 분석 대기</span><% } %>
                <% if (b.committee) { %><span class="pb-badge pb-badge-category"><%= b.committee %></span><% } %>
                <span class="pb-badge <%= resultClass(b.proc_result_name) %>">
                  <%= b.proc_result_name || '계류' %>
                  <span class="pb-help" data-help-href="/guide/glossary#<%= termAnchor %>" title="용어 설명">?</span>
                </span>
                <% if (isPending && d > 0) { %>
                  <span style="font-family:'JetBrains Mono',monospace;font-size:12px;color: <%= elapsedColor %>">
                    발의 후 <%= d %>일 경과
                  </span>
                <% } %>
              </div>
              <div class="bill-card-name"><%= b.bill_name %></div>
              <%
                // 카드 본문 — 법안의 87%가 동명("○○법 일부개정법률안")이라 이름만으로는 구분이 안 된다.
                // AI 요약이 있으면 그걸(쉬운 말), 없으면 국회 원문 제안이유를 보여준다.
                // 원문은 전건 보유하므로 이 자리가 비는 카드는 40건(대안반영폐기·철회)뿐이다.
                const rawPreview = b.has_ai_analysis && b.ai_summary ? null : summaryPreview(b.bill_summary);
              %>
              <% if (b.has_ai_analysis && b.ai_summary) { %>
                <div class="bill-card-summary"><%= b.ai_summary %></div>
              <% } else if (rawPreview) { %>
                <div class="bill-card-summary is-raw"><%= rawPreview %></div>
              <% } %>
              <div class="bill-card-info">
                <% if (b.proposer_name) { %><span>대표발의 <%= b.proposer_name %></span><span>·</span><% } %>
                <% if (b.co_proposer_count) { %><span>공동발의 <%= b.co_proposer_count %>인</span><span>·</span><% } %>
                <span><%= b.propose_dt || '—' %></span>
                <% if (b.ai_category_main) { %>
                  <span>·</span>
                  <span class="ai-category-tag">
                    <%= b.ai_category_main %><% if (b.ai_category_sub) { %><span class="ai-sub-category"> · <%= b.ai_category_sub %></span><% } %>
                  </span>
                <% } %>
                <% if (!b.has_ai_analysis && reqCount > 0) { %>
                  <span>·</span><span class="request-count-mini">💡 AI 분석 <%= reqCount %>명 요청</span>
                <% } %>
                <%
                  // 같은 법률의 개정안 건수 — 법안의 87%가 동명이라 "왜 똑같은 게 반복되지?" 를 먼저 해소한다.
                  // 이미 그 계열만 보고 있으면(bill_name 필터) 중복 정보라 숨긴다.
                  const sameCount = Number(b.same_name_count || 0);
                  const showSameChip = sameCount > 1 && !query.bill_name;
                %>
                <% if (showSameChip) { %>
                  <span>·</span>
                  <%# 카드 전체가 <a> 라 중첩 링크를 만들 수 없다 → data-href + JS 위임으로 처리 %>
                  <span class="same-name-chip" role="button" tabindex="0"
                        data-href="<%= billHref({ bill_name: b.bill_name, search: '', status: '', page: '' }) %>"
                        title="같은 법률의 개정안만 모아 보기">같은 법률 <%= sameCount %>건 →</span>
                <% } %>
              </div>
            </div>
            <div class="bill-card-right">
              <% if (hasVotes) {
                   const fp = (vFor / vTotal * 100);
                   const ap = (vAgainst / vTotal * 100);
                   const bp = (vAbs / vTotal * 100);
              %>
                <div class="vote-mini">
                  <div class="vote-mini-bar">
                    <div class="vb-for"     style="width:<%= fp %>%"></div>
                    <div class="vb-against" style="width:<%= ap %>%"></div>
                    <div class="vb-abs"     style="width:<%= bp %>%"></div>
                  </div>
                  <span class="vote-mini-nums">
                    <span class="for"><%= vFor %></span> /
                    <span class="against"><%= vAgainst %></span> / <%= vAbs %>
                  </span>
                </div>
              <% } %>
              <span class="bill-no">#<%= b.bill_no || b.bill_id %></span>
            </div>
          </a>
        <% }); %>
      </div>

      <%
        const { page, totalPages } = pagination;
        const buildHref = (p) => billHref({ page: p });
        const pagesAround = () => {
          const maxBtns = 7;
          let start = Math.max(1, page - 3);
          let end = Math.min(totalPages, start + maxBtns - 1);
          start = Math.max(1, end - maxBtns + 1);
          const arr = [];
          for (let p = start; p <= end; p++) arr.push(p);
          return arr;
        };
        const pages = pagesAround();
      %>
      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (page > 1) { %>
            <a href="<%= buildHref(page - 1) %>" class="pg-btn">←</a>
          <% } else { %>
            <span class="pg-btn" style="opacity:0.3">←</span>
          <% } %>

          <% if (pages[0] > 1) { %>
            <a href="<%= buildHref(1) %>" class="pg-btn">1</a>
            <% if (pages[0] > 2) { %><span class="pg-ellipsis">...</span><% } %>
          <% } %>

          <% pages.forEach(p => { %>
            <% if (p === page) { %>
              <span class="pg-btn active"><%= p %></span>
            <% } else { %>
              <a href="<%= buildHref(p) %>" class="pg-btn"><%= p %></a>
            <% } %>
          <% }); %>

          <% if (pages[pages.length - 1] < totalPages) { %>
            <% if (pages[pages.length - 1] < totalPages - 1) { %><span class="pg-ellipsis">...</span><% } %>
            <a href="<%= buildHref(totalPages) %>" class="pg-btn"><%= totalPages %></a>
          <% } %>

          <% if (page < totalPages) { %>
            <a href="<%= buildHref(page + 1) %>" class="pg-btn">→</a>
          <% } else { %>
            <span class="pg-btn" style="opacity:0.3">→</span>
          <% } %>
        </div>
      <% } %>
    <% } else { %>
      <div class="empty-state">
        검색 조건에 해당하는 법안이 없습니다.<br>
        <a href="/bill" style="color:var(--accent);margin-top:12px;display:inline-block">필터 초기화 →</a>
      </div>
    <% } %>
  </div>
</div>

<script>
(() => {
  const btn       = document.getElementById('filter-sheet-btn');
  const closeBtn  = document.getElementById('filter-sheet-close');
  const backdrop  = document.getElementById('filter-sheet-backdrop');
  const resetBtn  = document.getElementById('filter-sheet-reset');
  const applyBtn  = document.getElementById('filter-sheet-apply');
  const isOpen = () => document.body.classList.contains('filter-sheet-open');

  // 카테고리·정당·AI 카테고리 각각 Set, AI 분석/분석요청 필터는 enum
  let pendingCmt           = new Set();
  let pendingParty         = new Set();
  let pendingAiCategory    = new Set();
  let pendingHasAnalysis   = '';   // '' = 전체, 'Y' = 있음, 'N' = 없음
  let pendingRequestStatus = '';   // '' = 전체, 'any' = 1명+, 'priority' = 임계값 도달

  // 사이드바 a.side-item 토글 로직 — Set + data-*-value 기반
  const configs = [
    { attr: 'data-committee-value',   getSet: () => pendingCmt        },
    { attr: 'data-party-value',       getSet: () => pendingParty      },
    { attr: 'data-ai-category-value', getSet: () => pendingAiCategory }
  ];

  const updateSheetVisuals = () => {
    configs.forEach(cfg => {
      const set = cfg.getSet();
      document.querySelectorAll(`#filter-sidebar a.side-item[${cfg.attr}]`).forEach(el => {
        const val = el.getAttribute(cfg.attr);
        let active;
        if (val === '') {
          active = set.size === 0;
        } else {
          const names = val.split(',').filter(Boolean);
          active = names.length > 0 && names.every(n => set.has(n));
        }
        el.classList.toggle('sheet-pending', active);
      });
    });
    // AI 분석 통합 카드 — (ha, rs) 페어 매칭
    document.querySelectorAll('#filter-sidebar a.side-item[data-analysis-ha]').forEach(el => {
      const ha = el.getAttribute('data-analysis-ha') || '';
      const rs = el.getAttribute('data-analysis-rs') || '';
      const active = (ha === pendingHasAnalysis) && (rs === pendingRequestStatus);
      el.classList.toggle('sheet-pending', active);
    });
  };

  const loadFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    pendingCmt         = new Set((params.get('committee')        || '').split(',').filter(Boolean));
    pendingParty       = new Set((params.get('party')            || '').split(',').filter(Boolean));
    // ai_category_main 신규 + 구버전 ai_category 호환
    const aiCatMain    = params.get('ai_category_main') || params.get('ai_category') || '';
    pendingAiCategory  = new Set(aiCatMain.split(',').filter(Boolean));
    const ha           = params.get('has_analysis');
    pendingHasAnalysis = (ha === 'Y' || ha === '1') ? 'Y' : (ha === 'N') ? 'N' : '';
    const rs           = params.get('request_status');
    pendingRequestStatus = (rs === 'any' || rs === 'priority') ? rs : '';
  };

  /* ===== 모바일: 정렬 select 를 필터 시트로 이동 =====
     모바일 검색바가 3줄로 부푸는 것을 줄인다. 복제하지 말고 같은 노드를 옮긴다.
     🔴 시트는 <form> 바깥이라 옮기면 폼에서 빠진다 — select 의 form="bill-filter-form" 이 그걸 막는다.
     ⚠️ 시트 안에선 즉시 제출하지 않는다. 즉시 제출하면 아직 '적용' 을 안 누른
        카테고리·정당 선택이 통째로 날아간다. 대신 apply() 가 값을 읽어 URL 에 싣는다 */
  const sortSel    = document.getElementById('bill-sort');
  const selectsBox = document.getElementById('sheet-selects');
  const filterInner = document.querySelector('.filter-bar-inner');
  const sortInSheet = () => !!selectsBox && !!sortSel && selectsBox.contains(sortSel);

  const syncSortFromUrl = () => {
    if (!sortSel) return;
    sortSel.value = new URLSearchParams(window.location.search).get('sort') || 'recent';
  };
  const mobileMq = window.matchMedia('(max-width: 768px)');
  const relocateSort = () => {
    if (!sortSel || !selectsBox || !filterInner) return;
    if (mobileMq.matches) {
      if (selectsBox.contains(sortSel)) return;
      const row = document.createElement('div');
      row.className = 'sheet-select-row';
      const lb = document.createElement('span');
      lb.className = 'sheet-select-label';
      lb.textContent = '정렬';
      row.appendChild(lb);
      row.appendChild(sortSel);
      selectsBox.appendChild(row);
    } else {
      if (!selectsBox.contains(sortSel)) return;
      const row = sortSel.parentElement;
      // 원래 자리 — 검색 버튼 다음, 건수 앞
      filterInner.insertBefore(sortSel, filterInner.querySelector('.filter-count'));
      if (row && row.classList.contains('sheet-select-row')) row.remove();
    }
  };
  relocateSort();
  // ⚠️ requestAnimationFrame 으로 묶지 말 것 — 탭이 렌더링하지 않으면 콜백이 안 돈다
  let wasMobile = mobileMq.matches;
  const onViewportChange = () => {
    if (mobileMq.matches === wasMobile) return;
    wasMobile = mobileMq.matches;
    relocateSort();
  };
  mobileMq.addEventListener('change', onViewportChange);
  window.addEventListener('resize', onViewportChange);

  sortSel?.addEventListener('change', () => {
    if (sortInSheet()) return;            // 시트 안 — '적용' 에서 커밋
    window.pbShowLoader?.();
    sortSel.form?.submit();
  });

  const open = () => {
    loadFromUrl();
    updateSheetVisuals();
    document.body.classList.add('filter-sheet-open');
  };
  const close = () => {
    loadFromUrl();
    updateSheetVisuals();
    syncSortFromUrl();                    // 시트 안에서 바꿨다면 되돌린다
    document.body.classList.remove('filter-sheet-open');
  };
  const reset = () => {
    pendingCmt.clear();
    pendingParty.clear();
    pendingAiCategory.clear();
    pendingHasAnalysis = '';
    pendingRequestStatus = '';
    // 정렬이 시트 안에 있을 때만 초기화 — 데스크톱에선 시트 밖(상단 바)이라 건드리면 안 된다
    if (sortInSheet() && sortSel) sortSel.value = 'recent';
    updateSheetVisuals();
  };
  const apply = () => {
    const params = new URLSearchParams(window.location.search);
    if (pendingCmt.size > 0)        params.set('committee', Array.from(pendingCmt).join(','));
    else                             params.delete('committee');
    if (pendingParty.size > 0)      params.set('party', Array.from(pendingParty).join(','));
    else                             params.delete('party');
    if (pendingAiCategory.size > 0) params.set('ai_category_main', Array.from(pendingAiCategory).join(','));
    else                             params.delete('ai_category_main');
    if (pendingHasAnalysis)         params.set('has_analysis', pendingHasAnalysis);
    else                             params.delete('has_analysis');
    if (pendingRequestStatus)       params.set('request_status', pendingRequestStatus);
    else                             params.delete('request_status');
    // 정렬 — 시트로 옮겨졌을 땐 폼 제출을 안 하므로 여기서 실어야 한다
    if (sortSel && sortSel.value && sortSel.value !== 'recent') params.set('sort', sortSel.value);
    else                                                        params.delete('sort');
    // 구버전 키 잔재 제거
    params.delete('ai_category');
    params.delete('page');
    const qs = params.toString();
    window.pbShowLoader?.();
    window.location.href = '/bill' + (qs ? '?' + qs : '');
  };

  // 카드별 링크 클릭 intercept — 데스크톱/모바일 공통, 항상 pending 토글
  configs.forEach(cfg => {
    document.querySelectorAll(`#filter-sidebar a.side-item[${cfg.attr}]`).forEach(item => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const set = cfg.getSet();
        const val = item.getAttribute(cfg.attr);
        if (val === '') {
          set.clear();
        } else {
          const names = val.split(',').filter(Boolean);
          const allPresent = names.every(n => set.has(n));
          if (allPresent) names.forEach(n => set.delete(n));
          else            names.forEach(n => set.add(n));
        }
        updateSheetVisuals();
      });
    });
  });

  // AI 분석 통합 카드 — 한 클릭에 (ha, rs) 페어 동시 설정.
  // 같은 항목 다시 클릭 시 '전체' 로 복귀.
  document.querySelectorAll('#filter-sidebar a.side-item[data-analysis-ha]').forEach(item => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const ha = item.getAttribute('data-analysis-ha') || '';
      const rs = item.getAttribute('data-analysis-rs') || '';
      const isAlreadyActive = (ha === pendingHasAnalysis) && (rs === pendingRequestStatus);
      if (isAlreadyActive) {
        pendingHasAnalysis = '';
        pendingRequestStatus = '';
      } else {
        pendingHasAnalysis = ha;
        pendingRequestStatus = rs;
      }
      updateSheetVisuals();
    });
  });

  // 페이지 로드 시 URL 로 pending 초기화 + 서버렌더 .active 를 .sheet-pending 으로 교체
  loadFromUrl();
  document.querySelectorAll('#filter-sidebar .side-item.active').forEach(el => el.classList.remove('active'));
  updateSheetVisuals();

  btn?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  backdrop?.addEventListener('click', close);
  resetBtn?.addEventListener('click', reset);
  applyBtn?.addEventListener('click', apply);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) close();
  });
})();

/* "같은 법률 N건 →" 칩 — 카드 전체가 <a> 라 중첩 링크를 못 쓴다.
   위임으로 잡아서 카드 링크로의 전파를 막고 계열 필터로 보낸다. */
(() => {
  const go = (chip) => {
    const href = chip.dataset.href;
    if (!href) return;
    window.pbShowLoader?.();
    window.location.href = href;
  };
  document.addEventListener('click', (e) => {
    const chip = e.target.closest('.same-name-chip');
    if (!chip) return;
    e.preventDefault();
    e.stopPropagation();   // 카드 <a> 가 법안 상세로 끌고 가지 않도록
    go(chip);
  });
  // role="button" 을 붙였으므로 Enter/Space 도 동작해야 한다
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const chip = e.target.closest?.('.same-name-chip');
    if (!chip) return;
    e.preventDefault();
    e.stopPropagation();
    go(chip);
  });
})();
</script>
