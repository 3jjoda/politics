<%
  const nf = (n) => Number(n || 0).toLocaleString('ko-KR');
  const resultClass = (r) => {
    if (!r) return 'pb-badge-pending';
    if (r.indexOf('가결') > -1) return 'pb-badge-passed';
    if (r === '부결' || r === '폐기') return 'pb-badge-rejected';
    if (r === '철회') return 'pb-badge-withdrawn';
    if (r.indexOf('대안') > -1) return 'pb-badge-alt';
    return 'pb-badge-pending';
  };
  const termAnchor = (r) => {
    if (!r) return 'pending';
    if (r === '원안가결')      return 'original';
    if (r === '수정가결')      return 'modified';
    if (r === '대안반영폐기')  return 'alt-dropped';
    if (r === '수정안반영폐기') return 'mod-dropped';
    if (r === '철회')          return 'withdrawn';
    if (r === '부결')          return 'rejected';
    if (r === '폐기')          return 'dropped';
    return 'pending';
  };
%>

<style>
  /* ⚠️ 상단 여백은 `.bd-top` 이 가져갔다 (고정 nav 클리어런스 포함). 여기 다시 넣지 말 것 */
  .bd-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 28px 24px 60px;
  }
  .bd-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    margin-bottom: 18px;
  }
  .bd-breadcrumb a { color: var(--accent); }

  .bd-section {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 18px;
  }
  .bd-section h2 {
    font-size: 15px;
    font-weight: 600;
    color: var(--sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 18px;
  }
  .vote-dashboard {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }
  .vote-box {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg3);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.08s;
    font: inherit;
    width: 100%;
  }
  .vote-box:hover:not([data-empty]) {
    border-color: var(--border2);
    background: var(--bg2);
  }
  .vote-box:active:not([data-empty]) { transform: translateY(1px); }
  .vote-box[data-empty] { cursor: default; opacity: 0.55; }
  .vote-box strong {
    display: block;
    font-size: 12px;
    color: var(--sub);
    margin-bottom: 8px;
  }
  .vote-box .vote-count {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    line-height: 1;
    display: block;
  }
  .vote-box.agree    .vote-count { color: var(--green); }
  .vote-box.disagree .vote-count { color: var(--red); }
  .vote-box.abstain  .vote-count { color: var(--accent); }
  .vote-box.absent   .vote-count { color: var(--sub); }
  .vote-box .vote-pct { display: block; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; color: var(--text); margin-top: 2px; }
  .vote-box .vote-pct small { font-family: 'Noto Sans KR', sans-serif; font-weight: 400; font-size: 10.5px; color: var(--sub2); }
  .vote-box[data-empty] .vote-pct { color: var(--sub2); }
  .vote-box .vote-hint {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    color: var(--sub2);
    font-family: 'JetBrains Mono', monospace;
  }
  .vote-box[data-empty] .vote-hint { visibility: hidden; }

  .proposers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
  }
  .proposer-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 13px;
    color: var(--text);
  }
  .proposer-chip.rep { border-color: var(--accent); background: rgba(184,116,12,0.08); }
  .proposer-chip.retired { color: var(--sub2); font-style: italic; cursor: default; }
  .proposer-chip.retired .party-sm { color: var(--sub2); }
  .proposer-chip .avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
  }
  .proposer-chip .avatar img,
  .proposer-chip .avatar svg { width: 100%; height: 100%; display: block; }
  .proposer-chip .party-sm { color: var(--sub); font-size: 11px; }

  @media (max-width: 768px) {
    .vote-dashboard { grid-template-columns: repeat(2, 1fr); }
  }

  /* 표결 의원 명단 모달 */
  .voter-modal .pb-modal-card {
    max-width: 760px;
    padding: 22px 24px 20px;
    max-height: calc(100vh - 48px);
    display: flex;
    flex-direction: column;
  }
  .voter-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .voter-modal-title { font-size: 17px; font-weight: 700; color: var(--text); }
  .voter-modal-title .tc-dot {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: middle;
  }
  .voter-modal-title.agree    .tc-dot { background: var(--green); }
  .voter-modal-title.disagree .tc-dot { background: var(--red); }
  .voter-modal-title.abstain  .tc-dot { background: var(--accent); }
  .voter-modal-title.absent   .tc-dot { background: var(--sub); }
  .voter-modal-close {
    background: transparent;
    border: none;
    width: 32px; height: 32px;
    border-radius: 8px;
    font-size: 22px;
    line-height: 1;
    color: var(--sub);
    cursor: pointer;
    flex-shrink: 0;
  }
  .voter-modal-close:hover { background: var(--bg3); color: var(--text); }
  .voter-modal-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
    max-height: 100px;
    overflow-y: auto;
  }
  .voter-modal-search {
    margin-bottom: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .voter-modal-search input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    background: var(--bg2);
    color: var(--text);
    box-sizing: border-box;
  }
  .voter-modal-search input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(184,116,12,0.12);
  }
  .voter-modal-search input::placeholder { color: var(--sub2); }
  .voter-filter-chip {
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg2);
    font-size: 12px;
    color: var(--sub);
    cursor: pointer;
    font: inherit;
    line-height: 1.4;
    transition: all 0.12s;
  }
  .voter-filter-chip:hover { border-color: var(--border2); color: var(--text); }
  .voter-filter-chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .voter-filter-chip .chip-count {
    margin-left: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    opacity: 0.8;
  }
  .voter-modal-grid {
    flex: 0 0 auto;
    height: 456px;           /* 8줄 고정 (chip ~50px + gap 8px) */
    overflow-y: auto;
    padding: 4px 2px 2px;
  }
  .voter-modal-grid .proposers-grid {
    margin: 0;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  /* 정당별 chip 배경 — politician 페이지와 동일 팔레트(저채도 tint) */
  .voter-modal-grid .proposer-chip.cp-minjoo  { background: rgba(30,64,175,0.08);  border-color: rgba(30,64,175,0.28); }
  .voter-modal-grid .proposer-chip.cp-gukhim  { background: rgba(185,28,28,0.08);  border-color: rgba(185,28,28,0.28); }
  .voter-modal-grid .proposer-chip.cp-jokuk   { background: rgba(109,40,217,0.08); border-color: rgba(109,40,217,0.28); }
  .voter-modal-grid .proposer-chip.cp-gaehyuk { background: rgba(180,83,9,0.10);   border-color: rgba(180,83,9,0.28); }
  .voter-modal-grid .proposer-chip.cp-jinbo   { background: rgba(153,27,27,0.08);  border-color: rgba(153,27,27,0.28); }
  .voter-modal-grid .proposer-chip.cp-etc     { background: rgba(75,85,99,0.08);   border-color: rgba(75,85,99,0.28); }
  .voter-modal-grid .proposer-chip.retired    { background: var(--bg3); border-color: var(--border); }
  .voter-modal-empty {
    padding: 40px 12px;
    text-align: center;
    color: var(--sub2);
    font-size: 13px;
  }
  @media (max-width: 768px) {
    .voter-modal .pb-modal-card { padding: 18px 16px 16px; }
    .voter-modal-filters { max-height: 120px; }
    .voter-modal-grid { height: 60vh; }
    .voter-modal-grid .proposers-grid {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    }
  }

  /* =========================================================
     AI 분석 섹션 (UI_ANALYSIS.md 5-Zone)
     ========================================================= */
  /* AI 분석 라벨 — 분석 섹션 위 한 줄, 디스클레이머 + 상태 명시 */
  .ai-analysis-label {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 8px 14px;
    margin-bottom: 12px;
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.4;
  }
  /* ⚠️ 색은 대비비 기준으로 고른 값이다 (배경 #FAF6EB, 12px 본문 → WCAG AA 4.5:1 필요).
     `--accent #B8740C` 는 3.51 로 미달 — "AI가 생성한 분석으로 사실과 다를 수 있습니다" 는
     법적·윤리적 고지라 안 읽히면 곤란하다. `#8F5800` 은 5.46 으로 통과.
     보더는 장식이라 `--accent` 유지 (3:1 비텍스트 기준 충족). */
  .ai-analysis-label.is-done {
    background: #FAF6EB;
    border: 1px solid var(--accent);
    color: #8F5800;
  }
  .ai-analysis-label.is-pending {
    background: var(--bg3);
    border: 1px solid var(--border2);
    color: var(--sub);
  }
  .ai-analysis-label .label-tag {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }
  .ai-analysis-label .label-note {
    flex: 1;
    min-width: 0;
  }
  .ai-analysis-label .label-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    flex-shrink: 0;
  }
  /* opacity 0.8 을 걸면 배경과 합성돼 대비가 5.46 → 3.66 으로 떨어진다. 색으로만 톤을 낮춘다 */
  .ai-analysis-label.is-done .label-meta { color: #8F5800; }

  /* ⚠️ `.bill-basic-header` 도 같이 선언한다 — 미분석 분기 헤더가 Zone 1 과 같은 구성이라
     `.ba-meta-line`·`.ba-bill-name`·발의자 스택이 이 토큰들을 쓴다.
     빼면 미분석 법안에서 색·폰트가 통째로 무너진다 (var() 가 해석 안 됨) */
  .bill-ai-analysis,
  .bill-basic-header {
    /* 분석 섹션 전용 디자인 토큰 — 사용자 스펙 (Brand Assets 기반) */
    --ba-ink:    #0F1B1F;   /* 본문 */
    --ba-sub:    #374151;   /* 보조 */
    /* 메타 — #6B7280 은 대비 4.47 로 AA(4.5) 아슬하게 미달이었다. 한 톤만 내려 4.76~4.93.
       Z1 메타·태그라인, Z3 마진노트 등 12~14px 소형 텍스트가 전부 이 토큰을 쓴다 */
    --ba-meta:   #646E7E;
    --ba-gold:   #8F5800;   /* 머스타드 골드 (강조 단일색) */
    --ba-paper:  #F3F1EA;   /* 페이지 */
    --ba-card-bg:     #FAFAF7;
    --ba-card-border: #E8E5DC;
    --ba-sans:  'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
    --ba-serif: 'Noto Serif KR', 'Noto Sans KR', serif;
    --ba-mono:  'JetBrains Mono', monospace;
    margin-bottom: 32px;
  }

  /* ===== Shell: 1240px = 180 좌마진노트 거터 + 880 콘텐츠 + 180 우거터(인덱스 회피) ===== */
  .ba-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 180px minmax(0, 880px) 180px;
    gap: 0;
    justify-content: center;
    align-items: start;
    /* bd-wrap(960px) 보다 넓게 break out */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    width: 100vw;
    max-width: 100vw;
  }
  .ba-content {
    grid-column: 2 / 3;
    font-family: var(--ba-sans);
    font-size: 18px;
    font-weight: 450;
    line-height: 1.75;
    color: var(--ba-ink);
    word-break: keep-all;
  }
  .ba-content > .ba-zone + .ba-zone { margin-top: 64px; }

  /* 본문 강조: weight 700 + 골드 언더라인 */
  .ba-content strong, .ba-content em {
    font-style: normal;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--ba-gold);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    text-decoration-skip-ink: none;
  }
  .ba-content a {
    color: var(--ba-gold);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ba-muted { color: var(--ba-meta); font-weight: 450; }
  .ba-sep   { color: var(--ba-meta); margin: 0 6px; }

  /* ===== Zone 1: 메타 + 헤드라인 =====
     ⚠️ 미분석 분기 헤더(.bill-basic-header)도 같은 구성이라 함께 받아야 한다.
        `.ba-z1` 만 두면 그쪽 메타가 스타일을 못 받아 본문색·기본 폰트로 떨어진다 */
  .ba-z1 .ba-meta-line,
  .bill-basic-header .ba-meta-line {
    font-family: var(--ba-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    color: var(--ba-meta);
    margin-bottom: 6px;
    line-height: 1.6;
  }
  .ba-z1 .ba-meta-line a,
  .bill-basic-header .ba-meta-line a { color: var(--ba-meta); text-decoration: none; }
  .ba-z1 .ba-meta-line a:hover,
  .bill-basic-header .ba-meta-line a:hover { color: var(--ba-gold); }
  .ba-z1 .ba-meta-line-sub,
  .bill-basic-header .ba-meta-line-sub { margin-bottom: 24px; }

  /* ===== Zone 1 — 발의자 컴팩트 스택 (메타라인 직하) ===== */
  .ba-proposers {
    margin: 8px 0 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #E8E5DC;
  }
  .ba-proposers-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .ba-proposers-stack {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .ba-pp-stack-item {
    width: 24px; height: 24px;
    border-radius: 50%;
    overflow: hidden;
    background: #F3F1EA;
    border: 1.5px solid #F3F1EA;
    margin-left: -6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ba-sans);
    font-size: 11px;
    font-weight: 600;
    color: var(--ba-meta);
    text-decoration: none;
    flex-shrink: 0;
    box-sizing: content-box;
    transition: transform 0.15s, z-index 0.15s;
  }
  .ba-pp-stack-item:first-child { margin-left: 0; }
  .ba-pp-stack-item.is-rep {
    width: 32px; height: 32px;
    border: 1.5px solid var(--ba-gold);
    box-shadow: 0 0 0 2px #F3F1EA;
    z-index: 2;
    margin-left: 0;
  }
  .ba-pp-stack-item img,
  .ba-pp-stack-item svg { width: 100%; height: 100%; display: block; object-fit: cover; }
  .ba-pp-stack-item:hover { transform: translateY(-1px); z-index: 3; }
  .ba-pp-stack-initial { display: inline-block; line-height: 1; }
  .ba-proposers-label {
    flex: 1;
    min-width: 0;
    font-family: var(--ba-sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ba-meta);
  }
  .ba-pp-rep-name {
    color: var(--ba-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .ba-pp-rep-name:hover { text-decoration: underline; text-decoration-color: var(--ba-gold); text-underline-offset: 4px; }
  .ba-pp-others { color: #8B8578; }
  .ba-pp-sep    { color: #C8C0AA; }
  .ba-pp-parties { color: var(--ba-meta); }
  .ba-pp-toggle {
    flex-shrink: 0;
    background: transparent;
    border: none;
    padding: 2px 0 3px;
    color: var(--ba-gold);
    font-family: var(--ba-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    cursor: pointer;
    border-bottom: 1px dashed #C8A24A;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .ba-pp-toggle:hover { color: #6E4400; border-bottom-color: var(--ba-gold); }
  .ba-pp-toggle-arrow { font-size: 10px; transform: translateY(-1px); }

  /* 펼친 카드 그리드 — data-expanded="true" 일 때만 노출 (display:grid 가 [hidden] 을 덮어쓰는 문제 회피) */
  .ba-proposers-grid { display: none; }
  .ba-proposers[data-expanded="true"] .ba-proposers-grid {
    margin-top: 16px;
    padding: 16px;
    background: rgba(255,255,255,0.5);
    border: 1px dashed #D9D3C3;
    border-radius: 12px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }
  .ba-pp-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ba-ink);
    transition: border-color 0.15s, transform 0.15s;
    min-width: 0;
  }
  .ba-pp-card:hover { border-color: var(--ba-gold); transform: translateY(-1px); }
  .ba-pp-card.is-rep { border: 1.5px solid var(--ba-gold); }
  .ba-pp-card.is-retired {
    color: #9B9486;
    font-style: italic;
    cursor: default;
    background: #F3F1EA;
  }
  .ba-pp-card-avatar {
    width: 24px; height: 24px;
    border-radius: 50%;
    overflow: hidden;
    background: #F3F1EA;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ba-sans);
    font-size: 10px;
    font-weight: 600;
    color: var(--ba-meta);
  }
  .ba-pp-card-avatar img, .ba-pp-card-avatar svg { width: 100%; height: 100%; display: block; object-fit: cover; }
  .ba-pp-card-meta { min-width: 0; flex: 1; }
  .ba-pp-card-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--ba-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ba-pp-card-rep-tag {
    font-family: var(--ba-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--ba-gold);
    font-weight: 700;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .ba-pp-card-party {
    font-size: 10px;
    color: #8B8578;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ===== 모바일 (≤768) — 아바타 축소, 그리드 5→2열, 라벨 줄바꿈 ===== */
  @media (max-width: 768px) {
    .ba-pp-stack-item    { width: 22px; height: 22px; margin-left: -5px; }
    .ba-pp-stack-item.is-rep { width: 28px; height: 28px; margin-left: 0; }
    .ba-proposers-label  { flex-basis: 100%; order: 3; }
    /* 터치 타깃 확보 (실측 20px → 44px).
       밑줄(border-bottom)이 이 요소에 붙어 있어서 padding-bottom 으로 늘리면 밑줄이 글자에서 떨어진다.
       `min-height` + `align-items: flex-end` 로 히트영역만 위로 키우면 밑줄은 글자 바로 밑에 남는다 */
    .ba-pp-toggle        { flex-basis: 100%; order: 4; justify-content: flex-start;
                           min-height: 44px; align-items: flex-end; }
    <%# 🔴 특이도를 맞춰야 한다. 5열은 `.ba-proposers[data-expanded="true"] .ba-proposers-grid`(0,3,0)
        가 선언하므로, 여기서 `.ba-proposers-grid`(0,1,0) 로 쓰면 **순서와 무관하게 절대 못 이긴다.**
        그래서 문서엔 "모바일 5→2열" 이라 적혀 있었지만 실제로는 375px 에서도 5열이 나오고 있었다 %>
    .ba-proposers[data-expanded="true"] .ba-proposers-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .ba-bill-name {
    font-family: var(--ba-serif);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ba-ink);
    margin: 0 0 14px;
  }
  .ba-summary {
    font-family: var(--ba-serif);
    font-size: 44px;
    font-weight: 900;
    line-height: 1.15;
    color: var(--ba-ink);
    margin: 0 0 20px;
    padding-left: 18px;
    border-left: 4px solid var(--ba-gold);
    word-break: keep-all;
  }
  .ba-summary strong, .ba-summary em {
    /* 큰 헤드라인 안 강조는 언더라인 위치 보정 */
    text-underline-offset: 8px;
    text-decoration-thickness: 3px;
  }
  .ba-tagline {
    font-family: var(--ba-sans);
    font-size: 14px;
    color: var(--ba-meta);
    margin-bottom: 14px;
  }
  .ba-source-line {
    font-family: var(--ba-mono);
    font-size: 12px;
  }
  .ba-original-link {
    color: var(--ba-meta);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .ba-original-link:hover { color: var(--ba-gold); }

  /* ===== Zone 2: 핵심 변화 3카드 (8 / 4 / 4 비대칭) ===== */
  .ba-z2 .ba-cards {
    display: grid;
    grid-template-columns: 8fr 4fr 4fr;
    gap: 16px;
  }
  /* 태블릿~작은 노트북: 8fr/4fr/4fr 3열을 유지하면 소카드 내부가 121px 까지 좁아진다.
     16px 본문이 한 줄에 7글자밖에 안 들어가고 라벨 칩도 2줄로 깨진다 (820px 실측).
     → 큰 카드를 전체폭으로 내리고 소카드 둘을 반반으로. 내부 304px 확보 */
  @media (max-width: 1024px) and (min-width: 769px) {
    .ba-z2 .ba-cards { grid-template-columns: 1fr 1fr; }
    .ba-z2 .ba-card-changes { grid-column: 1 / -1; }
  }
  /* Zone 2 는 이 페이지에서 가장 중요한 정보인데 "눈에 안 들어온다" 는 지적이 있었다.
     원인: 세 카드가 **배경도 라벨색도 전부 같고** 차이가 좌측 4px 바 하나뿐이었다.
           라벨까지 셋 다 같은 회색이라 훑을 때 "혜택" 과 "손해" 가 구분되지 않았다.
     처방: ① 카드 표면을 서로 다르게(웜 / 순백 / 쿨그레이) ② 라벨을 색 채운 칩으로
           ③ 진입 애니메이션으로 시선 유도.
     ⚠️ 내용을 접지 않는다 — Zone 3 아코디언을 이미 폐기한 판단과 같은 이유다.
        가장 중요한 정보를 인터랙션 뒤에 숨기면 못 읽고 지나가는 손실이 몰입 이득보다 크다. */
  .ba-card {
    background: var(--ba-card-bg);
    border: 1px solid var(--ba-card-border);
    border-left: 4px solid transparent;
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  /* 표면을 웜 → 순백 → 쿨그레이 로 갈라 놓는다.
     정당색(파랑·빨강)을 못 쓰므로 **색상환이 아니라 온도와 명도**로 구분한다.
     밝기 순서(웜 tint → 흰색 → 회색)는 가치판단이 아니라 시선 유도용 위계다. */
  .ba-card-changes {
    border-left-color: var(--ba-gold);
    background: #FBF5EA;                 /* 골드 tint — 8fr 대형 카드, 가장 먼저 읽히는 자리 */
    border-color: #EFE3CC;
  }
  .ba-card-benefit {
    border-left-color: var(--ba-ink);
    background: #FFFFFF;                 /* 순백 — 페이지 배경(#F7F6F1)보다 밝아 도드라짐 */
    border-color: #E4E1D8;
  }
  .ba-card-loss {
    border-left-color: var(--ba-meta);
    background: #F0F1F3;                 /* 쿨 그레이 — 유일하게 차가운 면이라 즉시 갈림 */
    border-color: #DFE2E6;
  }
  .ba-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(15,27,31,0.07);
  }
  .ba-card-changes:hover { border-color: var(--ba-gold); }
  .ba-card-benefit:hover { border-color: var(--ba-ink); }
  .ba-card-loss:hover    { border-color: var(--ba-meta); }

  .ba-card-empty .ba-card-body { justify-content: center; }

  /* 라벨을 "메타데이터" 에서 "머리말" 로 승격 — 외곽선 칩.
     채움(흰 글자 + 색 배경)도 검토했으나, 차콜 칩이 흰 카드 위에서 혼자 시선을 독점하고
     페이지 톤(베이지 + 골드 단색)에서 과하게 튀어 외곽선으로 정리했다.
     표면 3색이 이미 구분을 하고 있어서 칩까지 채울 필요가 없다.
     대비(11px → AA 4.5 필요): 골드 5.43 / 차콜 17.55 / 그레이 4.56 — 전부 통과 */
  .ba-card-label {
    align-self: flex-start;
    font-family: var(--ba-mono);
    /* 11px 은 안 읽힌다는 판단으로 13px 로 상향 (2026-08-11).
       카드 본문이 18px(대) / 16px(소) 라 13px 이면 머리말로 읽히면서 본문을 밀어내지 않는다.
       ⚠️ 더 키울 거면 소카드 폭(1440 기준 4fr ≈ 212px, 패딩 제외 148px)에서
          최장 라벨 "혜택받는 사람" 이 한 줄에 들어가는지 먼저 확인할 것 */
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    background: transparent;
    text-transform: uppercase;
    padding: 5px 11px;
    border: 1px solid currentColor;
    border-radius: 6px;
    margin-bottom: 18px;
  }
  .ba-card-changes .ba-card-label { color: var(--ba-gold); }
  .ba-card-benefit .ba-card-label { color: var(--ba-ink); }
  .ba-card-loss    .ba-card-label { color: var(--ba-meta); }
  .ba-card-body {
    font-family: var(--ba-sans);
    font-size: 18px;
    font-weight: 450;
    line-height: 1.65;
    color: var(--ba-ink);
    flex: 1;
    display: flex;
    flex-direction: column;
    word-break: keep-all;
  }
  .ba-z2 .ba-card-loss .ba-card-body,
  .ba-z2 .ba-card-benefit .ba-card-body { font-size: 16px; }
  /* 진입 애니메이션 — Zone 2 가 화면에 들어올 때 3장이 순차로 올라온다.
     내용을 가리지 않으면서 "여기 봐라" 신호를 주는 장치.
     JS 가 .is-in 을 붙이기 전까지만 숨고, JS 가 없거나 실패하면 아래 no-js 폴백으로 그냥 보인다. */
  .ba-z2 .ba-cards[data-reveal] .ba-card {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .ba-z2 .ba-cards[data-reveal] .ba-card:nth-child(2) { transition-delay: 0.09s; }
  .ba-z2 .ba-cards[data-reveal] .ba-card:nth-child(3) { transition-delay: 0.18s; }
  .ba-z2 .ba-cards[data-reveal].is-in .ba-card {
    opacity: 1;
    transform: none;
  }
  /* 모션 최소화 설정 존중 — 이동 없이 즉시 표시 */
  @media (prefers-reduced-motion: reduce) {
    .ba-z2 .ba-cards[data-reveal] .ba-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .ba-card { transition: none; }
    .ba-card:hover { transform: none; }
  }

  .ba-card-sub {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--ba-card-border);
    font-size: 14px;
    color: var(--ba-sub);
    line-height: 1.6;
  }

  /* ===== Zone 3: 분석 (마진노트 + H3 + 본문) ===== */
  .ba-z3 .ba-issue {
    position: relative;
    padding: 28px 0;
    border-top: 1px solid var(--ba-card-border);
  }
  .ba-z3 .ba-issue:first-child { border-top: none; padding-top: 0; }
  /* Zone 3 라벨 — Zone 2 와 같은 외곽선 칩. 위치는 좌측 거터(마진노트) 그대로 유지한다.
     `left: -180px; width: 160px; text-align: right` 대신 `right: calc(100% + 24px)` 를 쓰는 이유:
     칩은 내용에 맞춰 줄어들어야 하는데 고정폭 + 우측정렬로는 테두리가 거터 전체를 감싼다.
     라벨이 `찬성 논리 / 반대 우려 / 법안 빈틈` **고정 3종에 전부 4글자**라
     (interactions.js `ISSUE_LABEL`) 칩 폭이 균일하게 떨어진다 — 마진에서 들쭉날쭉하지 않는다.

     ⚠️ 색은 세 개 모두 `--ba-meta` 로 **같아야 한다**. Zone 2 처럼 라벨별로 색을 주면 안 된다 —
        `바뀌는 것/혜택/손해` 는 서술이지만 `찬성/반대` 는 **입장**이라, 색을 다르게 주는 순간
        어느 쪽을 지지한다는 신호가 된다. */
  .ba-margin-note {
    position: absolute;
    right: calc(100% + 24px);
    /* `.ba-issue` 가 `padding: 28px 0` 이라 top:0 이면 칩이 제목보다 28px 위에 뜬다.
       평문일 땐 눈에 안 띄었지만 박스가 되니 앞 섹션에 붙은 것처럼 보였다.
       첫 항목만 padding-top:0 이라 아래에서 top:0 으로 되돌린다. */
    top: 28px;
    display: inline-block;
    white-space: nowrap;
    padding: 5px 11px;                 /* Zone 2 라벨 칩과 동일 */
    border: 1px solid currentColor;
    border-radius: 6px;
    font-family: var(--ba-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ba-meta);
    line-height: 1.6;
  }
  .ba-z3 .ba-issue:first-child .ba-margin-note { top: 0; }
  .ba-issue-title {
    font-family: var(--ba-serif);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ba-ink);
    margin: 0 0 16px;
    word-break: keep-all;
  }
  .ba-issue-body {
    font-family: var(--ba-sans);
    font-size: 18px;
    font-weight: 450;
    line-height: 1.75;
    color: var(--ba-ink);
    word-break: keep-all;
  }
  .ba-issue-body p + p { margin-top: 0.9em; }

  /* ===== Zone 5: 질문 ===== */
  .ba-z5 .ba-section-h {
    font-family: var(--ba-serif);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ba-ink);
    margin: 0 0 8px;
  }
  .ba-z5 .ba-section-hint {
    font-family: var(--ba-sans);
    font-size: 15px;
    color: var(--ba-sub);
    line-height: 1.6;
    margin: 0 0 28px;
  }
  .ba-questions {
    list-style: none;
    counter-reset: ba-q;
    margin: 0 0 32px;
    padding: 0;
  }
  .ba-questions li {
    counter-increment: ba-q;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--ba-card-border);
  }
  .ba-questions li:first-child { border-top: none; padding-top: 4px; }
  .ba-q-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--ba-gold);
    color: var(--ba-gold);
    font-family: var(--ba-mono);
    font-size: 12px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
  }
  .ba-q-num::before { content: counter(ba-q); }
  .ba-q-content { min-width: 0; }
  .ba-q-text {
    font-family: var(--ba-serif);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.55;
    color: var(--ba-ink);
    margin: 0;
    word-break: keep-all;
  }
  .ba-q-hint {
    font-family: var(--ba-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ba-meta);
    margin: 6px 0 0;
    line-height: 1.5;
  }

  .ba-cta { display: flex; gap: 10px; }
  .ba-cta-primary {
    flex: 1;
    padding: 14px 22px;
    background: var(--ba-ink);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-family: var(--ba-sans);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }
  .ba-cta-primary:hover { background: var(--ba-gold); }

  /* Zone 4 인덱스는 페이지 레벨 섹션 탭 바 `.bd-toc` 로 이동 (참여 섹션까지 포함) */

  /* ===== 반응형 ===== */
  @media (max-width: 1240px) {
    /* 우측 거터 회수 — 콘텐츠 가운데 정렬 */
    .ba-shell {
      grid-template-columns: minmax(0, 880px);
      padding: 0 24px;
    }
    .ba-content { grid-column: 1 / -1; }
    /* 마진노트 인라인으로 폴백 */
    /* 1240px 미만: 거터가 사라지므로 제목 위 인라인으로 폴백.
       칩 패딩/보더는 유지해야 데스크톱과 같은 형태로 보인다 (구 `padding-right: 0` 은 칩을 깨뜨림) */
    .ba-margin-note {
      position: static;
      right: auto;
      margin-bottom: 10px;
    }
  }
  @media (max-width: 768px) {
    .ba-shell { padding: 0 16px; }
    .ba-content { font-size: 16px; line-height: 1.7; }
    .ba-content > .ba-zone + .ba-zone { margin-top: 48px; }
    .ba-summary { font-size: 30px; padding-left: 14px; border-left-width: 3px; }
    .ba-bill-name { font-size: 19px; }
    .ba-z2 .ba-cards { grid-template-columns: 1fr; gap: 12px; }
    .ba-card { padding: 22px; border-radius: 12px; }
    .ba-card-body, .ba-z2 .ba-card-loss .ba-card-body, .ba-z2 .ba-card-benefit .ba-card-body { font-size: 16px; }
    .ba-issue-title { font-size: 20px; }
    .ba-issue-body { font-size: 16px; line-height: 1.7; }
    .ba-z5 .ba-section-h { font-size: 22px; }
    .ba-q-text { font-size: 16px; }
  }

  /* Zone 1 + basic header 공용 카드 스타일 (분석 없는 분기 — 그대로) */
  .analysis-zone-1,
  .bill-basic-header {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .bill-basic-header { margin-bottom: 20px; }

  /* ===== 법안 원문 (제안이유 및 주요내용) — 분석 없는 분기 =====
     5-Zone 분석의 --ba-* 토큰은 .bill-ai-analysis 스코프라 여기선 못 쓴다.
     같은 값을 이 섹션에 다시 선언해 톤을 맞춘다 (골드 강조 · 세리프 헤드라인 · 롱폼 본문). */
  .bill-raw-summary {
    --raw-ink:        #0F1B1F;
    --raw-meta:       #646E7E;   /* #6B7280 은 대비 4.47 로 AA 미달 */
    --raw-gold:       #8F5800;
    --raw-gold-hover: #6B4200;
    background: #FAFAF7;
    border: 1px solid #E8E5DC;
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 20px;
  }
  .raw-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid #E8E5DC;
  }
  .raw-h {
    font-family: 'Noto Serif KR', serif;
    font-weight: 700;
    font-size: 19px;
    color: var(--raw-ink);
    margin: 0;
  }
  /* 출처 명시 — AI 분석 라벨과 짝을 이룬다.
     위쪽에 "🤖 AI 분석 / 아직 분석되지 않은 법안입니다" 회색 라벨이 이미 떠 있으므로,
     바로 아래 이 본문이 AI 생성물로 오해되지 않도록 출처를 못박아 둔다.
     동시에 그 출처로 가는 링크를 겸한다 — 헤더에 따로 있던 `국회 원문 ↗` 버튼이
     같은 URL 이라 중복이었고, 출처 표기와 링크를 한 요소로 합치는 편이 자연스럽다. */
  .raw-src {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--raw-meta);
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  /* 링크일 때만 골드 — 이 사이트의 링크 색은 골드다 (`--accent` 계열).
     회색 + 연한 보더로 두면 메타데이터처럼 보여서 클릭 가능한 줄 모른다.
     ⚠️ 파란색은 쓰지 않는다: 정당색(파랑·빨강)은 중립성 브랜드 원칙상 금지. */
  a.raw-src {
    color: var(--raw-gold);
    font-weight: 500;
    border-bottom: 1px solid var(--raw-gold);
    padding-bottom: 1px;
  }
  a.raw-src:hover,
  a.raw-src:focus-visible {
    color: var(--raw-gold-hover);
    border-bottom-color: var(--raw-gold-hover);
    outline: none;
  }
  /* link_url 이 없을 때의 폴백은 클릭 불가라 회색 그대로 둔다 (골드면 링크로 오인된다) */
  .raw-body {
    /* 원문의 문단 구분(개행)을 그대로 살린다. 연속 공백은 접혀 들여쓰기 잡음이 사라진다. */
    white-space: pre-line;
    font-size: 16px;
    line-height: 1.85;
    color: var(--raw-ink);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  /* 긴 원문(최대 10,349자)은 접어둔다 — 중앙값 498자라 대부분은 접히지 않는다 */
  .raw-body.is-collapsed {
    max-height: 15em;
    overflow: hidden;
    /* 잘린 지점을 페이드로 알린다. 딱 잘리면 문장이 끝난 것처럼 보인다 */
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
  }
  .raw-toggle {
    margin-top: 12px;
    background: none;
    border: 0;
    padding: 4px 0;
    min-height: 44px;      /* 터치 타깃 (실측 25px 였음). 밑줄은 안쪽 span 이 아니라 이 요소라
                              세로 padding 대신 min-height 로 늘려야 밑줄이 안 뜬다 */
    display: inline-flex;
    align-items: flex-end;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--raw-gold);
    cursor: pointer;
    border-bottom: 1px solid currentColor;
  }
  .raw-toggle:hover { color: var(--accent2, #925C09); }

  /* ===== 대조 모드 (분석 있는 법안에서 5-Zone 아래에 붙는 변형) =====
     역할이 "본문 전달" 이 아니라 "검증" 이라, 톤을 한 단계 죽이고 항상 접어 둔다. */
  .bill-raw-summary.is-compare {
    /* 5-Zone 콘텐츠(.ba-content 880px)와 좌우를 맞춘다 — bd-wrap(960px) 그대로면 어긋나 보인다 */
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
    background: transparent;          /* 분석 카드들과 경쟁하지 않게 배경 제거 */
    border-style: dashed;             /* 참고자료라는 신호 */
  }
  .bill-raw-summary.is-compare .raw-h { font-size: 17px; }
  /* 대조 모드는 **완전 접힘**이다. 미분석 분기의 "15em 엿보기 + 페이드" 를 그대로 쓰면
     원문이 15em 보다 짧을 때(중앙값 498자 = 대부분) 접힘 높이 == 전체 높이가 되어
     버튼을 눌러도 아무 일도 안 일어나는 것처럼 보인다. 여긴 원문이 본문이 아니라
     펼쳐서 대조하는 참고자료라 accordion 이 의미상으로도 맞다. */
  .bill-raw-summary.is-compare .raw-body.is-collapsed {
    display: none;
    max-height: none;
    -webkit-mask-image: none;
            mask-image: none;
  }
  .bill-raw-summary.is-compare .raw-toggle { margin-top: 0; }
  .raw-note {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--raw-meta);
  }

  @media (max-width: 768px) {
    .bill-raw-summary { padding: 1.25rem 1.25rem; }
    .raw-body { font-size: 15px; line-height: 1.8; }
  }

  /* ===== 처리 경과 타임라인 (컴팩트) — 헤더/Zone 1 바로 아래 =====
     히어로 근처라 카드 배경 없이 한 줄 흐름으로. 결과는 마지막 단계에만.
     정당색 배제: 상태 구분은 **골드(완료) / 회색(미도달) / 점선+취소선(거치지 않음)** 으로만.
     가결·부결에 색을 주지 않는다 — 결과는 텍스트로만 말한다. */
  .bill-timeline {
    --tl-gold: #8F5800;
    --tl-meta: #646E7E;
    max-width: 880px;
    margin: 0 auto 24px;
    padding: 12px 0 0;
    border-top: 1px solid #E8E5DC;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 14px;
  }
  /* 스크린리더 전용 — 상태(완료/거치지 않음/진행 전)를 점 모양이 아니라 텍스트로도 전달한다.
     `title` 속성은 스크린리더가 일관되게 읽어주지 않는다 */
  .pb-sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .tl-cap {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #746C5D;          /* 대비 4.80 — 10px 이라 AA 필요 */
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .tl-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 0;
    min-width: 0;
  }
  .tl-step {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    padding-right: 12px;
    position: relative;
  }
  /* 단계 사이 화살표 — 진행 방향을 명시. 마지막 뒤에는 없음 */
  .tl-step::after {
    content: '›';
    margin-left: 12px;
    color: #C8C0AA;
    font-size: 13px;
  }
  .tl-step:last-child { padding-right: 0; }
  .tl-step:last-child::after { display: none; }
  .tl-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1.5px solid #C8C0AA;
    box-sizing: border-box;
    flex-shrink: 0;
    align-self: center;
  }
  .tl-step.is-done .tl-dot    { background: var(--tl-gold); border-color: var(--tl-gold); }
  .tl-step.is-skipped .tl-dot { border-style: dotted; }
  .tl-label {
    font-size: 13px;
    font-weight: 600;
    color: #0F1B1F;
    /* keep-all 은 한글 단어를 안 쪼개 읽기엔 좋지만, 공백 없는 긴 문자열을 통째 한 덩어리로 만든다.
       마지막 단계 라벨은 DB 의 proc_result_name(varchar 50)이 그대로 들어오므로
       예상 밖의 긴 값이 오면 페이지가 가로로 밀린다 (50자 주입 시 103px 오버플로 실측).
       overflow-wrap: anywhere 는 **다른 줄바꿈 기회가 없을 때만** 강제로 쪼개므로
       평소 한글 가독성은 그대로 두고 최악만 막는다. */
    word-break: keep-all;
    overflow-wrap: anywhere;
    min-width: 0;
  }
  /* 거치지 않은 단계는 취소선으로 "아직 안 온 것"과 구분한다 (점선 점만으로는 안 갈림) */
  .tl-step.is-skipped .tl-label {
    color: var(--tl-meta);
    font-weight: 500;
    text-decoration: line-through;
    text-decoration-color: #C8C0AA;
  }
  .tl-step.is-pending .tl-label { color: var(--tl-meta); font-weight: 500; }
  .tl-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--tl-gold);
  }
  /* 최종 결과 — 마지막 단계에만 붙는다 */
  .tl-result {
    font-size: 12px;
    font-weight: 700;
    color: #0F1B1F;
    word-break: keep-all;
    overflow-wrap: anywhere;   /* .tl-label 과 같은 이유 — 같은 DB 값이 들어온다 */
    min-width: 0;
  }
  /* 스텝 자체도 줄어들 수 있어야 내부 라벨의 줄바꿈이 실제로 발동한다
     (inline-flex 기본 min-width:auto 면 콘텐츠 크기 아래로 안 줄어든다) */
  .tl-step { min-width: 0; }
  @media (max-width: 768px) {
    .bill-timeline { gap: 6px 10px; }
    .tl-step { padding-right: 8px; }
    .tl-step::after { margin-left: 8px; }
    .tl-label { font-size: 12.5px; }
    .tl-date  { font-size: 11.5px; }
  }

  /* 메타 + 국회 원문 링크를 한 줄에 배치 */
  .zone-1-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
  }
  .zone-1-top .meta-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .zone-1-top .original-link {
    flex-shrink: 0;
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub);
    text-decoration: none;
    padding: 4px 10px;
    border: 0.5px solid var(--border);
    border-radius: 6px;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .zone-1-top .original-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-wash, #FAF6EB);
  }

  /* 메타 2줄 구조 (Zone 1 + basic header 공용) */
  .analysis-hook-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    line-height: 1.6;
  }
  .analysis-hook-meta + .analysis-hook-meta { margin-top: 0; }
  .analysis-hook-meta .sep { color: var(--border2); }
  .analysis-hook-meta a { color: var(--accent); }
  .analysis-hook-meta-block { margin-bottom: 12px; }

  .analysis-hook-title {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
    margin: 0 0 12px;
    word-break: keep-all;
  }
  .analysis-hook-summary {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 900;
    color: var(--text);
    line-height: 1.4;
    margin: 0 0 18px;
    padding: 14px 18px;
    background: var(--accent-wash, #FAF6EB);
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    word-break: keep-all;
  }
  .analysis-hook-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .analysis-hook-tags .hook-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 11px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--sub);
  }
  .analysis-hook-tags .hook-tag.tag-accent {
    background: var(--accent-10);
    border-color: var(--accent-20);
    color: var(--accent2);
  }

  /* Zone 2: 한눈에 보기 */
  .analysis-zone-2 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    position: relative;
  }
  .analysis-card {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-left: 3px solid var(--border2);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
  }
  /* 카드별 좌측보더 색 구분 — 정치색 피해서 회색·초록·주황 */
  .analysis-zone-2 .analysis-card:nth-child(1) {
    border-left-color: var(--sub2);
  }
  .analysis-zone-2 .analysis-card:nth-child(2) {
    border-left-color: var(--green);
  }
  .analysis-zone-2 .analysis-card:nth-child(2) .analysis-card-label .card-emoji {
    color: var(--green);
  }
  .analysis-zone-2 .analysis-card:nth-child(3) {
    border-left-color: #C2410C;
  }
  .analysis-zone-2 .analysis-card:nth-child(3) .analysis-card-label .card-emoji {
    color: #C2410C;
  }
  .analysis-card-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sub2);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .analysis-card-label .card-emoji { font-size: 14px; }
  .analysis-card-body {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--text);
    word-break: keep-all;
  }
  .analysis-card-body strong { font-weight: 700; }
  .analysis-card-sub {
    margin-top: 8px;
    font-size: 13px;
    color: var(--sub);
    line-height: 1.55;
  }
  .analysis-zone-2-progress {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    padding: 0 4px;
  }
  .analysis-zone-2-progress .progress-track {
    flex: 1;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .analysis-zone-2-progress .progress-fill {
    width: 30%;
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
  }

  /* Zone 3: 쟁점 */
  .analysis-zone-3 {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .analysis-zone-3-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sub);
    margin-bottom: 16px;
  }
  .issue-item {
    border-top: 1px solid var(--border);
    padding: 14px 0;
  }
  .issue-item:first-of-type { border-top: none; padding-top: 4px; }
  .issue-item:last-of-type { padding-bottom: 4px; }
  .issue-head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }
  .issue-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.02em;
    margin-top: 2px;
  }
  .issue-badge-pro { background: rgba(59,130,246,0.10); color: #2563EB; }
  .issue-badge-con { background: rgba(234,88,12,0.10);  color: #C2410C; }
  .issue-badge-gap { background: var(--bg3);            color: var(--sub); }
  .issue-title {
    flex: 1;
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    word-break: keep-all;
  }
  .issue-toggle {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--sub2);
    font-family: 'JetBrains Mono', monospace;
    margin-top: 4px;
  }
  .issue-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease, margin 0.25s ease;
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.75;
    color: var(--text);
    word-break: keep-all;
  }
  .issue-body strong { color: var(--text); font-weight: 700; }
  .issue-item.expanded .issue-body {
    max-height: 1200px;
    margin-top: 12px;
    margin-left: 24px;
  }
  .analysis-zone-3-progress {
    margin-top: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
  }
  .analysis-zone-3-progress .progress-track {
    flex: 1; height: 3px; background: var(--border); border-radius: 2px; overflow: hidden;
  }
  .analysis-zone-3-progress .progress-fill {
    width: 70%; height: 100%; background: var(--accent); border-radius: 2px;
  }

  /* Zone 4: 판단 질문 */
  .analysis-zone-4 {
    background: var(--accent-wash);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .analysis-zone-4-title {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
  }
  .analysis-zone-4-hint {
    font-size: 13px;
    color: var(--sub);
    margin-bottom: 16px;
    line-height: 1.55;
  }
  .judgment-list {
    list-style: none;
    counter-reset: judgment;
    margin: 0 0 20px;
    padding: 0;
  }
  .judgment-list li {
    counter-increment: judgment;
    position: relative;
    padding: 12px 0 12px 34px;
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--text);
    border-top: 1px solid rgba(184,116,12,0.15);
    word-break: keep-all;
  }
  .judgment-list li:first-child { border-top: none; }
  .judgment-list li::before {
    content: counter(judgment);
    position: absolute;
    left: 0; top: 12px;
    width: 22px; height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    background: var(--accent);
    color: #fff;
    border-radius: 50%;
  }
  .judgment-hint {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    color: var(--sub2);
    font-family: 'Noto Sans KR', sans-serif;
  }
  .analysis-cta {
    display: flex;
    gap: 10px;
  }
  .analysis-cta button {
    flex: 1;
    padding: 12px 18px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    font-family: inherit;
  }
  .analysis-cta .cta-secondary {
    background: var(--bg2);
    border-color: var(--border2);
    color: var(--text);
  }
  .analysis-cta .cta-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .analysis-cta .cta-primary {
    background: var(--accent);
    color: #fff;
  }
  .analysis-cta .cta-primary:hover { background: var(--accent2); }

  /* 모바일 */
  @media (max-width: 768px) {
    .analysis-hook-summary { font-size: 22px; }
    .analysis-hook-title { font-size: 19px; }
    .analysis-zone-2 { grid-template-columns: 1fr; }
    .analysis-cta { flex-direction: column; }
    .analysis-zone-1,
    .analysis-zone-3,
    .analysis-zone-4,
    .bill-basic-header { padding: 1.25rem 1.25rem; }
    .issue-item.expanded .issue-body { margin-left: 0; }
    .zone-1-top { gap: 8px; }
    .zone-1-top .original-link { font-size: 11px; padding: 3px 8px; }

    .analysis-request-section { padding: 20px 16px; }
    .request-count-display { font-size: 24px; }
  }

  /* =================================================================
     Zone 6~11 — 참여 섹션 디자인 시스템 통합
     ba-* 토큰 (5-Zone) 그대로 재사용
     ================================================================= */

  /* ===== Zone 7: 챕터 디바이더 ===== */
  .ba-chapter {
    margin: 120px -40px 48px;
    padding-top: 32px;
    border-top: 1px solid #E8E5DC;
    text-align: center;
  }
  .ba-chapter-h {
    font-family: 'Noto Serif KR', serif;
    font-weight: 900;
    font-size: 36px;
    line-height: 1.25;
    color: #0F1B1F;
    margin: 0 0 12px;
    word-break: keep-all;
  }
  .ba-chapter-sub {
    font-family: 'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
    font-size: 15px;
    color: #6B7280;
    line-height: 1.7;
    margin: 0;
    word-break: keep-all;
  }
  @media (max-width: 768px) {
    .ba-chapter { margin: 64px -16px 32px; padding-top: 24px; }
    .ba-chapter-h { font-size: 26px; }
    .ba-chapter-sub { font-size: 14px; }
  }

  /* ===== 공용 .pb-part 컨테이너 (Zone 8~11) ===== */
  .pb-part {
    background: #FAFAF7;
    border: 1px solid #E8E5DC;
    border-radius: 16px;
    padding: 32px;
    margin-bottom: 16px;
    font-family: 'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
  }
  .pb-part-head { margin-bottom: 20px; }
  .pb-part-h {
    font-family: 'Noto Serif KR', serif;
    font-weight: 700;
    font-size: 22px;
    color: #0F1B1F;
    margin: 0 0 6px;
    line-height: 1.4;
  }
  .pb-part-h-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 400;
    color: #8B8578;
    margin-left: 6px;
  }
  .pb-part-sub {
    font-size: 13px;
    color: #6B7280;
    line-height: 1.6;
    margin: 0;
  }
  .pb-part-foot {
    margin-top: 14px;
    font-size: 12px;
    color: #8B8578;
    text-align: center;
  }
  .pb-part-empty {
    padding: 40px 24px;
    text-align: center;
    color: #9B9486;
    font-style: italic;
    font-size: 14px;
  }

  /* ===== Zone 8: 국민 찬반 (cv-* 오버라이드 — 차콜 + 골드) ===== */
  .pb-part .cv-bar {
    height: 12px;
    border-radius: 6px;
    background: #EFEDE4;
    border: none;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .pb-part .cv-seg {
    color: transparent;     /* 막대 안 % 텍스트 제거, 범례에서 표시 */
    font-size: 0;
    height: 12px;
  }
  .pb-part .cv-agree    { background: #0F1B1F; }   /* 차콜 */
  .pb-part .cv-disagree { background: #8F5800; }   /* 골드 */
  .pb-part .cv-legend {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
    font-size: 13px;
    color: #374151;
  }
  .pb-part .cv-legend-item { gap: 6px; }
  .pb-part .cv-legend-item strong { color: #0F1B1F; font-weight: 700; }
  .pb-part .cv-dot { width: 8px; height: 8px; }
  .pb-part .cv-dot-agree    { background: #0F1B1F; }
  .pb-part .cv-dot-disagree { background: #8F5800; }
  .pb-part .cv-total { color: #8B8578; }
  .pb-part .cv-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .pb-part .cv-btn {
    flex: 1;
    min-width: 140px;
    padding: 12px 18px;
    background: #FFFFFF;
    border: 1px solid #D9D3C3;
    border-radius: 10px;
    color: #0F1B1F;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    justify-content: center;
  }
  .pb-part .cv-btn:hover { border-color: #8F5800; }
  .pb-part .cv-btn-agree.active,
  .pb-part .cv-btn-disagree.active {
    background: #0F1B1F;
    border-color: #0F1B1F;
    color: #FFFFFF;
    font-weight: 700;
  }
  .pb-part .cv-my-hint {
    width: 100%;
    margin: 8px 0 0;
    font-size: 12px;
    color: #8B8578;
    text-align: center;
  }

  /* ===== Zone 9: 본회의 표결 — 기존 vote-dashboard 유지, 카드 안에서 톤만 통일 ===== */
  .pb-part .vote-dashboard { gap: 12px; margin-bottom: 0; }
  .pb-part .vote-box {
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 10px;
  }
  .pb-part .vote-box:not([data-empty]):hover { border-color: #8F5800; }

  /* ===== Zone 10: 발의자 5열 그리드 ===== */
  .pb-proposers-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }
  .pb-proposer-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 10px;
    text-decoration: none;
    color: #0F1B1F;
    transition: border-color 0.15s, transform 0.15s;
    min-width: 0;
  }
  .pb-proposer-card:hover { border-color: #8F5800; transform: translateY(-1px); }
  .pb-proposer-card.is-rep { border: 1.5px solid #8F5800; }   /* 대표만 골드 외곽선 = 대표 표시 */
  .pb-proposer-card.is-retired {
    color: #9B9486;
    font-style: italic;
    cursor: default;
    background: #F3F1EA;
    border-color: #E8E5DC;
  }
  .pb-pp-avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: #F3F1EA;
  }
  .pb-pp-avatar img, .pb-pp-avatar svg { width: 100%; height: 100%; display: block; }
  .pb-pp-meta { min-width: 0; flex: 1; }
  .pb-pp-name {
    font-size: 13px;
    font-weight: 600;
    color: #0F1B1F;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }
  .pb-pp-party {
    font-size: 11px;
    color: #8B8578;
    line-height: 1.4;
  }
  .pb-proposer-card.is-retired .pb-pp-name,
  .pb-proposer-card.is-retired .pb-pp-party { color: #9B9486; }

  @media (max-width: 1024px) {
    .pb-proposers-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .pb-proposers-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ===== Zone 11: 댓글 — 알약 토글 → 텍스트 underline + 카드 흰배경 ===== */
  .pb-part .comment-write {
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 10px;
  }
  .pb-part .write-input::placeholder,
  .pb-part input::placeholder { color: #9B9486; }
  .pb-part .comment-sort { color: #8B8578; font-size: 13px; }
  .pb-part .sort-btn {
    padding: 0;
    background: transparent;
    border: none;
    color: #8B8578;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s;
  }
  .pb-part .sort-btn:hover { color: #0F1B1F; background: transparent; }
  .pb-part .sort-btn.active {
    color: #0F1B1F;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    background: transparent;
  }
  .pb-part .sort-count { color: #8B8578; font-family: 'JetBrains Mono', monospace; }
  .pb-part .comment-card {
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 10px;
    padding: 16px;
    box-shadow: none;
  }
  .pb-part .comment-card:hover { border-color: #D9D3C3; }
  .pb-part .comment-replies .comment-card { background: #FAFAF7; }
  .pb-part .comment-nickname { color: #0F1B1F; font-weight: 700; font-size: 14px; }
  .pb-part .comment-date { color: #8B8578; font-size: 12px; }
  .pb-part .comment-body { color: #0F1B1F; font-size: 14px; line-height: 1.7; }
  .pb-part .comment-action { color: #8B8578; }
  .pb-part .comment-action:hover { color: #0F1B1F; background: #F3F1EA; }
  .pb-part .comment-action.liked { color: #8F5800; background: rgba(143,88,0,0.08); }
  .pb-part .comment-action.liked strong { color: #8F5800; }
  .pb-part .comments-empty {
    background: transparent;
    color: #9B9486;
    font-style: italic;
    border: 1px dashed #E8E5DC;
  }

  /* ===== Zone 6: 우측 sticky 인덱스 (페이지 레벨, 데스크톱 ≥1260px) =====
     위치: 5-Zone `.ba-shell` 의 우측 거터 자리. 콘텐츠(.ba-content, max 880 중앙정렬)의
     우측 끝은 `50% + 440px` 이므로 그 바깥인 `50% + 448px` 에 둔다.

     ⚠️ 예전엔 `min(calc(50% + 480px), calc(100% - 232px))` 였는데,
        화면이 1424px 미만이면 두 번째 항이 이겨서 인덱스가 안쪽으로 당겨지고
        **콘텐츠를 덮었다.** 배경이 투명이라 글자끼리 겹쳤고, z-index:40 이라
        발의자 "전체 보기 ▾" 토글이 아예 클릭되지 않았다 (1280·1300px 실측 확인).
        1280px 는 가장 흔한 노트북 폭이라 그냥 둘 수 없었다.

        클램프를 없애고 항상 콘텐츠 바깥에 두되, 화면 밖으로 나가는 폭에서는
        아예 숨긴다(아래 미디어쿼리). "겹치더라도 보여준다" 보다 "안 되면 숨긴다" 가 맞다 —
        (2026-08-24 부로 세로 레일 자체가 사라지고 가로 탭 바 `.bd-toc` 로 대체됐다.)

     폭 계산: left(50%+448) + width(180) ≤ 100% → 화면 ≥ 1256px. 안전하게 1260 을 컷으로 잡음
              (1280px 실측: 인덱스 좌측 1088 vs 콘텐츠 우측 1071 → 17px 여유) */
  /* ===== 섹션 탭 바 `.bd-toc` (2026-08-24) =====
     🔴 사이트의 주 sticky 메뉴와 **같은 형태**다 — `/bill`·`/politician` 의 밑줄 탭,
        `/issue/:slug` 의 `.iss-toc` 와 같은 값(padding 14px 22px · 14px/500 · 활성 border-bottom 2px 골드).
        구 버전은 이 페이지만 **우측 세로 레일 + 모바일 플로팅 바** 두 벌을 썼다.
        되돌리지 말 것 — 한 사이트에 내비게이션 형태가 셋이 되어 있었다 (사용자 지적).
     🔴 **띠는 화면 전체 폭이다.** Zone 3 마진노트(`.ba-margin-note`)가 본문 왼쪽 바깥에 있어
        (실측 1440px 에서 150~251px, 본문은 275px 부터) 띠를 본문 폭으로 좁히면
        스크롤할 때 그 칩이 띠 옆으로 삐져나간다. `.ba-shell` 자체가 화면 전체 폭이라 자연스럽다.
     🔴 **그래서 `.bd-wrap` 바깥의 형제로 둔다. `100vw` 로 breakout 하지 말 것** —
        `100vw` 는 스크롤바를 포함해서 **문서에 가로 오버플로가 생긴다** (실측 5px).
        형제로 두면 `width: auto` 가 곧 클라이언트 폭이라 계산도 오버플로도 없다.
     ⚠️ 탭 줄은 `.bd-wrap` 과 같은 960px·24px 라 breadcrumb·참여 카드와 좌측 기준선을 공유한다.
        넘치면 가로 스크롤 (사이트의 다른 탭 바와 같은 처리). */
  /* breadcrumb 줄 — 고정 nav 여백을 여기서 가져간다 (구 `.bd-wrap` 의 padding-top 역할) */
  .bd-top { padding: calc(var(--nav-h) + 28px) 0 14px; }
  .bd-top-inner { max-width: 960px; margin: 0 auto; padding: 0 24px; }
  /* 🔴 **흰 배경·보더는 바깥이 아니라 가운데 정렬된 `-inner` 에 준다** (사이트 공통 규칙).
     바깥에 주면 흰 띠가 화면 끝까지 뻗어 본문과 따로 논다 — `/issue` 에서 같은 실수를 한 번 했다.
     🔴 **다만 바깥은 투명이 아니라 `--bg`(페이지 배경) 로 채운다.** 이 페이지에만 있는 사정이다:
        Zone 3 마진노트(`.ba-margin-note`)가 본문 왼쪽 **바깥**(1440px 실측 150~251px · 본문은 275px)에
        있어서, 바깥이 투명이면 스크롤할 때 그 칩이 흰 띠 옆으로 지나간다.
        `--bg` 로 채우면 **눈에는 페이지 배경 그대로**라 띠처럼 안 보이면서 가려주기만 한다.
        (`/bill`·`/politician`·`/issue` 는 콘텐츠가 전부 띠 안에 들어와 투명으로 충분하다) */
  .bd-toc {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    background: var(--bg);
    font-family: 'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
  }
  .bd-toc-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .bd-toc-inner::-webkit-scrollbar { display: none; }
  /* ⚠️ 활성색은 `--accent`(흰 배경 3.79 미달) 가 아니라 `--text` 다. 골드는 밑줄이 맡는다 */
  .bd-toc-tab {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--sub);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s;
  }
  .bd-toc-tab:hover { color: var(--text); }
  .bd-toc-tab.is-active { color: var(--text); border-bottom-color: var(--accent); }
  .bd-toc-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #746C5D;
    font-weight: 400;
  }
  /* ⚠️ 모바일에서도 `.bd-wrap` 은 좌우 24px 를 유지하므로 탭 줄도 24px 그대로 둔다 —
     여기만 16px 로 내리면 탭이 본문보다 8px 왼쪽으로 밀린다 */
  @media (max-width: 768px) {
    .bd-top { padding: calc(var(--nav-h) + 20px) 0 10px; }
  }

  /* ===== Zone 8/9 카드 모바일 padding 완화 ===== */
  @media (max-width: 768px) {
    .pb-part { padding: 22px 18px; border-radius: 12px; }
    .pb-part-h { font-size: 19px; }
  }

  /* 분석 요청 위젯 */
  .analysis-request-section {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    margin: 20px 0;
  }
  .request-header h2 {
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 6px;
  }
  .request-header p {
    color: var(--sub);
    font-size: 13px;
    margin: 0 0 18px;
  }
  .request-header strong { color: var(--accent); }
  .request-count-display {
    font-family: 'Noto Serif KR', serif;
    font-size: 32px;
    font-weight: 900;
    color: var(--accent);
    text-align: center;
    margin-bottom: 12px;
    line-height: 1.1;
  }
  .request-count-display .count-separator,
  .request-count-display .count-target {
    color: var(--sub);
    font-weight: 400;
  }
  .request-progress-bar {
    height: 8px;
    background: var(--bg3);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .request-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), #D4A442);
    transition: width 0.4s;
  }
  .threshold-reached {
    background: rgba(15,157,110,0.10);
    color: var(--green);
    border: 1px solid var(--green);
    border-radius: 8px;
    padding: 10px 14px;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .request-action { text-align: center; }
  .btn-request,
  .btn-request-done {
    display: inline-block;
    padding: 12px 28px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s;
    text-decoration: none;
  }
  .btn-request {
    background: var(--accent);
    color: #fff;
  }
  .btn-request:hover { opacity: 0.9; }
  .btn-request-done {
    background: var(--bg3);
    color: var(--accent);
    border: 1px solid var(--accent);
    cursor: default;
  }
</style>

<% const proposeDtFmt = (bill.propose_dt || '').replace(/-/g, '.') || '—'; %>

<%
  // ===== 처리 경과 타임라인 데이터 (헤더/Zone 1 아래에 붙는다, 파샬은 _bill_timeline.ejs) =====
  // ⚠️ 마지막 단계를 무조건 "본회의" 로 쓰면 안 된다.
  //    API 의 PROC_DT/PROC_RESULT 는 "최종 처리" 지 본회의 의결이 아니다.
  //    가결·부결·대안반영폐기는 본회의에서 확정되지만, **철회(161건)는 발의자가 거두는 것**이라
  //    본회의를 거치지 않는다. 그대로 두면 "본회의 / 철회" 라는 사실과 다른 표시가 된다.
  const FLOOR_RESULTS = ['원안가결', '수정가결', '부결', '대안반영폐기', '수정안반영폐기'];
  const tlLastLabel = FLOOR_RESULTS.includes(bill.proc_result_name)
    ? '본회의'
    : (bill.proc_result_name || '본회의');

  const tlSteps = [
    { label: '발의',        date: bill.propose_dt },
    { label: '소관위 회부', date: bill.committee_dt },
    { label: '위원회',      date: bill.cmt_proc_dt, result: bill.cmt_proc_result },
    { label: '법사위',      date: bill.law_proc_dt, result: bill.law_proc_result },
    { label: tlLastLabel,   date: bill.proc_dt,     result: bill.proc_result_name },
  ];
  // 뒤에 날짜가 있는 빈 단계 = 거치지 않음 / 뒤에도 없으면 = 아직 도달 전
  let tlLastDone = -1;
  tlSteps.forEach((s, i) => { if (s.date) tlLastDone = i; });
  tlSteps.forEach((s, i) => {
    s.state = s.date ? 'done' : (i < tlLastDone ? 'skipped' : 'pending');
  });
  // 압축형이라 결과는 **마지막 완료 단계에만** 남긴다 (중간 단계 결과까지 넣으면 한 줄이 무너진다).
  // 라벨과 같은 값이면(철회 등) 중복이라 뺀다.
  tlSteps.forEach((s, i) => { if (i !== tlLastDone || s.result === s.label) s.result = null; });
  const tlHasAny = tlLastDone >= 0;

  // 원문 첫 줄은 99.8%가 "제안이유 및 주요내용" 머리말 — 섹션 제목이 이미 그 역할을 하므로 제거
  const rawSummary = stripSummaryHeading(bill.summary);
  // 접기 기준이 두 분기에서 다르다:
  //   미분석 → 원문이 본문 역할. 길 때만 접는다 (중앙값 498자라 대부분 안 접힘)
  //   분석 있음 → 원문이 "대조용 참고자료". 길이와 무관하게 항상 접는다
  const RAW_COLLAPSE_LEN = 700;
  const rawNeedsCollapse = analysis ? Boolean(rawSummary) : rawSummary.length > RAW_COLLAPSE_LEN;

  /* 발의자 스택 입력 — 두 분기가 같은 데이터를 쓴다.
     미분석 분기는 헤더에서 바로 include, 분석 분기는 숨은 홀더에 SSR 해두고
     mountBillAnalysis 가 Zone 1 으로 옮긴다. 아래 window.__BILL_PROPOSERS__ 도 같은 배열 */
  /* ⚠️ 섹션 탭 바가 이 값을 쓰므로 여기서 계산한다 (바가 본회의 표결 섹션보다 위에 있다) */
  const hasVotes = voteCounts.agree + voteCounts.disagree + voteCounts.abstain + voteCounts.absent > 0;

  const proposerStackData = (coProposers || []).map(cp => ({
    mona_cd:    cp.mona_cd || null,
    name:       cp.name    || null,
    party_name: cp.party_name || null,
    photo:      cp.photo_url  || null,
    is_rep:     Boolean(cp.proposer_yn)
  }));
%>

<%# breadcrumb 는 탭 바 **위**다 — 탭 바가 sticky 라 아래에 두면 스크롤 시 바 밑에 깔린다 %>
<div class="bd-top">
  <div class="bd-top-inner">
    <div class="bd-breadcrumb"><a href="/">홈</a> / <a href="/bill">법안</a> / <%= bill.bill_no || bill.bill_id %></div>
  </div>
</div>

<%# ── 섹션 탭 바 (2026-08-24) ──
    🔴 사이트의 주 sticky 메뉴와 **같은 형태**다 (`/bill`·`/politician` 의 밑줄 탭).
       구 버전은 이 페이지만 **우측 세로 레일(.pb-section-index) + 모바일 플로팅 바(.pb-mobile-jumpbar)**
       두 벌을 썼다. 한 사이트에 내비게이션 형태가 셋이 되어 있었다 (사용자 지적).
    🔴 **`.bd-wrap` 바깥의 형제다.** 띠가 화면 전체 폭이어야 하는데(Zone 3 마진노트가 본문 왼쪽
       바깥에 있어 좁히면 스크롤할 때 삐져나간다) `100vw` 로 breakout 하면 스크롤바 폭만큼
       **문서에 가로 오버플로가 생긴다.** 형제로 두면 `width: auto` 가 곧 클라이언트 폭이다.
    🔴 breadcrumb(`.bd-top`)이 바 **위**다 — 아래에 두면 sticky 바 밑에 깔린다.
    ⚠️ 탭 순서는 마크업이 아니라 **JS 가 실제 DOM 위치로 다시 정렬**한다
       (`#bill-timeline` 이 분석 분기에서 Zone 1 뒤로 옮겨지기 때문) ── %>
<nav class="bd-toc" id="bd-toc" aria-label="섹션 이동">
  <div class="bd-toc-inner">
    <% if (analysis) { %>
      <a class="bd-toc-tab" href="#ba-summary"   data-idx="ba-summary">요약</a>
      <a class="bd-toc-tab" href="#ba-changes"   data-idx="ba-changes">핵심 변화</a>
      <% if (analysis.issues && analysis.issues.length) { %>
        <a class="bd-toc-tab" href="#ba-analysis" data-idx="ba-analysis">분석</a>
      <% } %>
      <% if (analysis.judgment_questions && analysis.judgment_questions.length) { %>
        <a class="bd-toc-tab" href="#ba-questions" data-idx="ba-questions">함께 생각</a>
      <% } %>
      <% if (bill.summary) { %>
        <a class="bd-toc-tab" href="#bill-summary-raw" data-idx="bill-summary-raw">원문</a>
      <% } %>
    <% } else if (bill.summary) { %>
      <a class="bd-toc-tab" href="#bill-summary-raw" data-idx="bill-summary-raw">제안이유</a>
    <% } %>
    <% if (tlHasAny) { %>
      <a class="bd-toc-tab" href="#bill-timeline" data-idx="bill-timeline">처리 경과</a>
    <% } %>
    <a class="bd-toc-tab" href="#citizen-vote-section" data-idx="citizen-vote-section">
      국민 찬반 <span class="bd-toc-badge" data-count-citizen>—</span>
    </a>
    <a class="bd-toc-tab" href="#part-floor-vote" data-idx="part-floor-vote">
      본회의 표결 <span class="bd-toc-badge"><%= hasVotes ? nf(voteCounts.agree + voteCounts.disagree + voteCounts.abstain + voteCounts.absent) : '—' %></span>
    </a>
    <a class="bd-toc-tab" href="#part-comments" data-idx="part-comments">
      의견 <span class="bd-toc-badge" data-count-comments>—</span>
    </a>
    <a class="bd-toc-tab" href="#bill-caveat" data-idx="bill-caveat">한계</a>
  </div>
</nav>

<div class="bd-wrap">
  <!-- AI 분석 라벨 — 분석 있음/없음 두 분기 공통 명시 -->
  <div class="ai-analysis-label <%= analysis ? 'is-done' : 'is-pending' %>">
    <span class="label-tag">🤖 AI 분석</span>
    <% if (analysis) { %>
      <span class="label-note">AI가 생성한 분석으로 사실과 다를 수 있습니다</span>
      <% if (analysis.prompt_version) { %>
        <span class="label-meta"><%= analysis.prompt_version %></span>
      <% } %>
    <% } else { %>
      <span class="label-note">아직 분석되지 않은 법안입니다</span>
    <% } %>
  </div>

  <!-- AI 분석 (5-Zone) — 분석 있으면 Zone 1이 히어로, 없으면 기본 헤더 -->
  <% if (analysis) { %>
    <section class="bill-ai-analysis" id="bill-analysis"></section>
    <%# 발의자 스택을 여기 SSR 해두고 mountBillAnalysis 가 Zone 1 안으로 가져다 쓴다.
        마크업을 JS 에 다시 두지 않기 위한 홀더다 — 미분석 분기와 **같은 파샬**을 쓴다.
        hidden 이라 화면엔 안 나오고, JS 가 읽어간 뒤엔 비워진다. %>
    <div id="proposer-stack-src" hidden><%- include('_proposer_stack', { proposers: proposerStackData }) %></div>
    <%# Zone 1~5 는 JS 가 렌더하므로 EJS 에서 Zone 1 과 Zone 2 사이에 끼어들 수 없다.
        여기 두고 mount 직후 JS 가 `.ba-z1` 뒤로 옮긴다.
        JS 가 실패하면 이 자리에 그대로 남는다 — 위치만 덜 이상적일 뿐 정보는 보인다. %>
    <% if (tlHasAny) { %><%- include('_bill_timeline', { steps: tlSteps }) %><% } %>

    <!-- ============ 원문 대조 (분석 있는 법안) ============
         분석 상단에 "AI가 생성한 분석으로 사실과 다를 수 있습니다" 라고 써놓고
         정작 대조할 원문은 사이트를 나가야 볼 수 있었다. 같은 페이지에 두면 검증이 클릭 한 번이다.
         기본 접힘이라 안 펼치는 사람에겐 비용 0, 의심하는 사람에겐 가치가 크다 — 비대칭이 유리한 쪽.

         ⚠️ 이건 **AI 가 읽은 그 문서가 아니다**. AI 분석은 pal.assembly.go.kr 입법예고 페이지를
            크롤하고(syncBillAiAnalysis.js), 이건 열린국회 API BPMBILLSUMMARY 다.
            둘 다 국회가 낸 "제안이유 및 주요내용" 이지만 동일 문서 보장은 없으므로
            "AI 가 읽은 원문" 같은 표현을 쓰면 안 된다. 대조용 참고자료로만 제시한다. -->
    <% if (rawSummary) { %>
      <section class="bill-raw-summary is-compare" id="bill-summary-raw">
        <div class="raw-head">
          <h2 class="raw-h">국회 원문과 대조하기</h2>
          <a class="raw-src" href="<%= bill.link_url %>" target="_blank" rel="noopener">국회 의안정보 원문 ↗</a>
        </div>
        <p class="raw-note">위 분석이 원문과 맞는지 직접 확인해 보세요. 국회가 공표한 제안이유 및 주요내용입니다.</p>
        <div class="raw-body is-collapsed" id="raw-summary-body"><%= rawSummary %></div>
        <button type="button" class="raw-toggle" id="raw-summary-toggle"
                aria-expanded="false" aria-controls="raw-summary-body"
                data-label-collapsed="원문 펼치기 ▾" data-label-expanded="접기 ▴">원문 펼치기 ▾</button>
      </section>
    <% } %>
  <% } else { %>
    <%# 🔴 분석 있는 분기의 Zone 1 과 **같은 구성**이다 (메타 2줄 → 발의자 스택 → 법안명).
        예전엔 발의자가 "대표발의 X · 공동발의 N인" 텍스트뿐이라 **누가 이름을 올렸는지 볼 수 없었다**
        (발의자 전용 섹션은 Zone 1 통합과 함께 폐기됐는데 이 분기만 통합에서 빠져 있었다).
        차이는 AI 산출물(한 줄 요약·카테고리·읽기시간)이 없다는 것뿐. %>
    <section class="bill-basic-header">
      <div class="zone-1-top">
        <div class="meta-col">
          <div class="ba-meta-line">
            <span>#<%= bill.bill_no || bill.bill_id %></span>
            <% if (bill.committee) { %><span class="ba-sep">·</span><span><%= bill.committee %></span><% } %>
            <span class="ba-sep">·</span><span><%= bill.proc_result_name || '계류' %></span>
          </div>
          <%# 대표발의·공동발의 인원은 아래 스택이 그대로 말해주므로 여기선 발의일만 남긴다 (Zone 1 과 동일) %>
          <div class="ba-meta-line ba-meta-line-sub"><span>발의일 <%= proposeDtFmt %></span></div>
        </div>
        <%# 원문 섹션이 렌더되면 그쪽 `.raw-src` 가 같은 링크(bill.link_url)를 이미 들고 있어 중복이다.
            원문이 없는 40건(대안반영폐기·철회)에서만 여기가 국회로 가는 유일한 통로라 살려둔다. %>
        <% if (bill.link_url && !rawSummary) { %>
          <a href="<%= bill.link_url %>" target="_blank" rel="noopener" class="original-link">국회 원문 ↗</a>
        <% } %>
      </div>
      <%- include('_proposer_stack', { proposers: proposerStackData }) %>
      <h1 class="ba-bill-name" style="margin-bottom:0"><%= bill.bill_name %></h1>
    </section>

    <%# 미분석 분기는 SSR 위치가 곧 최종 위치라 JS 이동이 필요 없다 (레이아웃 시프트 없음) %>
    <% if (tlHasAny) { %><%- include('_bill_timeline', { steps: tlSteps }) %><% } %>

    <!-- ============ 법안 원문 (제안이유 및 주요내용) ============
         AI 분석이 없어도 최소한 "이 법안이 뭘 바꾸려는지"는 알 수 있어야 한다.
         국회 공식 원문이라 전건(99.79%) 보유 — 이 섹션이 비는 건 40건뿐이다.
         분석 요청 위젯보다 **위**에 둔다: 내용을 읽고 나서 요청을 누르는 순서가 맞다. -->
    <% if (rawSummary) { %>
      <section class="bill-raw-summary" id="bill-summary-raw">
        <div class="raw-head">
          <h2 class="raw-h">제안이유 및 주요내용</h2>
          <%# 출처 표기 + 출처로 가는 링크를 한 요소로 겸한다.
              헤더에 있던 별도 `국회 원문 ↗` 버튼은 같은 URL 이라 이 경우 제거했다. %>
          <% if (bill.link_url) { %>
            <a class="raw-src" href="<%= bill.link_url %>" target="_blank" rel="noopener">국회 의안정보 원문 ↗</a>
          <% } else { %>
            <span class="raw-src">국회 의안정보 원문</span>
          <% } %>
        </div>
        <div class="raw-body<%= rawNeedsCollapse ? ' is-collapsed' : '' %>" id="raw-summary-body"><%= rawSummary %></div>
        <% if (rawNeedsCollapse) { %>
          <button type="button" class="raw-toggle" id="raw-summary-toggle"
                  aria-expanded="false" aria-controls="raw-summary-body"
                  data-label-collapsed="전문 보기 ▾" data-label-expanded="접기 ▴">전문 보기 ▾</button>
        <% } %>
      </section>
    <% } %>

    <!-- AI 분석 요청 위젯 (미분석일 때만 노출) -->
    <%
      const reqCount       = Number(analysisRequestCount || 0);
      const reqThreshold   = Number(requestThreshold || 5);
      const reqPct         = Math.min(100, (reqCount / reqThreshold) * 100);
      const isLoggedIn     = Boolean(currentUser);
      const reachedThreshold = reqCount >= reqThreshold;
    %>
    <section class="analysis-request-section" id="analysis-request-widget"
             data-bill-id="<%= bill.bill_id %>"
             data-count="<%= reqCount %>"
             data-threshold="<%= reqThreshold %>"
             data-has-requested="<%= hasRequested ? '1' : '0' %>"
             data-logged-in="<%= isLoggedIn ? '1' : '0' %>">
      <div class="request-header">
        <h2>이 법안의 AI 분석이 아직 없어요</h2>
        <p>요청이 <strong><%= reqThreshold %>명</strong>에 도달하면 우선 분석됩니다.</p>
      </div>

      <div class="request-count-display">
        <span class="count-current"><%= reqCount %></span><span class="count-separator"> / </span><span class="count-target"><%= reqThreshold %>명</span>
      </div>

      <div class="request-progress-bar">
        <div class="request-progress-fill" style="width: <%= reqPct.toFixed(2) %>%"></div>
      </div>

      <% if (reachedThreshold) { %>
        <div class="threshold-reached">충분한 요청이 모였어요. 곧 분석됩니다.</div>
      <% } %>

      <div class="request-action">
        <% if (!isLoggedIn) { %>
          <a href="/auth/login?next=<%= encodeURIComponent(currentUrl) %>" class="btn-request">
            로그인하고 분석 요청하기
          </a>
        <% } else if (hasRequested) { %>
          <button type="button" class="btn-request-done" disabled>✓ 요청했어요</button>
        <% } else { %>
          <button type="button" class="btn-request" id="btn-request-analysis">
            이 법안 분석 요청하기
          </button>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- ============ Zone 7: 분석 → 참여 챕터 디바이더 ============ -->
  <div class="ba-chapter">
    <h2 class="ba-chapter-h">이제 당신이 답할 차례입니다</h2>
    <p class="ba-chapter-sub">법안에 찬반을 표시하고, 다른 국민들의 의견을 읽어보세요</p>
  </div>

  <!-- ============ Zone 8: 국민 찬반 ============ -->
  <section class="pb-part" id="citizen-vote-section">
    <div class="pb-part-head">
      <h3 class="pb-part-h">국민 찬반</h3>
      <p class="pb-part-sub">국회의원의 본회의 표결과 별개로, 이 서비스에 로그인한 국민들의 찬반을 집계합니다.</p>
    </div>
    <div id="citizen-vote-widget"></div>
  </section>

  <!-- ============ Zone 9: 본회의 표결 결과 ============ -->
  <section class="pb-part" id="part-floor-vote">
    <div class="pb-part-head">
      <h3 class="pb-part-h">본회의 표결 결과</h3>
    </div>
    <% if (hasVotes) { %>
      <%# 비중 (2026-08-16) — 분모는 의원 상세 `.vote-tally` 와 같은 규칙: 찬성·반대·기권은 **참여분**(찬+반+기권), 불참은 **전체**.
          넷을 하나의 분모로 두면 "더해도 100%가 안 되는데?" 가 되고, 불참을 참여분에 넣으면 찬성률이 출석률과 섞인다 %>
      <% const vTotal = voteCounts.agree + voteCounts.disagree + voteCounts.abstain + voteCounts.absent;
         const vPart  = voteCounts.agree + voteCounts.disagree + voteCounts.abstain;
         const pct = (n, d) => d > 0 ? (n / d * 100).toFixed(1) + '%' : '—'; %>
      <div class="vote-dashboard">
        <% ['agree','disagree','abstain','absent'].forEach(b => {
             const labels = { agree:'찬성', disagree:'반대', abstain:'기권', absent:'불참' };
             const c = voteCounts[b];
             const p = b === 'absent' ? pct(c, vTotal) : pct(c, vPart);
        %>
          <button type="button" class="vote-box <%= b %>" data-bucket="<%= b %>"<% if (!c) { %> data-empty aria-disabled="true"<% } %>>
            <strong><%= labels[b] %></strong>
            <span class="vote-count"><%= nf(c) %></span>
            <span class="vote-pct"><%= p %><small><%= b === 'absent' ? ' / 전체' : ' / 참여' %></small></span>
            <span class="vote-hint">명단 보기</span>
          </button>
        <% }); %>
      </div>
      <div class="pb-part-foot">찬성·반대·기권 비중은 표결에 참여한 <%= nf(vPart) %>명 기준, 불참은 전체 <%= nf(vTotal) %>명 기준입니다. 각 박스를 누르면 표결 의원 명단이 열립니다.</div>
    <% } else { %>
      <div class="pb-part-empty">본회의 표결 데이터가 아직 수집되지 않았습니다.</div>
    <% } %>
  </section>

  <!-- 발의자 섹션은 Zone 1 헤더 메타라인 직하 컴팩트 스택으로 통합됨 (mountBillAnalysis) -->

  <!-- ============ Zone 11: 국민 의견 ============ -->
  <section class="pb-part" id="part-comments">
    <div class="pb-part-head">
      <h3 class="pb-part-h">국민 의견</h3>
    </div>
    <div id="comment-widget"></div>
  </section>

  <%# ── 「이 페이지가 말하지 않는 것」 ──
      🔴 공용 컴포넌트 `.pb-caveat` (main.css). 여기에 지역 스타일을 만들지 말 것.
      🔴 **페이지의 맨 끝**이다 (`/guide`·`/issue` 와 같은 자리). 국민 의견 뒤에 두는 이유는
         이 상자가 **"우리가 마지막으로 하는 말"** 이기 때문이다. 그 아래는 다른 사람들의 말이다.
      🔴 항목은 **이 페이지의 데이터에만** 붙인다. 일반론을 늘어놓으면 읽히지 않는다.
         숫자를 본문에 박지 않고 「읽는 법」으로 링크한다 — 배치가 매일 움직이는 값이라
         여기 적으면 조용히 거짓이 된다 (`/guide` 1편이 살아 있는 숫자를 맡는다) ── %>
  <section class="pb-caveat" id="bill-caveat">
    <h2 class="pb-caveat-h">이 페이지가 말하지 않는 것</h2>
    <ul>
      <% if (analysis) { %>
        <li>
          <strong>AI 분석은 사람이 검수한 글이 아닙니다.</strong>
          사실과 다를 수 있다는 건 위에도 적어뒀지만, 하나가 더 있습니다.
          AI가 읽은 문서와 국회가 공개한 원문이 같은 문서라는 보장이 없습니다.
          둘 다 국회가 낸 「제안이유 및 주요내용」이지만 받아오는 경로가 다릅니다.
          <a href="/guide/how-far-to-trust-ai">AI가 쓴 분석, 어디까지 믿을 수 있나 →</a>
        </li>
      <% } %>
      <% if (hasVotes) { %>
        <li>
          <strong>찬성이 많다고 이견이 없었다는 뜻은 아닙니다.</strong>
          본회의에 오르는 안건은 위원회를 이미 통과한 것이라 반대표가 원래 드뭅니다.
          걸러지는 곳은 본회의가 아니라 그 앞입니다.
          <a href="/guide/why-so-few-no-votes">반대표는 왜 1%도 안 될까 →</a>
        </li>
      <% } %>
      <% if (tlHasAny) { %>
        <li>
          <strong>처리 경과는 날짜만 압니다.</strong>
          위원회에서 무슨 논의가 오갔는지, 왜 여기서 멈춰 있는지는 이 데이터로 알 수 없습니다.
          위원회 표결은 개인별로 공개되지 않고, 이 사이트가 가진 것은 단계별 날짜와 결과뿐입니다.
          <a href="/guide/how-a-bill-moves">법안 하나가 국회를 통과하기까지 →</a>
        </li>
      <% } %>
      <% if (coProposers && coProposers.length) { %>
        <li>
          <strong>공동발의자 수는 기여도가 아닙니다.</strong>
          법안에 이름을 올렸다는 기록일 뿐, 누가 얼마나 만들었는지는 담기지 않습니다.
          숫자가 크다고 그만큼 중요한 법안이라는 뜻도 아닙니다.
          <a href="/guide/proposing-is-not-contribution">건수가 말하지 않는 것 →</a>
        </li>
      <% } %>
      <li>
        <strong>국민 찬반은 여론조사가 아닙니다.</strong>
        이 사이트에 로그인한 사람만 참여하고, 그중에서도 이 법안을 찾아 들어온 사람들이라
        표본이 한쪽으로 치우칠 수 있습니다. 국회 밖의 여론으로 읽지 마세요.
      </li>
    </ul>
  </section>
</div>

<!-- 표결 의원 명단 모달 -->
<% if (hasVotes) { %>
  <div class="pb-modal voter-modal" id="voter-modal" hidden role="dialog" aria-modal="true" aria-labelledby="voter-modal-title">
    <div class="pb-modal-backdrop" data-voter-close></div>
    <div class="pb-modal-card">
      <div class="voter-modal-head">
        <div class="voter-modal-title" id="voter-modal-title"><span class="tc-dot"></span><span class="tc-text"></span></div>
        <button type="button" class="voter-modal-close" aria-label="닫기" data-voter-close>×</button>
      </div>
      <div class="voter-modal-filters" id="voter-modal-filters"></div>
      <div class="voter-modal-search">
        <input type="search" id="voter-modal-search-input" placeholder="이름 검색" autocomplete="off" spellcheck="false">
      </div>
      <div class="voter-modal-grid" id="voter-modal-grid"></div>
    </div>
  </div>
<% } %>

<%# AI 분석 데이터 주입 — </script> 이스케이프로 XSS 방어 %>
<% if (analysis) { %>
<script>
  window.__BILL_ANALYSIS__ = <%- JSON.stringify(analysis).replace(/</g, '\\u003c') %>;
</script>
<% } else { %>
<script>window.__BILL_ANALYSIS__ = null;</script>
<% } %>

<script>
  window.__BILL_PROPOSERS__ = <%- JSON.stringify(
    (coProposers || []).map(cp => ({
      mona_cd:    cp.mona_cd || null,
      name:       cp.name    || null,
      party_name: cp.party_name || null,
      photo:      cp.photo_url  || null,
      is_rep:     Boolean(cp.proposer_yn)
    }))
  ).replace(/</g, '\\u003c') %>;
</script>

<% if (hasVotes) { %>
<script>
  window.__BILL_VOTERS__ = <%- JSON.stringify({
    agree:    voters.agree.map(v    => ({ mona_cd: v.mona_cd, name: v.name || null, party: v.party_name || null, photo: v.photo_url || null })),
    disagree: voters.disagree.map(v => ({ mona_cd: v.mona_cd, name: v.name || null, party: v.party_name || null, photo: v.photo_url || null })),
    abstain:  voters.abstain.map(v  => ({ mona_cd: v.mona_cd, name: v.name || null, party: v.party_name || null, photo: v.photo_url || null })),
    absent:   voters.absent.map(v   => ({ mona_cd: v.mona_cd, name: v.name || null, party: v.party_name || null, photo: v.photo_url || null }))
  }).replace(/</g, '\\u003c') %>;
</script>
<% } else { %>
<script>window.__BILL_VOTERS__ = null;</script>
<% } %>

<script>
(() => {
  const BILL_ID = '<%= bill.bill_id %>';
  const mount = () => {
    if (!window.PB) return setTimeout(mount, 30);
    PB.mountCitizenVote({ containerId: 'citizen-vote-widget', billId: BILL_ID });
    PB.mountComments({ containerId: 'comment-widget', type: 'bill', targetId: BILL_ID });
    if (window.__BILL_ANALYSIS__ && typeof PB.mountBillAnalysis === 'function') {
      PB.mountBillAnalysis({
        containerId: 'bill-analysis',
        analysisData: window.__BILL_ANALYSIS__,
        proposers: window.__BILL_PROPOSERS__ || [],
        // SSR 한 발의자 스택을 넘긴다 (마크업 단일 소스). 홀더가 없으면 JS 폴백이 그린다
        proposerStackHtml: (function () {
          const src = document.getElementById('proposer-stack-src');
          if (!src) return '';
          const html = src.innerHTML;
          src.remove();          // 같은 id/마크업이 문서에 두 벌 남지 않게
          return html;
        })(),
        bill: {
          bill_id:            BILL_ID,
          bill_no:            '<%= bill.bill_no || "" %>',
          bill_name:          <%- JSON.stringify(bill.bill_name || '').replace(/</g, '\\u003c') %>,
          proposer:           <%- JSON.stringify(bill.proposer_name || '').replace(/</g, '\\u003c') %>,
          proposer_mona_cd:   <%- JSON.stringify(bill.mona_cd || '').replace(/</g, '\\u003c') %>,
          propose_dt:         <%- JSON.stringify(bill.propose_dt || '').replace(/</g, '\\u003c') %>,
          co_proposer_count:  <%= Number(bill.co_proposer_count || 0) %>,
          co_rep_count:       <%= Number(coRepCount || 0) %>,
          status:             <%- JSON.stringify(bill.proc_result_name || '계류').replace(/</g, '\\u003c') %>,
          committee:          <%- JSON.stringify(bill.committee || '').replace(/</g, '\\u003c') %>,
          link_url:           <%- JSON.stringify(bill.link_url || '').replace(/</g, '\\u003c') %>
        },
        scrollTargetId: 'citizen-vote-section'
      });
      setupZone2Reveal();   // 5-Zone 은 JS 로 렌더되므로 mount 직후에 걸어야 한다
      // 처리 경과를 Zone 1(요약·발의자) 바로 아래로 올린다.
      // EJS 는 JS 가 렌더하는 Zone 1↔Zone 2 사이에 끼어들 수 없어서, 마운트 직후 여기서 옮긴다.
      // 실패해도 SSR 위치(분석 섹션 다음)에 남으므로 정보는 사라지지 않는다.
      const tl = document.getElementById('bill-timeline');
      const z1 = document.querySelector('.ba-z1');
      if (tl && z1 && z1.parentNode) z1.insertAdjacentElement('afterend', tl);
    }
    if (typeof PB.mountAnalysisRequest === 'function') {
      PB.mountAnalysisRequest({ containerId: 'analysis-request-widget' });
    }
  };

  /* Zone 2 진입 애니메이션 — 화면에 들어오면 카드 3장이 순차로 올라온다.
     `data-reveal` 을 JS 가 붙여야 초기 숨김이 시작된다 → JS 실패 시 카드는 그냥 보인다 (폴백). */
  function setupZone2Reveal() {
    const cards = document.querySelector('.ba-z2 .ba-cards');
    if (!cards || cards.hasAttribute('data-reveal')) return;

    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) return;   // 숨기지 않고 끝냄

    cards.setAttribute('data-reveal', '');

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        cards.classList.add('is-in');
        io.disconnect();
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
    io.observe(cards);

    // 안전장치 — 페이지에서 가장 중요한 정보를 CSS 로 숨겨두는 구조라 실패 시 손실이 크다.
    // `is-in` 만 붙이는 건 **전환이 실제로 돌아야** 보인다는 뜻인데, 백그라운드 탭 스로틀링이나
    // 일부 웹뷰처럼 전환이 진행되지 않는 환경에서는 opacity:0 인 채로 영영 남는다.
    // 2초 뒤에도 여전히 안 보이면 숨김 규칙과 전환을 통째로 걷어내 강제 노출한다.
    // (정상 브라우저에서는 이미 애니메이션이 끝나 있으므로 이 분기를 타지 않는다)
    setTimeout(() => {
      cards.classList.add('is-in');
      io.disconnect();
      const items = [...cards.querySelectorAll('.ba-card')];
      const stuck = items.some((c) => Number(getComputedStyle(c).opacity) < 1);
      if (!stuck) return;
      cards.removeAttribute('data-reveal');
      // 여기까지 왔다면 모션 자체가 죽은 환경이라, 이 카드들의 전환은 꺼두는 게 맞다
      items.forEach((c) => { c.style.transition = 'none'; c.style.opacity = '1'; c.style.transform = 'none'; });
    }, 2000);
  }
  mount();

  /* =========================================================
     Zone 6 — 섹션 탭 바 `.bd-toc` (가로 sticky · 전 폭 공용)
     ========================================================= */
  const allIdxItems = document.querySelectorAll('.bd-toc-tab');
  /* 🔴 `let` 이다 — 아래 setupIndexObserver 가 **실제 DOM 위치로 다시 정렬**한다.
     마크업 순서를 그대로 믿으면 안 된다: `#bill-timeline` 은 분석 분기에서 JS 가 렌더 후
     `.ba-z1` 뒤로 옮기므로(그게 이 섹션의 제자리다) 인덱스 마크업 순서와 어긋난다. */
  let idxTargetIds = [...new Set([...allIdxItems].map(a => a.dataset.idx).filter(Boolean))];

  /* 오프셋: 고정 nav + **탭 바 높이**. 탭 바가 sticky 라 그 아래로 착지해야 제목이 안 가린다.
     ⚠️ `--nav-h` 는 반응형(데스크톱 100 · 모바일 60)이라 하드코딩 금지.
     ⚠️ 바 높이는 실측값을 박지 말고 `offsetHeight` 로 읽는다 — 글꼴 로드 전후로 달라진다. */
  const bdToc = document.getElementById('bd-toc');
  const getScrollOffset = () => {
    const v = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 100;
    return v + (bdToc ? bdToc.offsetHeight : 0) + 12;
  };

  /* 법안 원문 전문 보기 토글 (분석 없는 분기 · 긴 원문일 때만 버튼이 렌더됨) */
  const rawToggle = document.getElementById('raw-summary-toggle');
  const rawBody   = document.getElementById('raw-summary-body');
  if (rawToggle && rawBody) {
    rawToggle.addEventListener('click', () => {
      const collapsed = rawBody.classList.toggle('is-collapsed');
      // 라벨은 마크업이 정한다 — 미분석 분기는 "전문 보기", 분석 분기(대조용)는 "원문 펼치기"
      rawToggle.textContent = collapsed
        ? (rawToggle.dataset.labelCollapsed || '전문 보기 ▾')
        : (rawToggle.dataset.labelExpanded  || '접기 ▴');
      rawToggle.setAttribute('aria-expanded', String(!collapsed));
      // 접을 때는 섹션 상단으로 돌려보낸다 — 안 하면 사라진 본문 아래 허공에 남는다
      if (collapsed) {
        const sec = document.getElementById('bill-summary-raw');
        if (sec) window.scrollTo({ top: sec.getBoundingClientRect().top + window.scrollY - getScrollOffset(), behavior: 'smooth' });
      }
    });
  }

  // 클릭 시 헤더 오프셋 보정 스크롤
  allIdxItems.forEach(a => {
    a.addEventListener('click', (e) => {
      const id = a.dataset.idx;
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      window.scrollTo({
        top: target.getBoundingClientRect().top + window.scrollY - getScrollOffset(),
        behavior: 'smooth'
      });
    });
  });

  // 활성 섹션 표시 — 스크롤 기반 트리거 (마지막 섹션도 안정적으로 잡힘).
  // 주의: 5-Zone (ba-summary 등) 은 mountBillAnalysis 가 동적 주입하므로 DOM 대기 필요.
  const setActive = (id) => {
    allIdxItems.forEach(a => a.classList.toggle('is-active', a.dataset.idx === id));
  };
  let scrollRaf = 0;
  const updateActive = () => {
    scrollRaf = 0;
    // 페이지 끝에 도달했으면(짧은 마지막 섹션이 trigger 라인까지 못 올라감) 마지막 섹션 강제 활성
    const docHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
    const reachedBottom = (window.innerHeight + window.scrollY) >= (docHeight - 24);
    if (reachedBottom && idxTargetIds.length) {
      setActive(idxTargetIds[idxTargetIds.length - 1]);
      return;
    }
    const triggerLine = getScrollOffset();
    let activeId = null;
    // DOM 순서대로 순회 → top <= triggerLine 인 마지막 섹션 = 현재 위치
    for (const id of idxTargetIds) {
      const el = document.getElementById(id);
      if (!el) continue;
      const top = el.getBoundingClientRect().top;
      if (top <= triggerLine) activeId = id;
    }
    // 페이지 맨 위라 아무것도 안 걸리면 첫 섹션
    if (!activeId && idxTargetIds.length) activeId = idxTargetIds[0];
    if (activeId) setActive(activeId);
  };
  const onScrollIdx = () => {
    if (scrollRaf) return;
    scrollRaf = requestAnimationFrame(updateActive);
  };
  const setupIndexObserver = (retry = 0) => {
    // 5-Zone 분석 있을 땐 ba-summary 가 주입될 때까지 대기 (최대 ~3초)
    if (window.__BILL_ANALYSIS__ && !document.getElementById('ba-summary') && retry < 60) {
      return setTimeout(() => setupIndexObserver(retry + 1), 50);
    }
    /* 🔴 **실제 DOM 위치로 정렬** (2026-08-24). 활성 추적이 "배열에서 마지막으로 걸린 것" 을 고르므로
       배열이 DOM 순서가 아니면 뒤에 적힌 항목이 앞 섹션을 통째로 가린다.
       실측(분석 있는 법안 1440x900): `bill-timeline` 이 배열 6번째 · DOM 2번째라
       **핵심 변화·분석·함께 생각·원문 대조 4개가 도달 불가**였고, 눌러도 「처리 경과」 가 켜졌다.
       처리 경과 혼자 스크롤 구간의 64%(2,084px)를 먹고 있었다.
       ⚠️ 반드시 위 ba-summary 대기 **뒤**에 정렬할 것 — 그 전엔 5-Zone 과 타임라인이 아직 제자리에 없다. */
    idxTargetIds = idxTargetIds
      .filter(id => document.getElementById(id))
      .sort((a, b) => (document.getElementById(a).compareDocumentPosition(document.getElementById(b))
        & Node.DOCUMENT_POSITION_FOLLOWING) ? -1 : 1);

    /* 🔴 **탭의 보이는 순서도 같이 맞춘다.** 세로 레일 때는 카테고리 묶음이라 순서가 조금 어긋나도
       읽혔지만, 가로 바에서는 왼→오 순서가 곧 페이지를 읽는 순서라 어긋나면 활성 점이 튄다.
       (`#bill-timeline` 이 분석 분기에서 Zone 1 뒤로 옮겨져 마크업 순서와 달라진다) */
    const tocInner = bdToc && bdToc.querySelector('.bd-toc-inner');
    if (tocInner) {
      idxTargetIds.forEach((id) => {
        const tab = tocInner.querySelector('[data-idx="' + id + '"]');
        if (tab) tocInner.appendChild(tab);        // 순서대로 뒤에 붙이면 정렬된다
      });
    }
    if (!idxTargetIds.length) return;
    window.addEventListener('scroll', onScrollIdx, { passive: true });
    window.addEventListener('resize',  onScrollIdx, { passive: true });
    updateActive();
  };
  setupIndexObserver();

  // 동적 카운트 채우기 — 찬반/의견 (서버에 미리 없는 값). PB 로드 후 수행
  const fillCount = (selector, value) => {
    document.querySelectorAll(selector).forEach(el => { el.textContent = value; });
  };
  const loadCounts = async () => {
    if (!window.PB) return setTimeout(loadCounts, 50);
    try {
      const d = await PB.fetch(`/api/votes/bill/${encodeURIComponent(BILL_ID)}`);
      fillCount('[data-count-citizen]', d.total != null ? d.total : '—');
    } catch (_) {}
    try {
      const d = await PB.fetch(`/api/comments?type=bill&targetId=${encodeURIComponent(BILL_ID)}`);
      const items = Array.isArray(d) ? d : (d.items || []);
      const visible = items.filter(c => !c.is_deleted).length;
      fillCount('[data-count-comments]', visible);
    } catch (_) {}
  };
  loadCounts();

  /* (구 모바일 jumpbar 로직은 2026-08-24 제거 — 가로 탭 바 `.bd-toc` 가 전 폭을 담당한다.
     body 로 옮기던 z-index 회피, focusin/focusout 숨김, 맨 위로 버튼이 전부 같이 사라졌다) */

  /* =========================================================
     본회의 표결 명단 모달
     ========================================================= */
  const voters = window.__BILL_VOTERS__;
  const modal = document.getElementById('voter-modal');
  if (!voters || !modal) return;

  const BUCKET_LABEL = { agree: '찬성', disagree: '반대', abstain: '기권', absent: '불참' };
  const RETIRED_KEY = '__retired__';
  const titleEl   = modal.querySelector('.voter-modal-title');
  const titleText = titleEl.querySelector('.tc-text');
  const filterEl  = document.getElementById('voter-modal-filters');
  const gridEl    = document.getElementById('voter-modal-grid');
  const searchEl  = document.getElementById('voter-modal-search-input');
  const esc = (s) => (window.PB && PB.escapeHtml) ? PB.escapeHtml(s) : String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const avatar = (name, photo) => {
    if (photo) return `<img src="${esc(photo)}" alt="${esc(name || '')}" style="width:100%;height:100%;object-fit:cover">`;
    return (window.PB && PB.avatarSvg) ? PB.avatarSvg(name || '', 28) : '';
  };
  const partyClassOf = (name) => {
    if (!name) return 'cp-etc';
    if (name.indexOf('더불어민주') > -1) return 'cp-minjoo';
    if (name.indexOf('국민의힘')   > -1) return 'cp-gukhim';
    if (name.indexOf('조국혁신')   > -1) return 'cp-jokuk';
    if (name.indexOf('개혁')       > -1) return 'cp-gaehyuk';
    if (name.indexOf('진보')       > -1) return 'cp-jinbo';
    return 'cp-etc';
  };

  let currentBucket = null;
  let currentFilter = 'all';
  let currentQuery  = '';

  const sortByName = (list) => list.slice().sort((a, b) => {
    const an = a.name || '￿', bn = b.name || '￿'; // 퇴임은 맨 뒤
    return an.localeCompare(bn, 'ko');
  });

  const buildPartyIndex = (list) => {
    const map = new Map();
    for (const v of list) {
      const key = v.name ? (v.party || '무소속') : RETIRED_KEY;
      if (!map.has(key)) map.set(key, 0);
      map.set(key, map.get(key) + 1);
    }
    return [...map.entries()].sort((a, b) => {
      if (a[0] === RETIRED_KEY) return 1;
      if (b[0] === RETIRED_KEY) return -1;
      return b[1] - a[1]; // 인원 많은 순
    });
  };

  const renderGrid = () => {
    const q = currentQuery;
    const list = sortByName(voters[currentBucket].filter(v => {
      if (currentFilter === RETIRED_KEY) { if (v.name) return false; }
      else if (currentFilter !== 'all')  { if (!v.name || (v.party || '무소속') !== currentFilter) return false; }
      if (q && !PB.matchesQuery(v.name || '', q)) return false;
      return true;
    }));
    if (list.length === 0) {
      const msg = q ? `"${esc(q)}" 에 해당하는 의원이 없습니다.` : '해당 조건의 의원이 없습니다.';
      gridEl.innerHTML = `<div class="voter-modal-empty">${msg}</div>`;
      return;
    }
    const chips = list.map(v => {
      if (v.name) {
        const pc = partyClassOf(v.party);
        return `<a href="/politician/${esc(v.mona_cd)}" class="proposer-chip ${pc}" style="text-decoration:none">
          <div class="avatar">${avatar(v.name, v.photo)}</div>
          <div style="min-width:0;overflow:hidden">
            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(v.name)}</div>
            <div class="party-sm">${esc(v.party || '무소속')}</div>
          </div>
        </a>`;
      }
      return `<div class="proposer-chip retired" title="22대 임기 중 퇴임 의원">
        <div class="avatar">${avatar(null, null)}</div>
        <div style="min-width:0;overflow:hidden">
          <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">(퇴임)</div>
          <div class="party-sm">—</div>
        </div>
      </div>`;
    }).join('');
    gridEl.innerHTML = `<div class="proposers-grid">${chips}</div>`;
  };

  const renderFilters = () => {
    const idx = buildPartyIndex(voters[currentBucket]);
    const totalClickable = voters[currentBucket].length;
    const btns = [`<button type="button" class="voter-filter-chip${currentFilter === 'all' ? ' active' : ''}" data-party="all">전체<span class="chip-count">${totalClickable}</span></button>`];
    for (const [key, count] of idx) {
      const isRetired = key === RETIRED_KEY;
      const label = isRetired ? '퇴임' : key;
      btns.push(`<button type="button" class="voter-filter-chip${currentFilter === key ? ' active' : ''}" data-party="${esc(key)}">${esc(label)}<span class="chip-count">${count}</span></button>`);
    }
    filterEl.innerHTML = btns.join('');
  };

  const openModal = (bucket) => {
    currentBucket = bucket;
    currentFilter = 'all';
    currentQuery  = '';
    searchEl.value = '';
    titleEl.className = 'voter-modal-title ' + bucket;
    titleText.textContent = `${BUCKET_LABEL[bucket]} ${voters[bucket].length}명`;
    renderFilters();
    renderGrid();
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    gridEl.scrollTop = 0;
  };

  const closeModal = () => {
    modal.hidden = true;
    document.body.style.overflow = '';
  };

  document.querySelectorAll('.vote-box[data-bucket]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.hasAttribute('data-empty')) return;
      openModal(btn.dataset.bucket);
    });
  });

  modal.addEventListener('click', (e) => {
    if (e.target.closest('[data-voter-close]')) closeModal();
  });
  filterEl.addEventListener('click', (e) => {
    const chip = e.target.closest('.voter-filter-chip');
    if (!chip) return;
    currentFilter = chip.dataset.party;
    renderFilters();
    renderGrid();
    gridEl.scrollTop = 0;
  });
  searchEl.addEventListener('input', () => {
    currentQuery = searchEl.value.trim();
    renderGrid();
    gridEl.scrollTop = 0;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
})();
</script>
