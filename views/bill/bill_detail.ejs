<%
  const nf = (n) => Number(n || 0).toLocaleString('ko-KR');
  const resultClass = (r) => {
    if (!r) return 'pb-badge-pending';
    if (r.indexOf('가결') > -1) return 'pb-badge-passed';
    if (r === '부결' || r === '폐기') return 'pb-badge-rejected';
    if (r === '철회') return 'pb-badge-withdrawn';
    if (r.indexOf('대안') > -1) return 'pb-badge-alt';
    return 'pb-badge-pending';
  };
  const termAnchor = (r) => {
    if (!r) return 'pending';
    if (r === '원안가결')      return 'original';
    if (r === '수정가결')      return 'modified';
    if (r === '대안반영폐기')  return 'alt-dropped';
    if (r === '수정안반영폐기') return 'mod-dropped';
    if (r === '철회')          return 'withdrawn';
    if (r === '부결')          return 'rejected';
    if (r === '폐기')          return 'dropped';
    return 'pending';
  };
%>

<style>
  .bd-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: calc(var(--nav-h) + 36px) 24px 60px;
  }
  .bd-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    margin-bottom: 18px;
  }
  .bd-breadcrumb a { color: var(--accent); }

  .bd-section {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 18px;
  }
  .bd-section h2 {
    font-size: 15px;
    font-weight: 600;
    color: var(--sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 18px;
  }
  .vote-dashboard {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }
  .vote-box {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg3);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.08s;
    font: inherit;
    width: 100%;
  }
  .vote-box:hover:not([data-empty]) {
    border-color: var(--border2);
    background: var(--bg2);
  }
  .vote-box:active:not([data-empty]) { transform: translateY(1px); }
  .vote-box[data-empty] { cursor: default; opacity: 0.55; }
  .vote-box strong {
    display: block;
    font-size: 12px;
    color: var(--sub);
    margin-bottom: 8px;
  }
  .vote-box .vote-count {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    line-height: 1;
    display: block;
  }
  .vote-box.agree    .vote-count { color: var(--green); }
  .vote-box.disagree .vote-count { color: var(--red); }
  .vote-box.abstain  .vote-count { color: var(--accent); }
  .vote-box.absent   .vote-count { color: var(--sub); }
  .vote-box .vote-hint {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    color: var(--sub2);
    font-family: 'JetBrains Mono', monospace;
  }
  .vote-box[data-empty] .vote-hint { visibility: hidden; }

  .proposers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
  }
  .proposer-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 13px;
    color: var(--text);
  }
  .proposer-chip.rep { border-color: var(--accent); background: rgba(184,116,12,0.08); }
  .proposer-chip.retired { color: var(--sub2); font-style: italic; cursor: default; }
  .proposer-chip.retired .party-sm { color: var(--sub2); }
  .proposer-chip .avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
  }
  .proposer-chip .avatar img,
  .proposer-chip .avatar svg { width: 100%; height: 100%; display: block; }
  .proposer-chip .party-sm { color: var(--sub); font-size: 11px; }

  @media (max-width: 768px) {
    .vote-dashboard { grid-template-columns: repeat(2, 1fr); }
  }

  /* 표결 의원 명단 모달 */
  .voter-modal .pb-modal-card {
    max-width: 760px;
    padding: 22px 24px 20px;
    max-height: calc(100vh - 48px);
    display: flex;
    flex-direction: column;
  }
  .voter-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .voter-modal-title { font-size: 17px; font-weight: 700; color: var(--text); }
  .voter-modal-title .tc-dot {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: middle;
  }
  .voter-modal-title.agree    .tc-dot { background: var(--green); }
  .voter-modal-title.disagree .tc-dot { background: var(--red); }
  .voter-modal-title.abstain  .tc-dot { background: var(--accent); }
  .voter-modal-title.absent   .tc-dot { background: var(--sub); }
  .voter-modal-close {
    background: transparent;
    border: none;
    width: 32px; height: 32px;
    border-radius: 8px;
    font-size: 22px;
    line-height: 1;
    color: var(--sub);
    cursor: pointer;
    flex-shrink: 0;
  }
  .voter-modal-close:hover { background: var(--bg3); color: var(--text); }
  .voter-modal-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
    max-height: 100px;
    overflow-y: auto;
  }
  .voter-modal-search {
    margin-bottom: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .voter-modal-search input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    background: var(--bg2);
    color: var(--text);
    box-sizing: border-box;
  }
  .voter-modal-search input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(184,116,12,0.12);
  }
  .voter-modal-search input::placeholder { color: var(--sub2); }
  .voter-filter-chip {
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg2);
    font-size: 12px;
    color: var(--sub);
    cursor: pointer;
    font: inherit;
    line-height: 1.4;
    transition: all 0.12s;
  }
  .voter-filter-chip:hover { border-color: var(--border2); color: var(--text); }
  .voter-filter-chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .voter-filter-chip .chip-count {
    margin-left: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    opacity: 0.8;
  }
  .voter-modal-grid {
    flex: 0 0 auto;
    height: 456px;           /* 8줄 고정 (chip ~50px + gap 8px) */
    overflow-y: auto;
    padding: 4px 2px 2px;
  }
  .voter-modal-grid .proposers-grid {
    margin: 0;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  /* 정당별 chip 배경 — politician 페이지와 동일 팔레트(저채도 tint) */
  .voter-modal-grid .proposer-chip.cp-minjoo  { background: rgba(30,64,175,0.08);  border-color: rgba(30,64,175,0.28); }
  .voter-modal-grid .proposer-chip.cp-gukhim  { background: rgba(185,28,28,0.08);  border-color: rgba(185,28,28,0.28); }
  .voter-modal-grid .proposer-chip.cp-jokuk   { background: rgba(109,40,217,0.08); border-color: rgba(109,40,217,0.28); }
  .voter-modal-grid .proposer-chip.cp-gaehyuk { background: rgba(180,83,9,0.10);   border-color: rgba(180,83,9,0.28); }
  .voter-modal-grid .proposer-chip.cp-jinbo   { background: rgba(153,27,27,0.08);  border-color: rgba(153,27,27,0.28); }
  .voter-modal-grid .proposer-chip.cp-etc     { background: rgba(75,85,99,0.08);   border-color: rgba(75,85,99,0.28); }
  .voter-modal-grid .proposer-chip.retired    { background: var(--bg3); border-color: var(--border); }
  .voter-modal-empty {
    padding: 40px 12px;
    text-align: center;
    color: var(--sub2);
    font-size: 13px;
  }
  @media (max-width: 768px) {
    .voter-modal .pb-modal-card { padding: 18px 16px 16px; }
    .voter-modal-filters { max-height: 120px; }
    .voter-modal-grid { height: 60vh; }
    .voter-modal-grid .proposers-grid {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    }
  }

  /* =========================================================
     AI 분석 섹션 (UI_ANALYSIS.md 5-Zone)
     ========================================================= */
  /* AI 분석 라벨 — 분석 섹션 위 한 줄, 디스클레이머 + 상태 명시 */
  .ai-analysis-label {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 8px 14px;
    margin-bottom: 12px;
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.4;
  }
  .ai-analysis-label.is-done {
    background: #FAF6EB;
    border: 1px solid var(--accent);
    color: var(--accent);
  }
  .ai-analysis-label.is-pending {
    background: var(--bg3);
    border: 1px solid var(--border2);
    color: var(--sub);
  }
  .ai-analysis-label .label-tag {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }
  .ai-analysis-label .label-note {
    flex: 1;
    min-width: 0;
  }
  .ai-analysis-label .label-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    flex-shrink: 0;
  }
  .ai-analysis-label.is-done .label-meta { color: var(--accent2, #925C09); opacity: 0.8; }

  .bill-ai-analysis {
    /* 분석 섹션 전용 디자인 토큰 — 사용자 스펙 (Brand Assets 기반) */
    --ba-ink:    #0F1B1F;   /* 본문 */
    --ba-sub:    #374151;   /* 보조 */
    --ba-meta:   #6B7280;   /* 메타 */
    --ba-gold:   #8F5800;   /* 머스타드 골드 (강조 단일색) */
    --ba-paper:  #F3F1EA;   /* 페이지 */
    --ba-card-bg:     #FAFAF7;
    --ba-card-border: #E8E5DC;
    --ba-sans:  'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
    --ba-serif: 'Noto Serif KR', 'Noto Sans KR', serif;
    --ba-mono:  'JetBrains Mono', monospace;
    margin-bottom: 32px;
  }

  /* ===== Shell: 1240px = 180 좌마진노트 거터 + 880 콘텐츠 + 180 우거터(인덱스 회피) ===== */
  .ba-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 180px minmax(0, 880px) 180px;
    gap: 0;
    justify-content: center;
    align-items: start;
    /* bd-wrap(960px) 보다 넓게 break out */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    width: 100vw;
    max-width: 100vw;
  }
  .ba-content {
    grid-column: 2 / 3;
    font-family: var(--ba-sans);
    font-size: 18px;
    font-weight: 450;
    line-height: 1.75;
    color: var(--ba-ink);
    word-break: keep-all;
  }
  .ba-content > .ba-zone + .ba-zone { margin-top: 64px; }

  /* 본문 강조: weight 700 + 골드 언더라인 */
  .ba-content strong, .ba-content em {
    font-style: normal;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--ba-gold);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    text-decoration-skip-ink: none;
  }
  .ba-content a {
    color: var(--ba-gold);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ba-muted { color: var(--ba-meta); font-weight: 450; }
  .ba-sep   { color: var(--ba-meta); margin: 0 6px; }

  /* ===== Zone 1: 메타 + 헤드라인 ===== */
  .ba-z1 .ba-meta-line {
    font-family: var(--ba-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    color: var(--ba-meta);
    margin-bottom: 6px;
    line-height: 1.6;
  }
  .ba-z1 .ba-meta-line a { color: var(--ba-meta); text-decoration: none; }
  .ba-z1 .ba-meta-line a:hover { color: var(--ba-gold); }
  .ba-z1 .ba-meta-line-sub { margin-bottom: 24px; }

  /* ===== Zone 1 — 발의자 컴팩트 스택 (메타라인 직하) ===== */
  .ba-proposers {
    margin: 8px 0 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #E8E5DC;
  }
  .ba-proposers-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .ba-proposers-stack {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .ba-pp-stack-item {
    width: 24px; height: 24px;
    border-radius: 50%;
    overflow: hidden;
    background: #F3F1EA;
    border: 1.5px solid #F3F1EA;
    margin-left: -6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ba-sans);
    font-size: 11px;
    font-weight: 600;
    color: var(--ba-meta);
    text-decoration: none;
    flex-shrink: 0;
    box-sizing: content-box;
    transition: transform 0.15s, z-index 0.15s;
  }
  .ba-pp-stack-item:first-child { margin-left: 0; }
  .ba-pp-stack-item.is-rep {
    width: 32px; height: 32px;
    border: 1.5px solid var(--ba-gold);
    box-shadow: 0 0 0 2px #F3F1EA;
    z-index: 2;
    margin-left: 0;
  }
  .ba-pp-stack-item img,
  .ba-pp-stack-item svg { width: 100%; height: 100%; display: block; object-fit: cover; }
  .ba-pp-stack-item:hover { transform: translateY(-1px); z-index: 3; }
  .ba-pp-stack-initial { display: inline-block; line-height: 1; }
  .ba-proposers-label {
    flex: 1;
    min-width: 0;
    font-family: var(--ba-sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ba-meta);
  }
  .ba-pp-rep-name {
    color: var(--ba-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .ba-pp-rep-name:hover { text-decoration: underline; text-decoration-color: var(--ba-gold); text-underline-offset: 4px; }
  .ba-pp-others { color: #8B8578; }
  .ba-pp-sep    { color: #C8C0AA; }
  .ba-pp-parties { color: var(--ba-meta); }
  .ba-pp-toggle {
    flex-shrink: 0;
    background: transparent;
    border: none;
    padding: 2px 0 3px;
    color: var(--ba-gold);
    font-family: var(--ba-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    cursor: pointer;
    border-bottom: 1px dashed #C8A24A;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .ba-pp-toggle:hover { color: #6E4400; border-bottom-color: var(--ba-gold); }
  .ba-pp-toggle-arrow { font-size: 10px; transform: translateY(-1px); }

  /* 펼친 카드 그리드 — data-expanded="true" 일 때만 노출 (display:grid 가 [hidden] 을 덮어쓰는 문제 회피) */
  .ba-proposers-grid { display: none; }
  .ba-proposers[data-expanded="true"] .ba-proposers-grid {
    margin-top: 16px;
    padding: 16px;
    background: rgba(255,255,255,0.5);
    border: 1px dashed #D9D3C3;
    border-radius: 12px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }
  .ba-pp-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ba-ink);
    transition: border-color 0.15s, transform 0.15s;
    min-width: 0;
  }
  .ba-pp-card:hover { border-color: var(--ba-gold); transform: translateY(-1px); }
  .ba-pp-card.is-rep { border: 1.5px solid var(--ba-gold); }
  .ba-pp-card.is-retired {
    color: #9B9486;
    font-style: italic;
    cursor: default;
    background: #F3F1EA;
  }
  .ba-pp-card-avatar {
    width: 24px; height: 24px;
    border-radius: 50%;
    overflow: hidden;
    background: #F3F1EA;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ba-sans);
    font-size: 10px;
    font-weight: 600;
    color: var(--ba-meta);
  }
  .ba-pp-card-avatar img, .ba-pp-card-avatar svg { width: 100%; height: 100%; display: block; object-fit: cover; }
  .ba-pp-card-meta { min-width: 0; flex: 1; }
  .ba-pp-card-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--ba-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ba-pp-card-rep-tag {
    font-family: var(--ba-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--ba-gold);
    font-weight: 700;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .ba-pp-card-party {
    font-size: 10px;
    color: #8B8578;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ===== 모바일 (≤768) — 아바타 축소, 그리드 5→2열, 라벨 줄바꿈 ===== */
  @media (max-width: 768px) {
    .ba-pp-stack-item    { width: 22px; height: 22px; margin-left: -5px; }
    .ba-pp-stack-item.is-rep { width: 28px; height: 28px; margin-left: 0; }
    .ba-proposers-label  { flex-basis: 100%; order: 3; }
    .ba-pp-toggle        { flex-basis: 100%; order: 4; justify-content: flex-start; }
    .ba-proposers-grid   { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .ba-bill-name {
    font-family: var(--ba-serif);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ba-ink);
    margin: 0 0 14px;
  }
  .ba-summary {
    font-family: var(--ba-serif);
    font-size: 44px;
    font-weight: 900;
    line-height: 1.15;
    color: var(--ba-ink);
    margin: 0 0 20px;
    padding-left: 18px;
    border-left: 4px solid var(--ba-gold);
    word-break: keep-all;
  }
  .ba-summary strong, .ba-summary em {
    /* 큰 헤드라인 안 강조는 언더라인 위치 보정 */
    text-underline-offset: 8px;
    text-decoration-thickness: 3px;
  }
  .ba-tagline {
    font-family: var(--ba-sans);
    font-size: 14px;
    color: var(--ba-meta);
    margin-bottom: 14px;
  }
  .ba-source-line {
    font-family: var(--ba-mono);
    font-size: 12px;
  }
  .ba-original-link {
    color: var(--ba-meta);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .ba-original-link:hover { color: var(--ba-gold); }

  /* ===== Zone 2: 핵심 변화 3카드 (8 / 4 / 4 비대칭) ===== */
  .ba-z2 .ba-cards {
    display: grid;
    grid-template-columns: 8fr 4fr 4fr;
    gap: 16px;
  }
  .ba-card {
    background: var(--ba-card-bg);
    border: 1px solid var(--ba-card-border);
    border-left: 4px solid transparent;
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }
  .ba-card-changes { border-left-color: var(--ba-gold); }
  .ba-card-benefit { border-left-color: var(--ba-ink); }
  .ba-card-loss    { border-left-color: var(--ba-meta); }
  .ba-card-empty .ba-card-body { justify-content: center; }
  .ba-card-label {
    font-family: var(--ba-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--ba-meta);
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .ba-card-body {
    font-family: var(--ba-sans);
    font-size: 18px;
    font-weight: 450;
    line-height: 1.65;
    color: var(--ba-ink);
    flex: 1;
    display: flex;
    flex-direction: column;
    word-break: keep-all;
  }
  .ba-z2 .ba-card-loss .ba-card-body,
  .ba-z2 .ba-card-benefit .ba-card-body { font-size: 16px; }
  .ba-card-sub {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--ba-card-border);
    font-size: 14px;
    color: var(--ba-sub);
    line-height: 1.6;
  }

  /* ===== Zone 3: 분석 (마진노트 + H3 + 본문) ===== */
  .ba-z3 .ba-issue {
    position: relative;
    padding: 28px 0;
    border-top: 1px solid var(--ba-card-border);
  }
  .ba-z3 .ba-issue:first-child { border-top: none; padding-top: 0; }
  .ba-margin-note {
    position: absolute;
    left: -180px;
    top: 0;
    width: 160px;
    padding-right: 24px;
    text-align: right;
    font-family: var(--ba-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--ba-meta);
    line-height: 1.6;
  }
  .ba-z3 .ba-issue:first-child .ba-margin-note { top: 0; }
  .ba-issue-title {
    font-family: var(--ba-serif);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ba-ink);
    margin: 0 0 16px;
    word-break: keep-all;
  }
  .ba-issue-body {
    font-family: var(--ba-sans);
    font-size: 18px;
    font-weight: 450;
    line-height: 1.75;
    color: var(--ba-ink);
    word-break: keep-all;
  }
  .ba-issue-body p + p { margin-top: 0.9em; }

  /* ===== Zone 5: 질문 ===== */
  .ba-z5 .ba-section-h {
    font-family: var(--ba-serif);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ba-ink);
    margin: 0 0 8px;
  }
  .ba-z5 .ba-section-hint {
    font-family: var(--ba-sans);
    font-size: 15px;
    color: var(--ba-sub);
    line-height: 1.6;
    margin: 0 0 28px;
  }
  .ba-questions {
    list-style: none;
    counter-reset: ba-q;
    margin: 0 0 32px;
    padding: 0;
  }
  .ba-questions li {
    counter-increment: ba-q;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--ba-card-border);
  }
  .ba-questions li:first-child { border-top: none; padding-top: 4px; }
  .ba-q-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--ba-gold);
    color: var(--ba-gold);
    font-family: var(--ba-mono);
    font-size: 12px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
  }
  .ba-q-num::before { content: counter(ba-q); }
  .ba-q-content { min-width: 0; }
  .ba-q-text {
    font-family: var(--ba-serif);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.55;
    color: var(--ba-ink);
    margin: 0;
    word-break: keep-all;
  }
  .ba-q-hint {
    font-family: var(--ba-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ba-meta);
    margin: 6px 0 0;
    line-height: 1.5;
  }

  .ba-cta { display: flex; gap: 10px; }
  .ba-cta-primary {
    flex: 1;
    padding: 14px 22px;
    background: var(--ba-ink);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-family: var(--ba-sans);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }
  .ba-cta-primary:hover { background: var(--ba-gold); }

  /* Zone 4 인덱스는 페이지 레벨 .pb-section-index 로 이동 (참여 섹션까지 포함) */

  /* ===== 반응형 ===== */
  @media (max-width: 1240px) {
    /* 우측 거터 회수 — 콘텐츠 가운데 정렬 */
    .ba-shell {
      grid-template-columns: minmax(0, 880px);
      padding: 0 24px;
    }
    .ba-content { grid-column: 1 / -1; }
    /* 마진노트 인라인으로 폴백 */
    .ba-margin-note {
      position: static;
      width: auto;
      text-align: left;
      padding-right: 0;
      margin-bottom: 8px;
    }
  }
  @media (max-width: 768px) {
    .ba-shell { padding: 0 16px; }
    .ba-content { font-size: 16px; line-height: 1.7; }
    .ba-content > .ba-zone + .ba-zone { margin-top: 48px; }
    .ba-summary { font-size: 30px; padding-left: 14px; border-left-width: 3px; }
    .ba-bill-name { font-size: 19px; }
    .ba-z2 .ba-cards { grid-template-columns: 1fr; gap: 12px; }
    .ba-card { padding: 22px; border-radius: 12px; }
    .ba-card-body, .ba-z2 .ba-card-loss .ba-card-body, .ba-z2 .ba-card-benefit .ba-card-body { font-size: 16px; }
    .ba-issue-title { font-size: 20px; }
    .ba-issue-body { font-size: 16px; line-height: 1.7; }
    .ba-z5 .ba-section-h { font-size: 22px; }
    .ba-q-text { font-size: 16px; }
  }

  /* Zone 1 + basic header 공용 카드 스타일 (분석 없는 분기 — 그대로) */
  .analysis-zone-1,
  .bill-basic-header {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .bill-basic-header { margin-bottom: 20px; }

  /* 메타 + 국회 원문 링크를 한 줄에 배치 */
  .zone-1-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
  }
  .zone-1-top .meta-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .zone-1-top .original-link {
    flex-shrink: 0;
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub);
    text-decoration: none;
    padding: 4px 10px;
    border: 0.5px solid var(--border);
    border-radius: 6px;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .zone-1-top .original-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-wash, #FAF6EB);
  }

  /* 메타 2줄 구조 (Zone 1 + basic header 공용) */
  .analysis-hook-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    line-height: 1.6;
  }
  .analysis-hook-meta + .analysis-hook-meta { margin-top: 0; }
  .analysis-hook-meta .sep { color: var(--border2); }
  .analysis-hook-meta a { color: var(--accent); }
  .analysis-hook-meta-block { margin-bottom: 12px; }

  .analysis-hook-title {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
    margin: 0 0 12px;
    word-break: keep-all;
  }
  .analysis-hook-summary {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 900;
    color: var(--text);
    line-height: 1.4;
    margin: 0 0 18px;
    padding: 14px 18px;
    background: var(--accent-wash, #FAF6EB);
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    word-break: keep-all;
  }
  .analysis-hook-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .analysis-hook-tags .hook-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 11px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--sub);
  }
  .analysis-hook-tags .hook-tag.tag-accent {
    background: var(--accent-10);
    border-color: var(--accent-20);
    color: var(--accent2);
  }

  /* Zone 2: 한눈에 보기 */
  .analysis-zone-2 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    position: relative;
  }
  .analysis-card {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-left: 3px solid var(--border2);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
  }
  /* 카드별 좌측보더 색 구분 — 정치색 피해서 회색·초록·주황 */
  .analysis-zone-2 .analysis-card:nth-child(1) {
    border-left-color: var(--sub2);
  }
  .analysis-zone-2 .analysis-card:nth-child(2) {
    border-left-color: var(--green);
  }
  .analysis-zone-2 .analysis-card:nth-child(2) .analysis-card-label .card-emoji {
    color: var(--green);
  }
  .analysis-zone-2 .analysis-card:nth-child(3) {
    border-left-color: #C2410C;
  }
  .analysis-zone-2 .analysis-card:nth-child(3) .analysis-card-label .card-emoji {
    color: #C2410C;
  }
  .analysis-card-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sub2);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .analysis-card-label .card-emoji { font-size: 14px; }
  .analysis-card-body {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--text);
    word-break: keep-all;
  }
  .analysis-card-body strong { font-weight: 700; }
  .analysis-card-sub {
    margin-top: 8px;
    font-size: 13px;
    color: var(--sub);
    line-height: 1.55;
  }
  .analysis-zone-2-progress {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    padding: 0 4px;
  }
  .analysis-zone-2-progress .progress-track {
    flex: 1;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .analysis-zone-2-progress .progress-fill {
    width: 30%;
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
  }

  /* Zone 3: 쟁점 */
  .analysis-zone-3 {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .analysis-zone-3-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sub);
    margin-bottom: 16px;
  }
  .issue-item {
    border-top: 1px solid var(--border);
    padding: 14px 0;
  }
  .issue-item:first-of-type { border-top: none; padding-top: 4px; }
  .issue-item:last-of-type { padding-bottom: 4px; }
  .issue-head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }
  .issue-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.02em;
    margin-top: 2px;
  }
  .issue-badge-pro { background: rgba(59,130,246,0.10); color: #2563EB; }
  .issue-badge-con { background: rgba(234,88,12,0.10);  color: #C2410C; }
  .issue-badge-gap { background: var(--bg3);            color: var(--sub); }
  .issue-title {
    flex: 1;
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    word-break: keep-all;
  }
  .issue-toggle {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--sub2);
    font-family: 'JetBrains Mono', monospace;
    margin-top: 4px;
  }
  .issue-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease, margin 0.25s ease;
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.75;
    color: var(--text);
    word-break: keep-all;
  }
  .issue-body strong { color: var(--text); font-weight: 700; }
  .issue-item.expanded .issue-body {
    max-height: 1200px;
    margin-top: 12px;
    margin-left: 24px;
  }
  .analysis-zone-3-progress {
    margin-top: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
  }
  .analysis-zone-3-progress .progress-track {
    flex: 1; height: 3px; background: var(--border); border-radius: 2px; overflow: hidden;
  }
  .analysis-zone-3-progress .progress-fill {
    width: 70%; height: 100%; background: var(--accent); border-radius: 2px;
  }

  /* Zone 4: 판단 질문 */
  .analysis-zone-4 {
    background: var(--accent-wash);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .analysis-zone-4-title {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
  }
  .analysis-zone-4-hint {
    font-size: 13px;
    color: var(--sub);
    margin-bottom: 16px;
    line-height: 1.55;
  }
  .judgment-list {
    list-style: none;
    counter-reset: judgment;
    margin: 0 0 20px;
    padding: 0;
  }
  .judgment-list li {
    counter-increment: judgment;
    position: relative;
    padding: 12px 0 12px 34px;
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--text);
    border-top: 1px solid rgba(184,116,12,0.15);
    word-break: keep-all;
  }
  .judgment-list li:first-child { border-top: none; }
  .judgment-list li::before {
    content: counter(judgment);
    position: absolute;
    left: 0; top: 12px;
    width: 22px; height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    background: var(--accent);
    color: #fff;
    border-radius: 50%;
  }
  .judgment-hint {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    color: var(--sub2);
    font-family: 'Noto Sans KR', sans-serif;
  }
  .analysis-cta {
    display: flex;
    gap: 10px;
  }
  .analysis-cta button {
    flex: 1;
    padding: 12px 18px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    font-family: inherit;
  }
  .analysis-cta .cta-secondary {
    background: var(--bg2);
    border-color: var(--border2);
    color: var(--text);
  }
  .analysis-cta .cta-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .analysis-cta .cta-primary {
    background: var(--accent);
    color: #fff;
  }
  .analysis-cta .cta-primary:hover { background: var(--accent2); }

  /* 모바일 */
  @media (max-width: 768px) {
    .analysis-hook-summary { font-size: 22px; }
    .analysis-hook-title { font-size: 19px; }
    .analysis-zone-2 { grid-template-columns: 1fr; }
    .analysis-cta { flex-direction: column; }
    .analysis-zone-1,
    .analysis-zone-3,
    .analysis-zone-4,
    .bill-basic-header { padding: 1.25rem 1.25rem; }
    .issue-item.expanded .issue-body { margin-left: 0; }
    .zone-1-top { gap: 8px; }
    .zone-1-top .original-link { font-size: 11px; padding: 3px 8px; }

    .analysis-request-section { padding: 20px 16px; }
    .request-count-display { font-size: 24px; }
  }

  /* =================================================================
     Zone 6~11 — 참여 섹션 디자인 시스템 통합
     ba-* 토큰 (5-Zone) 그대로 재사용
     ================================================================= */

  /* ===== Zone 7: 챕터 디바이더 ===== */
  .ba-chapter {
    margin: 120px -40px 48px;
    padding-top: 32px;
    border-top: 1px solid #E8E5DC;
    text-align: center;
  }
  .ba-chapter-h {
    font-family: 'Noto Serif KR', serif;
    font-weight: 900;
    font-size: 36px;
    line-height: 1.25;
    color: #0F1B1F;
    margin: 0 0 12px;
    word-break: keep-all;
  }
  .ba-chapter-sub {
    font-family: 'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
    font-size: 15px;
    color: #6B7280;
    line-height: 1.7;
    margin: 0;
    word-break: keep-all;
  }
  @media (max-width: 768px) {
    .ba-chapter { margin: 64px -16px 32px; padding-top: 24px; }
    .ba-chapter-h { font-size: 26px; }
    .ba-chapter-sub { font-size: 14px; }
  }

  /* ===== 공용 .pb-part 컨테이너 (Zone 8~11) ===== */
  .pb-part {
    background: #FAFAF7;
    border: 1px solid #E8E5DC;
    border-radius: 16px;
    padding: 32px;
    margin-bottom: 16px;
    font-family: 'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
  }
  .pb-part-head { margin-bottom: 20px; }
  .pb-part-h {
    font-family: 'Noto Serif KR', serif;
    font-weight: 700;
    font-size: 22px;
    color: #0F1B1F;
    margin: 0 0 6px;
    line-height: 1.4;
  }
  .pb-part-h-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 400;
    color: #8B8578;
    margin-left: 6px;
  }
  .pb-part-sub {
    font-size: 13px;
    color: #6B7280;
    line-height: 1.6;
    margin: 0;
  }
  .pb-part-foot {
    margin-top: 14px;
    font-size: 12px;
    color: #8B8578;
    text-align: center;
  }
  .pb-part-empty {
    padding: 40px 24px;
    text-align: center;
    color: #9B9486;
    font-style: italic;
    font-size: 14px;
  }

  /* ===== Zone 8: 국민 찬반 (cv-* 오버라이드 — 차콜 + 골드) ===== */
  .pb-part .cv-bar {
    height: 12px;
    border-radius: 6px;
    background: #EFEDE4;
    border: none;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .pb-part .cv-seg {
    color: transparent;     /* 막대 안 % 텍스트 제거, 범례에서 표시 */
    font-size: 0;
    height: 12px;
  }
  .pb-part .cv-agree    { background: #0F1B1F; }   /* 차콜 */
  .pb-part .cv-disagree { background: #8F5800; }   /* 골드 */
  .pb-part .cv-legend {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
    font-size: 13px;
    color: #374151;
  }
  .pb-part .cv-legend-item { gap: 6px; }
  .pb-part .cv-legend-item strong { color: #0F1B1F; font-weight: 700; }
  .pb-part .cv-dot { width: 8px; height: 8px; }
  .pb-part .cv-dot-agree    { background: #0F1B1F; }
  .pb-part .cv-dot-disagree { background: #8F5800; }
  .pb-part .cv-total { color: #8B8578; }
  .pb-part .cv-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .pb-part .cv-btn {
    flex: 1;
    min-width: 140px;
    padding: 12px 18px;
    background: #FFFFFF;
    border: 1px solid #D9D3C3;
    border-radius: 10px;
    color: #0F1B1F;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    justify-content: center;
  }
  .pb-part .cv-btn:hover { border-color: #8F5800; }
  .pb-part .cv-btn-agree.active,
  .pb-part .cv-btn-disagree.active {
    background: #0F1B1F;
    border-color: #0F1B1F;
    color: #FFFFFF;
    font-weight: 700;
  }
  .pb-part .cv-my-hint {
    width: 100%;
    margin: 8px 0 0;
    font-size: 12px;
    color: #8B8578;
    text-align: center;
  }

  /* ===== Zone 9: 본회의 표결 — 기존 vote-dashboard 유지, 카드 안에서 톤만 통일 ===== */
  .pb-part .vote-dashboard { gap: 12px; margin-bottom: 0; }
  .pb-part .vote-box {
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 10px;
  }
  .pb-part .vote-box:not([data-empty]):hover { border-color: #8F5800; }

  /* ===== Zone 10: 발의자 5열 그리드 ===== */
  .pb-proposers-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }
  .pb-proposer-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 10px;
    text-decoration: none;
    color: #0F1B1F;
    transition: border-color 0.15s, transform 0.15s;
    min-width: 0;
  }
  .pb-proposer-card:hover { border-color: #8F5800; transform: translateY(-1px); }
  .pb-proposer-card.is-rep { border: 1.5px solid #8F5800; }   /* 대표만 골드 외곽선 = 대표 표시 */
  .pb-proposer-card.is-retired {
    color: #9B9486;
    font-style: italic;
    cursor: default;
    background: #F3F1EA;
    border-color: #E8E5DC;
  }
  .pb-pp-avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: #F3F1EA;
  }
  .pb-pp-avatar img, .pb-pp-avatar svg { width: 100%; height: 100%; display: block; }
  .pb-pp-meta { min-width: 0; flex: 1; }
  .pb-pp-name {
    font-size: 13px;
    font-weight: 600;
    color: #0F1B1F;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }
  .pb-pp-party {
    font-size: 11px;
    color: #8B8578;
    line-height: 1.4;
  }
  .pb-proposer-card.is-retired .pb-pp-name,
  .pb-proposer-card.is-retired .pb-pp-party { color: #9B9486; }

  @media (max-width: 1024px) {
    .pb-proposers-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .pb-proposers-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ===== Zone 11: 댓글 — 알약 토글 → 텍스트 underline + 카드 흰배경 ===== */
  .pb-part .comment-write {
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 10px;
  }
  .pb-part .write-input::placeholder,
  .pb-part input::placeholder { color: #9B9486; }
  .pb-part .comment-sort { color: #8B8578; font-size: 13px; }
  .pb-part .sort-btn {
    padding: 0;
    background: transparent;
    border: none;
    color: #8B8578;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s;
  }
  .pb-part .sort-btn:hover { color: #0F1B1F; background: transparent; }
  .pb-part .sort-btn.active {
    color: #0F1B1F;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    background: transparent;
  }
  .pb-part .sort-count { color: #8B8578; font-family: 'JetBrains Mono', monospace; }
  .pb-part .comment-card {
    background: #FFFFFF;
    border: 1px solid #E8E5DC;
    border-radius: 10px;
    padding: 16px;
    box-shadow: none;
  }
  .pb-part .comment-card:hover { border-color: #D9D3C3; }
  .pb-part .comment-replies .comment-card { background: #FAFAF7; }
  .pb-part .comment-nickname { color: #0F1B1F; font-weight: 700; font-size: 14px; }
  .pb-part .comment-date { color: #8B8578; font-size: 12px; }
  .pb-part .comment-body { color: #0F1B1F; font-size: 14px; line-height: 1.7; }
  .pb-part .comment-action { color: #8B8578; }
  .pb-part .comment-action:hover { color: #0F1B1F; background: #F3F1EA; }
  .pb-part .comment-action.liked { color: #8F5800; background: rgba(143,88,0,0.08); }
  .pb-part .comment-action.liked strong { color: #8F5800; }
  .pb-part .comments-empty {
    background: transparent;
    color: #9B9486;
    font-style: italic;
    border: 1px dashed #E8E5DC;
  }

  /* ===== Zone 6: 우측 sticky 인덱스 (페이지 레벨, 데스크톱 ≥1240px) =====
     위치: 콘텐츠 우측에 붙음 (5-Zone .ba-shell 의 우측 거터 자리).
     min(콘텐츠우측+40, viewport우측-232) 로 좁은 화면에선 viewport 안쪽 클램프 */
  .pb-section-index {
    position: fixed;
    top: calc(var(--nav-h) + 32px);
    left: min(calc(50% + 480px), calc(100% - 232px));
    width: 200px;
    z-index: 40;
    font-family: 'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-height: calc(100vh - var(--nav-h) - 64px);
    /* overflow-y:auto 가 x 도 clip 하므로 좌측 도트(left:-5) 잘리는 문제 회피:
       padding-left 로 도트 영역 확보. 시각상 좌측 시작점은 그대로 보임 */
    padding-left: 8px;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .pb-section-index::-webkit-scrollbar { width: 4px; }
  .pb-section-index::-webkit-scrollbar-thumb { background: #E8E5DC; border-radius: 2px; }
  .pb-idx-group {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 1px solid #E8E5DC;     /* 그룹별 좌측 가이드 라인 */
    padding-left: 0;
  }
  .pb-idx-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: #A8A095;
    text-transform: uppercase;
    margin: 0 0 8px 22px;
  }
  .pb-idx-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 0 7px 22px;
    font-size: 12px;
    color: #6B7280;
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.15s;
  }
  .pb-idx-item::before {
    content: '';
    position: absolute;
    left: -5px;        /* 가이드 라인 위에 점 올라타게 */
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg, #F7F6F1);     /* 라인 위 점 — 라인이 점 뒤로 안 보이게 */
    border: 1px solid #C8C0AA;
    box-shadow: none;
    transition: background 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .pb-idx-item:hover { color: #0F1B1F; }
  .pb-idx-item.is-active {
    color: #0F1B1F;
    font-weight: 700;
  }
  .pb-idx-item.is-active::before {
    background: #8F5800;
    border-color: #8F5800;
    box-shadow: 0 0 0 4px rgba(143,88,0,0.12);
  }
  .pb-idx-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #A8A095;
    font-weight: 400;
  }
  /* 1240px 미만에서 인덱스 숨김 (5-Zone shell 우거터 사라지면서 시야 침범) */
  @media (max-width: 1239px) {
    .pb-section-index { display: none; }
  }

  /* ===== 모바일 floating jump bar — 모바일에서 항상 표시, 키보드 올라오면 숨김 ===== */
  .pb-mobile-jumpbar {
    position: fixed;
    bottom: max(16px, env(safe-area-inset-bottom, 16px));    /* iOS 홈 인디케이터 영역 보호 */
    left: 16px;
    right: 16px;
    height: 52px;
    border-radius: 26px;
    background: rgba(15,27,31,0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 60;
    display: none;        /* 데스크톱 기본 숨김, 모바일 미디어쿼리에서 flex */
    align-items: center;
    padding: 6px;
    gap: 4px;
    transform: translateY(0);
    opacity: 1;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .pb-mobile-jumpbar[data-visible="false"] {
    transform: translateY(120%);
    opacity: 0;
    pointer-events: none;
  }
  .pb-jb-tab {
    flex: 1;
    text-align: center;
    padding: 8px 4px;
    font-size: 12px;
    font-weight: 500;
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    border-radius: 18px;
    transition: background 0.15s, color 0.15s;
    line-height: 1.2;
    font-family: 'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
  }
  .pb-jb-tab.is-active {
    color: #FFFFFF;
    background: rgba(255,255,255,0.08);
    font-weight: 700;
  }
  .pb-jb-up {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #8F5800;
    border: none;
    color: #FFFFFF;
    font-size: 18px;
    cursor: pointer;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 4px;
  }
  .pb-jb-up:hover { background: #A36500; }
  /* sticky 인덱스가 숨겨지는 범위(<1240px) 전체에서 jumpbar 노출 — Fold 펼친 상태(~800px) 포함 */
  @media (max-width: 1239px) {
    .pb-mobile-jumpbar { display: flex; }
    /* jump bar 가 컨텐츠 가리지 않도록 하단 여백 확보 (52 + 16 + 16) */
    .bd-wrap { padding-bottom: 84px; }
  }

  /* ===== Zone 8/9 카드 모바일 padding 완화 ===== */
  @media (max-width: 768px) {
    .pb-part { padding: 22px 18px; border-radius: 12px; }
    .pb-part-h { font-size: 19px; }
  }

  /* 분석 요청 위젯 */
  .analysis-request-section {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    margin: 20px 0;
  }
  .request-header h2 {
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 6px;
  }
  .request-header p {
    color: var(--sub);
    font-size: 13px;
    margin: 0 0 18px;
  }
  .request-header strong { color: var(--accent); }
  .request-count-display {
    font-family: 'Noto Serif KR', serif;
    font-size: 32px;
    font-weight: 900;
    color: var(--accent);
    text-align: center;
    margin-bottom: 12px;
    line-height: 1.1;
  }
  .request-count-display .count-separator,
  .request-count-display .count-target {
    color: var(--sub);
    font-weight: 400;
  }
  .request-progress-bar {
    height: 8px;
    background: var(--bg3);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .request-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), #D4A442);
    transition: width 0.4s;
  }
  .threshold-reached {
    background: rgba(15,157,110,0.10);
    color: var(--green);
    border: 1px solid var(--green);
    border-radius: 8px;
    padding: 10px 14px;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .request-action { text-align: center; }
  .btn-request,
  .btn-request-done {
    display: inline-block;
    padding: 12px 28px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s;
    text-decoration: none;
  }
  .btn-request {
    background: var(--accent);
    color: #fff;
  }
  .btn-request:hover { opacity: 0.9; }
  .btn-request-done {
    background: var(--bg3);
    color: var(--accent);
    border: 1px solid var(--accent);
    cursor: default;
  }
</style>

<div class="bd-wrap">
  <div class="bd-breadcrumb"><a href="/">홈</a> / <a href="/bill">법안</a> / <%= bill.bill_no || bill.bill_id %></div>

  <% const proposeDtFmt = (bill.propose_dt || '').replace(/-/g, '.') || '—'; %>

  <!-- AI 분석 라벨 — 분석 있음/없음 두 분기 공통 명시 -->
  <div class="ai-analysis-label <%= analysis ? 'is-done' : 'is-pending' %>">
    <span class="label-tag">🤖 AI 분석</span>
    <% if (analysis) { %>
      <span class="label-note">AI가 생성한 분석으로 사실과 다를 수 있습니다</span>
      <% if (analysis.prompt_version) { %>
        <span class="label-meta"><%= analysis.prompt_version %></span>
      <% } %>
    <% } else { %>
      <span class="label-note">아직 분석되지 않은 법안입니다</span>
    <% } %>
  </div>

  <!-- AI 분석 (5-Zone) — 분석 있으면 Zone 1이 히어로, 없으면 기본 헤더 -->
  <% if (analysis) { %>
    <section class="bill-ai-analysis" id="bill-analysis"></section>
  <% } else { %>
    <section class="bill-basic-header">
      <div class="zone-1-top">
        <div class="meta-col">
          <div class="analysis-hook-meta">
            <span>#<%= bill.bill_no || bill.bill_id %></span>
            <% if (bill.committee) { %><span class="sep">·</span><span><%= bill.committee %></span><% } %>
            <span class="sep">·</span><span><%= bill.proc_result_name || '계류' %></span>
          </div>
          <div class="analysis-hook-meta">
            <% if (bill.proposer_name) { %>
              <span>대표발의
                <% if (bill.mona_cd) { %><a href="/politician/<%= bill.mona_cd %>"><%= bill.proposer_name %></a><% } else { %><%= bill.proposer_name %><% } %>
                <% if (coRepCount > 1) { %> 외 <%= coRepCount - 1 %>인 공동대표<% } %>
              </span>
              <span class="sep">·</span>
            <% } %>
            <span>발의일 <%= proposeDtFmt %></span>
            <% if (bill.co_proposer_count) { %>
              <span class="sep">·</span><span>공동발의 <%= bill.co_proposer_count %>인</span>
            <% } %>
          </div>
        </div>
        <% if (bill.link_url) { %>
          <a href="<%= bill.link_url %>" target="_blank" rel="noopener" class="original-link">국회 원문 ↗</a>
        <% } %>
      </div>
      <h1 class="analysis-hook-title" style="margin-bottom:0"><%= bill.bill_name %></h1>
    </section>

    <!-- AI 분석 요청 위젯 (미분석일 때만 노출) -->
    <%
      const reqCount       = Number(analysisRequestCount || 0);
      const reqThreshold   = Number(requestThreshold || 5);
      const reqPct         = Math.min(100, (reqCount / reqThreshold) * 100);
      const isLoggedIn     = Boolean(currentUser);
      const reachedThreshold = reqCount >= reqThreshold;
    %>
    <section class="analysis-request-section" id="analysis-request-widget"
             data-bill-id="<%= bill.bill_id %>"
             data-count="<%= reqCount %>"
             data-threshold="<%= reqThreshold %>"
             data-has-requested="<%= hasRequested ? '1' : '0' %>"
             data-logged-in="<%= isLoggedIn ? '1' : '0' %>">
      <div class="request-header">
        <h2>이 법안의 AI 분석이 아직 없어요</h2>
        <p>요청이 <strong><%= reqThreshold %>명</strong>에 도달하면 우선 분석됩니다.</p>
      </div>

      <div class="request-count-display">
        <span class="count-current"><%= reqCount %></span><span class="count-separator"> / </span><span class="count-target"><%= reqThreshold %>명</span>
      </div>

      <div class="request-progress-bar">
        <div class="request-progress-fill" style="width: <%= reqPct.toFixed(2) %>%"></div>
      </div>

      <% if (reachedThreshold) { %>
        <div class="threshold-reached">충분한 요청이 모였어요. 곧 분석됩니다.</div>
      <% } %>

      <div class="request-action">
        <% if (!isLoggedIn) { %>
          <a href="/auth/login?next=<%= encodeURIComponent(currentUrl) %>" class="btn-request">
            로그인하고 분석 요청하기
          </a>
        <% } else if (hasRequested) { %>
          <button type="button" class="btn-request-done" disabled>✓ 요청했어요</button>
        <% } else { %>
          <button type="button" class="btn-request" id="btn-request-analysis">
            이 법안 분석 요청하기
          </button>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- ============ Zone 7: 분석 → 참여 챕터 디바이더 ============ -->
  <div class="ba-chapter">
    <h2 class="ba-chapter-h">이제 당신이 답할 차례입니다</h2>
    <p class="ba-chapter-sub">법안에 찬반을 표시하고, 다른 시민들의 의견을 읽어보세요</p>
  </div>

  <!-- ============ Zone 8: 국민 찬반 ============ -->
  <section class="pb-part" id="citizen-vote-section">
    <div class="pb-part-head">
      <h3 class="pb-part-h">국민 찬반</h3>
      <p class="pb-part-sub">국회의원의 본회의 표결과 별개로, 이 서비스에 로그인한 국민들의 찬반을 집계합니다.</p>
    </div>
    <div id="citizen-vote-widget"></div>
  </section>

  <!-- ============ Zone 9: 본회의 표결 결과 ============ -->
  <% const hasVotes = voteCounts.agree + voteCounts.disagree + voteCounts.abstain + voteCounts.absent > 0; %>
  <section class="pb-part" id="part-floor-vote">
    <div class="pb-part-head">
      <h3 class="pb-part-h">본회의 표결 결과</h3>
    </div>
    <% if (hasVotes) { %>
      <div class="vote-dashboard">
        <% ['agree','disagree','abstain','absent'].forEach(b => {
             const labels = { agree:'찬성', disagree:'반대', abstain:'기권', absent:'불참' };
             const c = voteCounts[b];
        %>
          <button type="button" class="vote-box <%= b %>" data-bucket="<%= b %>"<% if (!c) { %> data-empty aria-disabled="true"<% } %>>
            <strong><%= labels[b] %></strong>
            <span class="vote-count"><%= nf(c) %></span>
            <span class="vote-hint">명단 보기</span>
          </button>
        <% }); %>
      </div>
      <div class="pb-part-foot">각 박스를 누르면 표결 의원 명단이 열립니다.</div>
    <% } else { %>
      <div class="pb-part-empty">본회의 표결 데이터가 아직 수집되지 않았습니다.</div>
    <% } %>
  </section>

  <!-- 발의자 섹션은 Zone 1 헤더 메타라인 직하 컴팩트 스택으로 통합됨 (mountBillAnalysis) -->

  <!-- ============ Zone 11: 국민 의견 ============ -->
  <section class="pb-part" id="part-comments">
    <div class="pb-part-head">
      <h3 class="pb-part-h">국민 의견</h3>
    </div>
    <div id="comment-widget"></div>
  </section>
</div>

<!-- ============ Zone 6: 우측 sticky 인덱스 (페이지 레벨, 데스크톱 전용) ============ -->
<nav class="pb-section-index" id="pb-section-index" aria-label="섹션 인덱스">
  <% if (analysis) { %>
    <div class="pb-idx-group">
      <div class="pb-idx-label">AI 분석</div>
      <a class="pb-idx-item" href="#ba-summary"   data-idx="ba-summary">요약</a>
      <a class="pb-idx-item" href="#ba-changes"   data-idx="ba-changes">핵심 변화</a>
      <% if (analysis.issues && analysis.issues.length) { %>
        <a class="pb-idx-item" href="#ba-analysis" data-idx="ba-analysis">분석</a>
      <% } %>
      <% if (analysis.judgment_questions && analysis.judgment_questions.length) { %>
        <a class="pb-idx-item" href="#ba-questions" data-idx="ba-questions">함께 생각</a>
      <% } %>
    </div>
  <% } %>
  <div class="pb-idx-group">
    <div class="pb-idx-label">참여</div>
    <a class="pb-idx-item" href="#citizen-vote-section" data-idx="citizen-vote-section">
      국민 찬반 <span class="pb-idx-count" data-count-citizen>—</span>
    </a>
    <a class="pb-idx-item" href="#part-floor-vote" data-idx="part-floor-vote">
      본회의 표결 <span class="pb-idx-count"><%= hasVotes ? nf(voteCounts.agree + voteCounts.disagree + voteCounts.abstain + voteCounts.absent) : '—' %></span>
    </a>
    <a class="pb-idx-item" href="#part-comments" data-idx="part-comments">
      의견 <span class="pb-idx-count" data-count-comments>—</span>
    </a>
  </div>
</nav>

<!-- ============ 모바일 floating jump bar ============ -->
<nav class="pb-mobile-jumpbar" id="pb-mobile-jumpbar" aria-label="빠른 이동" data-visible="false">
  <% if (analysis) { %>
    <a class="pb-jb-tab" href="#ba-summary"  data-idx="ba-summary">요약</a>
    <a class="pb-jb-tab" href="#ba-analysis" data-idx="ba-analysis">분석</a>
  <% } %>
  <a class="pb-jb-tab" href="#citizen-vote-section" data-idx="citizen-vote-section">찬반</a>
  <a class="pb-jb-tab" href="#part-comments"     data-idx="part-comments">의견</a>
  <button type="button" class="pb-jb-up" id="pb-jb-up" aria-label="맨 위로">↑</button>
</nav>

<!-- 표결 의원 명단 모달 -->
<% if (hasVotes) { %>
  <div class="pb-modal voter-modal" id="voter-modal" hidden role="dialog" aria-modal="true" aria-labelledby="voter-modal-title">
    <div class="pb-modal-backdrop" data-voter-close></div>
    <div class="pb-modal-card">
      <div class="voter-modal-head">
        <div class="voter-modal-title" id="voter-modal-title"><span class="tc-dot"></span><span class="tc-text"></span></div>
        <button type="button" class="voter-modal-close" aria-label="닫기" data-voter-close>×</button>
      </div>
      <div class="voter-modal-filters" id="voter-modal-filters"></div>
      <div class="voter-modal-search">
        <input type="search" id="voter-modal-search-input" placeholder="이름 검색" autocomplete="off" spellcheck="false">
      </div>
      <div class="voter-modal-grid" id="voter-modal-grid"></div>
    </div>
  </div>
<% } %>

<%# AI 분석 데이터 주입 — </script> 이스케이프로 XSS 방어 %>
<% if (analysis) { %>
<script>
  window.__BILL_ANALYSIS__ = <%- JSON.stringify(analysis).replace(/</g, '\\u003c') %>;
</script>
<% } else { %>
<script>window.__BILL_ANALYSIS__ = null;</script>
<% } %>

<script>
  window.__BILL_PROPOSERS__ = <%- JSON.stringify(
    (coProposers || []).map(cp => ({
      mona_cd:    cp.mona_cd || null,
      name:       cp.name    || null,
      party_name: cp.party_name || null,
      photo:      cp.photo_url  || null,
      is_rep:     Boolean(cp.proposer_yn)
    }))
  ).replace(/</g, '\\u003c') %>;
</script>

<% if (hasVotes) { %>
<script>
  window.__BILL_VOTERS__ = <%- JSON.stringify({
    agree:    voters.agree.map(v    => ({ mona_cd: v.mona_cd, name: v.name || null, party: v.party_name || null, photo: v.photo_url || null })),
    disagree: voters.disagree.map(v => ({ mona_cd: v.mona_cd, name: v.name || null, party: v.party_name || null, photo: v.photo_url || null })),
    abstain:  voters.abstain.map(v  => ({ mona_cd: v.mona_cd, name: v.name || null, party: v.party_name || null, photo: v.photo_url || null })),
    absent:   voters.absent.map(v   => ({ mona_cd: v.mona_cd, name: v.name || null, party: v.party_name || null, photo: v.photo_url || null }))
  }).replace(/</g, '\\u003c') %>;
</script>
<% } else { %>
<script>window.__BILL_VOTERS__ = null;</script>
<% } %>

<script>
(() => {
  const BILL_ID = '<%= bill.bill_id %>';
  const mount = () => {
    if (!window.PB) return setTimeout(mount, 30);
    PB.mountCitizenVote({ containerId: 'citizen-vote-widget', billId: BILL_ID });
    PB.mountComments({ containerId: 'comment-widget', type: 'bill', targetId: BILL_ID });
    if (window.__BILL_ANALYSIS__ && typeof PB.mountBillAnalysis === 'function') {
      PB.mountBillAnalysis({
        containerId: 'bill-analysis',
        analysisData: window.__BILL_ANALYSIS__,
        proposers: window.__BILL_PROPOSERS__ || [],
        bill: {
          bill_id:            BILL_ID,
          bill_no:            '<%= bill.bill_no || "" %>',
          bill_name:          <%- JSON.stringify(bill.bill_name || '').replace(/</g, '\\u003c') %>,
          proposer:           <%- JSON.stringify(bill.proposer_name || '').replace(/</g, '\\u003c') %>,
          proposer_mona_cd:   <%- JSON.stringify(bill.mona_cd || '').replace(/</g, '\\u003c') %>,
          propose_dt:         <%- JSON.stringify(bill.propose_dt || '').replace(/</g, '\\u003c') %>,
          co_proposer_count:  <%= Number(bill.co_proposer_count || 0) %>,
          co_rep_count:       <%= Number(coRepCount || 0) %>,
          status:             <%- JSON.stringify(bill.proc_result_name || '계류').replace(/</g, '\\u003c') %>,
          committee:          <%- JSON.stringify(bill.committee || '').replace(/</g, '\\u003c') %>,
          link_url:           <%- JSON.stringify(bill.link_url || '').replace(/</g, '\\u003c') %>
        },
        scrollTargetId: 'citizen-vote-section'
      });
    }
    if (typeof PB.mountAnalysisRequest === 'function') {
      PB.mountAnalysisRequest({ containerId: 'analysis-request-widget' });
    }
  };
  mount();

  /* =========================================================
     Zone 6 — 페이지 인덱스 (sticky right) + 모바일 jumpbar
     ========================================================= */
  const allIdxItems = document.querySelectorAll('.pb-idx-item, .pb-jb-tab');
  const idxTargetIds = [...new Set([...allIdxItems].map(a => a.dataset.idx).filter(Boolean))];

  // 오프셋: 고정 nav-h(데스크톱 100/모바일 60) + 20 여유. CSS 변수에서 동적 읽기
  const getScrollOffset = () => {
    const v = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 100;
    return v + 20;
  };

  // 클릭 시 헤더 오프셋 보정 스크롤
  allIdxItems.forEach(a => {
    a.addEventListener('click', (e) => {
      const id = a.dataset.idx;
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      window.scrollTo({
        top: target.getBoundingClientRect().top + window.scrollY - getScrollOffset(),
        behavior: 'smooth'
      });
    });
  });

  // 활성 섹션 표시 — 스크롤 기반 트리거 (마지막 섹션도 안정적으로 잡힘).
  // 주의: 5-Zone (ba-summary 등) 은 mountBillAnalysis 가 동적 주입하므로 DOM 대기 필요.
  const setActive = (id) => {
    allIdxItems.forEach(a => a.classList.toggle('is-active', a.dataset.idx === id));
  };
  let scrollRaf = 0;
  const updateActive = () => {
    scrollRaf = 0;
    // 페이지 끝에 도달했으면(짧은 마지막 섹션이 trigger 라인까지 못 올라감) 마지막 섹션 강제 활성
    const docHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
    const reachedBottom = (window.innerHeight + window.scrollY) >= (docHeight - 24);
    if (reachedBottom && idxTargetIds.length) {
      setActive(idxTargetIds[idxTargetIds.length - 1]);
      return;
    }
    const triggerLine = getScrollOffset();
    let activeId = null;
    // DOM 순서대로 순회 → top <= triggerLine 인 마지막 섹션 = 현재 위치
    for (const id of idxTargetIds) {
      const el = document.getElementById(id);
      if (!el) continue;
      const top = el.getBoundingClientRect().top;
      if (top <= triggerLine) activeId = id;
    }
    // 페이지 맨 위라 아무것도 안 걸리면 첫 섹션
    if (!activeId && idxTargetIds.length) activeId = idxTargetIds[0];
    if (activeId) setActive(activeId);
  };
  const onScrollIdx = () => {
    if (scrollRaf) return;
    scrollRaf = requestAnimationFrame(updateActive);
  };
  const setupIndexObserver = (retry = 0) => {
    // 5-Zone 분석 있을 땐 ba-summary 가 주입될 때까지 대기 (최대 ~3초)
    if (window.__BILL_ANALYSIS__ && !document.getElementById('ba-summary') && retry < 60) {
      return setTimeout(() => setupIndexObserver(retry + 1), 50);
    }
    if (!idxTargetIds.length) return;
    window.addEventListener('scroll', onScrollIdx, { passive: true });
    window.addEventListener('resize',  onScrollIdx, { passive: true });
    updateActive();
  };
  setupIndexObserver();

  // 동적 카운트 채우기 — 찬반/의견 (서버에 미리 없는 값). PB 로드 후 수행
  const fillCount = (selector, value) => {
    document.querySelectorAll(selector).forEach(el => { el.textContent = value; });
  };
  const loadCounts = async () => {
    if (!window.PB) return setTimeout(loadCounts, 50);
    try {
      const d = await PB.fetch(`/api/votes/bill/${encodeURIComponent(BILL_ID)}`);
      fillCount('[data-count-citizen]', d.total != null ? d.total : '—');
    } catch (_) {}
    try {
      const d = await PB.fetch(`/api/comments?type=bill&targetId=${encodeURIComponent(BILL_ID)}`);
      const items = Array.isArray(d) ? d : (d.items || []);
      const visible = items.filter(c => !c.is_deleted).length;
      fillCount('[data-count-comments]', visible);
    } catch (_) {}
  };
  loadCounts();

  // 모바일 jumpbar — 항상 표시, input/textarea focus 시에만 숨김
  // (visualViewport 휴리스틱은 모바일 브라우저 URL bar 자동 토글에 오작동하므로 사용 안 함)
  const jumpbar = document.getElementById('pb-mobile-jumpbar');
  if (jumpbar) {
    // jumpbar 를 body 직속으로 이전 — .pb-main(position:relative; z-index:1) 의 스태킹 컨텍스트
    // 안에 있으면 footer(z-index:1) 가 위로 올라와 가려짐. body 레벨로 빼야 z-index 60 이 진짜로 위.
    if (jumpbar.parentNode !== document.body) document.body.appendChild(jumpbar);
    const isInput = (el) => !!(el && el.matches && el.matches('input, textarea, [contenteditable=""], [contenteditable="true"]'));
    const isInputFocused = () => isInput(document.activeElement);
    const setJumpbar = (visible) => { jumpbar.dataset.visible = visible ? 'true' : 'false'; };
    setJumpbar(true);
    // 포커스 진입 시 input 이면 숨김. 그 외 어떤 이유로도 활성 input 이 없으면 항상 visible.
    document.addEventListener('focusin',  () => { setJumpbar(!isInputFocused()); });
    document.addEventListener('focusout', () => {
      // focusout 직후 activeElement 는 잠시 body 일 수 있음 → 마이크로타스크 후 재확인
      setTimeout(() => setJumpbar(!isInputFocused()), 0);
    });
    document.getElementById('pb-jb-up')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  /* =========================================================
     본회의 표결 명단 모달
     ========================================================= */
  const voters = window.__BILL_VOTERS__;
  const modal = document.getElementById('voter-modal');
  if (!voters || !modal) return;

  const BUCKET_LABEL = { agree: '찬성', disagree: '반대', abstain: '기권', absent: '불참' };
  const RETIRED_KEY = '__retired__';
  const titleEl   = modal.querySelector('.voter-modal-title');
  const titleText = titleEl.querySelector('.tc-text');
  const filterEl  = document.getElementById('voter-modal-filters');
  const gridEl    = document.getElementById('voter-modal-grid');
  const searchEl  = document.getElementById('voter-modal-search-input');
  const esc = (s) => (window.PB && PB.escapeHtml) ? PB.escapeHtml(s) : String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const avatar = (name, photo) => {
    if (photo) return `<img src="${esc(photo)}" alt="${esc(name || '')}" style="width:100%;height:100%;object-fit:cover">`;
    return (window.PB && PB.avatarSvg) ? PB.avatarSvg(name || '', 28) : '';
  };
  const partyClassOf = (name) => {
    if (!name) return 'cp-etc';
    if (name.indexOf('더불어민주') > -1) return 'cp-minjoo';
    if (name.indexOf('국민의힘')   > -1) return 'cp-gukhim';
    if (name.indexOf('조국혁신')   > -1) return 'cp-jokuk';
    if (name.indexOf('개혁')       > -1) return 'cp-gaehyuk';
    if (name.indexOf('진보')       > -1) return 'cp-jinbo';
    return 'cp-etc';
  };

  let currentBucket = null;
  let currentFilter = 'all';
  let currentQuery  = '';

  const sortByName = (list) => list.slice().sort((a, b) => {
    const an = a.name || '￿', bn = b.name || '￿'; // 퇴임은 맨 뒤
    return an.localeCompare(bn, 'ko');
  });

  const buildPartyIndex = (list) => {
    const map = new Map();
    for (const v of list) {
      const key = v.name ? (v.party || '무소속') : RETIRED_KEY;
      if (!map.has(key)) map.set(key, 0);
      map.set(key, map.get(key) + 1);
    }
    return [...map.entries()].sort((a, b) => {
      if (a[0] === RETIRED_KEY) return 1;
      if (b[0] === RETIRED_KEY) return -1;
      return b[1] - a[1]; // 인원 많은 순
    });
  };

  const renderGrid = () => {
    const q = currentQuery;
    const list = sortByName(voters[currentBucket].filter(v => {
      if (currentFilter === RETIRED_KEY) { if (v.name) return false; }
      else if (currentFilter !== 'all')  { if (!v.name || (v.party || '무소속') !== currentFilter) return false; }
      if (q && !PB.matchesQuery(v.name || '', q)) return false;
      return true;
    }));
    if (list.length === 0) {
      const msg = q ? `"${esc(q)}" 에 해당하는 의원이 없습니다.` : '해당 조건의 의원이 없습니다.';
      gridEl.innerHTML = `<div class="voter-modal-empty">${msg}</div>`;
      return;
    }
    const chips = list.map(v => {
      if (v.name) {
        const pc = partyClassOf(v.party);
        return `<a href="/politician/${esc(v.mona_cd)}" class="proposer-chip ${pc}" style="text-decoration:none">
          <div class="avatar">${avatar(v.name, v.photo)}</div>
          <div style="min-width:0;overflow:hidden">
            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(v.name)}</div>
            <div class="party-sm">${esc(v.party || '무소속')}</div>
          </div>
        </a>`;
      }
      return `<div class="proposer-chip retired" title="22대 임기 중 퇴임 의원">
        <div class="avatar">${avatar(null, null)}</div>
        <div style="min-width:0;overflow:hidden">
          <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">(퇴임)</div>
          <div class="party-sm">—</div>
        </div>
      </div>`;
    }).join('');
    gridEl.innerHTML = `<div class="proposers-grid">${chips}</div>`;
  };

  const renderFilters = () => {
    const idx = buildPartyIndex(voters[currentBucket]);
    const totalClickable = voters[currentBucket].length;
    const btns = [`<button type="button" class="voter-filter-chip${currentFilter === 'all' ? ' active' : ''}" data-party="all">전체<span class="chip-count">${totalClickable}</span></button>`];
    for (const [key, count] of idx) {
      const isRetired = key === RETIRED_KEY;
      const label = isRetired ? '퇴임' : key;
      btns.push(`<button type="button" class="voter-filter-chip${currentFilter === key ? ' active' : ''}" data-party="${esc(key)}">${esc(label)}<span class="chip-count">${count}</span></button>`);
    }
    filterEl.innerHTML = btns.join('');
  };

  const openModal = (bucket) => {
    currentBucket = bucket;
    currentFilter = 'all';
    currentQuery  = '';
    searchEl.value = '';
    titleEl.className = 'voter-modal-title ' + bucket;
    titleText.textContent = `${BUCKET_LABEL[bucket]} ${voters[bucket].length}명`;
    renderFilters();
    renderGrid();
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    gridEl.scrollTop = 0;
  };

  const closeModal = () => {
    modal.hidden = true;
    document.body.style.overflow = '';
  };

  document.querySelectorAll('.vote-box[data-bucket]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.hasAttribute('data-empty')) return;
      openModal(btn.dataset.bucket);
    });
  });

  modal.addEventListener('click', (e) => {
    if (e.target.closest('[data-voter-close]')) closeModal();
  });
  filterEl.addEventListener('click', (e) => {
    const chip = e.target.closest('.voter-filter-chip');
    if (!chip) return;
    currentFilter = chip.dataset.party;
    renderFilters();
    renderGrid();
    gridEl.scrollTop = 0;
  });
  searchEl.addEventListener('input', () => {
    currentQuery = searchEl.value.trim();
    renderGrid();
    gridEl.scrollTop = 0;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
})();
</script>
