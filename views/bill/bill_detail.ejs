<%
  const nf = (n) => Number(n || 0).toLocaleString('ko-KR');
  const resultClass = (r) => {
    if (!r) return 'pb-badge-pending';
    if (r.indexOf('가결') > -1) return 'pb-badge-passed';
    if (r === '부결' || r === '폐기') return 'pb-badge-rejected';
    if (r === '철회') return 'pb-badge-withdrawn';
    if (r.indexOf('대안') > -1) return 'pb-badge-alt';
    return 'pb-badge-pending';
  };
%>

<style>
  .bd-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 24px 60px;
  }
  .bd-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    margin-bottom: 18px;
  }
  .bd-breadcrumb a { color: var(--accent); }
  .bd-header {
    padding: 28px 32px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 20px;
  }
  .bd-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .bd-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
    margin-bottom: 14px;
  }
  .bd-meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--sub);
  }
  .bd-meta strong { color: var(--text); font-weight: 500; }
  .bd-meta a { color: var(--accent); }

  .bd-section {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 18px;
  }
  .bd-section h2 {
    font-size: 15px;
    font-weight: 600;
    color: var(--sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 18px;
  }
  .bd-external {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border: 1px solid var(--border2);
    border-radius: 8px;
    color: var(--text);
    font-size: 14px;
  }
  .bd-external:hover { border-color: var(--accent); color: var(--accent); }

  .vote-dashboard {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }
  .vote-box {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg3);
    text-align: center;
  }
  .vote-box strong {
    display: block;
    font-size: 12px;
    color: var(--sub);
    margin-bottom: 8px;
  }
  .vote-box span {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    line-height: 1;
  }
  .vote-box.agree    span { color: var(--green); }
  .vote-box.disagree span { color: var(--red); }
  .vote-box.abstain  span { color: var(--accent); }
  .vote-box.absent   span { color: var(--sub); }

  .vote-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .vote-list-container {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 18px;
    max-height: 280px;
    overflow-y: auto;
  }
  .vote-list-container h3 {
    font-size: 13px;
    color: var(--sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 12px;
  }
  .voter-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .voter-list li a {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    font-size: 13px;
    color: var(--text);
  }
  .voter-list li a:hover { color: var(--accent); }
  .voter-list .party { color: var(--sub); font-size: 12px; }

  .proposers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
  }
  .proposer-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 13px;
    color: var(--text);
  }
  .proposer-chip.rep { border-color: var(--accent); background: rgba(184,116,12,0.08); }
  .proposer-chip .avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
  }
  .proposer-chip .avatar img,
  .proposer-chip .avatar svg { width: 100%; height: 100%; display: block; }
  .proposer-chip .party-sm { color: var(--sub); font-size: 11px; }

  @media (max-width: 768px) {
    .vote-dashboard { grid-template-columns: repeat(2, 1fr); }
    .vote-lists { grid-template-columns: 1fr; }
  }
</style>

<div class="bd-wrap">
  <div class="bd-breadcrumb"><a href="/">홈</a> / <a href="/bill">법안</a> / <%= bill.bill_no || bill.bill_id %></div>

  <div class="bd-header">
    <div class="bd-meta-row">
      <% if (bill.bill_topic_nm) { %><span class="pb-badge pb-badge-category"><%= bill.bill_topic_nm %></span><% } %>
      <span class="pb-badge <%= resultClass(bill.proc_result_name) %>"><%= bill.proc_result_name || '계류' %></span>
      <span style="font-family:'JetBrains Mono';font-size:12px;color:var(--sub2);margin-left:auto">#<%= bill.bill_no || bill.bill_id %></span>
    </div>
    <h1 class="bd-title"><%= bill.bill_name %></h1>
    <div class="bd-meta">
      <% if (bill.proposer_name) { %>
        <span><strong>대표발의</strong>
          <% if (bill.mona_cd) { %><a href="/politician/<%= bill.mona_cd %>"><%= bill.proposer_name %></a>
          <% } else { %><%= bill.proposer_name %><% } %>
        </span>
      <% } %>
      <span><strong>발의일</strong> <%= bill.propose_dt || '—' %></span>
      <% if (bill.committee) { %><span><strong>소관위</strong> <%= bill.committee %></span><% } %>
      <% if (bill.co_proposer_count) { %><span><strong>공동발의</strong> <%= bill.co_proposer_count %>인</span><% } %>
    </div>
  </div>

  <% if (bill.link_url) { %>
    <div style="margin-bottom:16px">
      <a href="<%= bill.link_url %>" target="_blank" rel="noopener" class="bd-external">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        국회 원문 보기
      </a>
    </div>
  <% } %>

  <!-- 시민 찬반 -->
  <div class="bd-section">
    <h2>// 시민 찬반
      <a href="/glossary#vote-for" class="pb-help" title="로그인한 시민들의 찬반 — 국회의원 표결과는 별개">?</a>
    </h2>
    <div id="citizen-vote-widget"></div>
    <div style="margin-top:12px;font-size:12px;color:var(--sub2);line-height:1.7">
      국회의원의 본회의 표결과 별개로, 이 서비스에 로그인한 시민들의 찬반을 집계합니다.
    </div>
  </div>

  <div class="bd-section">
    <h2>// 본회의 표결 결과</h2>
    <% const hasVotes = voteCounts.agree + voteCounts.disagree + voteCounts.abstain + voteCounts.absent > 0; %>
    <% if (hasVotes) { %>
      <div class="vote-dashboard">
        <div class="vote-box agree"><strong>찬성</strong><span><%= nf(voteCounts.agree) %></span></div>
        <div class="vote-box disagree"><strong>반대</strong><span><%= nf(voteCounts.disagree) %></span></div>
        <div class="vote-box abstain"><strong>기권</strong><span><%= nf(voteCounts.abstain) %></span></div>
        <div class="vote-box absent"><strong>불참</strong><span><%= nf(voteCounts.absent) %></span></div>
      </div>

      <div class="vote-lists">
        <div class="vote-list-container">
          <h3>찬성 의원 (<%= voteCounts.agree %>명)</h3>
          <ul class="voter-list">
            <% voters.agree.forEach(v => { %>
              <li><a href="/politician/<%= v.mona_cd %>"><span><%= v.name || v.mona_cd %></span><span class="party"><%= v.party_name || '' %></span></a></li>
            <% }); %>
          </ul>
        </div>
        <div class="vote-list-container">
          <h3>반대 의원 (<%= voteCounts.disagree %>명)</h3>
          <ul class="voter-list">
            <% voters.disagree.forEach(v => { %>
              <li><a href="/politician/<%= v.mona_cd %>"><span><%= v.name || v.mona_cd %></span><span class="party"><%= v.party_name || '' %></span></a></li>
            <% }); %>
            <% if (voters.disagree.length === 0) { %><li style="color:var(--sub2);font-size:12px">반대 의원이 없습니다.</li><% } %>
          </ul>
        </div>
        <div class="vote-list-container">
          <h3>기권 의원 (<%= voteCounts.abstain %>명)</h3>
          <ul class="voter-list">
            <% voters.abstain.forEach(v => { %>
              <li><a href="/politician/<%= v.mona_cd %>"><span><%= v.name || v.mona_cd %></span><span class="party"><%= v.party_name || '' %></span></a></li>
            <% }); %>
            <% if (voters.abstain.length === 0) { %><li style="color:var(--sub2);font-size:12px">기권 의원이 없습니다.</li><% } %>
          </ul>
        </div>
        <div class="vote-list-container">
          <h3>불참 의원 (<%= voteCounts.absent %>명)</h3>
          <ul class="voter-list">
            <% voters.absent.slice(0, 60).forEach(v => { %>
              <li><a href="/politician/<%= v.mona_cd %>"><span><%= v.name || v.mona_cd %></span><span class="party"><%= v.party_name || '' %></span></a></li>
            <% }); %>
            <% if (voters.absent.length > 60) { %><li style="color:var(--sub2);font-size:11px">... 외 <%= voters.absent.length - 60 %>명</li><% } %>
          </ul>
        </div>
      </div>
    <% } else { %>
      <div style="padding:32px;text-align:center;color:var(--sub);background:var(--bg3);border:1px dashed var(--border);border-radius:8px">
        본회의 표결 데이터가 아직 수집되지 않았습니다.
      </div>
    <% } %>
  </div>

  <% if (coProposers && coProposers.length > 0) { %>
    <div class="bd-section">
      <h2>// 발의자 (<%= coProposers.length %>명)</h2>
      <div class="proposers-grid">
        <% coProposers.forEach(cp => { %>
          <a href="/politician/<%= cp.mona_cd %>" class="proposer-chip <%= cp.proposer_yn ? 'rep' : '' %>" style="text-decoration:none">
            <div class="avatar">
              <%- avatarHtml(cp.name, cp.photo_url, 28) %>
            </div>
            <div style="min-width:0;overflow:hidden">
              <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= cp.name || cp.mona_cd %><% if (cp.proposer_yn) { %> <span style="color:var(--accent);font-size:11px">(대표)</span><% } %></div>
              <div class="party-sm"><%= cp.party_name || '' %></div>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- 시민 댓글 -->
  <div class="bd-section">
    <h2>// 시민 의견</h2>
    <div id="comment-widget"></div>
  </div>
</div>

<script>
(() => {
  const BILL_ID = '<%= bill.bill_id %>';
  const mount = () => {
    if (!window.PB) return setTimeout(mount, 30);
    PB.mountCitizenVote({ containerId: 'citizen-vote-widget', billId: BILL_ID });
    PB.mountComments({ containerId: 'comment-widget', type: 'bill', targetId: BILL_ID });
  };
  mount();
})();
</script>
