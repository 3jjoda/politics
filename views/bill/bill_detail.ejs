<%
  const nf = (n) => Number(n || 0).toLocaleString('ko-KR');
  const resultClass = (r) => {
    if (!r) return 'pb-badge-pending';
    if (r.indexOf('가결') > -1) return 'pb-badge-passed';
    if (r === '부결' || r === '폐기') return 'pb-badge-rejected';
    if (r === '철회') return 'pb-badge-withdrawn';
    if (r.indexOf('대안') > -1) return 'pb-badge-alt';
    return 'pb-badge-pending';
  };
  const termAnchor = (r) => {
    if (!r) return 'pending';
    if (r === '원안가결')      return 'original';
    if (r === '수정가결')      return 'modified';
    if (r === '대안반영폐기')  return 'alt-dropped';
    if (r === '수정안반영폐기') return 'mod-dropped';
    if (r === '철회')          return 'withdrawn';
    if (r === '부결')          return 'rejected';
    if (r === '폐기')          return 'dropped';
    return 'pending';
  };
%>

<style>
  .bd-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: calc(var(--nav-h) + 28px) 24px 60px;
  }
  .bd-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    margin-bottom: 18px;
  }
  .bd-breadcrumb a { color: var(--accent); }
  .bd-header {
    padding: 28px 32px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 20px;
  }
  .bd-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .bd-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
    margin-bottom: 14px;
  }
  .bd-meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--sub);
  }
  .bd-meta strong { color: var(--text); font-weight: 500; }
  .bd-meta a { color: var(--accent); }

  .bd-section {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 18px;
  }
  .bd-section h2 {
    font-size: 15px;
    font-weight: 600;
    color: var(--sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 18px;
  }
  .bd-external {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border: 1px solid var(--border2);
    border-radius: 8px;
    color: var(--text);
    font-size: 14px;
  }
  .bd-external:hover { border-color: var(--accent); color: var(--accent); }

  .vote-dashboard {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }
  .vote-box {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg3);
    text-align: center;
  }
  .vote-box strong {
    display: block;
    font-size: 12px;
    color: var(--sub);
    margin-bottom: 8px;
  }
  .vote-box span {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    line-height: 1;
  }
  .vote-box.agree    span { color: var(--green); }
  .vote-box.disagree span { color: var(--red); }
  .vote-box.abstain  span { color: var(--accent); }
  .vote-box.absent   span { color: var(--sub); }

  .vote-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .vote-list-container {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 18px;
    max-height: 280px;
    overflow-y: auto;
  }
  .vote-list-container h3 {
    font-size: 13px;
    color: var(--sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 12px;
  }
  .voter-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .voter-list li a {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    font-size: 13px;
    color: var(--text);
  }
  .voter-list li a:hover { color: var(--accent); }
  .voter-list .party { color: var(--sub); font-size: 12px; }

  .proposers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
  }
  .proposer-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 13px;
    color: var(--text);
  }
  .proposer-chip.rep { border-color: var(--accent); background: rgba(184,116,12,0.08); }
  .proposer-chip .avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
  }
  .proposer-chip .avatar img,
  .proposer-chip .avatar svg { width: 100%; height: 100%; display: block; }
  .proposer-chip .party-sm { color: var(--sub); font-size: 11px; }

  @media (max-width: 768px) {
    .vote-dashboard { grid-template-columns: repeat(2, 1fr); }
    .vote-lists { grid-template-columns: 1fr; }
  }

  /* =========================================================
     AI 분석 섹션 (UI_ANALYSIS.md 5-Zone)
     ========================================================= */
  .bill-ai-analysis {
    --accent-wash: #FAF6EB;
    --serif: 'Noto Serif KR', 'Noto Sans KR', serif;
    margin-bottom: 20px;
  }
  .bill-ai-analysis > * + * { margin-top: 1.25rem; }
  .bill-ai-analysis .accent { color: var(--accent); font-weight: 700; }

  /* Zone 1: 훅 */
  .analysis-zone-1 {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .analysis-hook-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    margin-bottom: 10px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .analysis-hook-meta span + span::before {
    content: '·';
    margin-right: 10px;
    color: var(--border2);
  }
  .analysis-hook-title {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .analysis-hook-summary {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 900;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 18px;
    word-break: keep-all;
  }
  .analysis-hook-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .analysis-hook-tags .hook-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 11px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--sub);
  }
  .analysis-hook-tags .hook-tag.tag-accent {
    background: var(--accent-10);
    border-color: var(--accent-20);
    color: var(--accent2);
  }

  /* Zone 2: 한눈에 보기 */
  .analysis-zone-2 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    position: relative;
  }
  .analysis-card {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
  }
  .analysis-card-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sub2);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .analysis-card-label .card-emoji { font-size: 14px; }
  .analysis-card-body {
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
    word-break: keep-all;
  }
  .analysis-card-sub {
    margin-top: 8px;
    font-size: 13px;
    color: var(--sub);
    line-height: 1.55;
  }
  .analysis-zone-2-progress {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    padding: 0 4px;
  }
  .analysis-zone-2-progress .progress-track {
    flex: 1;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .analysis-zone-2-progress .progress-fill {
    width: 30%;
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
  }

  /* Zone 3: 쟁점 */
  .analysis-zone-3 {
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .analysis-zone-3-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sub);
    margin-bottom: 16px;
  }
  .issue-item {
    border-top: 1px solid var(--border);
    padding: 14px 0;
  }
  .issue-item:first-of-type { border-top: none; padding-top: 4px; }
  .issue-item:last-of-type { padding-bottom: 4px; }
  .issue-head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }
  .issue-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.02em;
    margin-top: 2px;
  }
  .issue-badge-pro { background: rgba(59,130,246,0.10); color: #2563EB; }
  .issue-badge-con { background: rgba(234,88,12,0.10);  color: #C2410C; }
  .issue-badge-gap { background: var(--bg3);            color: var(--sub); }
  .issue-title {
    flex: 1;
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    word-break: keep-all;
  }
  .issue-toggle {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--sub2);
    font-family: 'JetBrains Mono', monospace;
    margin-top: 4px;
  }
  .issue-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease, margin 0.25s ease;
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.75;
    color: var(--sub);
    word-break: keep-all;
  }
  .issue-body strong { color: var(--text); font-weight: 700; }
  .issue-item.expanded .issue-body {
    max-height: 800px;
    margin-top: 10px;
    margin-left: 54px;
  }
  .analysis-zone-3-progress {
    margin-top: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
  }
  .analysis-zone-3-progress .progress-track {
    flex: 1; height: 3px; background: var(--border); border-radius: 2px; overflow: hidden;
  }
  .analysis-zone-3-progress .progress-fill {
    width: 70%; height: 100%; background: var(--accent); border-radius: 2px;
  }

  /* Zone 4: 판단 질문 */
  .analysis-zone-4 {
    background: var(--accent-wash);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }
  .analysis-zone-4-title {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
  }
  .analysis-zone-4-hint {
    font-size: 13px;
    color: var(--sub);
    margin-bottom: 16px;
    line-height: 1.55;
  }
  .judgment-list {
    list-style: none;
    counter-reset: judgment;
    margin: 0 0 20px;
    padding: 0;
  }
  .judgment-list li {
    counter-increment: judgment;
    position: relative;
    padding: 10px 0 10px 34px;
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.55;
    color: var(--text);
    border-top: 1px solid rgba(184,116,12,0.15);
    word-break: keep-all;
  }
  .judgment-list li:first-child { border-top: none; }
  .judgment-list li::before {
    content: counter(judgment);
    position: absolute;
    left: 0; top: 12px;
    width: 22px; height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    background: var(--accent);
    color: #fff;
    border-radius: 50%;
  }
  .judgment-hint {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    color: var(--sub2);
    font-family: 'Noto Sans KR', sans-serif;
  }
  .analysis-cta {
    display: flex;
    gap: 10px;
  }
  .analysis-cta button {
    flex: 1;
    padding: 12px 18px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    font-family: inherit;
  }
  .analysis-cta .cta-secondary {
    background: var(--bg2);
    border-color: var(--border2);
    color: var(--text);
  }
  .analysis-cta .cta-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .analysis-cta .cta-primary {
    background: var(--accent);
    color: #fff;
  }
  .analysis-cta .cta-primary:hover { background: var(--accent2); }

  /* 모바일 */
  @media (max-width: 768px) {
    .analysis-hook-summary { font-size: 22px; }
    .analysis-hook-title { font-size: 18px; }
    .analysis-zone-2 { grid-template-columns: 1fr; }
    .analysis-cta { flex-direction: column; }
    .analysis-zone-1,
    .analysis-zone-3,
    .analysis-zone-4 { padding: 1.25rem 1.25rem; }
    .issue-item.expanded .issue-body { margin-left: 0; }
  }
</style>

<div class="bd-wrap">
  <div class="bd-breadcrumb"><a href="/">홈</a> / <a href="/bill">법안</a> / <%= bill.bill_no || bill.bill_id %></div>

  <div class="bd-header">
    <div class="bd-meta-row">
      <% if (bill.committee) { %><span class="pb-badge pb-badge-category"><%= bill.committee %></span><% } %>
      <span class="pb-badge <%= resultClass(bill.proc_result_name) %>">
        <%= bill.proc_result_name || '계류' %>
        <span class="pb-help" data-help-href="/glossary#<%= termAnchor(bill.proc_result_name) %>" title="용어 설명 보기">?</span>
      </span>
      <span style="font-family:'JetBrains Mono';font-size:12px;color:var(--sub2);margin-left:auto">#<%= bill.bill_no || bill.bill_id %></span>
    </div>
    <h1 class="bd-title"><%= bill.bill_name %></h1>
    <div class="bd-meta">
      <% if (bill.proposer_name) { %>
        <span><strong>대표발의</strong>
          <% if (bill.mona_cd) { %><a href="/politician/<%= bill.mona_cd %>"><%= bill.proposer_name %></a>
          <% } else { %><%= bill.proposer_name %><% } %>
        </span>
      <% } %>
      <span><strong>발의일</strong> <%= bill.propose_dt || '—' %></span>
      <% if (bill.committee) { %><span><strong>소관위</strong> <%= bill.committee %></span><% } %>
      <% if (bill.co_proposer_count) { %><span><strong>공동발의</strong> <%= bill.co_proposer_count %>인</span><% } %>
    </div>
  </div>

  <!-- AI 분석 (5-Zone) -->
  <% if (analysis) { %>
    <section class="bill-ai-analysis" id="bill-analysis"></section>
  <% } %>

  <% if (bill.link_url) { %>
    <div style="margin-bottom:16px">
      <a href="<%= bill.link_url %>" target="_blank" rel="noopener" class="bd-external">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        국회 원문 보기
      </a>
    </div>
  <% } %>

  <!-- 시민 찬반 -->
  <div class="bd-section" id="citizen-vote-section">
    <h2>시민 찬반
      <span class="pb-help" data-help-href="/glossary#vote-for" title="로그인한 시민들의 찬반 — 국회의원 표결과는 별개">?</span>
    </h2>
    <div id="citizen-vote-widget"></div>
    <div style="margin-top:12px;font-size:12px;color:var(--sub2);line-height:1.7">
      국회의원의 본회의 표결과 별개로, 이 서비스에 로그인한 시민들의 찬반을 집계합니다.
    </div>
  </div>

  <div class="bd-section">
    <h2>본회의 표결 결과</h2>
    <% const hasVotes = voteCounts.agree + voteCounts.disagree + voteCounts.abstain + voteCounts.absent > 0; %>
    <% if (hasVotes) { %>
      <div class="vote-dashboard">
        <div class="vote-box agree"><strong>찬성</strong><span><%= nf(voteCounts.agree) %></span></div>
        <div class="vote-box disagree"><strong>반대</strong><span><%= nf(voteCounts.disagree) %></span></div>
        <div class="vote-box abstain"><strong>기권</strong><span><%= nf(voteCounts.abstain) %></span></div>
        <div class="vote-box absent"><strong>불참</strong><span><%= nf(voteCounts.absent) %></span></div>
      </div>

      <div class="vote-lists">
        <div class="vote-list-container">
          <h3>찬성 의원 (<%= voteCounts.agree %>명)</h3>
          <ul class="voter-list">
            <% voters.agree.forEach(v => { %>
              <li><a href="/politician/<%= v.mona_cd %>"><span><%= v.name || v.mona_cd %></span><span class="party"><%= v.party_name || '' %></span></a></li>
            <% }); %>
          </ul>
        </div>
        <div class="vote-list-container">
          <h3>반대 의원 (<%= voteCounts.disagree %>명)</h3>
          <ul class="voter-list">
            <% voters.disagree.forEach(v => { %>
              <li><a href="/politician/<%= v.mona_cd %>"><span><%= v.name || v.mona_cd %></span><span class="party"><%= v.party_name || '' %></span></a></li>
            <% }); %>
            <% if (voters.disagree.length === 0) { %><li style="color:var(--sub2);font-size:12px">반대 의원이 없습니다.</li><% } %>
          </ul>
        </div>
        <div class="vote-list-container">
          <h3>기권 의원 (<%= voteCounts.abstain %>명)</h3>
          <ul class="voter-list">
            <% voters.abstain.forEach(v => { %>
              <li><a href="/politician/<%= v.mona_cd %>"><span><%= v.name || v.mona_cd %></span><span class="party"><%= v.party_name || '' %></span></a></li>
            <% }); %>
            <% if (voters.abstain.length === 0) { %><li style="color:var(--sub2);font-size:12px">기권 의원이 없습니다.</li><% } %>
          </ul>
        </div>
        <div class="vote-list-container">
          <h3>불참 의원 (<%= voteCounts.absent %>명)</h3>
          <ul class="voter-list">
            <% voters.absent.slice(0, 60).forEach(v => { %>
              <li><a href="/politician/<%= v.mona_cd %>"><span><%= v.name || v.mona_cd %></span><span class="party"><%= v.party_name || '' %></span></a></li>
            <% }); %>
            <% if (voters.absent.length > 60) { %><li style="color:var(--sub2);font-size:11px">... 외 <%= voters.absent.length - 60 %>명</li><% } %>
          </ul>
        </div>
      </div>
    <% } else { %>
      <div style="padding:32px;text-align:center;color:var(--sub);background:var(--bg3);border:1px dashed var(--border);border-radius:8px">
        본회의 표결 데이터가 아직 수집되지 않았습니다.
      </div>
    <% } %>
  </div>

  <% if (coProposers && coProposers.length > 0) { %>
    <div class="bd-section">
      <h2>발의자 (<%= coProposers.length %>명)</h2>
      <div class="proposers-grid">
        <% coProposers.forEach(cp => { %>
          <a href="/politician/<%= cp.mona_cd %>" class="proposer-chip <%= cp.proposer_yn ? 'rep' : '' %>" style="text-decoration:none">
            <div class="avatar">
              <%- avatarHtml(cp.name, cp.photo_url, 28) %>
            </div>
            <div style="min-width:0;overflow:hidden">
              <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= cp.name || cp.mona_cd %><% if (cp.proposer_yn) { %> <span style="color:var(--accent);font-size:11px">(대표)</span><% } %></div>
              <div class="party-sm"><%= cp.party_name || '' %></div>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- 시민 댓글 -->
  <div class="bd-section">
    <h2>시민 의견</h2>
    <div id="comment-widget"></div>
  </div>
</div>

<%# AI 분석 데이터 주입 — </script> 이스케이프로 XSS 방어 %>
<% if (analysis) { %>
<script>
  window.__BILL_ANALYSIS__ = <%- JSON.stringify(analysis).replace(/</g, '\\u003c') %>;
</script>
<% } else { %>
<script>window.__BILL_ANALYSIS__ = null;</script>
<% } %>

<script>
(() => {
  const BILL_ID = '<%= bill.bill_id %>';
  const mount = () => {
    if (!window.PB) return setTimeout(mount, 30);
    PB.mountCitizenVote({ containerId: 'citizen-vote-widget', billId: BILL_ID });
    PB.mountComments({ containerId: 'comment-widget', type: 'bill', targetId: BILL_ID });
    if (window.__BILL_ANALYSIS__ && typeof PB.mountBillAnalysis === 'function') {
      PB.mountBillAnalysis({
        containerId: 'bill-analysis',
        analysisData: window.__BILL_ANALYSIS__,
        bill: {
          bill_id:     BILL_ID,
          bill_no:     '<%= bill.bill_no || "" %>',
          bill_name:   <%- JSON.stringify(bill.bill_name || '').replace(/</g, '\\u003c') %>,
          proposer:    <%- JSON.stringify(bill.proposer_name || '').replace(/</g, '\\u003c') %>,
          status:      <%- JSON.stringify(bill.proc_result_name || '계류').replace(/</g, '\\u003c') %>,
          committee:   <%- JSON.stringify(bill.committee || '').replace(/</g, '\\u003c') %>
        },
        scrollTargetId: 'citizen-vote-section'
      });
    }
  };
  mount();
})();
</script>
