<%
  /* /balance-game/reveal — 「당신의 카드」 (2026-08-16 재작성)
     문항을 다 푼 직후의 보상 화면. 짧은 연출(약 2.5초) 뒤 카드가 뜬다.
     🔴 구 버전: 13초 연출 + |값| 다이아몬드 + 숫자 4개 + 응답 분포. 게이트가 sessionStorage 라 새 탭·새 세션마다 13초를 다시 기다렸고,
        카드엔 방향도 해석도 의원도 없어 진입 페이지 히어로·공유 카드보다 정보가 적었다.
     - 카드 본문은 `_result_axes.ejs` 파샬 — 진입 페이지 완료 히어로와 **같은 마크업**
     - 연출 게이트는 localStorage + `computed_at` 키: 결과가 바뀌었을 때만 다시 연출한다. 아니면 즉시 표시
     - `prefers-reduced-motion` 이면 연출 없이 즉시 */
  const META = (locals.AXIS && AXIS.AXIS_META) || {};
  const ms = Array.isArray(locals.matches) ? matches : [];
  const stamp = String(axisScore.computed_at || '');
%>

<style>
  .bg-reveal-wrap { max-width: 720px; margin: 0 auto; padding: calc(var(--nav-h) + 36px) 24px 80px; }

  /* 연출 — 짧게 */
  .reveal-loading[hidden] { display: none; }   /* flex 라 hidden 속성만으론 안 숨는다 */
  .reveal-loading { min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .reveal-loading-text { font-family: 'Noto Serif KR', serif; font-weight: 500; font-size: 18px; color: var(--sub); margin-bottom: 22px; letter-spacing: .04em; }
  .reveal-axis-typewriter { display: flex; flex-direction: column; gap: 6px; align-items: center; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: var(--accent); }
  .reveal-axis-typewriter span { opacity: 0; animation: revealAxisLine .45s ease forwards; }
  .reveal-axis-typewriter span:nth-child(1) { animation-delay: .1s; }
  .reveal-axis-typewriter span:nth-child(2) { animation-delay: .5s; }
  .reveal-axis-typewriter span:nth-child(3) { animation-delay: .9s; }
  .reveal-axis-typewriter span:nth-child(4) { animation-delay: 1.3s; }
  @keyframes revealAxisLine { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  /* 카드 */
  .reveal-card { background: var(--bg2); border: 2px solid var(--accent); border-radius: 18px; padding: 30px 32px 26px; box-shadow: 0 8px 28px rgba(184,116,12,0.10); }
  /* JS 없이도 카드는 보인다 — 연출할 때만 .is-in 으로 페이드 */
  .reveal-card.is-in { animation: revealCardIn .5s ease both; }
  @keyframes revealCardIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .reveal-card[hidden] { display: none; }
  .reveal-card-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .bg-tag { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-family: 'JetBrains Mono', monospace; font-size: 11px; }
  .bg-tag-done { background: rgba(15,157,110,0.10); color: var(--green); border: 1px solid var(--green); font-weight: 700; }
  .bg-tag-meta { background: var(--bg3); color: var(--sub); }
  .reveal-card-title { font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 26px; color: var(--text); margin: 0 0 18px; }

  /* 결과 블록 (_result_axes) — invite.ejs 와 같은 규칙 */
  .bg-res-kicker { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--accent2); letter-spacing: .08em; margin-bottom: 8px; }
  .bg-res-headline { font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 26px; line-height: 1.3; color: var(--text); margin: 0 0 6px; word-break: keep-all; border-left: 4px solid var(--accent); padding-left: 14px; }
  .bg-res-desc { font-size: 14px; color: var(--sub); line-height: 1.7; margin: 0 0 4px; padding-left: 18px; word-break: keep-all; }
  .bg-res-desc .bg-res-line { color: var(--text); font-weight: 600; }
  .bg-res-types { color: var(--accent2); font-weight: 600; text-decoration: none; white-space: nowrap; margin-left: 4px; }
  .bg-res-types:hover { text-decoration: underline; }
  .bg-res-sub { font-size: 13px; color: var(--sub2); margin: 0 0 22px; padding-left: 18px; }
  .bg-ax { display: flex; flex-direction: column; gap: 16px; }
  .bg-ax-row { display: grid; grid-template-columns: 1fr; gap: 6px; }
  .bg-ax-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .bg-ax-name { font-family: 'Noto Serif KR', serif; font-weight: 700; font-size: 15px; color: var(--text); }
  .bg-ax-name small { font-family: 'Noto Sans KR', sans-serif; font-weight: 400; font-size: 12px; color: var(--sub2); margin-left: 8px; }
  .bg-ax-phrase { font-size: 12.5px; font-weight: 700; color: var(--accent2); white-space: nowrap; }
  .bg-ax-phrase.is-mid { color: var(--sub); font-weight: 500; }
  .bg-ax-track { position: relative; height: 8px; border-radius: 4px; background: var(--border); margin: 2px 8px; }
  .bg-ax-track::before { content: ''; position: absolute; left: 50%; top: -4px; width: 2px; height: 16px; background: var(--border2); transform: translateX(-1px); }
  .bg-ax-band { position: absolute; top: 0; height: 100%; background: rgba(184,116,12,0.28); border-radius: 4px; }
  .bg-ax-dot { position: absolute; top: 50%; width: 16px; height: 16px; border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%); box-shadow: 0 0 0 3px var(--bg2); }
  .bg-ax-ends { display: flex; justify-content: space-between; font-size: 12px; color: var(--sub); }

  /* 가까운 의원 3명 */
  .reveal-near { margin-top: 26px; padding-top: 18px; border-top: 1px dashed var(--border); }
  .reveal-near-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
  .reveal-near-title { font-family: 'Noto Serif KR', serif; font-weight: 700; font-size: 15px; color: var(--text); margin: 0; }
  .reveal-near-meta { font-size: 12px; color: var(--sub2); }
  .reveal-near-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .reveal-near a { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px; text-decoration: none; color: inherit; transition: border-color .15s; min-width: 0; }
  .reveal-near a:hover { border-color: var(--accent); }
  .reveal-near .av { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; flex: 0 0 auto; }
  .reveal-near .rk { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--accent2); }
  .reveal-near .nm { font-weight: 700; font-size: 14px; color: var(--text); }
  .reveal-near .nm em { font-style: normal; font-size: 11px; color: var(--sub2); margin-left: 4px; font-weight: 500; }
  .reveal-near .ds { font-size: 11.5px; color: var(--sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .reveal-near .tx { min-width: 0; }
  .reveal-near-note { font-size: 12px; color: var(--sub2); line-height: 1.6; margin: 10px 0 0; word-break: keep-all; }

  .reveal-after { margin: 22px 0 0; padding: 12px 14px; background: var(--bg3); border-radius: 10px; font-size: 12.5px; color: var(--sub); line-height: 1.7; word-break: keep-all; }
  .reveal-after strong { color: var(--text); }

  /* 다음 */
  .reveal-next { margin-top: 24px; display: flex; gap: 10px; flex-wrap: wrap; }
  .reveal-cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 22px; border-radius: 10px; font-size: 14px; font-weight: 700; text-decoration: none; border: 1px solid var(--accent); }
  .reveal-cta.primary { background: var(--accent); color: #fff; }
  .reveal-cta.primary:hover { background: var(--accent2); }
  .reveal-cta.secondary { background: var(--bg2); color: var(--accent2); }
  .reveal-cta.secondary:hover { background: #FAF6EB; }
  .reveal-next .more { margin-left: auto; align-self: center; font-size: 13px; color: var(--sub); text-decoration: none; border-bottom: 1px dashed var(--border2); }
  .reveal-next .more:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 768px) {
    .bg-reveal-wrap { padding: calc(var(--nav-h) + 20px) 16px 60px; }
    .reveal-card { padding: 22px 18px 20px; }
    .reveal-card-title, .bg-res-headline { font-size: 22px; }
    .reveal-near-list { grid-template-columns: 1fr; }
    .reveal-cta { width: 100%; }
    .reveal-next .more { margin-left: 0; }
    .bg-ax-phrase { white-space: normal; text-align: right; }
  }
</style>

<div class="bg-reveal-wrap">
  <div class="reveal-loading" id="reveal-loading" hidden>
    <div class="reveal-loading-text">당신의 좌표를 그리는 중…</div>
    <div class="reveal-axis-typewriter">
      <span>· 경제</span><span>· 사회·문화</span><span>· 안보·외교</span><span>· 정치제도</span>
    </div>
  </div>

  <div class="reveal-card" id="reveal-card">
    <div class="reveal-card-tags">
      <span class="bg-tag bg-tag-done">✓ 진단 완료</span>
      <span class="bg-tag bg-tag-meta"><%= fmtDate(axisScore.computed_at) %></span>
      <span class="bg-tag bg-tag-meta">응답 <%= axisScore.total_responses %></span>
    </div>
    <h1 class="reveal-card-title">당신의 카드입니다</h1>

    <%- include('_result_axes', { axisScore, META, headline: null }) %>

    <% if (ms.length) { %>
      <div class="reveal-near">
        <div class="reveal-near-head">
          <h2 class="reveal-near-title">좌표가 가장 가까운 의원</h2>
          <span class="reveal-near-meta">경제·사회·정치제도 3축 거리 · 가까운 순</span>
        </div>
        <div class="reveal-near-list">
          <% ms.forEach((m, i) => { %>
            <a href="/politician/<%= m.mona_cd %>">
              <span class="av"><%- avatarHtml(m.name, m.photo_url, 36) %></span>
              <span class="tx">
                <span class="rk"><%= i + 1 %>번째</span>
                <div class="nm"><%= m.name %><% if (m.active_yn === false) { %><em>퇴임</em><% } %></div>
                <div class="ds"><%= m.electoral_district || '' %></div>
              </span>
            </a>
          <% }); %>
        </div>
        <p class="reveal-near-note">의원 좌표는 공동발의 기록 × 법안 방향 매핑으로 만든 값이라 안보축은 빠집니다. AI 1차 매핑이라 가까운 몇 명 사이의 차이는 크지 않습니다.</p>
      </div>
    <% } %>

    <p class="reveal-after">이제 의원 목록·상세 곳곳에 <strong>당신 좌표 기준</strong>의 정보가 보입니다 — 의원 목록을 가까운 순으로 정렬하거나,
      의원 상세에서 <strong>나와의 성향 일치</strong>(순위)를 볼 수 있어요. 결과는 비공개이고, 다시 풀면 갱신됩니다.</p>
    <div class="reveal-next">
      <a class="reveal-cta primary" href="/balance-game/share">결과 이미지로 공유 →</a>
      <a class="reveal-cta secondary" href="/balance-game/compare">의원과 비교</a>
      <a class="more" href="/politician?sort=match-desc">가까운 순으로 의원 전체 보기 →</a>
    </div>
  </div>
</div>

<script>
(() => {
  // 연출은 **결과가 바뀌었을 때 한 번**. 키에 computed_at 을 넣어 다시 풀면 다시 연출된다.
  const KEY = 'pb.balanceGame.revealed.<%= mappingVersion %>';
  const STAMP = <%- JSON.stringify(stamp) %>;
  const loadingEl = document.getElementById('reveal-loading');
  const cardEl = document.getElementById('reveal-card');
  let seen = false;
  try { seen = localStorage.getItem(KEY) === STAMP; } catch (e) {}
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (seen || reduce) return;                       // 이미 본 결과 — 즉시 표시 (SSR 그대로)
  cardEl.hidden = true; loadingEl.hidden = false;
  setTimeout(() => {
    loadingEl.hidden = true; cardEl.classList.add('is-in'); cardEl.hidden = false;
    try { localStorage.setItem(KEY, STAMP); } catch (e) {}
  }, 2400);
})();
</script>
