<style>
  .bg-map-wrap {
    max-width: 920px;
    margin: 0 auto;
    padding: calc(var(--nav-h) + 36px) 24px 80px;
  }

  .bg-map-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub2);
    margin-bottom: 14px;
  }
  .bg-map-breadcrumb a { color: var(--sub); text-decoration: none; }
  .bg-map-breadcrumb a:hover { color: var(--accent); }

  .bg-map-head { margin-bottom: 24px; }
  .bg-map-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 38px;
    color: var(--text);
    margin: 0 0 6px;
  }
  .bg-map-desc {
    font-size: 14px;
    color: var(--sub);
    line-height: 1.7;
    word-break: keep-all;
  }
  .bg-map-version {
    display: inline-block;
    margin-top: 8px;
    padding: 3px 10px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub);
  }

  .bg-map-axis-section { margin-bottom: 32px; }
  .bg-map-axis-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .bg-map-axis-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
  }
  .bg-map-axis-poles {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--sub);
  }
  .bg-map-axis-poles .left { color: var(--vote-pro); }
  .bg-map-axis-poles .right { color: var(--vote-con); }

  .bg-map-q {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 8px;
  }
  .bg-map-q-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .bg-map-q-id {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub2);
    background: var(--bg3);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .bg-map-q-prompt {
    font-size: 13px;
    line-height: 1.65;
    color: var(--sub);
    margin: 4px 0 10px;
    word-break: keep-all;
  }
  .bg-map-q-options {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
  }
  .bg-map-q-options li {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
  }
  .bg-map-q-options .opt-id {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    width: 18px;
    color: var(--sub2);
  }
  .bg-map-q-options .opt-text { flex: 1; color: var(--text); word-break: keep-all; }
  .bg-map-q-options .opt-score {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .opt-score.pos { background: rgba(176,147,124,0.15); color: var(--vote-con); }
  .opt-score.neg { background: rgba(124,154,175,0.15); color: var(--vote-pro); }
  .opt-score.zero { background: var(--bg3); color: var(--sub2); }

  .bg-map-foot {
    margin-top: 32px;
    padding: 18px 22px;
    background: var(--bg3);
    border: 1px dashed var(--border2);
    border-radius: 10px;
    font-size: 13px;
    color: var(--sub);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .bg-map-wrap { padding: calc(var(--nav-h) + 20px) 16px 60px; }
    .bg-map-title { font-size: 30px; }
  }
</style>

<div class="bg-map-wrap">
  <nav class="bg-map-breadcrumb">
    <a href="/">홈</a> <span style="color:var(--border2)">/</span>
    <a href="/balance-game">성향 진단</a> <span style="color:var(--border2)">/</span>
    <span>매핑 공개</span>
  </nav>

  <header class="bg-map-head">
    <h1 class="bg-map-title">매핑 미리 보기</h1>
    <p class="bg-map-desc">
      각 문항의 답이 어떤 축에 어떻게 들어가는지 전부 공개합니다.
      "객관"이 아니라 "투명"이 정직한 표현입니다. 이의가 있다면
      <a href="mailto:3jjoda@gmail.com" style="color:var(--accent)">피드백</a>으로 알려주세요.
    </p>
    <span class="bg-map-version">📊 mapping <%= mappingVersion %></span>
  </header>

  <% Object.entries(axes).forEach(([axisKey, axisDef]) => {
       const axisQs = questions.filter(q => q.axis === axisKey);
  %>
    <section class="bg-map-axis-section">
      <div class="bg-map-axis-head">
        <span class="bg-map-axis-name"><%= axisDef.label %></span>
        <span class="bg-map-axis-poles">
          <span class="left"><%= axisDef.left %></span>
          <span> ↔ </span>
          <span class="right"><%= axisDef.right %></span>
        </span>
      </div>

      <% axisQs.forEach(q => {
           const opts = [
             { id: 'A', text: q.option_a_text, score: q.option_a_score },
             { id: 'B', text: q.option_b_text, score: q.option_b_score },
             { id: 'C', text: '잘 모르겠다 / 관심 없음', score: 0 }
           ];
      %>
        <div class="bg-map-q">
          <div class="bg-map-q-head">
            <span class="bg-map-q-id"><%= q.id %></span>
            <span style="font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--sub2);margin-left:auto"><%= q.pack_id %></span>
          </div>
          <div class="bg-map-q-prompt"><%= q.prompt %></div>
          <ul class="bg-map-q-options">
            <% opts.forEach(opt => {
                 const cls = opt.score > 0 ? 'pos' : opt.score < 0 ? 'neg' : 'zero';
                 const sign = opt.score > 0 ? '+' : opt.score < 0 ? '' : '±';
            %>
              <li>
                <span class="opt-id"><%= opt.id %></span>
                <span class="opt-text"><%= opt.text %></span>
                <span class="opt-score <%= cls %>"><%= sign %><%= opt.score %></span>
              </li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    </section>
  <% }); %>

  <div class="bg-map-foot">
    이 매핑은 사람이 결정한 결과물이며, 의견 차이가 있을 수 있습니다.
    매핑이 갱신되면 매핑 버전이 올라가고,
    과거 응답은 그 시점 매핑 기준으로 보존됩니다.
  </div>
</div>
