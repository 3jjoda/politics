<%
  /* /balance-game — 성향 진단 진입 (2026-08-16 재구성)
     🔴 이 페이지는 "게임팩 목록" 이 아니라 **결과로 가는 문**이다.
        미완료: 무엇을 얻는지(좌표 · 가까운 의원 · 공유 카드) → 시작 버튼
        완료:   히어로가 곧 내 결과(4축 막대 + 한 줄 요약) + 결과로 할 수 있는 일 3가지 — 공유가 주인공
     ⚠️ `게임팩`·`매핑` 같은 내부 용어를 첫 화면에 쓰지 않는다 (사용자가 알 이유가 없다) */
  const generalPack = packs.find(p => p.is_general) || null;
  const otherPacks = packs.filter(p => !p.is_general);
  const isCompleted = Boolean(completed && axisScore);
  const META = (locals.AXIS && AXIS.AXIS_META) || {};
  const ORDER = ['economy', 'social', 'security', 'institution'];
  const val = (k) => { const v = axisScore ? Number(axisScore[k]) : NaN; return Number.isFinite(v) ? v : null; };
  // 한 줄 요약 — 공유 카드(shareCard.js headline) 와 같은 규칙: |값| ≥ 0.25 인 축을 세기 순으로 2개, 짧은 극 라벨
  let headline = '';
  if (isCompleted) {
    const rows = ORDER.map(k => ({ m: META[k], v: val(k) })).filter(r => r.m && r.v !== null && Math.abs(r.v) >= 0.25)
                      .sort((a, b) => Math.abs(b.v) - Math.abs(a.v)).slice(0, 2);
    headline = rows.length ? rows.map(r => `${r.m.name}는 ${r.v > 0 ? r.m.R : r.m.L}`).join(', ') + ' 쪽' : '네 축 모두 중도에 가깝습니다';
  }
  const intensity = (v) => { const a = Math.abs(v); return a < 0.25 ? '중도' : a < 0.5 ? '미세하게' : a < 0.75 ? '약간 뚜렷하게' : '뚜렷하게'; };
%>

<style>
  .bg-coll-wrap { max-width: 980px; margin: 0 auto; padding: 36px 24px 80px; }

  /* 진행 중 — 문항 교체로 완료가 풀린 사람. 남은 문항을 눈에 보이게 한다 */
  .bg-prog { margin: 18px 0 22px; }
  .bg-prog-top { display: flex; align-items: baseline; gap: 8px; font-size: 13.5px; color: var(--sub); margin-bottom: 8px; }
  .bg-prog-top b { font-family: "JetBrains Mono", monospace; font-size: 17px; color: var(--accent2); font-weight: 700; }
  .bg-prog-bar { height: 10px; border-radius: 6px; background: var(--bg3); overflow: hidden; }
  .bg-prog-fill { height: 100%; background: linear-gradient(90deg, var(--accent), #D4A442); border-radius: 6px; }
  .bg-hero-note { font-size: 13px; line-height: 1.7; color: var(--sub2); margin: 14px 0 0; word-break: keep-all; }

  /* ── 히어로 카드 (미완료 / 완료 공용 껍데기) ── */
  .bg-hero {
    background: var(--bg2);
    border: 2px solid var(--accent);
    border-radius: 18px;
    padding: 36px 38px 34px;
    position: relative;
    overflow: hidden;
  }
  .bg-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse at top right, rgba(184,116,12,0.08), transparent 60%);
  }
  .bg-hero > * { position: relative; }
  .bg-hero-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .bg-tag { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-family: 'JetBrains Mono', monospace; font-size: 11px; }
  .bg-tag-start { background: var(--accent); color: #fff; font-weight: 700; }
  .bg-tag-done  { background: rgba(15,157,110,0.10); color: var(--green); border: 1px solid var(--green); font-weight: 700; }
  .bg-tag-meta  { background: var(--bg3); color: var(--sub); }
  .bg-hero-title { font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 32px; line-height: 1.3; color: var(--text); margin: 0 0 10px; word-break: keep-all; }
  .bg-hero-desc  { font-size: 15px; line-height: 1.75; color: var(--sub); margin: 0 0 22px; max-width: 640px; word-break: keep-all; }
  .bg-cta { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 14px 30px; background: var(--accent); color: #fff; border-radius: 10px; font-size: 15px; font-weight: 700; text-decoration: none; transition: background .15s, transform .15s; }
  .bg-cta:hover { background: var(--accent2); transform: translateY(-1px); }
  .bg-cta.secondary { background: var(--bg2); color: var(--accent2); border: 1px solid var(--accent); }
  .bg-cta.secondary:hover { background: #FAF6EB; }
  .bg-hero-foot { margin-top: 14px; font-size: 12.5px; color: var(--sub2); }

  /* ── 미완료: 이렇게 나옵니다 3칸 ── */
  .bg-what { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 18px; }
  .bg-what-item { background: var(--bg2); border: 1px solid var(--border); border-radius: 14px; padding: 20px 20px 18px; }
  .bg-what-no { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--accent2); letter-spacing: .08em; margin-bottom: 8px; }
  .bg-what-title { font-family: 'Noto Serif KR', serif; font-weight: 700; font-size: 17px; color: var(--text); margin: 0 0 6px; }
  .bg-what-desc { font-size: 13.5px; line-height: 1.7; color: var(--sub); word-break: keep-all; margin: 0; }
  /* 3칸 미니 그림 — 정당색 없이 골드/무채색만 */
  .bg-what-fig { height: 54px; margin-bottom: 12px; display: flex; flex-direction: column; justify-content: center; gap: 7px; }
  .bg-what-fig .t { height: 6px; border-radius: 3px; background: var(--border); position: relative; }
  .bg-what-fig .t i { position: absolute; top: 50%; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%); box-shadow: 0 0 0 2px var(--bg2); }
  .bg-what-fig .r { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--sub); }
  .bg-what-fig .r b { width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid var(--accent); color: var(--accent2); font-family: 'JetBrains Mono', monospace; font-size: 10px; display: inline-flex; align-items: center; justify-content: center; }
  .bg-what-fig .r span { flex: 1; height: 8px; border-radius: 4px; background: var(--bg3); }
  .bg-what-fig .card { width: 34px; height: 54px; border-radius: 4px; border: 1.5px solid var(--accent); background: #FAF6EB; position: relative; }
  .bg-what-fig .card::before { content: ''; position: absolute; left: 5px; right: 5px; top: 8px; height: 4px; background: var(--accent); border-radius: 2px; }
  .bg-what-fig .card::after { content: ''; position: absolute; left: 5px; right: 12px; top: 18px; height: 3px; background: var(--border2); border-radius: 2px; box-shadow: 0 8px 0 var(--border2), 0 16px 0 var(--border2); }

  /* ── 완료: 내 결과 (2단) ── */
  .bg-result { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 32px; align-items: start; }
  .bg-res-kicker { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--accent2); letter-spacing: .08em; margin-bottom: 8px; }
  .bg-res-headline { font-family: 'Noto Serif KR', serif; font-weight: 900; font-size: 28px; line-height: 1.3; color: var(--text); margin: 0 0 6px; word-break: keep-all; border-left: 4px solid var(--accent); padding-left: 14px; }
  .bg-res-desc { font-size: 14px; color: var(--sub); line-height: 1.7; margin: 0 0 4px; padding-left: 18px; word-break: keep-all; }
  .bg-res-desc .bg-res-line { color: var(--text); font-weight: 600; }
  .bg-res-types { color: var(--accent2); font-weight: 600; text-decoration: none; white-space: nowrap; margin-left: 4px; }
  .bg-res-types:hover { text-decoration: underline; }
  .bg-res-sub { font-size: 13px; color: var(--sub2); margin: 0 0 22px; padding-left: 18px; }
  .bg-ax { display: flex; flex-direction: column; gap: 16px; }
  .bg-ax-row { display: grid; grid-template-columns: 1fr; gap: 6px; }
  .bg-ax-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .bg-ax-name { font-family: 'Noto Serif KR', serif; font-weight: 700; font-size: 15px; color: var(--text); }
  .bg-ax-name small { font-family: 'Noto Sans KR', sans-serif; font-weight: 400; font-size: 12px; color: var(--sub2); margin-left: 8px; }
  .bg-ax-phrase { font-size: 12.5px; font-weight: 700; color: var(--accent2); white-space: nowrap; }
  .bg-ax-phrase.is-mid { color: var(--sub); font-weight: 500; }
  .bg-ax-track { position: relative; height: 8px; border-radius: 4px; background: var(--border); margin: 2px 8px; }
  .bg-ax-track::before { content: ''; position: absolute; left: 50%; top: -4px; width: 2px; height: 16px; background: var(--border2); transform: translateX(-1px); }
  .bg-ax-band { position: absolute; top: 0; height: 100%; background: rgba(184,116,12,0.28); border-radius: 4px; }
  .bg-ax-dot { position: absolute; top: 50%; width: 16px; height: 16px; border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%); box-shadow: 0 0 0 3px var(--bg2); }
  .bg-ax-ends { display: flex; justify-content: space-between; font-size: 12px; color: var(--sub); }
  .bg-actions { display: flex; flex-direction: column; gap: 10px; }
  .bg-actions .bg-cta { width: 100%; padding: 13px 16px; font-size: 14.5px; }
  .bg-actions-note { font-size: 12px; color: var(--sub2); line-height: 1.6; word-break: keep-all; margin: 2px 0 0; }
  .bg-actions-links { margin-top: 6px; display: flex; gap: 12px; flex-wrap: wrap; font-size: 12.5px; }
  .bg-actions-links a { color: var(--sub); text-decoration: none; border-bottom: 1px dashed var(--border2); }
  .bg-actions-links a:hover { color: var(--accent); border-color: var(--accent); }

  /* ── 왜 이렇게 만들었나 — 진단의 의도와 한계 (2026-08-16)
        🔴 지우지 말 것. 이 문단이 없으면 사용자는 이 진단을 "측정 도구" 로 읽고,
        그 순간 "문항 20개와 의원 기록을 왜 같은 자로 안 쟀나" 가 결점이 된다.
        의도를 밝히면 같은 한계가 전제가 된다 — 사이트가 다른 곳에서 하는 것과 같은 방식 */
  .bg-why { margin-top: 26px; background: var(--bg2); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 12px; padding: 22px 26px 20px; }
  .bg-why-title { font-family: 'Noto Serif KR', serif; font-weight: 700; font-size: 17px; color: var(--text); margin: 0 0 12px; }
  .bg-why p { font-size: 14px; line-height: 1.8; color: var(--sub); margin: 0 0 10px; word-break: keep-all; max-width: 760px; }
  .bg-why p:last-child { margin-bottom: 0; }
  .bg-why strong { color: var(--text); font-weight: 700; }

  /* ── 주제별 문항 (준비 중) — 한 줄 ── */
  .bg-topic-line { margin-top: 26px; padding: 14px 18px; background: var(--bg3); border: 1px dashed var(--border2); border-radius: 10px; font-size: 13px; color: var(--sub); line-height: 1.7; word-break: keep-all; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .bg-topic-line a { color: var(--sub); text-decoration: none; border-bottom: 1px dashed var(--border2); }
  .bg-topic-line a:hover { color: var(--accent); border-color: var(--accent); }
  .bg-topic-grid { margin-top: 26px; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .bg-topic-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; text-decoration: none; color: var(--text); transition: border-color .15s; }
  .bg-topic-card:hover { border-color: var(--accent); }
  .bg-topic-card .n { font-size: 11px; color: var(--sub2); font-family: 'JetBrains Mono', monospace; margin-bottom: 6px; }
  .bg-topic-card .t { font-weight: 700; font-size: 16px; margin-bottom: 4px; }
  .bg-topic-card .d { font-size: 13px; color: var(--sub); line-height: 1.5; }

  @media (max-width: 900px) {
    .bg-result { grid-template-columns: 1fr; gap: 22px; }
    .bg-what { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .bg-coll-wrap { padding: 20px 16px 60px; }
    .bg-hero { padding: 24px 20px 22px; }
    .bg-hero-title { font-size: 25px; }
    .bg-res-headline { font-size: 22px; }
    .bg-cta { width: 100%; }
    .bg-ax-phrase { white-space: normal; text-align: right; }
  }
</style>

<div class="pb-page-header">
  <div class="pb-page-header-inner">
    <div>
      <h1 class="pb-page-title">성향 진단</h1>
      <p class="pb-page-desc">문항에 답하면 경제·사회·안보·정치제도 네 축의 좌표가 나오고, 좌표가 가장 가까운 국회의원을 찾아드립니다.</p>
    </div>
  </div>
</div>

<div class="bg-coll-wrap">

<% if (!isCompleted) { %>
  <%# ── 미완료: 무엇을 얻는지 → 시작 ── %>
  <article class="bg-hero">
    <div class="bg-hero-tags">
      <% if (progress) { %><span class="bg-tag bg-tag-start">이어서 풀기</span><% } else { %><span class="bg-tag bg-tag-start">여기서 시작</span><% } %>
      <% if (generalPack) { %><span class="bg-tag bg-tag-meta"><%= generalPack.active_question_count %>문항</span><% } %>
      <span class="bg-tag bg-tag-meta">약 5분</span>
      <span class="bg-tag bg-tag-meta">로그인 필요</span>
    </div>
    <% if (progress) { %>
      <%# 🔴 이유를 반드시 밝힌다 — 다 풀었다고 기억하는 사람에게 진행률만 보이면 오작동으로 읽힌다.
          문항 교체로 완료가 풀린 상태다 (BalanceGameController.getInvitePage 주석 참조) %>
      <h2 class="bg-hero-title">답변이 <%= progress.left %>개 남았습니다</h2>
      <p class="bg-hero-desc">
        <strong>문항이 일부 바뀌어서</strong> 새 문항 <%= progress.left %>개가 더 필요합니다.
        이미 답한 <%= progress.answered %>개는 그대로 저장돼 있어요.
      </p>
      <div class="bg-prog">
        <div class="bg-prog-top"><b><%= progress.answered %></b> / <%= progress.total %>문항</div>
        <div class="bg-prog-bar">
          <div class="bg-prog-fill" style="width: <%= (progress.answered / progress.total * 100).toFixed(1) %>%"></div>
        </div>
      </div>
    <% } else { %>
      <h2 class="bg-hero-title">당신과 가장 가까운<br>국회의원은 누구일까요?</h2>
      <p class="bg-hero-desc">
        정당 이름이 아니라 <strong>위치</strong>로 봅니다. 의원의 좌표는 소속 정당이 아니라 그 의원이
        <strong>공동발의로 이름을 올린 법안</strong>에서 만들었습니다. 한 문항씩 저장되니 중간에 나가도 이어서 풀 수 있어요.
      </p>
    <% } %>
    <% if (generalPack) { %>
      <a href="/balance-game/respond?pack=<%= generalPack.id %>" class="bg-cta"><%= progress ? "이어서 풀기 →" : "진단 시작하기 →" %></a>
    <% } %>
    <p class="bg-hero-foot">결과는 비공개입니다. 통계에는 성별·연령대만 익명으로 쓰입니다. 결과는 <a href="/balance-game/types" style="color:var(--accent2);font-weight:600;text-decoration:none">유형 9종</a> 중 하나로 나오고, 어느 유형도 치켜세우거나 깎지 않습니다.</p>
  </article>

  <div class="bg-what">
    <div class="bg-what-item">
      <div class="bg-what-fig">
        <div class="t"><i style="left:68%"></i></div>
        <div class="t"><i style="left:22%"></i></div>
        <div class="t"><i style="left:51%"></i></div>
      </div>
      <div class="bg-what-no">01</div>
      <h3 class="bg-what-title">네 축의 내 위치</h3>
      <p class="bg-what-desc">경제 · 사회·문화 · 안보·외교 · 정치제도. 각 축에서 어느 쪽에 얼마나 있는지를 막대 위 점으로 봅니다.</p>
    </div>
    <div class="bg-what-item">
      <div class="bg-what-fig">
        <div class="r"><b>1</b><span></span></div>
        <div class="r"><b>2</b><span style="max-width:70%"></span></div>
        <div class="r"><b>3</b><span style="max-width:55%"></span></div>
      </div>
      <div class="bg-what-no">02</div>
      <h3 class="bg-what-title">좌표가 가까운 의원</h3>
      <p class="bg-what-desc">300명 남짓 의원 전체를 거리 순으로 세웁니다. 순위는 나오지만 % 점수는 매기지 않습니다. 그건 설명할 수 없는 숫자라서요.</p>
    </div>
    <div class="bg-what-item">
      <div class="bg-what-fig"><div class="card"></div></div>
      <div class="bg-what-no">03</div>
      <h3 class="bg-what-title">공유 카드</h3>
      <p class="bg-what-desc">결과를 인스타 스토리·피드 이미지로 저장할 수 있어요. 닉네임 같은 개인정보는 들어가지 않고, 정당명·정당색도 없습니다.</p>
    </div>
  </div>

<% } else { %>
  <%# ── 완료: 히어로 = 내 결과. 공유가 첫 번째 행동 ── %>
  <article class="bg-hero">
    <div class="bg-hero-tags">
      <span class="bg-tag bg-tag-done">✓ 진단 완료</span>
      <span class="bg-tag bg-tag-meta"><%= fmtDate(axisScore.computed_at) %></span>
      <span class="bg-tag bg-tag-meta">응답 <%= axisScore.total_responses %></span>
    </div>
    <div class="bg-result">
      <div>
        <%- include('_result_axes', { axisScore, META, headline }) %>
      </div>
      <aside class="bg-actions">
        <a href="/balance-game/share" class="bg-cta">결과 이미지로 공유 →</a>
        <a href="/politician?sort=match-desc" class="bg-cta secondary">가까운 의원 보기</a>
        <a href="/balance-game/compare" class="bg-cta secondary">의원과 비교</a>
        <%# 🔴 다시 풀기는 12.5px 점선 링크(.bg-actions-links)에 있었다 — 각주로 읽혀서
            "다시 풀 방법이 없다" 는 지적을 받았다 (2026-08-24). 행동이니 버튼 줄에 둔다 %>
        <% if (generalPack) { %><a href="/balance-game/respond?pack=<%= generalPack.id %>&amp;redo=1" class="bg-cta secondary">다시 풀기</a><% } %>
        <p class="bg-actions-note">공유 카드에는 좌표와 가까운 의원 3명만 담기고, 닉네임 등 개인정보는 들어가지 않습니다.</p>
        <div class="bg-actions-links">
          <a href="/balance-game/types">유형 9종</a>
        </div>
      </aside>
    </div>
    <%- include('_anon_save') %>
  </article>
<% } %>

  <%# ── 왜 이렇게 만들었나 — 미완료·완료 공통. 진단이 무엇이고 무엇이 아닌지 ── %>
  <section class="bg-why" aria-labelledby="bg-why-title">
    <h2 class="bg-why-title" id="bg-why-title">이 진단은 무엇이고, 무엇이 아닌가</h2>
    <p>
      <strong>당신과 의원을 같은 자로 잴 수는 없습니다.</strong> 의원의 좌표는 실제 기록, 즉 공동발의로 이름을 올린 법안 수백 건에서
      나오지만, 당신에게 그 법안을 전부 읽고 찬반을 매기라고 할 수는 없습니다. 그래서 당신 쪽은 가벼운 문항으로 기준을 세우고,
      의원 쪽은 활동으로 기준을 세운 뒤 두 기준이 겹치는 자리를 찾습니다. 서로 다른 자로 잰 값을 겹친 <strong>근사</strong>이지, 정밀한 측정이 아닙니다.
    </p>
    <p>
      <strong>결과가 익숙한 정당 쪽으로 나와도 괜찮습니다.</strong> 이 진단의 목적은 정당을 지우는 게 아니라,
      당만 보고 찍어 온 사람이 한 번이라도 <strong>사람 이름</strong>을 보게 하는 것입니다. 가까운 의원이 나오면 그 사람이 낸 법안·표결·발언을
      이 사이트에서 이어서 볼 수 있습니다. 거기까지가 이 진단이 하려는 일입니다.
    </p>
    <p>
      그래서 % 점수 대신 순위만 내고, 어느 유형도 치켜세우거나 깎지 않으며, 좌표를 만든 법안 수와 재지 못한 축을 화면에 그대로 씁니다.
    </p>
  </section>

  <%# ── 주제별 문항 — 없으면 한 줄, 있으면 카드 ── %>
  <% if (otherPacks.length === 0) { %>
    <div class="bg-topic-line">
      <span>주제별 문항(환경·사법·노동·젠더 등)은 준비 중입니다. 같은 네 축을 채우므로 풀수록 좌표가 정밀해집니다.</span>
      <a href="/balance-game/mapping">문항이 어느 축에 닿는지 보기 →</a>
    </div>
  <% } else { %>
    <div class="bg-topic-grid">
      <% otherPacks.forEach(p => { %>
        <a href="/balance-game/respond?pack=<%= p.id %>" class="bg-topic-card">
          <div class="n"><%= p.active_question_count %>문항</div>
          <div class="t"><%= p.title %></div>
          <div class="d"><%= p.description %></div>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>
