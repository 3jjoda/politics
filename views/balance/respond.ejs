<%
  const escape = (s) => JSON.stringify(s).replace(/</g, '\\u003c');
%>

<style>
  .bg-respond-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: calc(var(--nav-h) + 24px) 20px 80px;
  }

  /* 진행도 바 (sticky) */
  .bg-progress {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    margin: 0 -20px 24px;
    padding: 14px 20px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }
  .bg-progress-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 8px;
  }
  .bg-progress-counter {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--sub);
    flex-shrink: 0;
  }
  .bg-progress-counter strong { color: var(--text); }
  .bg-progress-axis {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    padding: 3px 10px;
    background: #FAF6EB;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    flex-shrink: 0;
  }
  .bg-progress-prev {
    margin-left: auto;
    font-size: 12px;
    color: var(--sub2);
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 8px;
  }
  .bg-progress-prev:hover { color: var(--accent); }
  .bg-progress-prev:disabled { opacity: 0.3; cursor: default; }

  .bg-progress-track {
    height: 4px;
    background: var(--bg3);
    border-radius: 2px;
    overflow: hidden;
  }
  .bg-progress-fill {
    height: 100%;
    background: var(--accent);
    transition: width 0.3s ease;
  }

  /* 양측 맥락 (한 화면 한 문항) */
  .bg-question { animation: bgQuestionIn 0.3s ease; }
  @keyframes bgQuestionIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .bg-prompt {
    font-family: 'Noto Serif KR', serif;
    font-weight: 500;
    font-size: 17px;
    line-height: 1.75;
    color: var(--text);
    margin: 28px 0 24px;
    padding: 0 4px;
    word-break: keep-all;
  }

  .bg-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bg-option {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 64px;
    padding: 14px 18px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
  }
  .bg-option:hover { border-color: var(--accent); background: #FAF6EB; }
  .bg-option:active { transform: scale(0.99); }
  .bg-option:disabled { opacity: 0.6; cursor: progress; }
  .bg-option .key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--bg3);
    color: var(--sub);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .bg-option .text { flex: 1; line-height: 1.55; word-break: keep-all; }
  .bg-option.skip {
    background: var(--bg);
    color: var(--sub);
  }
  .bg-option.skip .key { background: var(--bg3); color: var(--sub2); }
  .bg-option.skip:hover { border-color: var(--sub2); background: var(--bg3); color: var(--text); }

  .bg-keyboard-hint {
    margin-top: 24px;
    text-align: center;
    font-size: 12px;
    color: var(--sub2);
    font-family: 'JetBrains Mono', monospace;
  }
  .bg-keyboard-hint kbd {
    padding: 1px 6px;
    border: 1px solid var(--border2);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--bg2);
    color: var(--sub);
    font-family: inherit;
    font-size: 11px;
  }

  .bg-error-banner {
    margin: 12px auto;
    padding: 10px 14px;
    background: rgba(208,58,58,0.08);
    border: 1px solid var(--red);
    color: var(--red);
    border-radius: 8px;
    font-size: 13px;
    text-align: center;
    display: none;
  }
  .bg-error-banner.visible { display: block; }

  @media (max-width: 768px) {
    .bg-respond-wrap { padding: calc(var(--nav-h) + 16px) 16px 60px; }
    .bg-prompt { font-size: 16px; line-height: 1.7; }
    .bg-option { font-size: 15px; min-height: 56px; padding: 12px 14px; gap: 10px; }
    .bg-keyboard-hint { display: none; }
  }
</style>

<div class="bg-respond-wrap">
  <div class="bg-progress">
    <div class="bg-progress-row">
      <span class="bg-progress-counter"><strong id="bg-current-num">1</strong> / <%= questions.length %></span>
      <span class="bg-progress-axis" id="bg-current-axis">—</span>
      <button type="button" class="bg-progress-prev" id="bg-btn-prev" disabled>← 이전 문항</button>
    </div>
    <div class="bg-progress-track" aria-hidden="true">
      <div class="bg-progress-fill" id="bg-progress-fill" style="width:0%"></div>
    </div>
  </div>

  <section class="bg-question" id="bg-question-section" aria-live="polite">
    <p class="bg-prompt" id="bg-prompt"></p>
    <div class="bg-options" id="bg-options"></div>
    <div class="bg-error-banner" id="bg-error-banner" role="alert"></div>
  </section>

  <p class="bg-keyboard-hint">
    <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> 으로 선택 ·
    <kbd>←</kbd> 이전 문항
  </p>
</div>

<script>
(() => {
  const QUESTIONS  = <%- escape(questions) %>;
  const AXES       = <%- escape(axes) %>;
  const ANSWERS_INIT = <%- escape(answers) %>;
  const PACK_ID    = <%- escape(pack.id) %>;
  const MAPPING_V  = <%- escape(mappingVersion) %>;
  const START_IDX  = Number(<%= startIndex %>) || 0;
  const IS_ANON    = <%- escape(!!locals.isAnon) %>;
  const REDO       = <%- escape(!!locals.redo) %>;   // 다시 풀기 — 1번 문항부터

  /* 🔴 비로그인 답변은 **브라우저에만** 있다 (2026-08-24 익명 진단).
     서버로는 채점 POST 한 번씩만 가고 DB 에는 아무것도 안 쌓인다 — utils/anonAxis.js 주석 참조.
     ⚠️ 키 이름은 utils/anonAxis.js ANON_ANSWERS_KEY · interactions.js 승격 코드와 **같아야 한다**.
        하나만 바꾸면 로그인해도 답변이 안 올라가고 조용히 사라진다 */
  const LS_KEY = 'pb.bg.answers';
  const readLocal = () => {
    try {
      const r = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
      return (r && typeof r === 'object' && !Array.isArray(r)) ? r : {};
    } catch (e) { return {}; }
  };
  const writeLocal = (o) => { try { localStorage.setItem(LS_KEY, JSON.stringify(o)); } catch (e) {} };
  const dropLocal  = () => { try { localStorage.removeItem(LS_KEY); } catch (e) {} };

  const promptEl    = document.getElementById('bg-prompt');
  const optionsEl   = document.getElementById('bg-options');
  const counterEl   = document.getElementById('bg-current-num');
  const axisEl      = document.getElementById('bg-current-axis');
  const fillEl      = document.getElementById('bg-progress-fill');
  const prevBtn     = document.getElementById('bg-btn-prev');
  const questionSec = document.getElementById('bg-question-section');
  const errorEl     = document.getElementById('bg-error-banner');

  let answers = Object.assign({}, ANSWERS_INIT, IS_ANON ? readLocal() : {});
  /* 비로그인은 서버의 next_index 가 항상 0 이다 (답변을 모른다) — 복원한 답변으로 여기서 다시 잡는다.
     ⚠️ QUESTIONS.length 로 클램프할 것. length-1 로 조이면 다 푼 사람이 마지막 문항을 다시 보고
        finish() 가 안 불려 결과 화면으로 못 간다 */
  let idx = START_IDX;
  if (IS_ANON) {
    const firstUnanswered = QUESTIONS.findIndex(q => !answers[q.id]);
    idx = firstUnanswered === -1 ? QUESTIONS.length : firstUnanswered;
  }
  /* 🔴 다시 풀기는 이어풀기를 무시하고 처음부터. 서버(로그인)·localStorage(비로그인) 어느 쪽이
     "다 풀었다" 고 해도 여기서 0 으로 되돌린다 — 안 그러면 마지막 문항만 보이거나 곧바로 결과로 튄다 */
  if (REDO) idx = 0;
  idx = Math.max(0, Math.min(idx, QUESTIONS.length));
  let saving = false;
  /* 🔴 다시 풀기 중에는 진행바가 **이번 회차**를 세야 한다 (2026-08-24).
     answers 에는 지난번 답 20개가 그대로 남아 있어서, 그걸 세면 1번 문항인데 막대가 100% 로 차고
     바로 옆 카운터("1 / 20")와 정면으로 어긋난다. 실제로 그렇게 나왔다 */
  const answeredNow = new Set();

  const showError = (msg) => {
    errorEl.textContent = msg;
    errorEl.classList.add('visible');
    setTimeout(() => errorEl.classList.remove('visible'), 4000);
  };

  const renderQuestion = () => {
    if (idx >= QUESTIONS.length) return finish();
    const q = QUESTIONS[idx];

    counterEl.textContent = String(idx + 1);
    axisEl.textContent = AXES[q.axis] ? AXES[q.axis].label : q.axis;
    promptEl.textContent = q.prompt;

    const answeredCount = REDO
      ? answeredNow.size
      : Object.keys(answers).filter(qId => QUESTIONS.some(qq => qq.id === qId)).length;
    fillEl.style.width = (answeredCount / QUESTIONS.length * 100).toFixed(1) + '%';

    optionsEl.innerHTML = '';
    /* 🔴 id 는 서버에 저장되는 **답변 값**이다 (balance_game_responses.answer = 'A'|'B'|'C').
       화면 라벨만 1·2·3 으로 바꾼다 — 하단 키보드 안내가 1·2·3 이라 버튼에 A·B·C 를 찍으면 서로 안 맞는다.
       ⚠️ id 를 숫자로 바꾸면 기존 응답과 API 검증이 전부 깨진다. */
    const opts = [
      { id: 'A', label: '1', text: q.option_a_text },
      { id: 'B', label: '2', text: q.option_b_text },
      { id: 'C', label: '3', text: '잘 모르겠다 / 관심 없음' }
    ];
    opts.forEach(opt => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'bg-option' + (opt.id === 'C' ? ' skip' : '');
      btn.dataset.optionId = opt.id;
      btn.innerHTML = '<span class="key">' + opt.label + '</span><span class="text">' + escapeHtml(opt.text) + '</span>';
      btn.addEventListener('click', () => choose(opt.id));
      optionsEl.appendChild(btn);
    });

    questionSec.style.animation = 'none';
    questionSec.offsetWidth;
    questionSec.style.animation = '';

    prevBtn.disabled = idx === 0;
  };

  const choose = async (optionId) => {
    if (saving) return;
    saving = true;
    const q = QUESTIONS[idx];
    // 옵티미스틱 — 응답 즉시 다음 문항으로
    const buttons = optionsEl.querySelectorAll('.bg-option');
    buttons.forEach(b => b.disabled = true);
    const nextAnswers = Object.assign({}, answers, { [q.id]: optionId });
    try {
      if (IS_ANON) {
        /* 답변을 **먼저** 로컬에 쓴다 — 채점 요청이 실패해도 답변은 남아야 이어 풀 수 있다 */
        writeLocal(nextAnswers);
        const res = await fetch('/api/balance-game/answers', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ answers: nextAnswers })
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || '채점 실패');
        }
        /* 응답 도중 다른 탭에서 로그인했다면 서버가 알아서 DB 에 저장한다(stored) — 로컬 사본은 지운다.
           같은 엔드포인트라서 화면이 401 을 맞고 답변을 잃는 일이 없다 */
        const data = await res.json().catch(() => ({}));
        if (data && data.stored) dropLocal();
      } else {
        const res = await fetch('/api/balance-game/respond', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ question_id: q.id, answer: optionId })
        });
        if (res.status === 401) {
          const next = encodeURIComponent('/balance-game/respond?pack=' + encodeURIComponent(PACK_ID));
          window.location.href = '/auth/login?next=' + next;
          return;
        }
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || '저장 실패');
        }
      }
      answers = nextAnswers;
      answeredNow.add(q.id);
      idx += 1;
      renderQuestion();
    } catch (err) {
      showError('저장 실패: ' + (err.message || '잠시 후 다시 시도') );
      buttons.forEach(b => b.disabled = false);
    } finally {
      saving = false;
    }
  };

  const goPrev = () => {
    if (idx === 0) return;
    idx -= 1;
    renderQuestion();
  };

  const finish = () => {
    // 종합팩 다 풀었으면 펼침으로
    window.location.href = '/balance-game/reveal';
  };

  const escapeHtml = (s) =>
    String(s).replace(/[&<>"']/g, ch => ({
      '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
    }[ch]));

  document.addEventListener('keydown', (e) => {
    const tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea') return;
    if (saving) return;
    if (idx >= QUESTIONS.length) return;
    if (e.key === '1' || e.key === 'a' || e.key === 'A') { e.preventDefault(); choose('A'); }
    else if (e.key === '2' || e.key === 'b' || e.key === 'B') { e.preventDefault(); choose('B'); }
    else if (e.key === '3' || e.key === 'c' || e.key === 'C') { e.preventDefault(); choose('C'); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); goPrev(); }
  });

  prevBtn.addEventListener('click', goPrev);

  renderQuestion();
})();
</script>
