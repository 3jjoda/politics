<%
  /* 숫자 캐러셀 — 1080×1350 (4:5). SNS.md 백로그 1.
   *
   * 브리핑 인스타 카드(briefing/card.ejs)와 같은 문법:
   *   쿼리 없음   → 전체를 0.35 배로 배열 + 툴바 + 캡션 (사람이 보고 PNG 저장)
   *   ?slide=N   → 그 장만 1:1 (html·body 가 정확히 1080×1350 → 캡처 = 카드)
   * 🔴 두 모드가 **같은 .sl 마크업**을 쓴다 — 미리보기와 산출물이 달라지면 안 된다.
   * ⚠️ layout:false 라 폰트·파비콘을 여기서 직접 로드한다.
   */
  const one = !!single;
  const shown = single ? [slides[single - 1]] : slides;
  const nl2br = (s) => String(s).split('\n');
  const PROC_STEPS = ['발의', '위원회', '본회의', '가결'];
%><!doctype html>
<html lang="ko" class="<%= one ? 'one' : '' %>">
<head>
<meta charset="utf-8">
<title>숫자 캐러셀 · <%= def.label %> · 당말사</title>
<meta name="robots" content="noindex">
<link rel="icon" type="image/svg+xml" href="/assets/imgs/favicon-32.svg">
<link rel="shortcut icon" href="/assets/imgs/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&family=Noto+Serif+KR:wght@700;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#F7F6F1; --bg2:#FFFFFF; --tint:#FBF5EA;
    --ink:#1A1D24; --sub:#4B5362; --sub2:#7A8090;
    --gold:#B8740C; --gold-d:#8F5800;
    --line:#E2DFD4; --line2:#C9C5B6;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: 'Noto Sans KR', sans-serif; background: #3A3833; }

  .sl {
    width: 1080px; height: 1350px; flex: 0 0 auto;
    background: var(--bg); color: var(--ink);
    display: flex; flex-direction: column;
    position: relative; overflow: hidden;
  }
  .sl-rule { height: 14px; flex: 0 0 auto; background: var(--gold); }
  .sl.is-sub .sl-rule { height: 8px; background: var(--line); }
  .sl.is-sub .sl-rule::after { content:''; display:block; width: 160px; height: 100%; background: var(--gold); }
  .sl-in { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 62px 76px 56px; }
  .sl-in, .sl-in * { word-break: keep-all; overflow-wrap: anywhere; }

  .sl-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex: 0 0 auto; }
  .sl-date { font-family:'JetBrains Mono',monospace; font-size: 30px; font-weight: 700; letter-spacing: .12em; color: var(--sub2); }
  .sl-tag {
    font-size: 26px; font-weight: 700; letter-spacing: .04em; color: var(--gold-d);
    border: 2px solid var(--gold-d); border-radius: 10px; padding: 7px 18px; background: var(--tint); white-space: nowrap;
  }

  /* 🔴 briefing/card.ejs 와 같은 세 줄 세트 — safe center · overflow:hidden · 자식 shrink 금지 */
  .sl-body { flex: 1; min-height: 0; display: flex; flex-direction: column;
             justify-content: center; justify-content: safe center;
             overflow: hidden; padding: 44px 0; }
  .sl-body > * { flex: 0 0 auto; }

  /* ── num · bridge — 큰 숫자 장 ── */
  .n-kicker { font-size: 40px; font-weight: 500; color: var(--sub); margin: 0 0 8px; }
  .n-big { font-family:'JetBrains Mono',monospace; font-weight: 700; font-size: 230px; line-height: 1.1;
           letter-spacing: -.04em; color: var(--ink); margin: 0; }
  .n-big.is-mid { font-size: 150px; }
  .n-line { font-family:'Noto Serif KR',serif; font-weight: 900; font-size: 60px; line-height: 1.4;
            margin: 26px 0 0; padding-left: 30px; border-left: 12px solid var(--gold); }
  .n-sub { font-size: 34px; line-height: 1.65; color: var(--sub); margin: 40px 0 0; max-width: 860px; }
  .n-meta { font-size: 27px; color: var(--sub2); margin: 44px 0 0; padding-top: 26px; border-top: 2px solid var(--line); }

  /* ── ask — 질문 장 ── */
  .a-head { font-family:'Noto Serif KR',serif; font-weight: 900; font-size: 78px; line-height: 1.38; margin: 0; }
  .a-head em { font-style: normal; color: var(--gold-d); }
  .a-sub { font-size: 36px; line-height: 1.7; color: var(--sub); margin: 52px 0 0; max-width: 880px;
           padding-left: 30px; border-left: 6px solid var(--line2); }

  /* ── process — 발의 → 위원회 → 본회의 → 가결 ── */
  .p-head { font-family:'Noto Serif KR',serif; font-weight: 900; font-size: 74px; line-height: 1.35; margin: 0 0 64px; }
  .p-steps { display: flex; align-items: center; gap: 18px; }
  .p-step { flex: 1; text-align: center; border: 3px solid var(--line2); border-radius: 18px;
            background: var(--bg2); padding: 34px 8px; font-size: 40px; font-weight: 700; color: var(--sub); }
  .p-step.on { border-color: var(--gold); background: var(--tint); color: var(--ink);
               box-shadow: 0 0 0 5px rgba(184,116,12,.14); }
  .p-arrow { flex: 0 0 auto; font-size: 36px; color: var(--line2); font-weight: 700; }
  .p-note { font-size: 33px; line-height: 1.7; color: var(--sub); margin: 64px 0 0;
            padding-left: 30px; border-left: 6px solid var(--line2); }

  /* ── outro ── */
  .o-wrap { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .o-head { font-family:'Noto Serif KR',serif; font-weight: 900; font-size: 76px; line-height: 1.42; margin: 0 0 70px; }
  .o-mark { width: 120px; height: 120px; display: block; margin-bottom: 22px; }
  .o-wm { height: 56px; display: block; margin-bottom: 14px; }
  .o-tag { height: 34px; display: block; margin-bottom: 54px; }
  .o-url { font-family:'JetBrains Mono',monospace; font-size: 40px; font-weight: 700; color: var(--gold-d); letter-spacing: .02em; }
  .o-note { font-size: 26px; line-height: 1.65; color: var(--sub2); margin: 64px 0 0;
            padding-top: 28px; border-top: 2px solid var(--line); max-width: 820px; }

  /* 하단 브랜드 줄 — briefing 카드와 같은 조립 규칙 (마크 46 · 안 12px · 밖 16px · 태그라인 h28) */
  .sl-foot { flex: 0 0 auto; display: flex; align-items: center; gap: 16px; border-top: 2px solid var(--line); padding-top: 26px; }
  .sl-brand { display: flex; align-items: center; gap: 12px; }
  .sl-mark { width: 46px; height: 46px; display: block; }
  .sl-wm { height: 34px; display: block; }
  .sl-div { width: 1px; height: 30px; background: var(--line2); flex: 0 0 auto; }
  .sl-tagline { height: 28px; display: block; }
  .sl-url { margin-left: auto; font-family:'JetBrains Mono',monospace; font-size: 26px; font-weight: 500; color: var(--gold-d); letter-spacing: .02em; }
  .sl-src { font-size: 24px; color: var(--sub2); }

  /* ── 1:1 캡처 모드 ── */
  html.one, html.one body { width: 1080px; height: 1350px; overflow: hidden; background: var(--bg); }

  /* ── 미리보기 모드 ── */
  .tb { position: sticky; top: 0; z-index: 10; background: #26241F; color: #EDEBE4;
        display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding: 14px 22px; font-size: 14px; }
  .tb b { font-size: 15px; }
  .tb .sp { margin-left: auto; color: #A8A295; font-size: 12.5px; }
  .tb a { color: #D9A040; }
  .tb code { background: #3A3833; border-radius: 4px; padding: 2px 7px; }
  .tb-nav { display: flex; gap: 8px; }
  .tb-nav a { display: inline-block; padding: 6px 14px; border-radius: 8px; border: 1px solid #4A4640;
              color: #EDEBE4; text-decoration: none; font-size: 13px; }
  .tb-nav a.on { border-color: #D9A040; color: #D9A040; font-weight: 700; }
  .tb-dl { background: #D9A040; color: #26241F; border: 0; border-radius: 8px; font-weight: 800;
           font-size: 13.5px; padding: 8px 16px; cursor: pointer; font-family: inherit; }
  .tb-status { font-size: 12.5px; color: #A8A295; }
  .pv { display: flex; flex-wrap: wrap; gap: 26px; padding: 30px; align-items: flex-start; }
  .pv-item { width: 378px; }
  .pv-box { width: 378px; height: 472.5px; overflow: hidden; border-radius: 6px; box-shadow: 0 8px 30px rgba(0,0,0,.35); }
  .pv-box .sl { transform: scale(.35); transform-origin: top left; }
  .pv-meta { display: flex; align-items: center; gap: 10px; margin-top: 10px; color: #C9C5BA; font-size: 12.5px; }
  .pv-dl { background: transparent; color: #D9A040; border: 1px solid #D9A040; border-radius: 7px;
           font-weight: 700; font-size: 12px; padding: 5px 12px; cursor: pointer; font-family: inherit; margin-left: auto; }
  .cap { max-width: 820px; margin: 6px 30px 50px; background: #1E1C18; border: 1px solid #3A3833;
         border-radius: 10px; padding: 18px 22px; color: #D8D4C9; }
  .cap h3 { margin: 0 0 10px; font-size: 14px; color: #A8A295; display: flex; align-items: center; gap: 12px; }
  .cap pre { margin: 0; white-space: pre-wrap; font-family: inherit; font-size: 14px; line-height: 1.8; }
  .cap button { background: transparent; color: #D9A040; border: 1px solid #D9A040; border-radius: 7px;
                font-weight: 700; font-size: 12px; padding: 4px 12px; cursor: pointer; font-family: inherit; }
</style>
</head>
<body class="<%= one ? 'one' : '' %>">

<% if (!one) { %>
  <div class="tb" data-shot-omit>
    <b>숫자 캐러셀</b>
    <div class="tb-nav">
      <% seriesList.forEach((s2) => { %>
        <a href="/promo/numbers?series=<%= s2.key %>" class="<%= s2.key === seriesKey ? 'on' : '' %>"><%= s2.label %> · <%= s2.title %></a>
      <% }) %>
    </div>
    <span><%= slides.length %>장 · 1080 × 1350 (4:5)</span>
    <button type="button" class="tb-dl" id="dl-all">PNG 전부 저장 (<%= slides.length %>장)</button>
    <span class="tb-status" id="dl-status"></span>
    <span class="sp"><a href="/promo/intro">소개</a> · <a href="/promo/balance">진단</a> · <a href="/promo/threads">쓰레드 문안</a> · 숫자는 지금 이 순간의 DB 집계입니다</span>
  </div>
  <div class="pv">
<% } %>

<% shown.forEach((s, i) => { const no = single || (i + 1); %>
  <% if (!one) { %><div class="pv-item" id="pv-<%= no %>"><div class="pv-box"><% } %>

  <section class="sl <%= no === 1 ? '' : 'is-sub' %>" data-slide="<%= no %>">
    <div class="sl-rule"></div>
    <div class="sl-in">

      <div class="sl-head">
        <span class="sl-date"><%= dateKo %> 기준</span>
        <span class="sl-tag">22대 국회</span>
      </div>

      <% if (s.kind === 'num' || s.kind === 'bridge') { %>
        <div class="sl-body">
          <% if (s.kicker) { %><p class="n-kicker"><%= s.kicker %></p><% } %>
          <p class="n-big <%= s.kind === 'bridge' ? 'is-mid' : '' %>"><%= s.big %></p>
          <h2 class="n-line"><%= s.line %></h2>
          <% if (s.sub) { %><p class="n-sub"><%= s.sub %></p><% } %>
          <% if (s.meta) { %><p class="n-meta"><%= s.meta %></p><% } %>
        </div>
      <% } else if (s.kind === 'ask') { %>
        <div class="sl-body">
          <h2 class="a-head"><% nl2br(s.head).forEach((ln, k) => { %><%= ln %><% if (k < nl2br(s.head).length - 1) { %><br><% } %><% }) %></h2>
          <% if (s.sub) { %><p class="a-sub"><%= s.sub %></p><% } %>
        </div>
      <% } else if (s.kind === 'process') { %>
        <div class="sl-body">
          <h2 class="p-head"><%= s.head %></h2>
          <div class="p-steps">
            <% PROC_STEPS.forEach((st, k) => { %>
              <div class="p-step <%= k === s.active ? 'on' : '' %>"><%= st %></div>
              <% if (k < PROC_STEPS.length - 1) { %><span class="p-arrow">→</span><% } %>
            <% }) %>
          </div>
          <% if (s.note) { %><p class="p-note"><%= s.note %></p><% } %>
        </div>
      <% } else if (s.kind === 'outro') { %>
        <div class="sl-body">
          <div class="o-wrap">
            <h2 class="o-head"><% nl2br(s.head).forEach((ln, k) => { %><%= ln %><% if (k < nl2br(s.head).length - 1) { %><br><% } %><% }) %></h2>
            <img class="o-mark" src="<%= asset('/assets/imgs/mark-only.svg') %>" alt="">
            <img class="o-wm" src="<%= asset('/assets/imgs/wordmark-nav.svg') %>" alt="당말사">
            <img class="o-tag" src="<%= asset('/assets/imgs/tagline.svg') %>" alt="당 말고 사람">
            <div class="o-url">dangmalsa.kr</div>
            <p class="o-note"><%= s.note || 'AI 없이 국회 공식 데이터 집계만으로 만든 카드입니다.' %> 출처: 열린국회정보</p>
          </div>
        </div>
      <% } %>

      <% if (s.kind !== 'outro') { %>
        <div class="sl-foot">
          <span class="sl-brand">
            <img class="sl-mark" src="<%= asset('/assets/imgs/mark-only.svg') %>" alt="">
            <img class="sl-wm" src="<%= asset('/assets/imgs/wordmark-nav.svg') %>" alt="당말사">
          </span>
          <span class="sl-div"></span>
          <img class="sl-tagline" src="<%= asset('/assets/imgs/tagline.svg') %>" alt="당 말고 사람">
          <span class="sl-src">· 출처 열린국회정보</span>
          <span class="sl-url">dangmalsa.kr</span>
        </div>
      <% } %>

    </div>
  </section>

  <% if (!one) { %></div>
    <div class="pv-meta" data-shot-omit>
      <span><%= no %> / <%= slides.length %></span>
      <a href="/promo/numbers?series=<%= seriesKey %>&slide=<%= no %>" target="_blank" style="color:#A8A295">1:1로 열기</a>
      <button type="button" class="pv-dl" data-name="numbers-<%= seriesKey %>-<%= String(no).padStart(2, '0') %>.png">PNG 저장</button>
    </div>
  </div><% } %>
<% }) %>

<% if (!one) { %>
  </div>
  <div class="cap" data-shot-omit>
    <h3>인스타 캡션 <button type="button" id="cap-copy">복사</button> <span id="cap-status"></span></h3>
    <pre id="cap-text"><%= caption %></pre>
  </div>

  <script>window.__ASSET_VER__ = <%- JSON.stringify(assetVer) %>;</script>
  <script src="<%= asset('/scripts/cardShot.js') %>"></script>
  <script>
  (function () {
    'use strict';
    var status = document.getElementById('dl-status');
    function say(msg, bad) { if (status) { status.textContent = msg; status.style.color = bad ? '#E08A8A' : '#A8A295'; } }
    function cardOf(btn) { return btn.closest('.pv-item').querySelector('.sl'); }

    document.querySelectorAll('.pv-dl').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        btn.disabled = true;
        try { await PBCard.save(cardOf(btn), btn.dataset.name); }
        catch (e) { console.error('[cardShot]', e); say('저장 실패: ' + e.message, true); }
        btn.disabled = false;
      });
    });

    var all = document.getElementById('dl-all');
    var ALL_LABEL = all ? all.textContent : '';
    var ready = null;   // 모바일 2단계용으로 만들어 둔 File[] — 브리핑 카드와 같은 패턴
    // 🔴 모바일은 두 번 탭이다 (만들기 → 'N장 공유하기' → 공유). navigator.share 는 제스처 권한(~5초)
    //    안에서만 열려서, 같은 탭에서 만들기를 await 한 뒤 부르면 실패한다 (브리핑 카드 실기기에서 배운 것).
    if (all) all.addEventListener('click', async function () {
      var btns = Array.prototype.slice.call(document.querySelectorAll('.pv-dl'));
      var items = btns.map(function (b) { return { node: cardOf(b), name: b.dataset.name }; });

      // 2단계 — 앞선 탭에서 만들어 둔 것을 await 없이 바로 넘긴다
      if (ready) {
        try {
          var ok = await PBCard.shareFiles(ready, ready.length + '장');
          if (ok) { ready = null; all.textContent = ALL_LABEL; say('사진 앱에 저장했습니다.'); }
          else say('취소했습니다. 다시 누르면 그대로 보냅니다.');
        } catch (e) { console.error('[cardShot]', e); say('공유에 실패했습니다. 카드마다 PNG 저장을 눌러주세요.', true); }
        return;
      }

      all.disabled = true;
      try {
        if (PBCard.isTouch) {
          // 공유 시트 자체가 없으면 만들 것도 없다 (다 만든 뒤 못 준다고 말하면 시간만 버린다)
          if (!PBCard.canShareFiles([])) { say('이 브라우저는 여러 장을 한 번에 못 받습니다. 카드마다 PNG 저장을 눌러주세요.', true); return; }
          var files = await PBCard.toFiles(items, function (i, n) { all.textContent = '만드는 중… ' + (i + 1) + '/' + n; say(''); });
          if (!PBCard.canShareFiles(files)) { say('이 브라우저는 여러 장을 한 번에 못 받습니다. 카드마다 PNG 저장을 눌러주세요.', true); all.textContent = ALL_LABEL; return; }
          ready = files;
          all.textContent = files.length + '장 공유하기';
          say('다 만들었습니다. 한 번 더 눌러 사진 앱에 저장하세요.');
          return;
        }
        for (var j = 0; j < items.length; j++) {
          all.textContent = '저장 중… ' + (j + 1) + '/' + items.length; say('');
          await PBCard.save(items[j].node, items[j].name, { share: false });
          await new Promise(function (r) { setTimeout(r, 350); });   // 연속 다운로드를 브라우저가 삼키지 않게
        }
        say(items.length + '장을 저장했습니다. 다운로드 폴더를 확인하세요.');
        all.textContent = ALL_LABEL;
      } catch (e) { console.error('[cardShot]', e); say((e && e.message) || '저장에 실패했습니다', true); all.textContent = ALL_LABEL; }
      finally { all.disabled = false; }
    });
    var copyBtn = document.getElementById('cap-copy');
    if (copyBtn) copyBtn.addEventListener('click', function () {
      navigator.clipboard.writeText(document.getElementById('cap-text').textContent).then(function () {
        document.getElementById('cap-status').textContent = '복사됨';
        setTimeout(function () { document.getElementById('cap-status').textContent = ''; }, 1500);
      });
    });
  })();
  </script>
<% } %>
</body>
</html>
