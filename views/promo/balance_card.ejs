<%
  /* 진단 캐러셀 — 1080×1350 (4:5) 6장. SNS.md 백로그 2.
   * numbers_card.ejs 와 같은 문법 (쿼리 없음 = 미리보기+PNG / ?slide=N = 1:1) · 같은 토큰.
   * 🔴 TOP3 장은 실명이 아니라 마스킹 목업 (컨트롤러 주석 참조).
   * 지도 점구름은 getAxisCloud — 익명 좌표뿐이라 개인 식별·정당 신호가 없다 (공유 카드와 같은 재료).
   */
  const one = !!single;
  const shown = single ? [slides[single - 1]] : slides;
  // 지도 투영 — economy(x) × social(y). 홈 히어로·공유 카드 지도와 같은 두 축 (institution 은 평면에 안 그린다)
  const MAP_W = 880, MAP_H = 640, PAD = 46;
  const px = (v) => PAD + (Number(v) + 1) / 2 * (MAP_W - PAD * 2);
  const py = (v) => (MAP_H - PAD) - (Number(v) + 1) / 2 * (MAP_H - PAD * 2);
%><!doctype html>
<html lang="ko" class="<%= one ? 'one' : '' %>">
<head>
<meta charset="utf-8">
<title>진단 캐러셀 · 당말사</title>
<meta name="robots" content="noindex">
<link rel="icon" type="image/svg+xml" href="/assets/imgs/favicon-32.svg">
<link rel="shortcut icon" href="/assets/imgs/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&family=Noto+Serif+KR:wght@700;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#F7F6F1; --bg2:#FFFFFF; --tint:#FBF5EA;
    --ink:#1A1D24; --sub:#4B5362; --sub2:#7A8090;
    --gold:#B8740C; --gold-d:#8F5800;
    --line:#E2DFD4; --line2:#C9C5B6;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: 'Noto Sans KR', sans-serif; background: #3A3833; }

  .sl { width: 1080px; height: 1350px; flex: 0 0 auto; background: var(--bg); color: var(--ink);
        display: flex; flex-direction: column; position: relative; overflow: hidden; }
  .sl-rule { height: 14px; flex: 0 0 auto; background: var(--gold); }
  .sl.is-sub .sl-rule { height: 8px; background: var(--line); }
  .sl.is-sub .sl-rule::after { content:''; display:block; width: 160px; height: 100%; background: var(--gold); }
  .sl-in { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 62px 76px 56px; }
  .sl-in, .sl-in * { word-break: keep-all; overflow-wrap: anywhere; }
  .sl-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex: 0 0 auto; }
  .sl-date { font-family:'JetBrains Mono',monospace; font-size: 30px; font-weight: 700; letter-spacing: .12em; color: var(--sub2); }
  .sl-tag { font-size: 26px; font-weight: 700; letter-spacing: .04em; color: var(--gold-d);
            border: 2px solid var(--gold-d); border-radius: 10px; padding: 7px 18px; background: var(--tint); white-space: nowrap; }
  .sl-body { flex: 1; min-height: 0; display: flex; flex-direction: column;
             justify-content: center; justify-content: safe center; overflow: hidden; padding: 44px 0; }
  .sl-body > * { flex: 0 0 auto; }

  .kicker { font-family:'JetBrains Mono',monospace; font-size: 28px; font-weight: 700; letter-spacing: .14em;
            color: var(--gold-d); margin: 0 0 36px; }
  .head { font-family:'Noto Serif KR',serif; font-weight: 900; font-size: 84px; line-height: 1.36; margin: 0; }
  .head em { font-style: normal; color: var(--gold-d); }
  .head.s { font-size: 74px; }
  .subp { font-size: 36px; line-height: 1.7; color: var(--sub); margin: 52px 0 0; max-width: 880px;
          padding-left: 30px; border-left: 6px solid var(--line2); }

  /* 축 3줄 */
  .ax { margin-top: 56px; }
  .ax-row { padding: 36px 0; border-top: 2px solid var(--line); }
  .ax-row:last-child { border-bottom: 2px solid var(--line); }
  .ax-name { font-size: 40px; font-weight: 800; margin: 0 0 6px; }
  .ax-name small { font-size: 27px; font-weight: 500; color: var(--sub2); margin-left: 16px; }
  .ax-bar { display: flex; align-items: center; gap: 20px; margin-top: 20px; }
  .ax-pole { font-size: 32px; font-weight: 700; color: var(--sub); flex: 0 0 auto; }
  .ax-track { flex: 1; height: 10px; border-radius: 5px; background: var(--line);
              position: relative; }
  .ax-track::before, .ax-track::after { content:''; position: absolute; top: 50%; width: 16px; height: 16px;
              border-radius: 50%; transform: translateY(-50%); background: var(--gold); }
  .ax-track::before { left: 0; } .ax-track::after { right: 0; }
  .ax-track i { position: absolute; left: 50%; top: -8px; bottom: -8px; width: 2px; background: var(--line2); }

  /* 지도 장 */
  .map-head { font-family:'Noto Serif KR',serif; font-weight: 900; font-size: 62px; line-height: 1.36; margin: 0 0 40px; }
  .map-box { background: var(--bg2); border: 3px solid var(--line); border-radius: 20px; padding: 18px; align-self: center; }
  .map-cap { font-size: 30px; color: var(--sub); margin: 36px 0 0; text-align: center; }
  .map-cap b { color: var(--gold-d); }

  /* 결과 목업 장 */
  .mk-card { background: var(--bg2); border: 3px solid var(--line); border-radius: 22px; padding: 44px 48px; }
  .mk-k { font-family:'JetBrains Mono',monospace; font-size: 25px; font-weight: 700; letter-spacing: .12em; color: var(--gold-d); margin: 0 0 18px; }
  .mk-type { font-family:'Noto Serif KR',serif; font-weight: 900; font-size: 66px; margin: 0 0 8px; }
  .mk-type .mask { color: transparent; background: var(--line); border-radius: 10px; }
  .mk-sub { font-size: 29px; color: var(--sub2); margin: 0 0 34px; }
  .mk-row { display: flex; align-items: center; gap: 22px; padding: 22px 0; border-top: 2px solid var(--line); }
  .mk-no { flex: 0 0 52px; height: 52px; border-radius: 50%; border: 3px solid var(--gold); color: var(--gold-d);
           font: 700 26px/46px 'JetBrains Mono',monospace; text-align: center; }
  .mk-name { font-size: 38px; font-weight: 700; }
  .mk-name .mask { color: transparent; background: var(--line); border-radius: 8px; }
  .mk-dist { margin-left: auto; font-size: 26px; color: var(--sub2); }
  .mk-note { font-size: 31px; line-height: 1.65; color: var(--sub); margin: 44px 0 0;
             padding-left: 30px; border-left: 6px solid var(--line2); }

  /* outro */
  .o-wrap { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .o-head { font-family:'Noto Serif KR',serif; font-weight: 900; font-size: 82px; line-height: 1.4; margin: 0 0 30px; }
  .o-pts { font-size: 34px; color: var(--sub); line-height: 2; margin: 0 0 64px; }
  .o-pts b { color: var(--ink); }
  .o-mark { width: 120px; height: 120px; display: block; margin-bottom: 22px; }
  .o-wm { height: 56px; display: block; margin-bottom: 14px; }
  .o-tag { height: 34px; display: block; margin-bottom: 50px; }
  .o-url { font-family:'JetBrains Mono',monospace; font-size: 40px; font-weight: 700; color: var(--gold-d); letter-spacing: .02em; }
  .o-note { font-size: 26px; line-height: 1.65; color: var(--sub2); margin: 58px 0 0;
            padding-top: 28px; border-top: 2px solid var(--line); max-width: 840px; }

  .sl-foot { flex: 0 0 auto; display: flex; align-items: center; gap: 16px; border-top: 2px solid var(--line); padding-top: 26px; }
  .sl-brand { display: flex; align-items: center; gap: 12px; }
  .sl-mark { width: 46px; height: 46px; display: block; }
  .sl-wm { height: 34px; display: block; }
  .sl-div { width: 1px; height: 30px; background: var(--line2); flex: 0 0 auto; }
  .sl-tagline { height: 28px; display: block; }
  .sl-url { margin-left: auto; font-family:'JetBrains Mono',monospace; font-size: 26px; font-weight: 500; color: var(--gold-d); letter-spacing: .02em; }
  .sl-src { font-size: 24px; color: var(--sub2); }

  html.one, html.one body { width: 1080px; height: 1350px; overflow: hidden; background: var(--bg); }

  .tb { position: sticky; top: 0; z-index: 10; background: #26241F; color: #EDEBE4;
        display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding: 14px 22px; font-size: 14px; }
  .tb b { font-size: 15px; }
  .tb .sp { margin-left: auto; color: #A8A295; font-size: 12.5px; }
  .tb a { color: #D9A040; }
  .tb-dl { background: #D9A040; color: #26241F; border: 0; border-radius: 8px; font-weight: 800;
           font-size: 13.5px; padding: 8px 16px; cursor: pointer; font-family: inherit; }
  .tb-status { font-size: 12.5px; color: #A8A295; }
  .pv { display: flex; flex-wrap: wrap; gap: 26px; padding: 30px; align-items: flex-start; }
  .pv-item { width: 378px; }
  .pv-box { width: 378px; height: 472.5px; overflow: hidden; border-radius: 6px; box-shadow: 0 8px 30px rgba(0,0,0,.35); }
  .pv-box .sl { transform: scale(.35); transform-origin: top left; }
  .pv-meta { display: flex; align-items: center; gap: 10px; margin-top: 10px; color: #C9C5BA; font-size: 12.5px; }
  .pv-dl { background: transparent; color: #D9A040; border: 1px solid #D9A040; border-radius: 7px;
           font-weight: 700; font-size: 12px; padding: 5px 12px; cursor: pointer; font-family: inherit; margin-left: auto; }
  .cap { max-width: 820px; margin: 6px 30px 50px; background: #1E1C18; border: 1px solid #3A3833;
         border-radius: 10px; padding: 18px 22px; color: #D8D4C9; }
  .cap h3 { margin: 0 0 10px; font-size: 14px; color: #A8A295; display: flex; align-items: center; gap: 12px; }
  .cap pre { margin: 0; white-space: pre-wrap; font-family: inherit; font-size: 14px; line-height: 1.8; }
  .cap button { background: transparent; color: #D9A040; border: 1px solid #D9A040; border-radius: 7px;
                font-weight: 700; font-size: 12px; padding: 4px 12px; cursor: pointer; font-family: inherit; }
</style>
</head>
<body class="<%= one ? 'one' : '' %>">

<% if (!one) { %>
  <div class="tb" data-shot-omit>
    <b>진단 캐러셀</b>
    <span><%= slides.length %>장 · 1080 × 1350 (4:5)</span>
    <button type="button" class="tb-dl" id="dl-all">PNG 전부 저장 (<%= slides.length %>장)</button>
    <span class="tb-status" id="dl-status"></span>
    <span class="sp"><a href="/promo/intro">소개</a> · <a href="/promo/numbers">숫자</a> · <a href="/promo/threads">쓰레드 문안</a> · 의원 수·문항 수는 지금 이 순간의 DB 값입니다</span>
  </div>
  <div class="pv">
<% } %>

<% shown.forEach((s, i) => { const no = single || (i + 1); %>
  <% if (!one) { %><div class="pv-item" id="pv-<%= no %>"><div class="pv-box"><% } %>

  <section class="sl <%= no === 1 ? '' : 'is-sub' %>" data-slide="<%= no %>">
    <div class="sl-rule"></div>
    <div class="sl-in">

      <div class="sl-head">
        <span class="sl-date"><%= dateKo %> 기준</span>
        <span class="sl-tag">정치 성향 진단</span>
      </div>

      <% if (s.kind === 'hook') { %>
        <div class="sl-body">
          <p class="kicker">당 말고 사람</p>
          <h2 class="head">국회의원 <em><%= polTotal %>명</em> 중<br>당신과 가장 가까운<br>사람은 누구일까요?</h2>
          <p class="subp"><%= qCount %>개의 질문이면 알 수 있습니다. 로그인 없이, 약 5분.</p>
        </div>
      <% } else if (s.kind === 'reframe') { %>
        <div class="sl-body">
          <h2 class="head">정치 성향은<br>보수 / 진보 하나로<br>설명되지 않습니다</h2>
          <p class="subp">당말사는 국회 법안 기록에서 만든 세 개의 축으로 봅니다. 같은 "보수", 같은 "진보" 안에서도 사람마다 위치가 다릅니다.</p>
        </div>
      <% } else if (s.kind === 'axes') { %>
        <div class="sl-body">
          <h2 class="head s">세 개의 축</h2>
          <div class="ax">
            <% axes.forEach((a) => { %>
              <div class="ax-row">
                <p class="ax-name"><%= a.name %><small><%= a.short %></small></p>
                <div class="ax-bar">
                  <span class="ax-pole"><%= a.Lx %></span>
                  <span class="ax-track"><i></i></span>
                  <span class="ax-pole"><%= a.Rx %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } else if (s.kind === 'map') { %>
        <div class="sl-body">
          <h2 class="map-head">국회의원 <%= polTotal %>명이<br>이 지도 위에 있습니다</h2>
          <div class="map-box">
            <svg width="<%= MAP_W %>" height="<%= MAP_H %>" viewBox="0 0 <%= MAP_W %> <%= MAP_H %>" xmlns="http://www.w3.org/2000/svg">
              <line x1="<%= MAP_W/2 %>" y1="<%= PAD - 14 %>" x2="<%= MAP_W/2 %>" y2="<%= MAP_H - PAD + 14 %>" stroke="#E2DFD4" stroke-width="2"/>
              <line x1="<%= PAD - 14 %>" y1="<%= MAP_H/2 %>" x2="<%= MAP_W - PAD + 14 %>" y2="<%= MAP_H/2 %>" stroke="#E2DFD4" stroke-width="2"/>
              <% cloud.forEach((c) => { %><circle cx="<%= px(c[0]).toFixed(1) %>" cy="<%= py(c[1]).toFixed(1) %>" r="7" fill="#8A8577" opacity=".42"/><% }) %>
              <%# 사분면 이름 — 유형 4종 (TYPE_NAMES 단일 소스). 익명 점구름 위의 유일한 라벨 %>
              <text x="<%= PAD %>" y="<%= PAD + 6 %>" font-size="27" font-weight="700" fill="#8F5800" font-family="Noto Sans KR"><%= quads.LR %></text>
              <text x="<%= MAP_W - PAD %>" y="<%= PAD + 6 %>" text-anchor="end" font-size="27" font-weight="700" fill="#8F5800" font-family="Noto Sans KR"><%= quads.RR %></text>
              <text x="<%= PAD %>" y="<%= MAP_H - PAD + 2 %>" font-size="27" font-weight="700" fill="#8F5800" font-family="Noto Sans KR"><%= quads.LL %></text>
              <text x="<%= MAP_W - PAD %>" y="<%= MAP_H - PAD + 2 %>" text-anchor="end" font-size="27" font-weight="700" fill="#8F5800" font-family="Noto Sans KR"><%= quads.RL %></text>
              <%# 가운데 골드 링 + 물음표 — "당신의 점" 자리. 중앙이라 어느 쪽도 편들지 않는다 %>
              <circle cx="<%= MAP_W/2 %>" cy="<%= MAP_H/2 %>" r="26" fill="#F7F6F1" stroke="#B8740C" stroke-width="6"/>
              <text x="<%= MAP_W/2 %>" y="<%= MAP_H/2 + 12 %>" text-anchor="middle" font-size="34" font-weight="800" fill="#8F5800" font-family="Noto Sans KR">?</text>
            </svg>
          </div>
          <p class="map-cap">가로 경제 · 세로 사회문화 — <b><%= qCount %>문항에 답하면 당신의 점이 찍힙니다</b></p>
        </div>
      <% } else if (s.kind === 'mock') { %>
        <div class="sl-body">
          <h2 class="head s" style="margin-bottom:48px">이런 결과를 받습니다</h2>
          <div class="mk-card">
            <p class="mk-k">당신의 유형</p>
            <p class="mk-type">나는 <span class="mask">○○ ○○○</span></p>
            <p class="mk-sub">아홉 가지 유형 중 하나 + 축별 위치</p>
            <div class="mk-row"><span class="mk-no">1</span><span class="mk-name"><span class="mask">○○○</span> 의원</span><span class="mk-dist">서울 ○○구 · 나와 가장 가깝다</span></div>
            <div class="mk-row"><span class="mk-no">2</span><span class="mk-name"><span class="mask">○○○</span> 의원</span><span class="mk-dist">경기 ○○시</span></div>
            <div class="mk-row"><span class="mk-no">3</span><span class="mk-name"><span class="mask">○○○</span> 의원</span><span class="mk-dist">부산 ○○구</span></div>
          </div>
          <p class="mk-note">가장 가까운 3명과 <b>가장 먼 3명</b>까지. 결과는 당신만 봅니다 — 여기 이름은 가려둔 예시입니다.</p>
        </div>
      <% } else if (s.kind === 'outro') { %>
        <div class="sl-body">
          <div class="o-wrap">
            <h2 class="o-head">로그인 없이,<br>약 5분</h2>
            <p class="o-pts"><b><%= qCount %>문항</b> · 답변은 이 브라우저에만 저장 · 국회의원 <b><%= polTotal %>명</b>과 비교</p>
            <img class="o-mark" src="<%= asset('/assets/imgs/mark-only.svg') %>" alt="">
            <img class="o-wm" src="<%= asset('/assets/imgs/wordmark-nav.svg') %>" alt="당말사">
            <img class="o-tag" src="<%= asset('/assets/imgs/tagline.svg') %>" alt="당 말고 사람">
            <div class="o-url">dangmalsa.kr/balance-game</div>
            <p class="o-note">성향 진단은 정밀한 측정이 아니라 근사입니다. 의원 좌표는 국회 공동발의 기록으로 만들었습니다. 출처: 열린국회정보</p>
          </div>
        </div>
      <% } %>

      <% if (s.kind !== 'outro') { %>
        <div class="sl-foot">
          <span class="sl-brand">
            <img class="sl-mark" src="<%= asset('/assets/imgs/mark-only.svg') %>" alt="">
            <img class="sl-wm" src="<%= asset('/assets/imgs/wordmark-nav.svg') %>" alt="당말사">
          </span>
          <span class="sl-div"></span>
          <img class="sl-tagline" src="<%= asset('/assets/imgs/tagline.svg') %>" alt="당 말고 사람">
          <span class="sl-url">dangmalsa.kr/balance-game</span>
        </div>
      <% } %>

    </div>
  </section>

  <% if (!one) { %></div>
    <div class="pv-meta" data-shot-omit>
      <span><%= no %> / <%= slides.length %></span>
      <a href="/promo/balance?slide=<%= no %>" target="_blank" style="color:#A8A295">1:1로 열기</a>
      <button type="button" class="pv-dl" data-name="balance-<%= String(no).padStart(2, '0') %>.png">PNG 저장</button>
    </div>
  </div><% } %>
<% }) %>

<% if (!one) { %>
  </div>
  <div class="cap" data-shot-omit>
    <h3>인스타 캡션 <button type="button" id="cap-copy">복사</button> <span id="cap-status"></span></h3>
    <pre id="cap-text"><%= caption %></pre>
  </div>

  <script>window.__ASSET_VER__ = <%- JSON.stringify(assetVer) %>;</script>
  <script src="<%= asset('/scripts/cardShot.js') %>"></script>
  <script>
  (function () {
    'use strict';
    var status = document.getElementById('dl-status');
    function say(msg, bad) { if (status) { status.textContent = msg; status.style.color = bad ? '#E08A8A' : '#A8A295'; } }
    function cardOf(btn) { return btn.closest('.pv-item').querySelector('.sl'); }
    document.querySelectorAll('.pv-dl').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        btn.disabled = true;
        try { await PBCard.save(cardOf(btn), btn.dataset.name); }
        catch (e) { console.error('[cardShot]', e); say('저장 실패: ' + e.message, true); }
        btn.disabled = false;
      });
    });
    var all = document.getElementById('dl-all');
    var ALL_LABEL = all ? all.textContent : '';
    var ready = null;   // 모바일 2단계용으로 만들어 둔 File[] — 브리핑 카드와 같은 패턴
    // 🔴 모바일은 두 번 탭이다 (만들기 → 'N장 공유하기' → 공유). navigator.share 는 제스처 권한(~5초)
    //    안에서만 열려서, 같은 탭에서 만들기를 await 한 뒤 부르면 실패한다 (브리핑 카드 실기기에서 배운 것).
    if (all) all.addEventListener('click', async function () {
      var btns = Array.prototype.slice.call(document.querySelectorAll('.pv-dl'));
      var items = btns.map(function (b) { return { node: cardOf(b), name: b.dataset.name }; });

      // 2단계 — 앞선 탭에서 만들어 둔 것을 await 없이 바로 넘긴다
      if (ready) {
        try {
          var ok = await PBCard.shareFiles(ready, ready.length + '장');
          if (ok) { ready = null; all.textContent = ALL_LABEL; say('사진 앱에 저장했습니다.'); }
          else say('취소했습니다. 다시 누르면 그대로 보냅니다.');
        } catch (e) { console.error('[cardShot]', e); say('공유에 실패했습니다. 카드마다 PNG 저장을 눌러주세요.', true); }
        return;
      }

      all.disabled = true;
      try {
        if (PBCard.isTouch) {
          // 공유 시트 자체가 없으면 만들 것도 없다 (다 만든 뒤 못 준다고 말하면 시간만 버린다)
          if (!PBCard.canShareFiles([])) { say('이 브라우저는 여러 장을 한 번에 못 받습니다. 카드마다 PNG 저장을 눌러주세요.', true); return; }
          var files = await PBCard.toFiles(items, function (i, n) { all.textContent = '만드는 중… ' + (i + 1) + '/' + n; say(''); });
          if (!PBCard.canShareFiles(files)) { say('이 브라우저는 여러 장을 한 번에 못 받습니다. 카드마다 PNG 저장을 눌러주세요.', true); all.textContent = ALL_LABEL; return; }
          ready = files;
          all.textContent = files.length + '장 공유하기';
          say('다 만들었습니다. 한 번 더 눌러 사진 앱에 저장하세요.');
          return;
        }
        for (var j = 0; j < items.length; j++) {
          all.textContent = '저장 중… ' + (j + 1) + '/' + items.length; say('');
          await PBCard.save(items[j].node, items[j].name, { share: false });
          await new Promise(function (r) { setTimeout(r, 350); });   // 연속 다운로드를 브라우저가 삼키지 않게
        }
        say(items.length + '장을 저장했습니다. 다운로드 폴더를 확인하세요.');
        all.textContent = ALL_LABEL;
      } catch (e) { console.error('[cardShot]', e); say((e && e.message) || '저장에 실패했습니다', true); all.textContent = ALL_LABEL; }
      finally { all.disabled = false; }
    });
    var copyBtn = document.getElementById('cap-copy');
    if (copyBtn) copyBtn.addEventListener('click', function () {
      navigator.clipboard.writeText(document.getElementById('cap-text').textContent).then(function () {
        document.getElementById('cap-status').textContent = '복사됨';
        setTimeout(function () { document.getElementById('cap-status').textContent = ''; }, 1500);
      });
    });
  })();
  </script>
<% } %>
</body>
</html>
